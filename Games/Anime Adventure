    local function Send(kind, target, remote, acceptUI, room)
        if R.Stopped or R.Shared.Pending then return end

        local p = {
            Kind = kind,
            Target = target,
            Room = room,
            Returned = false,
            PartyId = player:GetAttribute("PartyId"),
            Plan = R.Shared.Plan,
            Deletion = R.Shared.Delete,
        }

        R.Shared.Pending = p

        if kind == "Start" then
            R.Shared.LastStart = p
        end

        task.spawn(function()
            local valid = not R.Stopped and R.Shared.Pending == p
                and Loader and Loader.IsLobby == true
                and (not target or target.Parent == Players)

            local lock = Child(player, "TeleportingLock", "NumberValue")
            valid = valid and not (lock and lock.Value > 0)

            if kind == "Invite" then
                valid = valid and cfg.PartyEnabled
                    and cfg.PartyRole == "Leader"
                    and R.Shared.Plan == p.Plan
                    and p.Plan ~= nil
                    and (player:GetAttribute("PartyId") == nil or Owner())
                    and target:GetAttribute("PartyId") == nil

            elseif kind == "Accept" then
                valid = valid and cfg.PartyEnabled
                    and cfg.PartyRole == "Member"
                    and UserId(cfg.PartyLeaderId) == target.UserId
                    and player:GetAttribute("PartyId") == nil
                    and GUI.party_ui == acceptUI
                    and acceptUI.incoming_invites[target] ~= nil

            elseif kind == "Start" then
                local state = env.__AnimeAdventureLobbyAutoJoin

                valid = valid and cfg.PartyEnabled
                    and cfg.PartyAutoStart
                    and R.CheckStart(room, p)
                    and not (state and (state.Busy or state.Operation))
                    and room == Lobby.current_lobby_model
                    and Child(player, "AlreadyInLobby", "BoolValue")
                    and player.AlreadyInLobby.Value == true

            else
                valid = valid and R.Shared.Delete == p.Deletion
                    and p.Deletion ~= nil
                    and Owner()
                    and player:GetAttribute("PartyId") == p.PartyId
                    and (
                        not target
                        or target:GetAttribute("PartyId") == p.PartyId
                    )
            end

            if not valid then
                p.Cancelled, p.Returned = true, true
                return
            end

            local ok, result

            if acceptUI then
                ok, result = pcall(
                    acceptUI.respond_invite,
                    acceptUI,
                    target,
                    true
                )
            elseif kind == "Start" then
                ok, result = pcall(
                    remote.InvokeServer,
                    remote,
                    room.Name
                )
            elseif target then
                ok, result = pcall(remote.InvokeServer, remote, target)
            else
                ok, result = pcall(remote.InvokeServer, remote)
            end

            if kind == "Invite" and ok and result == true then
                local ui = GUI and GUI.party_ui

                if ui and type(ui.outgoing_invites) == "table"
                    and target.Parent == Players
                    and target:GetAttribute("PartyId") == nil
                then
                    ui.outgoing_invites[target] = true
                end
            end

            p.OK, p.Result, p.Returned = ok, result, true
        end)
    end

    local function Observe()
        local p = R.Shared.Pending
        if not p then return false end

        if not p.Returned then
            Status("รอ RPC ปาร์ตี้เดิม ไม่ส่งซ้ำ")
            return true
        end

        if p.Cancelled then
            if p.Plan and p.Target
                and p.Plan.Sent[p.Target.UserId] == p.Target
            then
                p.Plan.Sent[p.Target.UserId] = nil
            end

            if R.Shared.LastStart == p then
                R.Shared.LastStart = nil
            end

            R.Shared.Pending = nil
            Status("เงื่อนไขเปลี่ยนก่อนส่งคำสั่ง จึงยกเลิกเฉพาะงานที่ยังไม่ส่ง")
            return true
        end

        local confirmed

        if p.Kind == "Invite" then
            if not p.OK then
                local id = player:GetAttribute("PartyId")

                if id == nil or p.Target:GetAttribute("PartyId") ~= id then
                    Status(
                        "ผลคำเชิญไม่ชัดเจน พักคำสั่งและไม่ส่งซ้ำ: "
                        .. tostring(p.Result)
                    )
                    return true
                end
            end

            local ui = GUI and GUI.party_ui

            if p.OK and p.Result == true and ui
                and type(ui.outgoing_invites) == "table"
                and p.Target.Parent == Players
                and p.Target:GetAttribute("PartyId") == nil
            then
                ui.outgoing_invites[p.Target] = true
            end

            -- ยืนยันเพียงการส่งคำเชิญ ยังไม่ใช่การเข้าปาร์ตี้
            R.Shared.Pending = nil

            Status(p.OK and p.Result == true
                and "ส่งคำเชิญแล้ว รอสมาชิกตอบรับ"
                or ("คำเชิญไม่สำเร็จ ไม่ส่งซ้ำ: " .. tostring(p.Result)))

            return true

        elseif p.Kind == "Accept" then
            local id = player:GetAttribute("PartyId")

            confirmed = id ~= nil
                and id == p.Target:GetAttribute("PartyId")
                and player:GetAttribute("PartyOwnerId") == p.Target.UserId

        elseif p.Kind == "Start" then
            local teleport = Child(p.Room, "Teleporting", "BoolValue")
            local lock = Child(player, "TeleportingLock", "NumberValue")

            confirmed = (teleport and teleport.Value)
                or (lock and lock.Value > 0)

            if not confirmed and not p.Room.Parent then
                R.Shared.Pending = nil
                Status("ห้องเดิมถูกนำออก ผล Start ยังไม่ยืนยัน จึงไม่ส่งซ้ำ")
                return true
            end

        elseif p.Kind == "Kick" then
            confirmed = p.Target.Parent ~= Players
                or p.Target:GetAttribute("PartyId") ~= p.PartyId

        else
            confirmed = player:GetAttribute("PartyId") ~= p.PartyId
        end

        if confirmed then
            R.Shared.Pending = nil
            Status("ยืนยันผลปาร์ตี้แล้ว")
            return true
        end

        Status(p.OK
            and "รอยืนยันผลปาร์ตี้จาก Attributes ไม่ส่งซ้ำ"
            or ("คำสั่งปาร์ตี้มีข้อผิดพลาด พักรอตรวจผล: "
                .. tostring(p.Result)))

        return true
    end

    local function Render()
        local room = Lobby and Lobby.current_lobby_model
        local present = room and room.Parent and InRoom(room)
        local lines = {}

        for _, member in ipairs(Members()) do
            local leader =
                member:GetAttribute("PartyOwnerId") == member.UserId

            table.insert(
                lines,
                member.Name .. " [" .. member.UserId .. "]"
                    .. (leader and " — หัวหน้า" or " — สมาชิก")
                    .. (
                        present and present[member.UserId]
                        and " / อยู่ในห้องด่าน"
                        or " / รอเข้าห้องด่าน"
                    )
            )
        end

        local text = table.concat(lines, "\n")

        if roster.self.Parent and roster.Desc.Text ~= text then
            roster.Desc.Text = text
        end
    end

    local function Step()
        Render()

        if Observe() then return end
        if os.clock() < (R.NextLoad or 0) then return end

        if not Load() then
            R.NextLoad = os.clock() + 3
            return
        end

        if Loader.IsLobby ~= true then
            Status("ระบบปาร์ตี้รอหน้า Lobby")
            return
        end

        local lock = Child(player, "TeleportingLock", "NumberValue")

        if lock and lock.Value > 0 then
            Status("กำลังเทเลพอร์ต")
            return
        end

        local deletion = R.Shared.Delete

        if deletion then
            local id = player:GetAttribute("PartyId")

            if id ~= deletion.PartyId then
                R.Shared.Delete = nil
                Status("ปาร์ตี้เดิมยุบหรือบัญชีออกจากปาร์ตี้เดิมแล้ว")
                return
            end

            if not Owner() then
                Status("สิทธิ์หัวหน้าเปลี่ยน พักการยุบปาร์ตี้")
                return
            end

            for _, member in ipairs(Members()) do
                if member ~= player then
                    local remote = Remote("party_kick")

                    if not remote then
                        Status("รอ party_kick")
                        return
                    end

                    Send("Kick", member, remote)
                    return
                end
            end

            local remote = Remote("party_leave")

            if remote then
                Send("Leave", nil, remote)
            else
                Status("รอ party_leave")
            end

            return
        end

        local last = R.Shared.LastStart
        local inLobby = Child(player, "AlreadyInLobby", "BoolValue")

        if last and inLobby and not inLobby.Value
            and Lobby.current_lobby_model == nil
        then
            last.ExitSeen = true
        end

        if not cfg.PartyEnabled then
            R.Gate = nil
            Status("ปิด Auto Party")
            return
        end

        local state = env.__AnimeAdventureLobbyAutoJoin
        local room = Lobby.current_lobby_model

        if cfg.PartyAutoStart and cfg.PartyRole == "Leader"
            and inLobby and inLobby.Value
            and not (state and (state.Busy or state.Operation))
            and room
            and (not last or last.Room ~= room or last.ExitSeen)
        then
            local allowed, reason = R.CheckStart(room)

            if allowed then
                R.Gate = nil

                local remote = Remote("request_start_game")

                if remote then
                    Send("Start", nil, remote, nil, room)
                else
                    Status("รอ request_start_game")
                end

                return
            end

            R.Report(reason)
        end

        if cfg.PartyRole == "Member" then
            local leaderId = UserId(cfg.PartyLeaderId)

            if not leaderId or leaderId == player.UserId then
                Status("กรอก Leader UserId ให้ถูกต้อง")
                return
            end

            if player:GetAttribute("PartyId") ~= nil then
                Status(player:GetAttribute("PartyOwnerId") == leaderId
                    and "เข้าปาร์ตี้หัวหน้าที่กำหนดแล้ว"
                    or "อยู่ปาร์ตี้อื่น ไม่ออกให้อัตโนมัติ")
                return
            end

            local leader = Players:GetPlayerByUserId(leaderId)

            if leader and leader:GetAttribute("PartyId") ~= nil
                and leader:GetAttribute("PartyOwnerId") ~= leaderId
            then
                Status("ผู้เล่นที่กำหนดไม่ได้เป็นหัวหน้าปาร์ตี้")
                return
            end

            local ui = GUI and GUI.party_ui

            if not leader or leader.Parent ~= Players then
                Status("รอหัวหน้าอยู่เซิร์ฟเวอร์เดียวกัน")
                return
            end

            if type(ui) ~= "table"
                or type(ui.respond_invite) ~= "function"
                or type(ui.incoming_invites) ~= "table"
                or not ui.incoming_invites[leader]
            then
                Status("รอคำเชิญจากหัวหน้าที่กำหนด")
                return
            end

            if not Remote("party_respond_invite") then
                Status("รอ party_respond_invite")
                return
            end

            Send("Accept", leader, nil, ui)
            return
        end

        local plan = R.Shared.Plan

        if not plan then
            Status("ตั้งสมาชิกแล้วกด Create Party")
            return
        end

        if player:GetAttribute("PartyId") ~= nil and not Owner() then
            Status("บัญชีนี้ไม่ได้เป็นหัวหน้า พักคำเชิญ")
            return
        end

        local members, inParty = Members(), {}

        for _, member in ipairs(members) do
            if not plan.Expected[member.UserId] then
                Status("มีสมาชิกนอกกลุ่ม พักคำเชิญและ Start")
                return
            end

            inParty[member.UserId] = true
        end

        local targetCount = 0

        for _ in pairs(plan.Expected) do
            targetCount = targetCount + 1
        end

        if #members == targetCount then
            Status(
                "สมาชิกครบตามที่เลือก: "
                .. #members .. "/" .. targetCount
            )
            return
        end

        for id in pairs(plan.Expected) do
            local sent = plan.Sent[id]

            if sent and sent.Parent ~= Players
                and Players:GetPlayerByUserId(id) ~= sent
            then
                plan.Sent[id] = nil
            end

            if not inParty[id] and not plan.Sent[id] then
                local target = Players:GetPlayerByUserId(id)

                if target and target.Parent == Players
                    and target:GetAttribute("PartyId") == nil
                then
                    local ui = GUI and GUI.party_ui

                    if type(ui) ~= "table"
                        or type(ui.outgoing_invites) ~= "table"
                    then
                        Status("รอสถานะคำเชิญของเกม")
                        return
                    end

                    if ui.outgoing_invites[target] then
                        plan.Sent[id] = target
                        return
                    end

                    local remote = Remote("party_invite")

                    if not remote then
                        Status("รอ party_invite")
                        return
                    end

                    plan.Sent[id] = target
                    Send("Invite", target, remote)
                    return
                end
            end
        end

        Status(
            "รอสมาชิกตอบรับหรือเข้ามาเซิร์ฟเวอร์เดียวกัน; คำเชิญเดิมไม่ส่งซ้ำ"
        )
    end

    ready = true

    task.spawn(function()
        while not R.Stopped do
            local ok, reason = xpcall(Step, debug.traceback)

            if not ok then
                Status("Auto Party / Step: " .. tostring(reason))
            end

            task.wait(ok and 0.5 or 3)
        end
    end)
end


