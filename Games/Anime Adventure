            runtime.Busy = true
            -- Read the current challenge; do not assume event argument format.
            local ok, data = Invoke("get_normal_challenge")

            if ok and type(data) == "table"
                and type(data.current_uuid) == "string"
                and data.current_uuid ~= settings.ActiveChallengeUUID
                and not runtime.Stopped
                and settings.Mode == "Challenge"
                and settings.LeaveWhenChallengeChanges
            then
                runtime.LeaveRequested = true
                Invoke("teleport_back_to_lobby")
            end

            runtime.Busy = false
        end))
    end

    table.insert(runtime.Connections, mansionToggle.self.Destroying:Connect(function()
        runtime.Stop()
    end))

    ready = true
    if settings.Mode == "Mansion" then
        mansionToggle:SetValue(true)
    end

    task.spawn(function()
        local gui = playerGui:WaitForChild("ResultsUI", 15)
        if runtime.Stopped then
            return
        end
        if not gui or not gui:IsA("ScreenGui") then
            warn("[Lobby Extra] ResultsUI ScreenGui is unavailable.")
            return
        end

        resultsGui = gui
        TowerCore = Loader.load_core_service(loaderScript, "InfiniteTowerServiceCore")

        if runtime.Stopped then
            return
        end

        table.insert(runtime.Connections,
            gui:GetPropertyChangedSignal("Enabled"):Connect(TryContinue)
        )
        TryContinue()
    end)

    return
end


