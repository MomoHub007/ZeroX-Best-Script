            if type(items) ~= "table"
                or type(LevelCore) ~= "table"
                or type(
                    LevelCore.is_valid_replay_portal_item
                ) ~= "function"
            then
                return valid, false
            end

            for uuid in pairs(items) do
                if type(uuid) == "string" then
                    local ok, fits = pcall(
                        LevelCore.is_valid_replay_portal_item,
                        session,
                        uuid
                    )

                    if ok and fits == true then
                        table.insert(valid, uuid)
                    end
                end
            end

            table.sort(valid)
            return valid, true
        end

        local SellUnits
        local tags = game:GetService("CollectionService")
        local ownerTag = "player_units:"
            .. tostring(player.UserId)

        local function WaveStep(started, finished)
            local folder = Child(workspace, "_UNITS")
            local pending = state.WavePending

            if pending then
                if pending.Model.Parent ~= pending.Folder then
                    print(
                        "[Match Sell] Target left deployment: "
                            .. pending.Name
                    )

                    state.WavePending = nil
                else
                    state.WaveHold = true

                    Status(
                        "Waiting for sale confirmation: "
                            .. pending.Name
                    )
                    return true
                end
            end

            local wave = Child(
                workspace, "_wave_num", "NumberValue"
            )

            if not wave or wave.Value ~= wave.Value then
                return false
            end

            if wave.Value == 0 then
                state.WaveSold = false
                state.WaveLeaveSent = false
                state.WaveHold = false
            end

            if not started
                or not started.Value
                or not finished
                or finished.Value
                or wave.Value <= 0
            then
                return false
            end

            local sellDue = settings.MathSell
                and wave.Value >= settings.MathSellWave

            local leaveDue = settings.MathWaveLeave
                and wave.Value >= settings.MathLeaveWave

            state.WaveHold = sellDue
                or leaveDue
                or state.WaveLeaveSent == true

            if not state.WaveHold then
                return false
            end

            local normal = getgenv()["__AANormalAutoPlay"]
            if normal and (normal.Busy or (normal.Pending and #normal.Pending > 0)) then
                Status("Wave trigger: waiting for normal Auto Play reconciliation.")
                return true
            end

            local april = getgenv()["__AAAprilSelection"]

            if type(april) == "table"
                and (
                    april.PlacementBusy
                    or april.PendingSpawn
                    or april.SpellPending
                    or (
                        april.PendingActions
                        and #april.PendingActions > 0
                    )
                )
            then
                Status(
                    "Wave trigger: waiting for "
                        .. "April action reconciliation."
                )
                return true
            end

            if state.Busy then
                return true
            end

            if state.WaveLeaveSent then
                Status(
                    "Wave return requested; "
                        .. "waiting for transition."
                )
                return true
            end

            if sellDue and not state.WaveSold then
                if type(SellUnits) ~= "table" then
                    local ok, value = pcall(
                        Loader.load_data, module, "Units"
                    )

                    if ok and type(value) == "table" then
                        SellUnits = value
                    end
                end

                if type(SellUnits) ~= "table" or not folder then
                    Status(
                        "Waiting for unit definitions / deployment."
                    )
                    return true
                end

                local candidate
                local unknown = false
                local skipped = 0

                for _, model in ipairs(
                    tags:GetTagged(ownerTag)
                ) do
                    if model:IsA("Model")
                        and model.Parent == folder
                        and not tags:HasTag(
                            model, "dying_units"
                        )
                    then
                        local id = Child(
                            Child(model, "_stats"),
                            "id",
                            "StringValue"
                        )

                        local def = id and SellUnits[id.Value]

                        if type(def) ~= "table" then
                            unknown = true

                        elseif def.unsellable == true then
                            skipped = skipped + 1

                        else
                            candidate = candidate or model
                        end
                    end
                end

                if candidate then
                    local remote = Child(
                        Child(
                            Child(RS, "endpoints"),
                            "client_to_server"
                        ),
                        "sell_unit_ingame",
                        "RemoteFunction"
                    )

                    if not remote then
                        Status("Waiting for sell_unit_ingame.")
                        return true
                    end

                    if candidate.Parent ~= folder
                        or not tags:HasTag(candidate, ownerTag)
                        or tags:HasTag(
                            candidate, "dying_units"
                        )
                    then
                        return true
                    end

                    state.WavePending = {
                        Model = candidate,
                        Folder = folder,
                        Name = candidate.Name,
                    }

                    Status(
                        "Selling: " .. candidate.Name
