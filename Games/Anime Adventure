        local object = parent and parent:FindFirstChild(name)
        return object
            and (not class or object:IsA(class))
            and object or nil
    end

    local function BindInventoryEvents()
        local signals = Child(Child(RS, "endpoints"), "server_to_client")

        for _, name in ipairs({
            "unique_item_added",
            "unique_item_removed",
            "normal_item_added",
            "normal_item_removed",
        }) do
            local object = Child(signals, name, "RemoteEvent")
            local previous = bindings[name]

            if not previous or previous.Object ~= object then
                if previous then previous.Connection:Disconnect() end
                bindings[name] = nil

                if object then
                    bindings[name] = {
                        Object = object,
                        Connection = object.OnClientEvent:Connect(function()
                            if not R.Stopped then R.NextRead = 0 end
                        end),
                    }
                end
            end
        end
    end

    local function Number(n)
        return type(n) == "number" and n == n
            and n ~= math.huge and n ~= -math.huge and n >= 0
    end

    local Loader, Items, GUI, module

    local function Load()
        if not Loader then
            module = Child(Child(RS, "src"), "Loader", "ModuleScript")
            if not module then return false end

            local ok, value = pcall(require, module)
            if not ok or type(value) ~= "table" then
                Status("รอ Loader: " .. tostring(value))
                return false
            end
            Loader = value
        end

        if not Items then
            local ok, value = pcall(Loader.load_data, module, "Items")
            if R.Stopped then return false end
            if not ok or type(value) ~= "table" then
                Status("รอ Items: " .. tostring(value))
                return false
            end
            Items = value
        end

        if not GUI then
            local ok, value = pcall(
                Loader.load_client_service, module, "GUIService"
            )
            if R.Stopped then return false end
            if not ok or type(value) ~= "table" then
                Status("รอ GUIService: " .. tostring(value))
                return false
            end
            GUI = value
        end
        return true
    end

    local function RefreshSelection()
        local ids, labels, names = {}, {}, {}

        for _, id in ipairs(targets) do
            local item = Items[id]

            if type(item) == "table" and item.unique == true
                and type(item.crafting_recipe) == "table"
            then
                local name = (
                    type(item.name) == "string" and item.name or id
                ) .. " [" .. id .. "]"

                ids[name], labels[id] = id, name
                table.insert(names, name)
            end
        end

        table.sort(names)

        local signature = table.concat(names, "\n")
        if R.SelectionSignature == signature then return end

        relicIds = ids
        applyingSelection = true

        selection:ClearAll()

        for _, name in ipairs(names) do
            selection:AddList(name)
        end

        local chosen = {}

        for _, id in ipairs(targets) do
            if Selected(id) and labels[id] then
                table.insert(chosen, labels[id])
            end
        end

        selection:SetValue(chosen)
        applyingSelection = false
        R.SelectionSignature = signature
    end

    local function Context()
        local ui = GUI and GUI.craft_relics_ui
        local session = type(ui) == "table" and ui.session
        local inventory = type(session) == "table" and session.inventory
        local profile = type(session) == "table" and session.profile_data
        local contents = type(inventory) == "table"
            and inventory.inventory_profile_data

        if type(profile) ~= "table" or type(contents) ~= "table"
            or type(contents.normal_items) ~= "table"
            or type(contents.unique_items) ~= "table"
            or type(inventory.get_number_of_owned_item) ~= "function"
        then
            return
        end
        return session, inventory, profile
    end

    local function Counter(inventory)
        local cache = {}
        return function(id)
            if cache[id] ~= nil then
                return cache[id] ~= false and cache[id] or nil
            end

            local ok, value = pcall(
                inventory.get_number_of_owned_item, inventory, id
            )
            if not ok or not Number(value) or value % 1 ~= 0 then
                cache[id] = false
                return
            end
            cache[id] = value
            return value
        end
    end

    local function Evaluate(id, profile, count)
        local item = Items[id]
        if type(item) ~= "table" or item.unique ~= true
            or type(item.crafting_recipe) ~= "table"
            or not Number(item.crafting_cost)
        then
            return
        end

        local owned = count(id)
        local gold = profile.gold_amount
        local valid = owned ~= nil and Number(gold)
        local enough = valid and owned == 0 and gold >= item.crafting_cost
        local lines, ingredients = {}, {}

        for material, amount in pairs(item.crafting_recipe) do
            if type(material) ~= "string"
                or not Number(amount) or amount % 1 ~= 0
            then
                return
            end
            table.insert(ingredients, material)
        end
        table.sort(ingredients)

        for _, material in ipairs(ingredients) do
            local need = item.crafting_recipe[material]
            local have = count(material)
            local definition = Items[material]
            local name = type(definition) == "table"
                and definition.name or material
            local unique = type(definition) == "table"
                and definition.unique == true

            table.insert(lines,
                tostring(name) .. ": "
                .. (have ~= nil and tostring(have) or "?")
                .. "/" .. tostring(need)
                .. (unique and " (ใช้ Relic/ไอเทมเฉพาะเป็นวัตถุดิบ)" or "")
            )

            if have == nil then
                valid = false
                enough = false
            elseif have < need then
                enough = false
            end
        end

        if #ingredients == 0 then return end

        return {
            Id = id,
            Definition = item,
            Owned = owned,
            Cost = item.crafting_cost,
            Known = valid,
            Ready = enough,
            Lines = lines,
            Gold = Number(gold) and gold or nil,
        }
    end

    local function RecoverPending()
        if R.Pending then return end

        for _, id in ipairs(targets) do
            local entry = R.Ledger[id]
            if type(entry) == "table" and entry.State == "Sent" then
                if not Number(entry.Before) or not Number(entry.Cost) then
                    R.Pending = {Id = id, Invalid = true}
                    return
                end

                R.Pending = {
                    Id = id,
                    Before = entry.Before,
                    Cost = entry.Cost,
                    Entry = entry,
                    Sent = true,
                    FromDisk = true,
                    SaveFinished = true,
                }
                return
            end
        end
    end

    local function PendingStep(count)
        local op = R.Pending
        if not op then return false end
        if op.Invalid then
            Status("บันทึกคำสั่งเดิมไม่ครบ รอตรวจสอบ " .. op.Id)
            return true
        end
        if not op.SaveFinished then
            Status("รอบันทึกคำสั่งคราฟเดิม")
            return true
        end

        if op.CancelledBeforeSend then
            if not op.Refunded then
                R.Reserved = math.max(0, R.Reserved - op.Cost)
                cfg.RelicGoldReserved = R.Reserved
                if R.Ledger[op.Id] == op.Entry then
                    R.Ledger[op.Id] = nil
                end
                op.Refunded = true
            end

            if Persist() and not R.Stopped and env[key] == R then
                R.Pending = nil
            end
            return true
        end

        if not op.Sent or (not op.Returned and not op.FromDisk) then
            Status("รอคำสั่งคราฟเดิม ไม่ส่งซ้อน")
            return true
        end

        local owned = count(op.Id)
        if owned == nil then
            Status("รอคลังยืนยันผลคราฟ " .. op.Id)
            return true
        end
        if owned <= op.Before then
            Status("ยังไม่พบ Relic จากคำสั่งเดิม: " .. op.Id .. " ไม่ส่งซ้ำ")
            return true
        end

        op.Entry.State = "Done"
        if Persist() and not R.Stopped and env[key] == R then
            R.Pending = nil
            Status("ยืนยันได้รับ " .. op.Id .. " แล้ว")
        end
        return true
    end

    local function Step()
        BindInventoryEvents()
        if not Load() or R.Stopped then return end
        RefreshSelection()

        local session, inventory, profile = Context()
        if not session then
            Status("รอคลังและ Craft Relics ของเกม ข้อมูลที่ขาดยังไม่นับเป็น 0")
            return
        end

        local count = Counter(inventory)
        local candidate, satisfied, selectedCount = nil, 0, 0

        for _, id in ipairs(targets) do
            local selected = Selected(id)

            if selected then
                selectedCount = selectedCount + 1
            end

            local result = Evaluate(id, profile, count)
            local entry = R.Ledger[id]

            if result then
                local row = rows[id]

                row.Title.Text = type(result.Definition.name) == "string"
                    and result.Definition.name or id

                local state

                if result.Owned and result.Owned > 0 then
                    state = "มีแล้ว"
                    if selected then satisfied = satisfied + 1 end

                elseif type(entry) == "table" and entry.State == "Done" then
                    state = "คราฟแล้วในชุดนี้"
                    if selected then satisfied = satisfied + 1 end

                elseif type(entry) == "table" then
                    state = "กำลังติดตามคำสั่งคราฟ"

                elseif not result.Known then
                    state = "รอข้อมูลวัตถุดิบ/Gold"

                elseif result.Ready then
                    state = "ของครบ พร้อมคราฟ"

                else
                    state = "วัตถุดิบหรือ Gold ยังไม่ครบ"
                end

                if not selected then
                    state = "ไม่ได้เลือกคราฟ — " .. state
                end

                local text = state
                    .. "\nGold: "
                    .. (result.Gold and tostring(result.Gold) or "?")
                    .. "/" .. result.Cost
                    .. "\n" .. table.concat(result.Lines, "\n")

                if row.Desc.Text ~= text then
                    row.Desc.Text = text
                end

                if selected and not candidate
                    and result.Ready and not entry
                    and R.Reserved + result.Cost <= cfg.RelicGoldLimit
                then
                    candidate = result
                end
            else
                rows[id].Desc.Text =
                    "รอสูตร Relic ที่ถูกต้องจาก Items"
            end
        end

        budget.Desc.Text = string.format(
            "วงเงิน Gold จองสะสม %.0f / %.0f",
            R.Reserved,
            cfg.RelicGoldLimit
        )

        RecoverPending()
        if os.clock() < (R.NextWrite or 0) then return end
        if PendingStep(count) then return end

        if cfg.RelicAutoCraft ~= true then
            Status("ปิด Auto Craft")
            return
        end
        if selectedCount == 0 then
            Status("Waiting: เลือก Relic ใน Relics to Craft ก่อน")
            return
        end

        if satisfied == selectedCount then
            Status("Completed: Relic ที่เลือกครบชุดนี้ คง Toggle เปิดไว้")
            return
        end
        if Loader.IsLobby ~= true then
            Status("Auto Craft รอหน้า Lobby")
            return
        end
        if not AAExtra.StorageOK then
            Status("Auto Craft ต้องใช้พื้นที่บันทึกถาวรเพื่อรักษางบและป้องกันส่งซ้ำ")
            return
        end
        if cfg.RelicGoldLimit <= 0 then
            Status("ตั้ง Total Craft Gold Budget มากกว่า 0 ก่อน")
            return
        end
        if not candidate then
            Status("Waiting: รอวัตถุดิบ Gold หรือวงเงินรวมให้ครบ")
            return
        end

        local remote = Child(
            Child(Child(RS, "endpoints"), "client_to_server"),
            "craft_item",
            "RemoteFunction"
        )
        if not remote then
            Status("รอ craft_item")
            return
        end

        local entry = {
            State = "Sent",
            Before = candidate.Owned,
            Cost = candidate.Cost,
        }
        local op = {
            Id = candidate.Id,
            Before = candidate.Owned,
            Cost = candidate.Cost,
            Entry = entry,
            Sent = false,
            SaveFinished = false,
        }

        R.Pending = op
        R.Ledger[op.Id] = entry
        R.Reserved = R.Reserved + op.Cost
        cfg.RelicGoldReserved = R.Reserved

        local saved = Persist()
        op.SaveFinished = true

        if R.Stopped or env[key] ~= R or not saved then
            op.CancelledBeforeSend = true
            return
        end

        local currentSession, currentInventory, currentProfile = Context()
        local fresh = currentSession and Evaluate(
            op.Id, currentProfile, Counter(currentInventory)
        )

        if cfg.RelicAutoCraft ~= true or Loader.IsLobby ~= true
            or not Selected(op.Id)
            or currentSession ~= session
            or currentInventory ~= inventory
            or currentProfile ~= profile
            or not fresh or not fresh.Ready
            or fresh.Cost ~= op.Cost
            or fresh.Definition ~= candidate.Definition
            or R.Reserved > cfg.RelicGoldLimit
        then
            op.CancelledBeforeSend = true
            return
        end

        op.Sent = true
        Status("ส่งคราฟ " .. op.Id .. " แล้ว รอตรวจรับ Relic")

        local ok, result = pcall(
            remote.InvokeServer,
            remote,
            op.Id,
            "craft_relics_ui"
        )
        op.TransportOK, op.Result, op.Returned = ok, result, true
    end

    task.spawn(function()
        while not R.Stopped do
            local ok, err = xpcall(function()
                if os.clock() >= (R.NextRead or 0) then
                    R.NextRead = os.clock() + 1
                    Step()
                end
            end, debug.traceback)

            if not ok then
                Status("Relic Craft / Step: " .. tostring(err))
            end
            task.wait(ok and 0.25 or 3)
        end
    end)
end


-- Anti AFK: triggers on Player.Idled without UI controls.
do
    local player = game:GetService("Players").LocalPlayer
    local antiBusy = false

    player.Idled:Connect(function()
        if antiBusy then return end
        antiBusy = true

        local available, virtualUser, capture, click = pcall(function()
            local service = game:GetService("VirtualUser")
            return service, service.CaptureController, service.ClickButton2
        end)

        if not available
            or typeof(virtualUser) ~= "Instance"
            or type(capture) ~= "function"
            or type(click) ~= "function"
        then
            antiBusy = false
            warn("[Anti AFK] VirtualUser unavailable: " .. tostring(virtualUser))
            return
        end

        local captured, captureError = pcall(capture, virtualUser)
        if not captured then
            antiBusy = false
            warn("[Anti AFK] CaptureController failed: " .. tostring(captureError))
            return
        end

        local camera = workspace.CurrentCamera
        if not camera or not camera:IsA("Camera") then
            antiBusy = false
            return
        end

        local sent, inputError = pcall(
            click,
            virtualUser,
            Vector2.new(0, 0),
            camera.CFrame
        )
        antiBusy = false

        if not sent then
            warn("[Anti AFK] ClickButton2 failed: " .. tostring(inputError))
        end
    end)
end


