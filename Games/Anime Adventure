        end

        local function ObserveRound(data, started, finished)
            if not data or not started or not finished then
                return
            end

            local changed = state.RoundData ~= nil
                and state.RoundData ~= data
                and not finished.Value

            local restarted = state.RoundFinished == true
                    and not finished.Value
                or state.RoundStarted == true
                    and not started.Value
                    and not finished.Value

            if changed or restarted then
                state.StartSent = false
                state.ResultSent = false
                state.Result = nil
                state.FallbackSent = false
                state.TransitionStarted = false
                state.LobbyReturnSent = false
                state.ResultVisibleAt = nil
                state.WaveSold = false
                state.WaveLeaveSent = false
                state.WaveHold = state.WavePending ~= nil

                skipOpen = false
                skipSent = false
                startAt = nil

                Status("ตรวจพบรอบใหม่ รีเซ็ตสถานะคำสั่งของรอบก่อนแล้ว")
            end

            state.RoundData = data
            state.RoundStarted = started.Value
            state.RoundFinished = finished.Value
        end

        local function RequestLobby()
            if state.Stopped
                or state.Busy
                or state.LobbyReturnSent
                or state.TransitionStarted
            then
                return
            end

            local remote = Child(
                Child(
                    Child(RS, "endpoints"),
                    "client_to_server"
                ),
                "teleport_back_to_lobby",
                "RemoteFunction"
            )

            if not remote then
                Status("รอ Remote: teleport_back_to_lobby")
                return
            end

            state.LobbyReturnSent = true
            state.ResultSent = true

            Status("ส่งคำสั่งกลับ Lobby แล้ว กำลังรอสัญญาณเปลี่ยนฉาก")

            local sent, ok, result = Call("teleport_back_to_lobby")

            if sent and not ok then
                Status(
                    "คำสั่งกลับ Lobby มีข้อผิดพลาด ยังไม่ส่งซ้ำ: "
                        .. tostring(result)
                )
            end
        end

        local function Step()
            local level = Loader.LevelData

            if Loader.IsLobby ~= false
                or type(level) ~= "table"
            then
                Status("Waiting for a match.")
                return
            end

            local gui = player:FindFirstChildOfClass("PlayerGui")
            local data = Child(workspace, "_DATA")

            local finished = Child(
                data, "GameFinished", "BoolValue"
            )

            local results = Child(
                gui, "ResultsUI", "ScreenGui"
            )

            local startGui = Child(
                gui, "VoteStart", "ScreenGui"
            )

            local vote = Child(
                Child(data, "VoteStart"),
                "VotingFinished",
                "BoolValue"
            )

            local started = Child(
                data, "GameStarted", "BoolValue"
            )

            ObserveRound(data, started, finished)

            local ended = finished and finished.Value

            if not ended then
                if AAExtra.MacroBusy and AAExtra.MacroBusy() then
                    Status("รอ Macro ทำงานเสร็จ")
                    return
                end

                if WaveStep(started, finished) then
                    return
                end
            end

            local startOpen = vote
                and not vote.Value
                and startGui
                and startGui.Enabled
                and started
                and not started.Value

            if startOpen then
                startAt = startAt or os.clock()

                if settings.MathStart
                    and not state.StartSent
                    and (os.clock() - startAt >= settings.MathDelay)
                then
                    local remote = Child(
                        Child(
                            Child(RS, "endpoints"),
                            "client_to_server"
                        ),
                        "vote_start",
                        "RemoteFunction"
                    )

                    if remote then
                        state.StartSent = true
                        Status("Start vote requested.")
                        Call("vote_start")
                    end
                end
            else
                startAt = nil
            end

            local waveGui = Child(
                gui, "VoteWave", "ScreenGui"
            )

            local auto = Child(
                Child(player, "_settings"),
                "autoskip_waves",
                "BoolValue"
            )

            if settings.MathSkip
                and (
                    skipOpen
                    or (waveGui and waveGui.Enabled)
                )
                and not skipSent
                and started
                and started.Value
                and finished
                and not finished.Value
            then
                if auto and auto.Value then
                    skipSent = true
                    Status("Native auto-skip is active.")
                else
                    local remote = Child(
                        Child(
                            Child(RS, "endpoints"),
                            "client_to_server"
                        ),
                        "vote_wave_skip",
                        "RemoteFunction"
                    )

                    if remote then
                        skipSent = true

                        local _, ok, accepted =
                            Call("vote_wave_skip")

                        Status(
                            ok and accepted == true
                                and "Skip vote accepted."
                                or (
                                    "Skip unconfirmed; "
                                    .. "waiting for next window."
                                )
                        )
                    end
                end
            end

            if not (results and results.Enabled) then
                state.ResultVisibleAt = nil
            else
                state.ResultVisibleAt =
                    state.ResultVisibleAt or os.clock()
            end

            local mansion = getgenv()["__AAExtraGameplay"]
            local mansionBusy = type(mansion) == "table"
                and mansion.Busy

            if settings.MathFallback
                and finished
                and finished.Value
                and results
                and results.Enabled
                and state.ResultVisibleAt
                and os.clock() - state.ResultVisibleAt
                    >= settings.MathFallbackDelay
                and not state.FallbackSent
                and not state.LobbyReturnSent
                and not state.TransitionStarted
                and not state.Busy
                and not mansionBusy
            then
                local remote = Child(
                    Child(
                        Child(RS, "endpoints"),
                        "client_to_server"
                    ),
                    "teleport_back_to_lobby",
                    "RemoteFunction"
                )

                if remote then
                    state.FallbackSent = true
                    RequestLobby()
                    return
                end
            end

            if not (
                finished
                and finished.Value
                and results
                and results.Enabled
            ) then
                return
            end

            if state.ResultSent
                or state.Busy
                or state.TransitionStarted
            then
                return
            end

            local tower = level._gamemode == "infinite_tower"
            local portalLevel = level._is_map_or_portal_level

            local wantsPortal = settings.MathPortal
                and portalLevel
                and level._owner_player_userid == player.UserId

            local wantsNext = settings.MathNext
                and not portalLevel
                and level._is_actual_storymode

            local wantsRetry = settings.MathRetry
                and not tower
                and not portalLevel
                and not level._event_contract
                and not level._dungeon

            local mansionOwns = tower
                and settings.Mode == "Mansion"

            if settings.MathReturn
                and not wantsPortal
                and not wantsNext
                and not wantsRetry
                and not mansionOwns
            then
                RequestLobby()
                return
            end

            if tower then
                Status("Infinity Mansion ใช้ระบบเล่นต่อเดิม")
                return
            end

            local controller = type(GUI) == "table"
                and GUI.results_ui

            if type(controller) ~= "table"
                or controller._teleport_locked
            then
                return
            end

            local result = state.Result

            if type(result) ~= "table" then
                result = controller.settings
            end

            if type(result) ~= "table"
                or type(result.victory) ~= "boolean"
            then
                Status("Waiting for verified result.")
                return
            end

            local action, portal

            if level._is_map_or_portal_level then
                if level._owner_player_userid ~= player.UserId then
                    Status("Waiting for the Portal host.")
                    return
                end

                if settings.MathPortal then
                    local choices, inventoryReady = Portals()

                    if not inventoryReady then
                        Status("Waiting for compatible Portal inventory.")
                        return
                    end

                    local signature = table.concat(choices, "|")

                    if signature ~= portalSignature then
                        portalSignature = signature
                        applyingPortal = true

                        portalDropdown:ClearAll()
                        portalDropdown:AddList("--")

                        for _, uuid in ipairs(choices) do
                            portalDropdown:AddList(uuid)
                        end

                        portalDropdown:SetValue(
                            table.find(
                                choices, settings.MathPortalUUID
                            )
                                and settings.MathPortalUUID
                                or "--"
                        )

                        applyingPortal = false
                    end

                    portal = table.find(
                        choices, settings.MathPortalUUID
                    )
                        and settings.MathPortalUUID
                        or choices[1]

                    if portal then
                        action = "Portal"
                    end
                end

            elseif settings.MathNext
                and result.victory == true
            then
                local button = controller.NextLevelButton

                if level._is_actual_storymode ~= true then
                    Status("Auto Next: Not a story level")

                elseif typeof(button) ~= "Instance"
                    or not button:IsA("TextButton")
                then
                    Status("Auto Next: Waiting for NextLevelButton")

                elseif level._owner_player_nonportal_userid
                    ~= player.UserId
                then
                    Status("Auto Next: Waiting for room owner")

                else
                    -- ResultsUI has two phases.
                    -- NextLevelButton.Visible is false during XP summary.
                    -- Native server vote does not require clicking that UI.
                    action = "Next"

                    Status("Auto Next: Story vote ready")
                end
            end

            if not action
                and settings.MathRetry
                and not level._is_map_or_portal_level
                and not level._event_contract
                and not level._dungeon
            then
                action = "Retry"
            end

            if not action and settings.MathReturn then
                action = "Return"
            end

            if not action then
                Status("Results: no applicable enabled action.")
                return
            end

            local remoteName = action == "Return"
                and "teleport_back_to_lobby"
                or "set_game_finished_vote"

            local remote = Child(
                Child(
                    Child(RS, "endpoints"),
                    "client_to_server"
                ),
                remoteName,
                "RemoteFunction"
            )

            if not remote then
                Status("Waiting for Remote: " .. remoteName)
                return
            end

            -- Reserve before sending to prevent duplicate result actions.
            state.ResultSent = true
            Status("Requested: " .. action .. ". Waiting for transition.")

            if action == "Portal" then
                Call(remoteName, "replay", {
                    item_uuid = portal,
                })
            elseif action == "Next" then
                Call(remoteName, "next_story")
            elseif action == "Retry" then
                Call(remoteName, "replay")
            else
                RequestLobby()
            end
        end

        while not state.Stopped do
            LoadServices()

            Bind("start_vote_wave_skip", function()
                skipOpen = true
                skipSent = false
            end)

            Bind("close_vote_prompts", function()
                skipOpen = false
                skipSent = true
            end)

            Bind("boss_wave", function()
                skipOpen = false
                skipSent = true
            end)

            Bind("game_finished", function(result)
                if type(result) == "table"
                    and type(result.victory) == "boolean"
                then
                    state.Result = result
                end
            end)

            Bind("replay_started", function()
                state.TransitionStarted = true
                Status("Replay accepted; teleporting...")
            end)

            Bind("on_lock_teleport_to_lobby", function()
                state.TransitionStarted = true
                Status("Returning to Lobby...")
            end)

            local ok, failure = xpcall(Step, debug.traceback)

            if not ok then
                Status("Waiting after error; see console.")
                warn("[Math] " .. tostring(failure))
            end

            task.wait(0.5)
        end
    end)
end

