                        Title = option.title,
                        Kind = option.option_type,
                    })

                    AddCard(option.option_type, option.title)
                end
            end

            table.sort(rows, function(a, b)
                return a.Slot < b.Slot
            end)

            if #rows == 0 then return end

            currentRound = {
                Options = rows,
                Deadline = os.clock() + duration,
                Source = boundOptions,
            }

            CardStatus("Cards received: " .. #rows)
        end

        local function ChooseBest(rows, folder)
            local best = nil
            local bestKind = math.huge
            local bestRank = math.huge

            local function GetPriority(kind, title)
                local group = summerGroups[kind]
                if not group then
                    return math.huge
                end

                local exact = table.find(group.Order, title)
                if exact then
                    return exact
                end

                -- Match category labels against actual tiered titles.
                for index, saved in ipairs(group.Order) do
                    local prefix = saved .. " "

                    if title:sub(1, #prefix) == prefix then
                        local suffix = title:sub(#prefix + 1)

                        if suffix == "I"
                            or suffix == "II"
                            or suffix == "III"
                        then
                            return index
                        end
                    end
                end

                return math.huge
            end

            for _, row in ipairs(rows) do
                if Child(folder, row.Slot, "NumberValue") then
                    local kindRank

                    if row.Kind == "Good" then
                        kindRank = 1
                    elseif row.Kind == "Bad" then
                        kindRank = 2
                    end

                    if kindRank then
                        local rank = GetPriority(
                            row.Kind,
                            row.Title
                        )

                        if not best
                            or kindRank < bestKind
                            or (
                                kindRank == bestKind
                                and rank < bestRank
                            )
                        then
                            best = row
                            bestKind = kindRank
                            bestRank = rank
                        end
                    end
                end
            end

            return best
        end

