function App:MakeTab(settings)
    settings = settings or {}
    local title = tostring(settings.Title or "Tab")
    local icon = TabIconMap[title] or settings.Icon or "layers"
    local section = settings.Section or TabSectionMap[title]

    local macTab = Tabs.ByTitle[title] or Window:AddTab({
        Title = title,
        Icon = icon,
        Section = section,
    })

    if settings.Selected == true then
        task.defer(function()
            pcall(function()
                macTab:Select()
            end)
        end)
    end

    local tabObj = {
        Tab = macTab,
        Title = title,
    }

    function tabObj:Section(secTitle)
        local macSection = self.Tab:AddSection({
            Title = tostring(secTitle or ""),
        })

        local secObj = {
            Section = macSection,
            Tab = self.Tab,
            Title = secTitle,
        }

        function secObj:Paragraph(cfg)
            cfg = cfg or {}
            local initialTitle = tostring(cfg.Title or "")
            local initialDesc = tostring(cfg.Description or "")

            local row = self.Section:AddParagraph({
                Title = initialTitle,
                Content = initialDesc,
            })

            local rowObj = row.Row or row
            local frame = rowObj.Frame or Instance.new("Frame")
            local contentFrame = rowObj.Content or frame
            local separator = rowObj.Separator or Instance.new("Frame")
            local titleLabel = rowObj.TitleLabel
            local descLabel = rowObj.DescLabel

            local descText = initialDesc
            local descProxy = {}
            setmetatable(descProxy, {
                __index = function(t, k)
                    if k == "Text" then
                        return (descLabel and descLabel.Text) or descText
                    end
                    return rawget(t, k)
                end,
                __newindex = function(t, k, v)
                    if k == "Text" then
                        descText = tostring(v or "")
                        local str = tostring(v or "")
                        pcall(function()
                            if row.SetContent then
                                row:SetContent(str)
                            elseif rowObj.SetDesc then
                                rowObj:SetDesc(str)
                            elseif descLabel then
                                descLabel.Text = str
                            end
                        end)
                    else
                        rawset(t, k, v)
                    end
                end,
            })

            local titleText = initialTitle
            local titleProxy = {}
            setmetatable(titleProxy, {
                __index = function(t, k)
                    if k == "Text" then
                        return (titleLabel and titleLabel.Text) or titleText
                    end
                    return rawget(t, k)
                end,
                __newindex = function(t, k, v)
                    if k == "Text" then
                        titleText = tostring(v or "")
                        local str = tostring(v or "")
                        pcall(function()
                            if rowObj.SetTitle then
                                rowObj:SetTitle(str)
                            elseif titleLabel then
                                titleLabel.Text = str
                            end
                        end)
                    else
                        rawset(t, k, v)
                    end
                end,
            })

            local pItem = {
                self = frame,
                Desc = descProxy,
                Title = titleProxy,
                Left = contentFrame,
                Line = separator,
                Right = rowObj.Accessory or Instance.new("Frame"),
                Row = rowObj,
                Element = row,
            }

            function pItem:SetValue(val)
                self.Desc.Text = val
            end
            function pItem:SetContent(val)
                self.Desc.Text = val
            end
            function pItem:Typography(text)
                local tObj = { Text = tostring(text or "") }
                return setmetatable(tObj, {
                    __newindex = function(s, k, v)
                        rawset(s, k, v)
                    end
                })
            end
            function pItem:Icon()
                return setmetatable({}, { __index = function() return function() end end })
            end
            function pItem:Status()
                return setmetatable({}, { __index = function() return function() end end })
            end
            function pItem:Padding() end
            function pItem:Layout() end

            return setmetatable(pItem, {
                __index = function(t, k)
                    if k == "Description" then
                        return t.Desc.Text
                    end
                    return rawget(t, k)
                end,
                __newindex = function(t, k, v)
                    if k == "Description" then
                        t.Desc.Text = v
                    elseif k == "Title" then
                        t.Title.Text = v
                    elseif k == "Visible" then
                        pcall(function()
                            if rowObj.SetVisible then
                                rowObj:SetVisible(v)
                            else
                                frame.Visible = v
                            end
                        end)
                    else
                        rawset(t, k, v)
                    end
                end,
            })
        end

        function secObj:Toggle(cfg)
            cfg = cfg or {}
            local idx = NextControlIndex("Toggle", cfg.Title)
            local toggleObj
            local initialVal = cfg.Value == true

            local macToggle = self.Section:AddToggle(idx, {
                Title = cfg.Title or "Toggle",
                Description = cfg.Description or "",
                Default = initialVal,
                Callback = function(val)
                    if toggleObj and cfg.Callback then
                        task.spawn(pcall, cfg.Callback, toggleObj, val)
                    end
                end,
            })

            local rowObj = macToggle.Row or macToggle
            toggleObj = {
                self = rowObj.Frame or Instance.new("Frame"),
                Row = rowObj,
                Element = macToggle,
                Value = initialVal,
            }

            function toggleObj:SetValue(val)
                self.Value = val == true
                pcall(function()
                    macToggle:SetValue(self.Value)
                end)
            end

            return toggleObj
        end

        function secObj:Button(cfg)
            cfg = cfg or {}
            local buttonObj
            local macButton = self.Section:AddButton({
                Title = cfg.Title or "Button",
                Description = cfg.Description or "",
                ButtonText = cfg.ButtonText or "Click",
                Style = (cfg.Type == "Danger" and "Destructive" or "Primary"),
                Callback = function()
                    if cfg.Type == "Danger" then
                        Window:Dialog({
                            Title = cfg.Title or "Confirm",
                            Content = cfg.Description or "Confirm action?",
                            Buttons = {
                                {
                                    Title = "Confirm",
                                    Callback = function()
                                        if cfg.Callback then
                                            task.spawn(pcall, cfg.Callback, buttonObj)
                                        end
                                    end,
                                },
                                { Title = "Cancel" },
                            },
                        })
                    else
                        if cfg.Callback then
                            task.spawn(pcall, cfg.Callback, buttonObj)
                        end
                    end
                end,
            })

            local rowObj = macButton.Row or macButton
            buttonObj = {
                self = rowObj.Frame or Instance.new("Frame"),
                Row = rowObj,
                Element = macButton,
            }
            return buttonObj
        end

        function secObj:Slider(cfg)
            cfg = cfg or {}
            local idx = NextControlIndex("Slider", cfg.Title)
            local sliderObj
            local initialVal = cfg.Value ~= nil and cfg.Value or (cfg.Min or 0)
            local inc = (cfg.Rounding and cfg.Rounding > 0) and (1 / (10 ^ cfg.Rounding)) or 1

            local macSlider = self.Section:AddSlider(idx, {
                Title = cfg.Title or "Slider",
                Description = cfg.Description or "",
                Min = cfg.Min or 0,
                Max = cfg.Max or 100,
                Default = initialVal,
                Rounding = cfg.Rounding or 0,
                Increment = inc,
                Callback = function(val)
                    if sliderObj and cfg.Callback then
                        task.spawn(pcall, cfg.Callback, sliderObj, val)
                    end
                end,
            })

            local rowObj = macSlider.Row or macSlider
            sliderObj = {
                self = rowObj.Frame or Instance.new("Frame"),
                Row = rowObj,
                Element = macSlider,
                Value = initialVal,
            }

            function sliderObj:SetValue(val)
                self.Value = val
                pcall(function()
                    macSlider:SetValue(val)
                end)
            end

            return sliderObj
        end

        function secObj:Textbox(cfg)
            cfg = cfg or {}
            local idx = NextControlIndex("Input", cfg.Title)
            local inputObj
            local initialVal = cfg.Value ~= nil and tostring(cfg.Value) or ""
            local isNum = cfg.TypeOfValue == "number"

            local macInput = self.Section:AddInput(idx, {
                Title = cfg.Title or "Input",
                Description = cfg.Description or "",
                Default = initialVal,
                Numeric = isNum,
                Finished = true,
                Callback = function(text)
                    if inputObj and cfg.Callback then
                        local finalVal = isNum and (tonumber(text) or 0) or text
                        task.spawn(pcall, cfg.Callback, inputObj, finalVal)
                    end
                end,
            })

            local rowObj = macInput.Row or macInput
            inputObj = {
                self = rowObj.Frame or Instance.new("Frame"),
                Row = rowObj,
                Element = macInput,
                Value = initialVal,
            }
            return inputObj
        end

        function secObj:Dropdown(cfg)
            cfg = cfg or {}
            local idx = NextControlIndex("Dropdown", cfg.Title)
            local isMulti = type(cfg.Value) == "table"
            local rawList = {}
            if type(cfg.List) == "table" then
                for _, v in ipairs(cfg.List) do
                    table.insert(rawList, tostring(v))
                end
            end

            local dropdownObj
            local macDropdown

            macDropdown = self.Section:AddDropdown(idx, {
                Title = cfg.Title or "Dropdown",
                Description = cfg.Description or "",
                Values = rawList,
                Multi = isMulti,
                Searchable = true,
                AllowNull = true,
                Default = cfg.Value,
                Callback = function(val)
                    if not dropdownObj or not macDropdown or not cfg.Callback then
                        return
                    end

                    if isMulti then
                        local arr = {}
                        local currentValues = macDropdown.Values or rawList or {}

                        if type(val) == "table" then
                            for _, item in ipairs(currentValues) do
                                if val[item] == true then
                                    table.insert(arr, item)
                                end
                            end
                        end

                        task.spawn(pcall, cfg.Callback, dropdownObj, arr)
                    else
                        task.spawn(pcall, cfg.Callback, dropdownObj, val or "--")
                    end
                end,
            })

            local rowObj = macDropdown.Row or macDropdown
            local frame = rowObj.Frame or Instance.new("Frame")

            dropdownObj = {
                self = frame,
                Row = rowObj,
                Element = macDropdown,
                IsMulti = isMulti,
            }

            function dropdownObj:ClearAll()
                macDropdown.Values = {}
                pcall(function()
                    macDropdown:SetValues({})
                    macDropdown:SetValue(isMulti and {} or nil)
                end)
            end

            function dropdownObj:Clear(value)
                if value == nil then
                    return self:ClearAll()
                end
                local current = macDropdown.Values or {}
                local updated = {}
                for _, item in ipairs(current) do
                    local matched = false
                    if type(value) == "string" and item == value then
                        matched = true
                    elseif type(value) == "table" then
                        for _, v in ipairs(value) do
                            if item == v then matched = true; break end
                        end
                    end
                    if not matched then
                        table.insert(updated, item)
                    end
                end
                macDropdown.Values = updated
                pcall(function()
                    macDropdown:SetValues(updated)
                end)
            end

            function dropdownObj:AddList(name)
                if type(name) ~= "string" then return end
                local current = macDropdown.Values or {}
                if not table.find(current, name) then
                    table.insert(current, name)
                    macDropdown.Values = current
                    pcall(function()
                        macDropdown:SetValues(current)
                    end)
                end
            end

            function dropdownObj:SetValue(val)
                pcall(function()
                    macDropdown:SetValue(val)
                end)
            end

            function dropdownObj:CloseDropdown()
                pcall(function()
                    macDropdown:Close()
                end)
            end

            return dropdownObj
        end

        return secObj
    end

    return tabObj
end

