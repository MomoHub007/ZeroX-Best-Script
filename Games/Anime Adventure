      local function SaveDraft()
        if not R.Draft then
            R.Mode = "Idle"
            Status("Recording cancelled.")
            return
        end

        -- ตรวจผลอีกครั้งก่อนเซฟ
        for _, item in ipairs(R.Queue) do
            if not item.Done
                and item.Returned
                and not item.Rejected
                and R.ObserveRecorded
            then
                local ok, confirmed = pcall(R.ObserveRecorded, item)

                if ok and confirmed then
                    item.Success = true
                    item.Done = true
                end
            end
        end

        local actions = {}
        local available = {}
        local needed = {}
        local skipped = 0

        for _, item in ipairs(R.Queue) do
            local action = item.Action

            if action.Type ~= "Bind"
                and item.Success == true
                and not item.Rejected
            then
                if action.Unit then needed[action.Unit] = true end
                if action.Target then needed[action.Target] = true end
            end
        end

        for _, item in ipairs(R.Queue) do
            local action = item.Action

            if action.Type == "Bind" then
                -- เก็บข้อมูลอ้างอิงเฉพาะตัวที่ action สำเร็จต้องใช้
                if needed[action.Unit] then
                    table.insert(actions, action)
                    available[action.Unit] = true
                end
            elseif item.Success == true and not item.Rejected then
                local unitReady = action.Type == "Place"
                    or not action.Unit
                    or available[action.Unit]

                local targetReady = not action.Target
                    or available[action.Target]

                if unitReady and targetReady then
                    table.insert(actions, action)

                    if action.Type == "Place" then
                        available[action.Unit] = true
                    end
                else
                    skipped = skipped + 1
                end
            else
                skipped = skipped + 1
            end
        end

        R.Draft.Actions = actions
        profiles[R.DraftName] = R.Draft
        selected = R.DraftName

        local saved = AAExtra.StorageOK and AAExtra.Save()
        Refresh()

        Status(
            "Saved " .. #actions .. " entries; skipped "
                .. skipped .. " failed / unconfirmed actions"
                .. (saved and "." or " (memory only).")
        )

        R.Draft = nil
        R.Queue = {}
        R.Mode = "Idle"
    end
