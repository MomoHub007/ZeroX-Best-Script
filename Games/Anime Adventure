    local function BuildStageList(order, list, entries, category)
        if type(order) ~= "table" then
            warn("[Lobby] Missing runtime world order: " .. category)
            return
        end

        for _, worldId in ipairs(order) do
            local world = Worlds[worldId]
            if type(world) == "table" and type(world.levels) == "table" then
                local acts = {}

                for key, reference in pairs(world.levels) do
                    local id = type(reference) == "table" and reference.id
                    if type(id) == "string" and type(Levels[id]) == "table" then
                        table.insert(acts, {
                            Key = tostring(key),
                            Id = id,
                        })
                    end
                end

                table.sort(acts, function(a, b)
                    local first, second = tonumber(a.Key), tonumber(b.Key)
                    if first and second and first ~= second then
                        return first < second
                    end
                    return a.Key < b.Key
                end)

                for _, act in ipairs(acts) do
                    local level = Levels[act.Id]
                    local worldName = type(world.name) == "string" and world.name or tostring(worldId)
                    local levelName = type(level.name) == "string" and level.name or act.Id
                    local label = worldName .. " / " .. levelName .. " [" .. act.Id .. "]"

                    if not entries[label] then
                        entries[label] = {
                            Id = act.Id,
                            World = worldId,
                        }
                        table.insert(list, label)
                    end
                end
            else
                warn(
                    "[Lobby] Missing " .. category .. " world/levels mapping: " .. tostring(worldId)
                )
            end
        end
    end

