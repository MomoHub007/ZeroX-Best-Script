        -- Cache structure only. CFrame and Size are read live during checks.
        local function Parts(root, cache)
            if not root then
                return nil
            end

            local entry = cache[root]
            if not entry then
                entry = { Dirty = true }
                cache[root] = entry

                local function Invalidate()
                    entry.Dirty = true
                end

                table.insert(runtime.Connections, root.DescendantAdded:Connect(Invalidate))
                table.insert(runtime.Connections, root.DescendantRemoving:Connect(Invalidate))
                table.insert(runtime.Connections, root.Destroying:Connect(function()
                    cache[root] = nil
                end))
            end

            if entry.Dirty then
                local parts = {}
                if root:IsA("BasePart") then
                    table.insert(parts, root)
                end

                for _, object in ipairs(root:GetDescendants()) do
                    if object:IsA("BasePart") then
                        table.insert(parts, object)
                    end
                end

                entry.Parts = parts
                entry.Dirty = false
            end

            return entry.Parts
        end

        -- Oriented-box separation test.
        -- Conservative for MeshParts/non-block shapes: may reject extra points.
        local function BoxesOverlap(cfA, sizeA, cfB, sizeB)
            local axesA = { cfA.RightVector, cfA.UpVector, cfA.LookVector }
            local axesB = { cfB.RightVector, cfB.UpVector, cfB.LookVector }
            local halfA = { sizeA.X / 2, sizeA.Y / 2, sizeA.Z / 2 }
            local halfB = { sizeB.X / 2, sizeB.Y / 2, sizeB.Z / 2 }
            local delta = cfB.Position - cfA.Position

            local function Separated(axis)
                if axis:Dot(axis) < 1e-12 then
                    return false
                end

                local radiusA, radiusB = 0, 0
                for i = 1, 3 do
                    radiusA += halfA[i] * math.abs(axesA[i]:Dot(axis))
                    radiusB += halfB[i] * math.abs(axesB[i]:Dot(axis))
                end

                return math.abs(delta:Dot(axis)) > radiusA + radiusB
            end

            for i = 1, 3 do
                if Separated(axesA[i]) or Separated(axesB[i]) then
                    return false
                end

                for j = 1, 3 do
                    if Separated(axesA[i]:Cross(axesB[j])) then
                        return false
                    end
                end
            end

            return true
        end

        local function FindBounds()
            local bounds = ReplicatedStorage:FindFirstChild("_bounds")
            if bounds then
                return bounds
            end

            -- Native placement temporarily reparents this same object here.
            return Child(Child(workspace, "ignore"), "_bounds")
                or Child(Child(workspace, "Map"), "Bounds")
        end

        local function HasCollision(cf, size, road, bounds)
            for _, root in ipairs({ road, bounds }) do
                for _, part in ipairs(Parts(root, obstacleCache) or {}) do
                    if part.Parent and BoxesOverlap(cf, size, part.CFrame, part.Size) then
                        return true
                    end
                end
            end

            for _, hitbox in ipairs(CollectionService:GetTagged("player_unit_hitboxes")) do
                if hitbox:IsA("BasePart") and hitbox:IsDescendantOf(workspace)
                    and BoxesOverlap(cf, size, hitbox.CFrame, hitbox.Size)
                then
                    return true
                end
            end

            return false
        end

        local function CalcCanvas(part)
            local _, _, normalId = Util.get_upwards_direction(part.CFrame, part)
            local normal = -Vector3.FromNormalId(normalId)
            local dot = normal:Dot(Vector3.new(0, 1, 0))
            local axis = math.abs(dot) == 1
                and Vector3.new(-dot, 0, 0)
                or Vector3.new(0, 1, 0)
            local right = CFrame.fromAxisAngle(axis, math.pi / 2) * normal
            local up = normal:Cross(right).Unit

            return part.CFrame * CFrame.fromMatrix(
                -normal * part.Size / 2,
                right,
                up,
                normal
            )
        end

        local function Geometry(record, definition)
            local model
            local ok, geometry = xpcall(function()
                model = UnitCore.get_pet_model(
                    record.unit_id,
                    record.shiny,
                    record.skin,
                    nil, nil, nil,
                    true,
                    { traits = record.traits }
                )

                assert(
                    typeof(model) == "Instance" and model:IsA("Model"),
                    "get_pet_model did not return a Model"
                )

                local root = Child(model, "HumanoidRootPart", "BasePart")
                assert(root, "Placement model has no HumanoidRootPart")
                root.Anchored = true

                local level = Loader.LevelData
                local tournament = type(level) == "table" and level._tournament
                if not (type(tournament) == "table" and tournament.traitless) then
                    TraitCore.apply_trait(model, record.unit_id, record.traits, nil)
                end

                local alignment = UnitCore.create_hitbox_client(model, true, definition)
                alignment.Name = "_placement_hitbox"

                local collision = UnitCore.create_hitbox_client(model, false, definition)

                return {
                    Range = UnitCore.get_unit_range_with_override(
                        model,
                        record.unit_id,
                        record,
                        collectionService.session
                    ),
                    Height = alignment.Size.Y,
                    CollisionOffset = alignment.CFrame:ToObjectSpace(collision.CFrame),
                    CollisionSize = collision.Size * Vector3.new(0.01, 1, 0.01),
                }
            end, debug.traceback)

            if typeof(model) == "Instance" then
                model:Destroy()
            end

            if not ok then
                error(geometry, 0)
            end
            return geometry
        end

        local PathService = Loader.load_core_service(
            loaderScript, "PathService"
        )

        local function Finite(value)
            return type(value) == "number"
                and value == value
                and math.abs(value) < math.huge
        end

        local function PathPlan(preferSpawn, antiLeak)
            local base = Child(Child(workspace, "_BASES"), "pve")
            local lanes = Child(base, "LANES")

            local cache = type(PathService) == "table"
                and PathService.PATH_CACHE

            local baseCache = type(cache) == "table"
                and cache[base]

            if not lanes or type(baseCache) ~= "table" then
                return nil, "Waiting for the native PvE path cache."
            end

            local plan = {
                Segments = {},
                Targets = {},
            }

            for _, lane in ipairs(lanes:GetChildren()) do
                local laneCache = baseCache[lane]
                local points = {}

                if type(laneCache) == "table"
                    and type(laneCache.point_data) == "table"
                then
                    for part, info in pairs(laneCache.point_data) do
                        if typeof(part) == "Instance"
                            and part:IsA("BasePart")
                            and part:IsDescendantOf(lane)
                            and type(info) == "table"
                            and Finite(info.distance_from_spawn)
                        then
                            table.insert(points, {
                                Part = part,
                                Distance = info.distance_from_spawn,
                            })
                        end
                    end
                end

                table.sort(points, function(a, b)
                    return a.Distance < b.Distance
                end)

                for i = 2, #points do
                    table.insert(plan.Segments, {
                        points[i - 1].Part.Position,
                        points[i].Part.Position,
                        points[i - 1].Distance,
                        points[i].Distance,
                        lane,
                        laneCache.total_distance,
                    })
                end

                local final = Child(lane, "final", "BasePart")
                if final then
                    table.insert(plan.Targets, final.Position)
                end
            end

            if #plan.Segments == 0 then
                return nil, "PvE path segments are not ready."
            end

            if antiLeak == nil then
                antiLeak = AAExtra.Settings.AprilAntiLeak == true
            end
            plan.AntiLeak = not preferSpawn and antiLeak == true

            if plan.AntiLeak then
                if type(
                    PathService.calculate_unit_distance_from_base
                ) ~= "function" then
                    return nil, "Native enemy progression helper is unavailable."
                end

                local folder = Child(workspace, "_UNITS")
                local target
                local minimum = math.huge

                for _, enemy in ipairs(
                    CollectionService:GetTagged("pve_units")
                ) do
                    if enemy:IsA("Model")
                        and enemy.Parent == folder
                        and CollectionService:HasTag(
                            enemy, "pve_minions_alive"
                        )
                    then
                        local stats = Child(enemy, "_stats")
                        local root = Child(enemy, "_root", "ObjectValue")
                        local bend = Child(
                            stats, "last_reached_bend", "ObjectValue"
                        )
                        local lane = Child(stats, "lane", "ObjectValue")
                        local origin = Child(stats, "base", "ObjectValue")

                        local byBase = origin and cache[origin.Value]
                        local route = lane
                            and type(byBase) == "table"
                            and byBase[lane.Value]

                        if not root or not root.Value
                            or not root.Value:IsA("BasePart")
                            or not bend or not bend.Value
                            or not bend.Value:IsA("BasePart")
                            or not lane or not lane.Value
                            or lane.Value.Parent ~= lanes
                            or type(route) ~= "table"
                            or type(route.point_data) ~= "table"
                            or type(
                                route.point_data[bend.Value]
                            ) ~= "table"
                            or not Finite(route.total_distance)
                            or not Finite(
                                route.point_data[bend.Value]
                                    .distance_from_spawn
                            )
                        then
                            return nil, "Waiting for live enemy path references."
                        end

                        local ok, remaining, traveled = pcall(
                            PathService.calculate_unit_distance_from_base,
                            enemy
                        )

                        if not ok then
                            return nil,
                                "Enemy progression failed: "
                                    .. tostring(remaining)
                        end

                        if not Finite(remaining) then
                            return nil,
                                "Enemy progression returned a non-finite distance."
                        end

                        if not Finite(traveled) then
                            return nil,
                                "Enemy traveled distance is unavailable."
                        end

                        if remaining < minimum then
                            minimum = remaining
                            target = root.Value.Position
                            plan.TargetLane = lane.Value
                            plan.TargetTravel = traveled
                        end
                    end
                end

                if target then
                    plan.Targets = { target }
                else
                    -- No live enemy: use opening placement.
                    plan.AntiLeak = false
                    plan.Targets = {}
                end
            end

            return plan
        end

        local function PathDistance(position, plan)
            local nearest
            local distance = math.huge

            for _, segment in ipairs(plan.Segments) do
                local delta = segment[2] - segment[1]
                local lengthSquared = delta:Dot(delta)

                local t = lengthSquared > 0
                    and math.clamp(
                        (position - segment[1]):Dot(delta)
                            / lengthSquared,
                        0,
                        1
                    )
                    or 0

                local point = segment[1] + delta * t
                local current = (position - point).Magnitude

                if current < distance then
                    nearest = point
                    distance = current
                end
            end

            return distance, nearest
        end

        local function PlacementScore(position, plan)
            local pathDistance, anchor = PathDistance(position, plan)
            local score = pathDistance

            if plan.AntiLeak then
                score = math.huge

                for _, target in ipairs(plan.Targets) do
                    local current = (position - target).Magnitude

                    if current < score then
                        score = current
                        anchor = target
                    end
                end
            end

            return score, pathDistance, anchor
        end

        local function PathCoverage(position, plan, range)
            if not Finite(range) or range <= 0 then
                return 0
            end

            local radiusSquared = range * range
            if not Finite(radiusSquared) then
                return 0
            end

            -- Cache geometry for this PathPlan snapshot.
            if not plan.CoverageSegments then
                local cached = {}

                for _, segment in ipairs(plan.Segments) do
                    local delta = segment[2] - segment[1]
                    local length = delta.Magnitude

                    if Finite(length) and length > 0 then
                        table.insert(cached, {
                            Start = segment[1],
                            Direction = delta / length,
                            Length = length,
                        })
                    end
                end

                plan.CoverageSegments = cached
            end

            local coverage = 0

            for _, segment in ipairs(plan.CoverageSegments) do
                local offset = position - segment.Start
                local along = offset:Dot(segment.Direction)

                local perpendicularSquared = math.max(
                    0,
                    offset:Dot(offset) - along * along
                )

                if perpendicularSquared < radiusSquared then
                    local reach = math.sqrt(
                        radiusSquared - perpendicularSquared
                    )

                    local enter = math.max(0, along - reach)
                    local leave = math.min(
                        segment.Length, along + reach
                    )

                    if leave > enter then
                        coverage = coverage + leave - enter
                    end
                end
            end

            return coverage
        end

        local function EconomyCandidate(record, definition, token, options)
            local terrain = Child(workspace, "_terrain")
            local ground = Child(terrain, "ground")
            local hill = Child(terrain, "hill")
            local road = Child(workspace, "_road")
            local bounds = FindBounds()

            if not road or not bounds then
                return nil, "Waiting for road / Bounds placement validation."
            end

            local roots = {}

            if definition.hill_unit then
                if hill then table.insert(roots, hill) end
            elseif definition.hybrid_placement then
                if ground then table.insert(roots, ground) end
                if hill then table.insert(roots, hill) end
            elseif ground then
                table.insert(roots, ground)
            end

            if #roots == 0 then
                return nil, "Economy placement terrain is unavailable."
            end

            local geometry = Geometry(record, definition)

            local offsets = {
                Vector2.new(0, 0),
                Vector2.new(0.25, 0),
                Vector2.new(-0.25, 0),
                Vector2.new(0, 0.25),
                Vector2.new(0, -0.25),
                Vector2.new(0.25, 0.25),
                Vector2.new(-0.25, 0.25),
                Vector2.new(0.25, -0.25),
                Vector2.new(-0.25, -0.25),
            }

            local surfaces = {}

            for _, root in ipairs(roots) do
                for _, part in ipairs(Parts(root, terrainCache) or {}) do
                    if part.Parent and part.Name ~= "_donotplace" then
                        table.insert(surfaces, part)
                    end
                end
            end

            if #surfaces == 0 then
                return nil, "No economy placement surfaces are ready."
            end

            runtime.EconomySearch = runtime.EconomySearch or {}
            local cursor = runtime.EconomySearch[record.unit_id] or 0
            local total = #surfaces * #offsets

            for checked = 1, math.min(total, 64) do
                if not IsCurrent(token) or not MatchActive(token) then
                    return nil
                end

                local index = (cursor + checked - 1) % total
                local part = surfaces[index % #surfaces + 1]
                local offset = offsets[math.floor(index / #surfaces) + 1]

                runtime.EconomySearch[record.unit_id] = (index + 1) % total

                if part.Parent then
                    local point = part.CFrame:PointToWorldSpace(
                        Vector3.new(
                            offset.X * part.Size.X,
                            0,
                            offset.Y * part.Size.Z
                        )
                    )

                    local extent = (
                        math.abs(part.CFrame.RightVector.Y) * part.Size.X
                        + math.abs(part.CFrame.UpVector.Y) * part.Size.Y
                        + math.abs(part.CFrame.LookVector.Y) * part.Size.Z
                    ) / 2

                    local ray = PlacementCore.raycast(
                        point + Vector3.new(0, extent + 4, 0),
                        Vector3.new(0, -(extent * 2 + 8), 0)
                    )

                    if ray and ray.Instance:IsA("BasePart")
                        and PlacementCore.is_valid_raycast_hit(
                            ray.Instance, definition
                        )
                    then
                        local canvas = CalcCanvas(ray.Instance)
                        local hit = canvas:PointToObjectSpace(ray.Position)
                        local height = geometry.Height

                        local projected = canvas
                            * CFrame.new(hit.X, hit.Y, -height / 2)
                            * CFrame.Angles(-math.pi / 2, 0, 0)

                        local position = projected.Position
                            - projected.UpVector * (height / 2)

                        local oriented = CFrame.new(
                            position + Vector3.new(0, height / 2, 0)
                        )

                        if (not options or not options.PositionAllowed or options.PositionAllowed(position))
                            and not HasCollision(
                            oriented * geometry.CollisionOffset,
                            geometry.CollisionSize,
                            road,
                            bounds
                        ) then
                            if not IsCurrent(token) or not MatchActive(token) then
                                return nil
                            end

                            return CFrame.lookAt(
                                position,
                                position + oriented.LookVector
                            ), nil, {
                                Surface=ray.Instance, SurfaceCFrame=ray.Instance.CFrame,
                                SurfaceSize=ray.Instance.Size, Road=road, Bounds=bounds,
                                CollisionCFrame=oriented * geometry.CollisionOffset,
                                CollisionSize=geometry.CollisionSize,
                            }
                        end
                    end
                end

                if checked % 8 == 0 then
                    task.wait()
                end
            end

            return nil,
                "No economy point in this batch; next attempt continues."
        end

        local function Candidate(record, definition, token, options)
            if Finite(definition.farm_amount)
                and definition.farm_amount > 0
            then
                return EconomyCandidate(record, definition, token, options)
            end

            local terrain = Child(workspace, "_terrain")
            local ground = Child(terrain, "ground")
            local hill = Child(terrain, "hill")
            local road = Child(workspace, "_road")
            local bounds = FindBounds()

            if not ground or not road or not bounds then
                return nil, "Terrain, road, or Bounds is unavailable."
            end

            local plan, reason = PathPlan(false, options and options.AntiLeak)
            if not plan then
                return nil, reason
            end

            local geometry = Geometry(record, definition)
            local range = geometry.Range
            local hasRange = Finite(range) and range > 0

            if not hasRange then
                return nil, "Waiting for a positive attack range."
            end

            local START_PATH_RATIO = options and options.StartRatio or 0.30
            local normal = type(token) == "table" and token.Normal == true

            local deescalateRatio = normal
                and math.max(START_PATH_RATIO, 0.20)
                or START_PATH_RATIO

            local clipped = {}

            -- Enemy before 20%: prepare the normal defense area first.
            if plan.AntiLeak then
                for _, segment in ipairs(plan.Segments) do
                    if segment[5] == plan.TargetLane
                        and Finite(segment[6])
                    then
                        if Finite(plan.TargetTravel)
                            and plan.TargetTravel
                                < segment[6] * deescalateRatio
                        then
                            plan.AntiLeak = false
                        end

                        break
                    end
                end
            end

            for _, segment in ipairs(plan.Segments) do
                local a = segment[3]
                local b = segment[4]
                local total = segment[6]

                if (
                    not plan.AntiLeak
                    or segment[5] == plan.TargetLane
                )
                    and Finite(a)
                    and Finite(b)
                    and b > a
                    and Finite(total)
                    and total > 0
                then
                    local first = total * START_PATH_RATIO

                    if plan.AntiLeak then
                        if not Finite(plan.TargetTravel) then
                            return nil,
                                "Waiting for native enemy progress."
                        end

                        first = math.max(first, plan.TargetTravel)
                    end

                    local windowLength = range * 2

                    -- ขยายช่วงเปิดด่านเฉพาะ Normal Auto Play
                    if normal and not plan.AntiLeak then
                        windowLength = math.max(
                            windowLength,
                            total * 0.35
                        )
                    end

                    local last = math.min(
                        total,
                        first + windowLength
                    )

                    local enter = math.max(a, first)
                    local leave = math.min(b, last)

                    if leave > enter then
                        local delta = segment[2] - segment[1]

                        table.insert(clipped, {
                            segment[1]
                                + delta * ((enter - a) / (b - a)),
                            segment[1]
                                + delta * ((leave - a) / (b - a)),
                        })
                    end
                end
            end

            if #clipped == 0 then
                return nil,
                    "No remaining path in the placement window."
            end

            plan.Segments = clipped
            plan.CoverageSegments = nil

            -- Restore the original collision width for sampling
            -- when the definition has no positive attack range.
            local radius = hasRange and range
                or math.max(
                    geometry.CollisionSize.X,
                    geometry.CollisionSize.Z
                ) / 0.01

            if not Finite(radius) or radius <= 0 then
                return nil, "Placement sampling size is unavailable."
            end

            local roots = {}

            if definition.hill_unit then
                if hill then
                    table.insert(roots, hill)
                end
            elseif definition.hybrid_placement then
                table.insert(roots, ground)
                if hill then
                    table.insert(roots, hill)
                end
            else
                table.insert(roots, ground)
            end

            local samples = {}
            local spacing = math.max(1, radius / 3)
            local anchors = {}

            -- กระจายจุดอ้างอิงตลอดทุกช่วงของ Path
            for _, segment in ipairs(plan.Segments) do
                local delta = segment[2] - segment[1]
                local steps = math.max(
                    1, math.ceil(delta.Magnitude / spacing)
                )

                for step = 0, steps do
                    table.insert(
                        anchors,
                        segment[1] + delta * (step / steps)
                    )
                end
            end

            local attempts = 0

            for _, root in ipairs(roots) do
                for _, part in ipairs(
                    Parts(root, terrainCache) or {}
                ) do
                    if part.Parent and part.Name ~= "_donotplace" then
                        local seen = {}

                        for _, anchor in ipairs(anchors) do
                            local center =
                                part.CFrame:PointToObjectSpace(anchor)

                            -- ทดลองทั้งสองฝั่งและแนวทแยงรอบ Path
                            for dx = -3, 3 do
                                for dz = -3, 3 do
                                    attempts = attempts + 1

                                    if attempts % 128 == 0 then
                                        task.wait()
                                    end

                                    if not IsCurrent(token)
                                        or not MatchActive(token)
                                    then
                                        return nil
                                    end

                                    local x = math.clamp(
                                        center.X + dx * spacing,
                                        -part.Size.X / 2,
                                        part.Size.X / 2
                                    )

                                    local z = math.clamp(
                                        center.Z + dz * spacing,
                                        -part.Size.Z / 2,
                                        part.Size.Z / 2
                                    )

                                    local key = string.format(
                                        "%.2f:%.2f", x, z
                                    )

                                    if not seen[key] then
                                        seen[key] = true

                                        local point =
                                            part.CFrame:PointToWorldSpace(
                                                Vector3.new(
                                                    x,
                                                    part.Size.Y / 2,
                                                    z
                                                )
                                            )

                                        local score, distance =
                                            PlacementScore(point, plan)

                                        if not hasRange
                                            or distance <= range
                                        then
                                            table.insert(samples, {
                                                Part = part,
                                                Point = point,
                                                Score = score,
                                                Coverage = hasRange
                                                    and PathCoverage(
                                                        point, plan, range
                                                    )
                                                    or 0,
                                            })
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end

            table.sort(samples, function(a, b)
                if hasRange and plan.AntiLeak then
                    local aReaches = a.Score <= range
                    local bReaches = b.Score <= range

                    if aReaches ~= bReaches then
                        return aReaches
                    end
                end

                if a.Coverage ~= b.Coverage then
                    return a.Coverage > b.Coverage
                end

                return a.Score < b.Score
            end)

            local best
            local bestValidation
            local bestScore = math.huge
            local bestCoverage = -1

            -- Local search budget; not a server rate-limit assumption.
            for i = 1, #samples do
                if not IsCurrent(token) or not MatchActive(token) then
                    return nil
                end

                local sample = samples[i]
                local part = sample.Part

                if part.Parent then
                    local extent = (
                        math.abs(part.CFrame.RightVector.Y) * part.Size.X
                        + math.abs(part.CFrame.UpVector.Y) * part.Size.Y
                        + math.abs(part.CFrame.LookVector.Y) * part.Size.Z
                    ) / 2

                    local ray = PlacementCore.raycast(
                        sample.Point + Vector3.new(0, extent + 4, 0),
                        Vector3.new(0, -(extent * 2 + 8), 0)
                    )

                    if ray and ray.Instance:IsA("BasePart")
                        and PlacementCore.is_valid_raycast_hit(
                            ray.Instance, definition
                        )
                    then
                        local canvas = CalcCanvas(ray.Instance)
                        local localHit = canvas:PointToObjectSpace(
                            ray.Position
                        )
                        local height = geometry.Height

                        local projected = canvas
                            * CFrame.new(
                                localHit.X, localHit.Y, -height / 2
                            )
                            * CFrame.Angles(-math.pi / 2, 0, 0)

                        local position = projected.Position
                            - projected.UpVector * (height / 2)

                        local oriented = CFrame.new(
                            position + Vector3.new(0, height / 2, 0)
                        )

                        local score, pathDistance = PlacementScore(
                            position, plan
                        )

                        -- Recalculate using the actual projected placement.
                        local coverage = hasRange
                            and PathCoverage(position, plan, range)
                            or 0

                        local better = coverage > bestCoverage
                            or (
                                coverage == bestCoverage
                                and score < bestScore
                            )

                        if better
                            and (not options or not options.PositionAllowed or options.PositionAllowed(position))
                            and (
                                not hasRange
                                or (
                                    coverage > 0
                                    and pathDistance <= range
                                    and (
                                        not plan.AntiLeak
                                        or score <= range
                                    )
                                )
                            )
                            and not HasCollision(
                                oriented * geometry.CollisionOffset,
                                geometry.CollisionSize,
                                road,
                                bounds
                            )
                        then
                            best = CFrame.lookAt(
                                position,
                                position + oriented.LookVector
                            )

                            bestValidation = {
                                Surface=ray.Instance, SurfaceCFrame=ray.Instance.CFrame,
                                SurfaceSize=ray.Instance.Size, Road=road, Bounds=bounds,
                                CollisionCFrame=oriented * geometry.CollisionOffset,
                                CollisionSize=geometry.CollisionSize,
                            }
                            bestScore = score
                            bestCoverage = coverage
                        end
                    end
                end

                if i % 8 == 0 then
                    task.wait()
                end
            end

            if not IsCurrent(token) or not MatchActive(token) then
                return nil
            end

            if best then
                if hasRange then
                    print(string.format(
                        "[April Fool / Placement] Range=%.2f CoveredPath=%.2f "
                            .. "Tests=%d AntiLeak=%s",
                        range,
                        bestCoverage,
                        #samples,
                        tostring(plan.AntiLeak)
                    ))
                end

                return best, nil, bestValidation
            end

            return nil, "No valid point in the sampled path area."
        end

        -- Shared geometry only; the normal runner owns its RPCs and settings.
        runtime.NormalCandidate = Candidate
        runtime.NormalPositionClear = function(check, definition)
            if type(check)~="table" or typeof(check.Surface)~="Instance"
                or not check.Surface:IsA("BasePart")
                or not check.Surface:IsDescendantOf(workspace)
                or check.Surface.CFrame~=check.SurfaceCFrame
                or check.Surface.Size~=check.SurfaceSize
                or check.Road~=Child(workspace,"_road")
                or check.Bounds~=FindBounds()
                or not PlacementCore.is_valid_raycast_hit(check.Surface,definition) then
                return false
            end
            return not HasCollision(check.CollisionCFrame,check.CollisionSize,check.Road,check.Bounds)
        end
    end)
end


