    local function Score(room)
        local rank = math.huge
        local level = type(room._l) == "table" and room._l
        local weak = level and level._weak_against

        if type(weak) == "table" then
            for _, record in pairs(weak) do
                if type(record) == "table"
                    and table.find(cfg.DungeonElements, record.damage_type)
                then
                    local priority = table.find(
                        cfg.DungeonElementOrder, record.damage_type
                    )
                    if priority and priority < rank then rank = priority end
                end
            end
        end

        local count = 0
        for _, category in ipairs(cfg.DungeonTargets) do
            for _, flag in ipairs(flags[category] or {}) do
                if room._t[flag] ~= nil then
                    count = count + 1
                    break
                end
            end
        end
        return rank, count
    end

    local function Available(controller, choice)
        local frames = controller.LevelFrames
        local entry = type(frames) == "table" and frames[choice]
        local frame = type(entry) == "table" and entry.frame
        if typeof(frame) ~= "Instance" or not frame.Parent then return false end

        local unavailable = Child(
            Child(frame, "Main"), "Unavailable", "GuiObject"
        )
        return unavailable ~= nil and unavailable.Visible == false
    end

    local function ReadFloor(data)
        local choices = type(data) == "table" and data.next
        local first = type(choices) == "table" and choices["1"]
        if type(first) ~= "table" then return end

        local depth, seed = first._d, first._r
        if type(depth) ~= "number" or depth ~= depth
            or depth == math.huge or depth == -math.huge
            or depth % 1 ~= 0
            or type(seed) ~= "number" or seed ~= seed
            or seed == math.huge or seed == -math.huge
        then
            return
        end

        return choices, first, depth, seed
    end

    local function CurseRank(room)
        local configured = false
        for _, id in ipairs(cfg.DungeonDebuffOrder) do
            if curseLabels[id] then
                configured = true
                break
            end
        end
        if not configured then return 0 end

        local curse = room._t["0"]
        if curse == nil then return 0 end
        if type(curse) ~= "table" or type(curse.id) ~= "string" then
            return math.huge
        end
        return table.find(cfg.DungeonDebuffOrder, curse.id) or math.huge
    end

    local function StartStep(session, profile, data)
        local sent = R.StartAttempt
        if sent then
            if not sent.Returned then
                Status("รอคำสั่ง Start เดิม ไม่ส่งซ้ำ")
                return true
            end
            if data._started == true then
                R.StartAttempt = nil
                return false
            end

            Status(sent.TransportOK
                and "ส่ง Start แล้ว รอ dungeon_changed ยืนยัน _started"
                or ("Start ผิดพลาด ไม่ส่งซ้ำ: " .. tostring(sent.Result)))
            return true
        end

        if cfg.DungeonAutoStart ~= true or data._started == true then
            return false
        end

        if Loader.IsLobby ~= true or data._dead ~= nil
            or (data._started ~= nil and data._started ~= false)
        then
            Status("Auto Start รอหน้า Lobby และสถานะเริ่มรันที่ถูกต้อง")
            return true
        end

        local controller = GUI.dungeon_ui
        local holder = type(controller) == "table" and controller.StartHolder

        if type(controller) ~= "table" or not controller.IsOpen
            or typeof(holder) ~= "Instance"
            or not holder:IsA("GuiObject")
            or not holder.Parent or not holder.Visible
        then
            Status("รอปุ่ม Start ของ Dungeon พร้อม")
            return true
        end

        local shared = env["__AnimeAdventureLobbyAutoJoin"]
        if type(shared) == "table" and (shared.Busy or shared.Operation) then
            Status("Auto Start รอระบบเข้าห้องเดิมสิ้นสุด")
            return true
        end

        local remote = Child(
            Child(Child(RS, "endpoints"), "client_to_server"),
            "dungeon_start",
            "RemoteFunction"
        )
        if not remote then
            Status("รอ dungeon_start")
            return true
        end

        if R.Stopped or env[key] ~= R or cfg.DungeonAutoStart ~= true
            or Dungeon.session ~= session or session.profile_data ~= profile
            or profile.dungeon_data ~= data or data._started == true
            or data._dead ~= nil
            or GUI.dungeon_ui ~= controller or not controller.IsOpen
            or controller.StartHolder ~= holder
            or not holder.Parent or not holder.Visible
        then
            return true
        end

        sent = {Returned = false}
        R.StartAttempt = sent
        R.ResetSeen = true

        Status("ส่ง dungeon_start แล้ว รอยืนยันการเริ่มรัน")
        local ok, result = pcall(remote.InvokeServer, remote)
        sent.TransportOK, sent.Result, sent.Returned = ok, result, true

        if not ok then
            Status("Start ผิดพลาด ไม่ส่งซ้ำ: " .. tostring(result))
        end
        return true
    end

    local ShopCore

    local function Finite(n)
        return type(n) == "number" and n == n
            and n ~= math.huge and n ~= -math.huge
    end

    local function ShopRemote(name)
        return Child(
            Child(Child(RS, "endpoints"), "client_to_server"),
            name,
            "RemoteFunction"
        )
    end

    local function CountItem(items, id)
        local count = 0
        for _, entry in pairs(items) do
            if type(entry) == "table" and entry.id == id then
                count = count + 1
            end
        end
        return count
    end

    local function ShopCatalog()
        if R.ShopCatalogReady then return true end
        if os.clock() < (R.NextShopLoad or 0) then return false end
        R.NextShopLoad = os.clock() + 3

        local ok, value = pcall(
            Loader.load_core_service, R.Module, "DungeonServiceCore"
        )
        if R.Stopped then return false end
        if not ok or type(value) ~= "table"
            or type(value.ITEMS) ~= "table"
            or type(value.sum_item_values) ~= "function"
        then
            ShopStatus("รอ DungeonServiceCore: " .. tostring(value))
            return false
        end
        ShopCore = value

        local names = {}
        for id, item in pairs(ShopCore.ITEMS) do
            if type(id) == "string" and type(item) == "table"
                and type(item.name) == "string"
                and Finite(item.cost) and item.cost >= 0
            then
                local name = item.name .. " [" .. id .. "]"
                buyIds[name] = id
                buyLabels[id] = name
                table.insert(names, name)
            end
        end
        table.sort(names)
        if #names == 0 then
            ShopStatus("รอรายการสินค้าที่มีราคา")
            return false
        end

        R.ShopApplying = true
        buyDropdown:ClearAll()
        moveDropdown:ClearAll()
        moveDropdown:AddList("--")
        for _, name in ipairs(names) do
            buyDropdown:AddList(name)
            moveDropdown:AddList(name)
        end

        local selected = {}
        for _, id in ipairs(cfg.DungeonBuyOrder) do
            if buyLabels[id] then table.insert(selected, buyLabels[id]) end
        end
        buyDropdown:SetValue(selected)
        moveDropdown:SetValue("--")
        R.ShopApplying = false
        R.ShopCatalogReady = true

        ShowBuyOrder()
        return true
    end

    local function Merchant(data)
        local shops = type(data.current_shops) == "table"
            and data.current_shops
        local shop = shops and shops[1]
        return type(shop) == "table" and shop._t == "1" and shop or nil
    end

    local function ShopVisible()
        local ui = GUI.dungeon_ui
        local screen = type(ui) == "table" and ui.ShopSelection
        return type(ui) == "table" and ui.IsOpen
            and typeof(screen) == "Instance"
            and screen:IsA("GuiObject")
            and screen.Parent and screen.Visible
    end

    local function ShopValid(session, profile, data, shop)
        return not R.Stopped and env[key] == R
            and Dungeon.session == session
            and session.profile_data == profile
            and profile.dungeon_data == data
            and data._started == true
            and not data._dead
            and Merchant(data) == shop
            and ShopVisible()
    end

    local function ShopStep(session, profile, data)
        local catalog = ShopCatalog()
        budgetLabel.Desc.Text = string.format(
            "วงเงินจองสะสม %.0f / งบรวม %.0f",
            R.ShopReserved,
            cfg.DungeonShopBudget
        )

        local shop = Merchant(data)
        local op = R.ShopAttempt

        if op then
            if not op.Returned then
                ShopStatus("รอคำสั่ง Shop เดิม")
                return true
            end

            if op.Kind == "Continue" then
                if data.current_shops == nil then
                    R.ShopAttempt = nil
                    ShopStatus("ยืนยันว่าออกจาก Merchant แล้ว")
                else
                    ShopStatus("รอยืนยันออกจาก Merchant ไม่ส่ง Continue ซ้ำ")
                end
                return true
            end

            if type(data._items) ~= "table" then
                ShopStatus("รอข้อมูลรับสินค้า")
                return true
            end

            local _, _, depth, seed = ReadFloor(data)
            local same = shop and depth == op.Depth and seed == op.Seed
            local moved = depth ~= nil and seed ~= nil
                and (depth > op.Depth or seed ~= op.Seed)
            local removed = data.current_shops == nil or moved
                or (same and type(shop.data) == "table"
                    and shop.data[op.Slot] == nil)

            if CountItem(data._items, op.Id) > op.Before and removed then
                R.ShopAttempt = nil
                ShopStatus("ยืนยันรับสินค้า " .. op.Id .. " แล้ว")
            else
                ShopStatus("รอไอเทมเพิ่มและข้อเสนอเดิมหาย ไม่ซื้อหรือออกจาก Shop ซ้ำ")
            end
            return true
        end

        if not shop then return false end
        if cfg.DungeonAutoShop ~= true
            and cfg.DungeonContinueShop ~= true
        then
            return false
        end
        if not ShopValid(session, profile, data, shop) then
            ShopStatus("รอ Merchant พร้อม")
            return true
        end

        local _, _, depth, seed = ReadFloor(data)
        if not depth then
            ShopStatus("รอรหัสรอบของ Merchant")
            return true
        end

        local offers = shop.data
        if type(offers) ~= "table" then
            ShopStatus("รอข้อเสนอ Merchant")
            return true
        end

        local best, bestRank, budgetBlocked

        if cfg.DungeonAutoShop then
            if not catalog then return true end
            if not AAExtra.StorageOK then
                ShopStatus("Auto Buy ต้องใช้พื้นที่บันทึกถาวรเพื่อรักษางบรวม")
                return true
            end
            if cfg.DungeonShopBudget <= 0 then
                ShopStatus("ตั้งงบซื้อรวมให้มากกว่า 0 ก่อน")
                return true
            end
            if #cfg.DungeonBuyOrder == 0 then
                ShopStatus("เลือก Buy Items และจัดลำดับก่อน")
                return true
            end

            local resources = data._resources
            local money = type(resources) == "table" and resources.money
            if not Finite(money) or type(data._items) ~= "table" then
                ShopStatus("รอ Dungeon Gold และรายการไอเทม")
                return true
            end

            local ok, modifier = pcall(
                ShopCore.sum_item_values, data, "shop_prices"
            )
            if not ok or not Finite(modifier) then
                ShopStatus("คำนวณราคาไม่ได้: " .. tostring(modifier))
                return true
            end

            for slot, offer in pairs(offers) do
                if (type(slot) ~= "string" and type(slot) ~= "number")
                    or type(offer) ~= "table"
                    or type(offer.id) ~= "string"
                then
                    ShopStatus("รูปแบบข้อเสนอไม่ตรง Contract")
                    return true
                end

                local rank = table.find(cfg.DungeonBuyOrder, offer.id)
                if rank then
                    local item = ShopCore.ITEMS[offer.id]
                    if type(item) ~= "table"
                        or not Finite(item.cost) or item.cost < 0
                    then
                        ShopStatus("รอราคาสินค้า " .. offer.id)
                        return true
                    end

                    local price = math.ceil(
                        item.cost * math.max(0, modifier + 1)
                    )
                    if not Finite(price) then
                        ShopStatus("ราคาสินค้าไม่ถูกต้อง")
                        return true
                    end

                    if money >= price then
                        if R.ShopReserved + price > cfg.DungeonShopBudget then
                            budgetBlocked = true
                        elseif not best or rank < bestRank
                            or (rank == bestRank
                                and tostring(slot) < tostring(best.Slot))
                        then
                            best = {
                                Slot = slot,
                                Id = offer.id,
                                Price = price,
                                Offer = offer,
                            }
                            bestRank = rank
                        end
                    end
                end
            end
        end

        if best then
            if os.clock() < (R.NextShopAction or 0) then return true end
            local remote = ShopRemote("dungeon_buy_shop")
            if not remote then
                ShopStatus("รอ dungeon_buy_shop")
                return true
            end

            local before = R.ShopReserved
            R.ShopReserved = before + best.Price
            cfg.DungeonShopReserved = R.ShopReserved

            local saved = ShopSave()
            if R.Stopped or env[key] ~= R then return true end

            if not saved then
                R.ShopReserved = before
                cfg.DungeonShopReserved = before
                R.NextShopAction = os.clock() + 3
                return true
            end

            if not ShopValid(session, profile, data, shop)
                or cfg.DungeonAutoShop ~= true
                or R.ShopReserved > cfg.DungeonShopBudget
                or shop.data ~= offers
                or offers[best.Slot] ~= best.Offer
                or not table.find(cfg.DungeonBuyOrder, best.Id)
            then
                R.ShopReserved = before
                cfg.DungeonShopReserved = before
                ShopSave()
                return true
            end

            op = {
                Kind = "Buy",
                Slot = best.Slot,
                Id = best.Id,
                Depth = depth,
                Seed = seed,
                Before = CountItem(data._items, best.Id),
                Returned = false,
            }
            R.ShopAttempt = op

            ShopStatus("ส่งซื้อ " .. best.Id .. " ราคา "
                .. best.Price .. " แล้ว รอตรวจรับ")

            -- คงชนิดคีย์เดิมจาก native pairs: number หรือ string
            local ok, result = pcall(
                remote.InvokeServer, remote, best.Slot
            )
            op.TransportOK, op.Result, op.Returned = ok, result, true
            return true
        end

        if budgetBlocked then
            ShopStatus("วงเงินรวมไม่พอ รอเพิ่มงบ คง Toggle ไว้")
            return true
        end
        if cfg.DungeonContinueShop ~= true then
            ShopStatus("ไม่มีรายการที่ซื้อได้ รอ Auto Continue Shop")
            return true
        end

        local remote = ShopRemote("dungeon_continue_shop")
        if not remote then
            ShopStatus("รอ dungeon_continue_shop")
            return true
        end
        if not ShopValid(session, profile, data, shop)
            or cfg.DungeonContinueShop ~= true
        then
            return true
        end

        op = {Kind = "Continue", Returned = false}
        R.ShopAttempt = op
        ShopStatus("ส่งออกจาก Merchant แล้ว รอยืนยัน")

        local ok, result = pcall(remote.InvokeServer, remote)
        op.TransportOK, op.Result, op.Returned = ok, result, true
        return true
    end

    local function DeathStep(session, profile, data)
        local op = R.DeathAttempt

        if op then
            if op.Returned and not data._dead and data._started == false then
                R.DeathAttempt = nil
                R.ResetSeen = true
                ShopStatus("ยืนยันการปิดผลการตายแล้ว")
                return false
            end
            ShopStatus("รอยืนยันปิดผลการตาย ไม่ส่งซ้ำ")
            return true
        end

        if not data._dead or cfg.DungeonContinueDeath ~= true then
            return false
        end

        local ui = GUI.dungeon_ui
        local screen = type(ui) == "table" and ui.YouDied
        if type(ui) ~= "table" or not ui.IsOpen
            or typeof(screen) ~= "Instance"
            or not screen:IsA("GuiObject")
            or not screen.Parent or not screen.Visible
        then
            ShopStatus("รอหน้าผลการตาย")
            return true
        end

        local remote = ShopRemote("dungeon_continue_death")
        if not remote then
            ShopStatus("รอ dungeon_continue_death")
            return true
        end

        if R.Stopped or env[key] ~= R
            or cfg.DungeonContinueDeath ~= true
            or Dungeon.session ~= session
            or session.profile_data ~= profile
            or profile.dungeon_data ~= data or not data._dead
            or GUI.dungeon_ui ~= ui or ui.YouDied ~= screen
            or not screen.Visible
        then
            return true
        end

        op = {Returned = false}
        R.DeathAttempt = op
        ShopStatus("ส่งปิดผลการตายแล้ว รอยืนยัน")

        local ok, result = pcall(remote.InvokeServer, remote)
        op.TransportOK, op.Result, op.Returned = ok, result, true
        return true
    end

    local function Step()
        if not Load() or R.Stopped or not Catalog() then return end

        local session = Dungeon.session
        local profile = type(session) == "table" and session.profile_data
        local data = type(profile) == "table" and profile.dungeon_data
        if type(data) ~= "table" then
            Status("รอ dungeon_data ของผู้เล่น")
            return
        end

        local attempt = R.Attempt
        if attempt and not attempt.Returned then
            Status("ติดตามคำสั่งเลือกห้องเดิม ไม่ส่งซ้อน")
            return
        end

        for _, operation in pairs({
            R.StartAttempt,
            R.ShopAttempt,
            R.DeathAttempt,
        }) do
            if not operation.Returned then
                ShopStatus("ติดตามคำสั่งเดิม ไม่ส่งซ้อน")
                return
            end
        end

        if R.ShopAttempt and ShopStep(session, profile, data) then return end
        if DeathStep(session, profile, data) then return end
        if ShopStep(session, profile, data) then return end
        if StartStep(session, profile, data) then return end

        if data._started == false then
            R.ResetSeen = true
            Status("รอเริ่ม Dungeon รอบใหม่")
            return
        end
        if data._started ~= true or data._dead ~= nil then
            Status("รอสถานะ Dungeon ที่พร้อมเลือกห้อง")
            return
        end

        if R.ResetSeen then
            R.Attempt = nil
            attempt = nil
            R.ResetSeen = false
        end

        local _, floor, depth, roundSeed = ReadFloor(data)
        if not floor then
            Status("รอ next[1]._d และ next[1]._r ของ Dungeon")
            return
        end

        if attempt then
            local advanced = depth > attempt.Depth
                or (type(attempt.RoundSeed) == "number"
                    and roundSeed ~= attempt.RoundSeed)

            if not advanced then
                Status(data.selected_next ~= nil
                    and "เกมล็อกตัวเลือกแล้ว รอรอบห้องเปลี่ยน"
                    or "ส่งคำสั่งรอบห้องนี้แล้ว รอยืนยัน ไม่ส่งซ้ำ")
                return
            end

            R.Attempt = nil
        end

        if cfg.DungeonAutoRoom ~= true then
            Status("ปิด Auto Select Dungeon")
            return
        end
        if data.selected_next ~= nil then
            Status("มีตัวเลือกที่เกมล็อกแล้ว")
            return
        end
        if data.current_shops ~= nil then
            Status("รอขั้นตอน Shop สิ้นสุด")
            return
        end

        local offered = data.next
        local controller = GUI.dungeon_ui
        if type(offered) ~= "table" or type(controller) ~= "table"
            or not controller.IsOpen
        then
            Status("รอหน้าตัวเลือก Dungeon เปิด")
            return
        end

        local best, bestRank, bestItems, bestCurse
        for _, choice in ipairs({"1", "2", "3"}) do
            local room = offered[choice]
            if type(room) == "table" and type(room._t) == "table"
                and Available(controller, choice)
            then
                local rank, count = Score(room)
                local curse = CurseRank(room)

                if not best or rank < bestRank
                    or (rank == bestRank and count > bestItems)
                    or (rank == bestRank
                        and count == bestItems
                        and curse < bestCurse)
                then
                    best, bestRank, bestItems, bestCurse =
                        choice, rank, count, curse
                end
            end
        end

        if not best then
            Status("รอตัวเลือกห้องที่ Native UI อนุญาต")
            return
        end

        local remote = Child(
            Child(Child(RS, "endpoints"), "client_to_server"),
            "dungeon_enter_room",
            "RemoteFunction"
        )
        if not remote then
            Status("รอ dungeon_enter_room")
            return
        end

        local currentChoices, currentFloor, currentDepth, currentSeed =
            ReadFloor(data)

        if R.Stopped or env[key] ~= R or cfg.DungeonAutoRoom ~= true
            or Dungeon.session ~= session or session.profile_data ~= profile
            or profile.dungeon_data ~= data or data.next ~= offered
            or data._started ~= true
            or currentChoices ~= offered or currentFloor ~= floor
            or currentDepth ~= depth or currentSeed ~= roundSeed
            or data._dead ~= nil or data.selected_next ~= nil
            or data.current_shops ~= nil
            or GUI.dungeon_ui ~= controller or not controller.IsOpen
            or not Available(controller, best)
        then
            return
        end

        attempt = {
            Profile = profile,
            Depth = depth,
            RoundSeed = roundSeed,
            Choice = best,
            Returned = false,
        }
        R.Attempt = attempt

        Status("ส่งเลือกห้อง " .. best .. " ชั้น " .. depth .. " แล้ว รอยืนยัน")
        local ok, result = pcall(remote.InvokeServer, remote, best)
        attempt.TransportOK, attempt.Result, attempt.Returned = ok, result, true

        if not ok then
            Status("เลือกห้องผิดพลาด ไม่ส่งซ้ำชั้นนี้: " .. tostring(result))
        end
    end

    task.spawn(function()
        while not R.Stopped do
            local ok, err = xpcall(Step, debug.traceback)
            if not ok then
                Status("Dungeon / Step: " .. tostring(err))
            end
            task.wait(ok and 0.5 or 3)
        end
    end)
end


