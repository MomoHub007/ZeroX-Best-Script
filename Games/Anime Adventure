    local function Child(p,n,c)
        local v=p and p:FindFirstChild(n)
        return v and (not c or v:IsA(c)) and v or nil
    end
    local function Num(p,n)
        local v=Child(p,n,"NumberValue")
        return v and v.Value==v.Value and math.abs(v.Value)<math.huge and v.Value or nil
    end
    local function Stop()
        if R.Busy or R.NativeBusy>0 or R.Pending then
            R.CloseRequested=true
            R.Mode="Stopping"
            Status("Closing after the in-flight action is reconciled.")
            return
        end
        R.Stopped=true
        R.Mode="Idle"
        if R.Endpoints and R.Endpoints.invoke_server==R.Wrapper then
            R.Endpoints.invoke_server=R.Original
