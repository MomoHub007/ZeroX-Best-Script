    local Loader, Dungeon, GUI, Damage

    local function Load()
        if not Loader then
            local module = Child(Child(RS, "src"), "Loader", "ModuleScript")
            if not module then return false end

            local ok, value = pcall(require, module)
            if not ok or type(value) ~= "table" then
                Status("โหลด Loader ไม่สำเร็จ: " .. tostring(value))
                return false
            end
            Loader = value
            R.Module = module
        end

        for _, entry in ipairs({
            {"DungeonServiceClient", Dungeon},
            {"GUIService", GUI},
        }) do
            if type(entry[2]) ~= "table" then
                local ok, value = pcall(
                    Loader.load_client_service, R.Module, entry[1]
                )
                if R.Stopped then return false end
                if not ok or type(value) ~= "table" then
                    Status("รอ " .. entry[1] .. ": " .. tostring(value))
                    return false
                end

                if entry[1] == "DungeonServiceClient" then
                    Dungeon = value
                else
                    GUI = value
                end
            end
        end

        if not Damage then
            local ok, value = pcall(
                Loader.load_data, R.Module, "DamageTypes"
            )
            if R.Stopped then return false end
            if not ok or type(value) ~= "table"
                or type(value.TYPES) ~= "table"
            then
                Status("รอ DamageTypes: " .. tostring(value))
                return false
            end
            Damage = value
        end
        return true
    end

    local function Catalog()
        if R.CatalogReady then return true end

        local ids, names = {}, {}
        for id, record in pairs(Damage.TYPES) do
            if type(id) == "string" and type(record) == "table"
                and type(record.name) == "string"
            then
                table.insert(ids, id)
                local name = record.name .. " [" .. id .. "]"
                idsByLabel[name] = id
                labelsById[id] = name
            end
        end

        if #ids == 0 then
            Status("ทะเบียนธาตุยังว่าง")
            return false
        end

        local order = type(Damage.TYPES_ORDER) == "table"
            and Damage.TYPES_ORDER or {}

        table.sort(ids, function(a, b)
            local x = type(order[a]) == "number" and order[a] or math.huge
            local y = type(order[b]) == "number" and order[b] or math.huge
            return x < y or (x == y and a < b)
        end)

        local sorted, seen = {}, {}
        for _, id in ipairs(cfg.DungeonElementOrder) do
            if labelsById[id] and not seen[id] then
                seen[id] = true
                table.insert(sorted, id)
            end
        end

        for _, id in ipairs(ids) do
            table.insert(names, labelsById[id])
            if not seen[id] then
                seen[id] = true
                table.insert(sorted, id)
            end
        end
        cfg.DungeonElementOrder = sorted

        R.Applying = true
        elements:ClearAll()
        for _, name in ipairs(names) do elements:AddList(name) end

        local selected = {}
        for _, id in ipairs(cfg.DungeonElements) do
            if labelsById[id] then
                table.insert(selected, labelsById[id])
            end
        end
        elements:SetValue(selected)

        local selectedTargets = {}
        for _, id in ipairs(cfg.DungeonTargets) do
            if categoryNames[id] then
                table.insert(selectedTargets, categoryNames[id])
            end
        end
        targets:SetValue(selectedTargets)

        for rank = 1, #sorted do
            local index = rank
            priorities[index] = prioritySection:Dropdown({
                Title = "Priority " .. index,
                Value = labelsById[sorted[index]],
                List = names,
                Callback = function(_, value)
                    if not ready or R.Stopped or R.Applying then return end
                    local id = idsByLabel[value]
                    local other = id and table.find(cfg.DungeonElementOrder, id)
                    if not other then return end

                    local current = cfg.DungeonElementOrder
                    current[index], current[other] = current[other], current[index]
                    RefreshPriority()
                    Save()
                end,
            })
        end

        R.Applying = false
        R.CatalogReady = true
        return true
    end

