    }
    environment[registryKey] = runtime

    function runtime.Stop()
        runtime.Stopped = true
        for _, connection in ipairs(runtime.Connections) do
            connection:Disconnect()
        end
        table.clear(runtime.Connections)
    end

    local function Required(parent, name, className)
        local object = parent:WaitForChild(name, 15)
        assert(
            object and (not className or object:IsA(className)),
            "[Lobby Extra] Missing object: " .. name
        )
        return object
    end

    local src = ReplicatedStorage:WaitForChild("src", 15)
    if not src then
