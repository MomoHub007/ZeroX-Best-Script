    local function ExtraLaunching(op)
        return Teleporting()
            or (
                op.Room and op.Room.Parent
                and RoomValue(op.Room, "Teleporting", "BoolValue") == true
            )
    end

    local function CheckChallengeRotation(op)
        if op.Mode ~= "Challenge" or not NormalChallengeDirty then
            return
        end

        local data = ChallengeData("Challenge")
        if type(data) ~= "table" or type(data.current_uuid) ~= "string" then
            op.Cancelled = true
            warn("[Lobby Extra] Challenge refresh failed; operation stopped.")
            return
        end

        if data.current_uuid ~= op.UUID
            and ExtraSettings.LeaveWhenChallengeChanges
        then
            op.Cancelled = true
            Log("Challenge changed; stopping the tracked room/queue.")
        end
    end

    local function SaveDailyReservation(op)
        if op.Mode ~= "Daily" then
            return true
        end

        op.PreviousDailyUUID = ExtraSettings.DailyAttemptedUUID
        ExtraSettings.DailyAttemptedUUID = op.UUID
        return AAExtra.Save()
    end

    local function RestoreRejectedDaily(op)
        if op.Mode == "Daily"
            and ExtraSettings.DailyAttemptedUUID == op.UUID
        then
            ExtraSettings.DailyAttemptedUUID = op.PreviousDailyUUID or ""
            AAExtra.Save()
        end
    end

    local function CleanupExtra(op)
        if ExtraLaunching(op) then
            op.Launching = true
            return
        end

        if op.RoomJoined then
            local room = op.Room
            if room and room.Parent
                and LobbyService.current_lobby == room.Name
                and LobbyService.current_lobby_model == room
                and InLobby() == true
            then
                local ok, accepted = Call("request_leave_lobby", room.Name)
                if ok and accepted == true
                    and LobbyService.current_lobby == room.Name
                    and LobbyService.current_lobby_model == room
                then
                    LobbyService.cancel_selections()
                end
            end
        end

        -- Uses the existing queue cleanup and ownership tracking.
        Cleanup(op)
    end

    local function RunExtra(op)
        if not WaitPartyEntry(op, function()
            if op.Mode == "Mansion" then
                return "Mansion"
            end

            return op.Mode == "Daily"
                and ExtraSettings.DailyJoinBy
                or ExtraSettings.ChallengeJoinBy
        end) then
            return
        end

        if not AAExtra.StorageOK then
            warn("[Lobby Extra] Persistent settings are unavailable.")
            return
        end

        local queue = QueueGui()
        if not queue or InLobby() == nil
            or not Child(Player, "TeleportingLock", "NumberValue")
        then
            warn("[Lobby Extra] Required player state is not ready.")
            return
        end

        if InLobby() or queue.Enabled or Teleporting()
            or LobbyService.current_lobby ~= nil
        then
            warn("[Lobby Extra] Existing room, queue, or teleport detected.")
            return
        end

        if op.Mode == "Mansion" then
            local profile = ExtraProfile()
            if type(profile) ~= "table" then
                warn("[Lobby Extra] Mansion profile type=" .. typeof(profile))
                return
            end

            local levelData = profile.level_data
            if type(levelData) ~= "table" then
                warn("[Lobby Extra] Mansion level_data type=" .. typeof(levelData))
                return
            end

            local tower = levelData.infinite_tower
            local floor

            if tower == nil then
                -- Documented default when no tower progression exists.
                floor = 1
            elseif type(tower) ~= "table" then
                warn(
                    "[Lobby Extra] Mansion infinite_tower type="
                        .. typeof(tower) .. " value=" .. tostring(tower)
                )
                return
            else
                floor = tower.floor_reached
                if floor == nil then
                    floor = 1
                end
            end

            if type(floor) ~= "number"
                or floor ~= floor
                or floor == math.huge
                or floor < 1
                or floor % 1 ~= 0
            then
                warn(
                    "[Lobby Extra] Invalid Mansion floor: type="
                        .. typeof(floor) .. " value=" .. tostring(floor)
                )
                return
            end
            if floor > 100 and op.Difficulty ~= "Hard" then
                warn("[Lobby Extra] Mansion above room 100 requires Hard.")
                return
            end
            if not Current(op) then
                return
            end

            Log("Starting Infinity Mansion: " .. floor .. " / " .. op.Difficulty)
            local ok = Call("request_start_infinite_tower", floor, op.Difficulty)
            if not ok then
                return
            end

            Observe(op, 20, function()
                return ExtraLaunching(op)
            end)
            op.Launching = ExtraLaunching(op) == true

            if not op.Launching then
                warn("[Lobby Extra] Mansion launch is unconfirmed; no retry sent.")
            end
            return
        end

        if op.Mode == "Challenge" and not rotationSignal then
            warn("[Lobby Extra] Challenge rotation signal is unavailable.")
            return
        end

        -- When already cleared/attempted, wait for a new UUID without rejoining.
        local data
        while Current(op) do
            data = ChallengeData(op.Mode)
            if not Current(op) then
                return
            end

            local profile = ExtraProfile()
            if type(data) ~= "table"
                or type(data.current_uuid) ~= "string"
                or data.current_uuid == ""
                or type(profile) ~= "table"
            then
                local session = LobbyService.session
                local dailyCache
                local uuid

                if type(ChallengeService) == "table" then
                    dailyCache = ChallengeService._CURRENT_DAILY_CHALLENGE
                end
                if type(data) == "table" then
                    uuid = data.current_uuid
                end

                warn(string.format(
                    "[Lobby Extra / Data] Mode=%s "
                        .. "SessionType=%s ProfileType=%s "
                        .. "ChallengeServiceType=%s DailyCacheType=%s "
                        .. "DataType=%s UUIDType=%s UUID=%s",
                    tostring(op.Mode),
                    typeof(session),
                    typeof(profile),
                    typeof(ChallengeService),
                    typeof(dailyCache),
                    typeof(data),
                    typeof(uuid),
                    tostring(uuid)
                ))
                return
            end

            local completed
            if op.Mode == "Daily" then
                completed = profile.last_completed_daily_challenge_uuid
                    == data.current_uuid
                    or ExtraSettings.DailyAttemptedUUID == data.current_uuid
            else
                completed = profile.last_completed_challenge_uuid
                    == data.current_uuid
            end

            if not completed then
                break
            end

            if not op.WaitLogged then
                Log(op.Mode .. " already cleared/attempted. Waiting for a new UUID.")
                op.WaitLogged = true
            end
            task.wait(1)
        end

        if not Current(op) then
            return
        end

        op.UUID = data.current_uuid
        op.ExpectedLevel = op.Mode == "Daily"
            and "__DAILY_CHALLENGE" or data.current_level_id

        if type(op.ExpectedLevel) ~= "string" then
            warn("[Lobby Extra] Invalid challenge level ID.")
            return
        end

        ExtraSettings.ActiveChallengeUUID = op.Mode == "Challenge" and op.UUID or ""
        if not AAExtra.Save() then
            return
        end

        if op.JoinBy == "Matchmaking" then
            if not SaveDailyReservation(op) or not Current(op) then
                return
            end

            op.QueueGui = queue
            local matchmakingId = op.Mode == "Daily"
                and "__DAILY_CHALLENGE" or "__NORMAL_CHALLENGE"

            local ok = Call("request_matchmaking", matchmakingId)
            if not ok then
                return
            end

            local deadline = os.clock() + 12
            repeat
                if queue.Parent and queue.Enabled then
                    op.QueueConfirmed = true
                    break
                end
                if ExtraLaunching(op) then
                    op.Launching = true
                    return
                end
                task.wait(0.2)
            until os.clock() >= deadline

            if not op.QueueConfirmed then
                warn("[Lobby Extra] Challenge queue is unconfirmed; no retry sent.")
                return
            end

            while Current(op) and queue.Parent and queue.Enabled do
                if ExtraLaunching(op) then
                    op.Launching = true
                    return
                end
                CheckChallengeRotation(op)
                task.wait(0.25)
            end

            op.Launching = ExtraLaunching(op) == true
            return
        end

        local root = Child(workspace, "_CHALLENGES")
        local container = Child(
            root, op.Mode == "Daily" and "DailyChallenge" or "Challenges"
        )
        if not container then
            warn("[Lobby Extra] Challenge room container is unavailable.")
            return
        end

        local room
        local found = Observe(op, 60, function()
            CheckChallengeRotation(op)
            if not Current(op) then
                return false
            end

            if InLobby() or queue.Enabled or LobbyService.current_lobby ~= nil then
                op.Cancelled = true
                return false
            end

            for _, candidate in ipairs(container:GetChildren()) do
                if candidate:IsA("Model")
                    and RoomValue(candidate, "Level", "StringValue") == op.ExpectedLevel
                    and RoomValue(candidate, "Difficulty", "StringValue") == "Hard"
                    and RoomValue(candidate, "requires_owner", "BoolValue") == false
                    and RoomValue(candidate, "Teleporting", "BoolValue") == false
                then
                    room = candidate
                    return true
                end
            end
            return false
        end)

        if not found or not Current(op) then
            warn("[Lobby Extra] No matching challenge room or operation cancelled.")
            return
        end

        op.Room = room
        if not SaveDailyReservation(op) or not Current(op) then
            return
        end

        local joined, accepted = Call("request_join_lobby", room.Name)
        if joined and accepted == false then
            RestoreRejectedDaily(op)
        end
        if not joined or accepted ~= true then
            warn("[Lobby Extra] Challenge room join was not confirmed.")
            return
        end

        op.RoomJoined = true

        if LobbyService.current_lobby ~= nil
            and LobbyService.current_lobby ~= room.Name
        then
            warn("[Lobby Extra] Current room changed; automatic Start stopped.")
            return
        end

        LobbyService.current_lobby = room.Name
        LobbyService.current_lobby_model = room

        local function ReadyToStart()
            local timer = RoomValue(room, "Timer", "IntValue")
            return room.Parent == container
                and InLobby() == true
                and LobbyService.current_lobby == room.Name
                and LobbyService.current_lobby_model == room
                and RoomValue(room, "Level", "StringValue") == op.ExpectedLevel
                and RoomValue(room, "Difficulty", "StringValue") == "Hard"
                and RoomValue(room, "requires_owner", "BoolValue") == false
                and (
                    RoomValue(room, "Active", "BoolValue") == true
                    or (type(timer) == "number" and timer >= 0)
                )
        end

        local staged = Observe(op, 8, function()
            CheckChallengeRotation(op)
            return ExtraLaunching(op) or ReadyToStart()
        end)

        if ExtraLaunching(op) then
            op.Launching = true
            return
        end

        CheckChallengeRotation(op)
        if not staged or not Current(op) or not ReadyToStart() then
            warn("[Lobby Extra] Challenge room state changed or staging failed.")
            return
        end

        -- Challenge rooms are already configured: no request_lock_level.
        local ok = Call("request_start_game", room.Name)
        if not ok then
            return
        end

        Observe(op, 20, function()
            CheckChallengeRotation(op)
            return ExtraLaunching(op)
        end)

        op.Launching = ExtraLaunching(op) == true
        if not op.Launching then
            warn("[Lobby Extra] Challenge launch is unconfirmed; no retry sent.")
        end
    end

    local function OnExtraToggle(mode, enabled)
        if not ExtraReady then
            return
        end

        if not enabled then
            if ExtraSettings.Mode == mode then
                ExtraSettings.Mode = ""
                AAExtra.Save()
            end
            local op = State.Operation
            if op and op.Mode == mode then
                op.Cancelled = true
            end
            return
        end

        if State.Disposed or State.Busy or not AAExtra.StorageOK then
            warn("[Lobby Extra] Another operation is active or storage is unavailable.")
            ExtraToggles[mode]:SetValue(false)
            return
        end

        ExtraSettings.Mode = mode
        if not AAExtra.Save() then
            ExtraToggles[mode]:SetValue(false)
            return
        end

        local op = {
            Mode = mode,
            JoinBy = mode == "Daily"
                and ExtraSettings.DailyJoinBy
                or ExtraSettings.ChallengeJoinBy,
            Difficulty = ExtraSettings.MansionDifficulty,
            Cancelled = false,
        }

        State.Operation = op
        State.Busy = true

        task.spawn(function()
            local ok, failure = xpcall(function()
                RunExtra(op)
            end, debug.traceback)

            if not ok then
                warn("[Lobby Extra] " .. tostring(failure))
            end

            if not op.Launching then
                local cleaned, cleanupError = xpcall(function()
                    CleanupExtra(op)
                end, debug.traceback)
                if not cleaned then
                    warn("[Lobby Extra] Cleanup failed: " .. tostring(cleanupError))
                end
                ExtraToggles[mode]:SetValue(false)
            end

            task.defer(function()
                if State.Operation == op then
                    State.Operation = nil
                    State.Busy = false
                end
            end)
        end)
    end

    local function Run(op)
        if not WaitPartyEntry(op, function()
            return Config[op.Mode].JoinBy
        end) then
            return
        end

        local entry = op.Entry
        local valid, reason = Validate(op.Mode, entry, op.Difficulty)

        if not valid then
            warn("[Lobby] " .. reason)
            return
        end

        local gui = QueueGui()
        if not gui or InLobby() == nil
            or not Child(Player, "TeleportingLock", "NumberValue")
        then
            warn("[Lobby] Required player/queue state is not ready.")
            return
        end

        if Teleporting() or InLobby() or gui.Enabled
            or LobbyService.current_lobby ~= nil
        then
            warn("[Lobby] Existing room, queue, or teleport detected. Auto Join stopped.")
            return
        end

        local level = Levels[entry.Id]
        if type(level) ~= "table" then
            warn("[Lobby] Selected level is no longer available.")
            return
        end

        if op.JoinBy == "Matchmaking" and level._MATCHMAKING then
            op.QueueGui = gui

            Log("Requesting matchmaking: " .. entry.Id)
            local ok = Call("request_matchmaking", entry.Id)

            -- A returned value alone does not prove queue acceptance.
            if not ok then
                return
            end

            local deadline = os.clock() + 12
            repeat
                if gui.Parent and gui.Enabled then
                    op.QueueConfirmed = true
                    Log("Matchmaking queue confirmed by UI state.")
                    break
                end

                if Teleporting() then
                    Log("Teleport transition observed.")
                    return
                end

                task.wait(0.2)
            until os.clock() >= deadline

            if not op.QueueConfirmed then
                warn("[Lobby] Queue acceptance is unconfirmed; no retry was sent.")
                return
            end

            while Current(op) and gui.Parent and gui.Enabled and not Teleporting() do
                task.wait(0.25)
            end

            if Teleporting() then
                Log("Teleport transition observed.")
            elseif Current(op) then
                Log("Matchmaking UI closed. Auto Join stopped.")
            end
            return
        end

        if op.JoinBy == "Matchmaking" then
            Log("This stage has no matchmaking; using Normal.")
        end

        local room
        local found = Observe(op, 60, function()
            if InLobby() or QueueGui() ~= gui or gui.Enabled
                or LobbyService.current_lobby ~= nil
            then
                op.Conflict = true
                return true
            end

            local container = Rooms(op.Mode)
            if not container then
                return false
            end

            for _, candidate in ipairs(container:GetChildren()) do
                local owner = Child(candidate, "Owner", "ObjectValue")
                local locked = Child(candidate, "Locked", "BoolValue")
                local teleport = Child(candidate, "Teleporting", "BoolValue")

                if candidate:IsA("Model") and owner and locked and teleport
                    and owner.Value == nil
                    and not locked.Value
                    and not teleport.Value
                then
                    room = candidate
                    return true
                end
            end
            return false
        end)

        if not found or not Current(op) then
            warn("[Lobby] No available room, cancelled, or teleport started.")
            return
        end
        if op.Conflict then
            warn("[Lobby] Manual room/queue activity detected. Auto Join stopped.")
            return
        end

        op.Room = room
        Log("Joining room: " .. room.Name)

        local joined, accepted = Call("request_join_lobby", room.Name)
        if not joined or accepted ~= true then
            warn("[Lobby] Room join was not accepted; no automatic retry.")
            return
        end

        local owned = Observe(op, 8, function()
            return room.Parent ~= nil
                and RoomValue(room, "Owner", "ObjectValue") == Player
                and InLobby() == true
        end)

        -- Even after cancellation, recover confirmed ownership for cleanup.
        if room.Parent
            and RoomValue(room, "Owner", "ObjectValue") == Player
            and (
                LobbyService.current_lobby == nil
                or LobbyService.current_lobby == room.Name
            )
        then
            LobbyService.current_lobby = room.Name
            LobbyService.current_lobby_model = room
        end

        if not owned or not Current(op) then
            warn("[Lobby] Room ownership was not confirmed or operation was cancelled.")
            return
        end

        if LobbyService.current_lobby ~= room.Name
            or LobbyService.current_lobby_model ~= room
        then
            warn("[Lobby] Current room changed. Auto Join stopped.")
            return
        end

        valid, reason = Validate(op.Mode, entry, op.Difficulty)
        if not valid then
            warn("[Lobby] " .. reason)
            return
        end

        local locked, lockAccepted = Call(
            "request_lock_level",
            room.Name,
            entry.Id,
            false,
            op.Difficulty
        )

        if not locked or lockAccepted ~= true then
            warn("[Lobby] Level lock was not accepted.")
            return
        end

        local function RoomConfigured()
            local container = Rooms(op.Mode)
            if not container or room.Parent ~= container then
                return false
            end

            local timer = RoomValue(room, "Timer", "IntValue")

            return RoomValue(room, "Owner", "ObjectValue") == Player
                and RoomValue(room, "Level", "StringValue") == entry.Id
                and RoomValue(room, "Difficulty", "StringValue") == op.Difficulty
                and RoomValue(room, "FriendsOnly", "BoolValue") == false
                and RoomValue(room, "Active", "BoolValue") == true
                and type(timer) == "number"
                and timer >= 0
                and LobbyService.current_lobby == room.Name
                and LobbyService.current_lobby_model == room
        end

        local function LaunchStarted()
            return Teleporting()
                or (
                    room.Parent ~= nil
                    and RoomValue(room, "Teleporting", "BoolValue") == true
                )
        end

        local configured = Observe(op, 8, function()
            return LaunchStarted() or RoomConfigured()
        end)

        if LaunchStarted() then
            op.Launching = true
            Log("Launch already started; another Start request was not sent.")
            return
        end

        if not Current(op) then
            Log("Level selection cancelled; Start was not sent.")
            return
        end

        if not configured or not RoomConfigured() then
            warn(string.format(
                "[Lobby] Room configuration not confirmed. "
                    .. "ExpectedLevel=%s ActualLevel=%s "
                    .. "ExpectedDifficulty=%s ActualDifficulty=%s "
                    .. "Active=%s FriendsOnly=%s Timer=%s",
                entry.Id,
                tostring(RoomValue(room, "Level", "StringValue")),
                op.Difficulty,
                tostring(RoomValue(room, "Difficulty", "StringValue")),
                tostring(RoomValue(room, "Active", "BoolValue")),
                tostring(RoomValue(room, "FriendsOnly", "BoolValue")),
                tostring(RoomValue(room, "Timer", "IntValue"))
            ))
            return
        end

        -- Native client UI synchronization; no additional lock request.
        if type(LobbyService.on_request_lock_level) == "function" then
            local uiOK, uiError = pcall(LobbyService.on_request_lock_level)
            if not uiOK then
                warn("[Lobby] Native start UI sync failed: " .. tostring(uiError))
            end
        else
            warn("[Lobby] Native on_request_lock_level is unavailable.")
        end

        -- UI synchronization may yield; recheck before sending Start.
        if LaunchStarted() then
            op.Launching = true
            Log("Launch started during UI synchronization.")
            return
        end

        if not Current(op) or not RoomConfigured() then
            warn("[Lobby] Operation or room changed before Start.")
            return
        end

        Log("Room configuration confirmed: " .. entry.Id .. " / " .. op.Difficulty)

        if op.Mode == "Raid" then
            local eligible, failure = Validate(op.Mode, entry, op.Difficulty)
            if not eligible then
                warn("[Lobby] " .. failure)
                return
            end
        end

        if not Current(op) then
            return
        end

        Log("Starting: " .. entry.Id .. " / " .. op.Difficulty)
        local started = Call("request_start_game", room.Name)
        if not started then
            return
        end

        local launching = Observe(op, 20, function()
            return Teleporting()
                or (
                    room.Parent ~= nil
                    and RoomValue(room, "Teleporting", "BoolValue") == true
                )
        end)

        if launching then
            op.Launching = true
            Log("Launch state confirmed. Arrival in the match is not yet verified.")
        else
            warn("[Lobby] Launch state is unconfirmed; no duplicate Start request.")
        end
    end

    local function OnToggle(mode, enabled)
        if not enabled then
            local op = State.Operation
            if op and op.Mode == mode then
                op.Cancelled = true
            end
            return
        end

        if State.Disposed or State.Busy then
            warn("[Lobby] Another operation is active or stopping.")
            Toggles[mode]:SetValue(false)
            return
        end

        local settings = Config[mode]
        local entries = EntriesByMode[mode]
        local entry = settings and entries and entries[settings.Selection]

        if not entry then
            warn("[Lobby] Select a stage/world first.")
            Toggles[mode]:SetValue(false)
            return
        end

        local op = {
            Mode = mode,
            Entry = entry,
            JoinBy = settings.JoinBy,
            Difficulty = settings.Difficulty,
            Cancelled = false,
        }

        State.Busy = true
        State.Operation = op

        task.spawn(function()
            Run(op)

            if not op.Launching then
                Cleanup(op)
            end

            -- Keep the operation reserved until the UI callback has run.
            Toggles[mode]:SetValue(false)
            task.defer(function()
                if State.Operation == op then
                    State.Operation = nil
                    State.Busy = false
                end
            end)
        end)
    end

