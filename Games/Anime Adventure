    local function RefreshPortals()
        if State.Disposed or not PortalAlive or not PortalDropdown then
            return
        end

        local records = PortalInventory()
        if not records then
            PortalSelectedUUID = nil
            PortalDropdown:SetValue("--")
            warn("[Portal] Inventory unique_items is not ready.")
            return
        end

        local rows = {}
        local present = {}

        for _, record in pairs(records) do
            if type(record) == "table" and type(record.uuid) == "string" then
                present[record.uuid] = true

                if not PortalRemoved[record.uuid] and IsUsablePortal(record) then
                    local definition = PortalItems[record.item_id]
                    local name = type(definition.name) == "string"
                        and definition.name or record.item_id
                    local tier = record.tier ~= nil
                        and (" / Tier " .. tostring(record.tier)) or ""
                    local label = name .. tier .. " [" .. record.uuid .. "]"

                    table.insert(rows, {
                        Label = label,
                        UUID = record.uuid,
                    })
                end
            end
        end

        -- Remove invalidation entries after native inventory catches up.
        for uuid in pairs(PortalRemoved) do
            if not present[uuid] then
                PortalRemoved[uuid] = nil
            end
        end

        table.sort(rows, function(a, b)
            return a.Label < b.Label
        end)

        table.clear(PortalEntries)
        table.clear(PortalList)
        table.insert(PortalList, "--")

        local selectedLabel = "--"
        for _, row in ipairs(rows) do
            PortalEntries[row.Label] = row.UUID
            table.insert(PortalList, row.Label)
            if row.UUID == PortalSelectedUUID then
                selectedLabel = row.Label
            end
        end

        if selectedLabel == "--" then
            PortalSelectedUUID = nil
        end

        if type(PortalDropdown.ClearAll) == "function" then
            PortalDropdown:ClearAll()
        elseif type(PortalDropdown.Clear) == "function" then
            PortalDropdown:Clear()
        end
        for _, label in ipairs(PortalList) do
            PortalDropdown:AddList(label)
        end
        if type(PortalDropdown.SetValue) == "function" then
            PortalDropdown:SetValue(selectedLabel)
        end
    end

    local function SchedulePortalRefresh()
        if PortalRefreshScheduled or State.Disposed or not PortalAlive then
            return
        end

        PortalRefreshScheduled = true
        task.delay(0.2, function()
            PortalRefreshScheduled = false
            if not State.Disposed and PortalAlive then
                RefreshPortals()
            end
        end)
    end

    local portalEndpoints = Child(ReplicatedStorage, "endpoints")
    local portalSignals = Child(portalEndpoints, "server_to_client")
    local portalCreated = Child(
        portalSignals, "portal_lobby_owner_created", "RemoteEvent"
    )
    local portalAdded = Child(portalSignals, "unique_item_added", "RemoteEvent")
    local portalRemoved = Child(portalSignals, "unique_item_removed", "RemoteEvent")

    if portalCreated then
        table.insert(State.Connections,
            portalCreated.OnClientEvent:Connect(function(room)
                local op = State.Operation
                if not op or op.Mode ~= "Portal" or not op.Sent then
                    return
                end

                if typeof(room) == "Instance" and room:IsA("Model") then
                    op.EventRoom = room
                end
            end)
        )
    end

    if portalAdded then
        table.insert(State.Connections,
            portalAdded.OnClientEvent:Connect(SchedulePortalRefresh)
        )
    end

    if portalRemoved then
        table.insert(State.Connections,
            portalRemoved.OnClientEvent:Connect(function(uuid)
                if type(uuid) ~= "string" then
                    return
                end

                PortalRemoved[uuid] = true

                if PortalSelectedUUID == uuid then
                    PortalSelectedUUID = nil
                    if PortalDropdown then
                        PortalDropdown:SetValue("--")
                    end
                end

                local op = State.Operation
                if op and op.Mode == "Portal" and op.UUID == uuid and op.Sent then
                    op.RemovalConfirmed = true
                end

                SchedulePortalRefresh()
            end)
        )
    end

    local function PortalLaunching(op)
        return Teleporting()
            or (
                op.Room and op.Room.Parent
                and RoomValue(op.Room, "Teleporting", "BoolValue") == true
            )
    end

    local function RunPortal(op)
        if not WaitPartyEntry(op, function()
            return "Normal"
        end) then
            return
        end

        local container = PortalRooms()
        local queue = QueueGui()

        if not container or not queue or InLobby() == nil
            or not Child(Player, "TeleportingLock", "NumberValue")
            or not portalCreated or not portalRemoved
        then
            warn("[Portal] Required room, player state, or signals are unavailable.")
            return
        end

        if InLobby() or queue.Enabled or Teleporting()
            or LobbyService.current_lobby ~= nil
        then
            warn("[Portal] Existing room, queue, or teleport detected.")
            return
        end

        local record, inventoryReady = PortalRecord(op.UUID)
        if not inventoryReady or not IsUsablePortal(record)
            or PortalRemoved[op.UUID]
        then
            warn("[Portal] Selected UUID is unavailable or no longer usable.")
            return
        end

        local before = {}
        for _, room in ipairs(container:GetChildren()) do
            before[room] = true
            if RoomValue(room, "Owner", "ObjectValue") == Player then
                warn("[Portal] You already own a Portal room.")
                return
            end
        end

        local function FindCreatedRoom()
            local function Eligible(room)
                return typeof(room) == "Instance"
                    and room:IsA("Model")
                    and room.Parent == container
                    and not before[room]
                    and RoomValue(room, "Owner", "ObjectValue") == Player
            end

            if Eligible(op.EventRoom) then
                return op.EventRoom
            end

            local current = LobbyService.current_lobby_model
            if Eligible(current) then
                return current
            end

            local found
            for _, room in ipairs(container:GetChildren()) do
                if Eligible(room) then
                    if found then
                        -- Multiple candidates cannot be attributed safely.
                        return nil
                    end
                    found = room
                end
            end
            return found
        end

        if not Current(op) or not PortalAlive then
            return
        end

        -- Durable reservation BEFORE the consumptive request.
        AAExtra.Settings.PendingPortalUUID = op.UUID
        if not AAExtra.Save() then
            AAExtra.Settings.PendingPortalUUID = ""
            warn("[Portal] Reservation could not be saved. Portal was not opened.")
            return
        end

        op.Sent = true
        print("[Portal] Opening one Portal UUID: " .. op.UUID)

        local transportOK, returned = Call(
            "use_portal",
            op.UUID,
            { friends_only = false }
        )

        print(
            "[Portal] use_portal returned. TransportOK="
                .. tostring(transportOK)
                .. " ReturnType=" .. typeof(returned)
                .. " Return=" .. tostring(returned)
        )

        -- Reconcile even after error, false return, or Toggle Off.
        -- Never send use_portal a second time.
        local deadline = os.clock() + 12
        repeat
            local room = FindCreatedRoom()
            if room then
                op.Room = room
            end

            local remaining, ready = PortalRecord(op.UUID)
            op.Consumed = op.RemovalConfirmed
                or (ready and remaining == nil)

            if op.Room and op.Consumed then
                break
            end

            if PortalLaunching(op) then
                op.Launching = true
                break
            end

            task.wait(0.2)
        until os.clock() >= deadline

        if not op.Room or not op.Consumed then
            warn(
                "[Portal] Result unresolved. UUID=" .. op.UUID
                    .. " Consumed=" .. tostring(op.Consumed)
                    .. " RoomFound=" .. tostring(op.Room ~= nil)
                    .. ". Opening another Portal is blocked."
            )
            return
        end

        -- Opening is now reconciled; do not retain an unresolved reservation.
        AAExtra.Settings.PendingPortalUUID = ""
        if not AAExtra.Save() then
            AAExtra.Settings.PendingPortalUUID = op.UUID
            warn("[Portal] Could not save reconciliation. Start was not sent.")
            return
        end

        local function RoomReady()
            local room = op.Room
            return room.Parent == container
                and RoomValue(room, "Owner", "ObjectValue") == Player
                and InLobby() == true
                and LobbyService.current_lobby == room.Name
                and LobbyService.current_lobby_model == room
        end

        if PortalLaunching(op) then
            op.Launching = true
            return
        end

        if not Current(op) or not PortalAlive then
            return
        end

        local ready = Observe(op, 8, function()
            return PortalLaunching(op) or RoomReady()
        end)

        if PortalLaunching(op) then
            op.Launching = true
            return
        end

        if not ready or not Current(op) or not PortalAlive or not RoomReady() then
            warn("[Portal] Native room synchronization is unconfirmed. Start not sent.")
            return
        end

        -- Native portal-created handler already joined/configured the room.
        local ok = Call("request_start_game", op.Room.Name)
        if not ok then
            return
        end

        Observe(op, 20, function()
            return PortalLaunching(op)
        end)

        op.Launching = PortalLaunching(op) == true
        if op.Launching then
            print("[Portal] Launch state confirmed; match arrival is not yet verified.")
        else
            warn("[Portal] Launch unconfirmed. No duplicate Start or Open request.")
        end
    end

    local function OnPortalToggle(enabled)
        if not enabled then
            local op = State.Operation
            if op and op.Mode == "Portal" then
                op.Cancelled = true
            end
            return
        end

        if State.Disposed or not PortalAlive or State.Busy then
            warn("[Portal] Another operation is active or stopping.")
            PortalToggle:SetValue(false)
            return
        end

        if not AAExtra.StorageOK then
            warn("[Portal] Persistent reservation storage is unavailable.")
            PortalToggle:SetValue(false)
            return
        end

        if AAExtra.Settings.Mode ~= "" then
            warn("[Portal] Turn off the active Daily/Challenge/Mansion toggle first.")
            PortalToggle:SetValue(false)
            return
        end

        if AAExtra.Settings.PendingPortalUUID ~= "" then
            warn(
                "[Portal] Unresolved previous UUID: "
                    .. AAExtra.Settings.PendingPortalUUID
                    .. ". No new Portal was opened."
            )
            PortalToggle:SetValue(false)
            return
        end

        if type(PortalSelectedUUID) ~= "string" then
            warn("[Portal] Select an owned Portal first.")
            PortalToggle:SetValue(false)
            return
        end

        local op = {
            Mode = "Portal",
            UUID = PortalSelectedUUID,
            Cancelled = false,
        }

        State.Operation = op
        State.Busy = true

        task.spawn(function()
            local ok, failure = xpcall(function()
                RunPortal(op)
            end, debug.traceback)

            if not ok then
                warn("[Portal] " .. tostring(failure))
            end

            -- Only intentional cancellation leaves a confirmed owned room.
            -- Failed/uncertain opening preserves it for inspection.
            if op.Cancelled and not PortalLaunching(op) and op.Room then
                local cleaned, cleanupError = xpcall(function()
                    Cleanup(op)
                end, debug.traceback)

                if not cleaned then
                    warn("[Portal] Cleanup failed: " .. tostring(cleanupError))
                end
                warn("[Portal] Leaving does not refund the consumed Portal.")
            end

            if PortalAlive and not State.Disposed then
                PortalToggle:SetValue(false)
                SchedulePortalRefresh()
            end

            task.defer(function()
                if State.Operation == op then
                    State.Operation = nil
                    State.Busy = false
                end
            end)
        end)
    end

    PortalToggle = PortalSection:Toggle({
        Title = "Auto Join Portal",
        Description = "เปิดพอร์ทัลที่เลือกจากคลังหนึ่งชิ้น",
        Value = false,
        Callback = function(_, value)
            OnPortalToggle(value == true)
        end,
    })

    PortalDropdown = PortalSection:Dropdown({
        Title = "Portals",
        Value = "--",
        List = PortalList,
        Callback = function(_, label)
            PortalSelectedUUID = PortalEntries[label]
        end,
    })

    table.insert(State.Connections,
        PortalToggle.self.Destroying:Connect(function()
            PortalAlive = false
            local op = State.Operation
            if op and op.Mode == "Portal" then
                op.Cancelled = true
            end
        end)
    )

    RefreshPortals()

    function State.Stop()
        State.Disposed = true


        if State.Operation then
            State.Operation.Cancelled = true
        end

        for _, connection in ipairs(State.Connections) do
            connection:Disconnect()
        end
        table.clear(State.Connections)
    end

    table.insert(State.Connections, Toggles.Story.self.Destroying:Connect(function()
        State.Stop()
    end))

    Log(
        "Lobby ready: "
            .. tostring(#StoryList - 1)
            .. " Story acts / "
            .. tostring(#InfiniteList - 1)
            .. " Infinite worlds."
    )
end

