    local function RoomValue(room, name, className)
        local object = Child(room, name, className)
        if object then
            return object.Value
        end
        return nil
    end

    local function Call(name, ...)
        if name == "request_start_game" and AAExtra.Party then
            local op = State.Operation
            local room = LobbyService.current_lobby_model

            local expectedLevel =
                room and RoomValue(room, "Level", "StringValue")

            local expectedDifficulty =
                room and RoomValue(room, "Difficulty", "StringValue")

            local ready = AAExtra.Party.WaitStart(room, function()
                return op ~= nil
                    and not State.Disposed
                    and State.Operation == op
                    and not op.Cancelled
                    and not Teleporting()
                    and room ~= nil
                    and room.Parent ~= nil
                    and LobbyService.current_lobby_model == room
                    and LobbyService.current_lobby == room.Name
                    and RoomValue(room, "Level", "StringValue") == expectedLevel
                    and RoomValue(room, "Difficulty", "StringValue") == expectedDifficulty
            end)

            if not ready then
                return false, "Party Start cancelled"
            end
        end

        if (name == "request_matchmaking"
            or name == "request_start_infinite_tower")
            and AAExtra.Party
        then
            local op = State.Operation

            while AAExtra.Settings.PartyEnabled do
                if not op or State.Disposed
                    or State.Operation ~= op
                    or op.Cancelled
                    or Teleporting()
                then
                    return false, "Party queue cancelled"
                end

                AAExtra.Party.Report(
                    "พักคิว Matching/Mansion ขณะเปิด Auto Party"
                )

                task.wait(0.5)
            end
        end

        local endpoints = Child(ReplicatedStorage, "endpoints")
        local folder = Child(endpoints, "client_to_server")
        local remote = Child(folder, name, "RemoteFunction")

        if not remote then
            return false, "Missing RemoteFunction: " .. name
        end

        -- One synchronous request at a time. Never retry an unresolved call.
        local ok, result = pcall(remote.InvokeServer, remote, ...)
        if not ok then
            warn("[Lobby] " .. name .. " failed: " .. tostring(result))
        end
        return ok, result
    end

    local function Current(op)
        return not State.Disposed
            and State.Operation == op
            and not op.Cancelled
    end

    local function WaitPartyEntry(op, readJoinBy)
        if not AAExtra.Party then return true end

        return AAExtra.Party.WaitEntry(function()
            return Current(op) and not Teleporting()
        end, function()
            op.JoinBy = readJoinBy()
            return op.JoinBy
        end)
    end

    -- Local observation deadline, not an assumed server cooldown.
    local function Observe(op, seconds, predicate)
        local deadline = os.clock() + seconds

        repeat
            if not Current(op) then
                return false
            end

            if predicate() then
                return true
            end

            if Teleporting() then
                return false
            end

            task.wait(0.2)
        until os.clock() >= deadline

        return false
    end

    local function Cleanup(op)
        if Teleporting() then
            Log("Teleport already started; cancellation was not attempted.")
            return
        end

        local room = op.Room
        if room and room.Parent
            and RoomValue(room, "Owner", "ObjectValue") == Player
            and LobbyService.current_lobby == room.Name
            and LobbyService.current_lobby_model == room
        then
            local ok, accepted = Call("request_leave_lobby", room.Name)

            if ok and accepted == true
                and LobbyService.current_lobby == room.Name
                and LobbyService.current_lobby_model == room
            then
                LobbyService.cancel_selections()
            end
        end

        -- Do not cancel a pre-existing or unconfirmed queue.
        local gui = QueueGui()
        if op.QueueConfirmed and gui == op.QueueGui and gui.Enabled then
            local ok = Call("leave_matchmaking")

            if ok then
                local deadline = os.clock() + 8
                while gui.Parent and gui.Enabled
                    and not Teleporting()
                    and os.clock() < deadline
                do
                    task.wait(0.2)
                end

                if gui.Parent and gui.Enabled then
                    warn("[Lobby] Queue cancellation is not confirmed.")
                else
                    Log("Queue UI closed.")
                end
            end
        end
    end

    local function Validate(mode, entry, difficulty)
        if mode == "Legend" or mode == "Raid" then
            local level = Levels[entry.Id]
            if type(level) ~= "table" then
                return false, "Selected level is unavailable."
            end

            if difficulty ~= "Hard" then
                return false, mode .. " requires Hard difficulty."
            end

            local service = mode == "Raid" and RaidService or LobbyService
            local session = type(service) == "table" and service.session
            local profile = type(session) == "table" and session.profile_data
            local levelData = type(profile) == "table" and profile.level_data

            if type(profile) ~= "table" or type(levelData) ~= "table" then
                return false, mode .. " progression data is not ready."
            end

            -- Check the actual required level IDs from runtime config.
            -- Remaining game-specific validation belongs to the server.
            local requirements = level.requirements
            if requirements ~= nil and type(requirements) ~= "table" then
                return false, "Invalid level requirements."
            end

            local requiredLevels = requirements and requirements.required_levels
            if requiredLevels ~= nil then
                if type(requiredLevels) ~= "table" then
                    return false, "Invalid required_levels."
                end

                local completed = levelData.completed_story_levels
                if type(completed) ~= "table" then
                    return false, "Completed level data is not ready."
                end

                for _, requiredId in pairs(requiredLevels) do
                    if type(requiredId) ~= "string" then
                        return false, "Unsupported required level entry."
                    end

                    local completion = completed[requiredId]
                    local clears = type(completion) == "table" and completion.times_completed
                    if type(clears) ~= "number" or clears <= 0 then
                        return false, "Stage locked. Required clear: " .. requiredId
                    end
                end
            end

            if mode == "Raid" then
                local limit = level._raid_daily_tries
                -- A nil limit means no daily limit, per inspected config.
                if limit ~= nil then
                    if type(limit) ~= "number" or limit < 0 or limit % 1 ~= 0 then
                        return false, "Invalid raid daily limit."
                    end

                    local tries = profile.raid_tries
                    if tries ~= nil and type(tries) ~= "table" then
                        return false, "Invalid raid tries data."
                    end

                    local perLevel = tries and tries.levels
                    if perLevel ~= nil and type(perLevel) ~= "table" then
                        return false, "Invalid per-level raid tries."
                    end

                    local consumed = perLevel and perLevel[entry.Id]
                    if consumed == nil then
                        consumed = 0
                    end

                    if type(consumed) ~= "number" or consumed < 0 or consumed % 1 ~= 0 then
                        return false, "Invalid consumed raid attempts."
                    end

                    if consumed >= limit then
                        return false, "Raid skipped: no free attempts remaining for " .. entry.Id
                    end
                end
            end

            return true
        end

        local session = LobbyService.session
        local profile = type(session) == "table" and session.profile_data
        local levelData = type(profile) == "table" and profile.level_data

        if type(session) ~= "table" or type(levelData) ~= "table" then
            return false, "Player progression data is not ready."
        end

        local ok, unlocked, requirement
        if mode == "Infinite" then
            ok, unlocked, requirement = pcall(
                Progression.check_if_unlocked_story_infinite,
                session,
                entry.World
            )
        else
            local level = Levels[entry.Id]
            if type(level) ~= "table" then
                return false, "Selected level is unavailable."
            end
            ok, unlocked, requirement = pcall(
                Progression.check_if_unlocked_level,
                session,
                level
            )
        end

        if not ok then
            return false, "Unlock check failed: " .. tostring(unlocked)
        end
        if not unlocked then
            return false, "Stage locked. Requirement: " .. tostring(requirement)
        end

        local checked, eligible = pcall(
            Progression.check_if_unlocked_difficulty,
            session,
            entry.Id,
            difficulty
        )

        if not checked then
            return false, "Difficulty check failed: " .. tostring(eligible)
        end
        if not eligible then
            return false, "Selected difficulty is locked."
        end

        return true
    end

