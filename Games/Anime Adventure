                gui = value
            end

            if not catalogReady and os.clock() >= (trade.NextCatalog or 0) then
                trade.NextCatalog = os.clock() + 3

                local ok, a, b = pcall(function()
                    return loader.load_data(loaderModule, "Items"),
                        loader.load_data(loaderModule, "ItemsForSaleEvent")
                end)
                if R.Stopped then return false end

                if ok and type(a) == "table" and type(b) == "table" then
                    items, definitions = a, b
                    applying = true
                    products:ClearAll()
                    local selected = {}

                    for _, entry in ipairs(catalog) do
                        local id = entry.Id
                        if type(definitions[id]) == "table" then
                            local item = items[id]
                            local name = (
                                type(item) == "table"
                                and type(item.name) == "string"
                                and item.name or id
                            ) .. " [" .. id .. "]"

                            idsByName[name] = id
                            products:AddList(name)

                            if table.find(cfg.SummerMarketItems, id) then
                                table.insert(selected, name)
                            end
                        end
                    end

                    products:SetValue(selected)
                    applying = false
                    catalogReady = true
                else
                    Message("Buy", "รอรายการ Summer Market: " .. tostring(a))
                end
            end
            return not R.Stopped
        end

        local function Context()
            local shop = gui and gui.event_shop
            local session = type(shop) == "table" and shop.session
            local inv = type(session) == "table" and session.inventory
            local data = type(inv) == "table" and inv.inventory_profile_data

            if type(data) ~= "table"
                or type(data.normal_items) ~= "table"
                or type(data.unique_items) ~= "table"
                or type(inv.get_number_of_owned_item) ~= "function"
            then
                return
            end

            local cache = {}
            local function Count(id)
                if cache[id] ~= nil then
                    return cache[id] ~= false and cache[id] or nil
                end
                local ok, n = pcall(inv.get_number_of_owned_item, inv, id)
                if not ok or not Number(n) or n % 1 ~= 0 then
                    cache[id] = false
                    return
                end
                cache[id] = n
                return n
            end

            return session, inv, Count
        end

        local function Idle()
            local shared = env["__AnimeAdventureLobbyAutoJoin"]
            local inLobby = Child(player, "AlreadyInLobby", "BoolValue")
            local teleport = Child(player, "TeleportingLock", "NumberValue")

            return loader.IsLobby == true
                and inLobby and not inLobby.Value
                and teleport and teleport.Value <= 0
                and not (
                    type(shared) == "table"
                    and (shared.Busy or shared.Operation)
                )
        end

        local function BuyChoice(balance)
            if not catalogReady or #cfg.SummerMarketItems == 0 then return end

            local ids = cfg.SummerMarketItems
            local start = ((trade.Cursor or 1) - 1) % #ids + 1

            for offset = 0, #ids - 1 do
                local index = (start + offset - 1) % #ids + 1
                local id = ids[index]
                local product = definitions[id]
                local price = prices[id]

                if price and type(product) == "table" then
                    for _, n in ipairs({100, 10, 1}) do
                        local allowed = n == 1
                            or (n == 10 and product.buy10 == true)
                            or (n == 100 and product.buy100 == true)

                        local limit = id == "capsule_summer2"
                            and cfg.SummerMarketBuyBatch or 1

                        if n <= limit and allowed and balance >= price * n then
                            return id, n, price * n, index % #ids + 1
                        end
                    end
                end
            end
        end

        local function StepMarket()
            Observe()
            if not LoadMarket() then return end

            local session, inventory, Count = Context()
            if not session then
                Message("Buy", "รอคลัง Summer Market")
                Message("Open", "รอคลัง Sunny Star")
                return
            end

            local value, balance = Wallet()
            local op = trade.Pending

            if op then
                if not op.Returned then
                    Message(op.Kind, "รอคำสั่งเดิม ไม่ส่งซ้อน")
                    return
                end

                local owned = Count(op.Id)
                if op.Kind == "Buy" then
                    if balance then
                        op.LowestPearls = math.min(op.LowestPearls, balance)
                    end

                    if owned and owned >= op.Before + op.Quantity
                        and op.LowestPearls <= op.BeforePearls - op.Cost
                    then
                        trade.Pending = nil
                        trade.Cursor = op.NextCursor
                        Message("Buy", "ยืนยันซื้อ " .. op.Id
                            .. " x" .. op.Quantity .. " แล้ว")
                    else
                        Message("Buy", "รอจำนวนสินค้าเพิ่มและยอดเหรียญลด ไม่ซื้อซ้ำ")
                    end
                elseif owned
                    and (owned <= op.Before - op.Quantity
                        or (op.Removed or 0) >= op.Quantity)
                    and op.RewardSeen
                then
                    trade.Pending = nil
                    if trade.Group == op.Group then
                        trade.Group.Remaining = math.max(
                            0, trade.Group.Remaining - op.Quantity
                        )
                    end
                    Message("Open", "ยืนยันใช้ Sunny Star x"
                        .. op.Quantity .. " และพบข้อมูลรางวัลแล้ว")
                else
                    Message("Open", "รอยืนยันการใช้ Sunny Star และข้อมูลรางวัล ไม่เปิดซ้ำ")
                end
                return
            end

            if not marketReady or not Idle() then
                Message("Buy", "รอหน้า Lobby ที่ไม่มีคิวหรือการเทเลพอร์ต")
                Message("Open", "รอหน้า Lobby ที่ไม่มีคิวหรือการเทเลพอร์ต")
                return
            end

            if not cfg.SummerStarOpen then trade.Group = nil end
            if trade.Group
                and (trade.Group.Mode ~= cfg.SummerStarOpenBatch
                    or trade.Group.Remaining <= 0)
            then
                trade.Group = nil
            end

            local stars = Count("capsule_summer2")
            local kind, id, quantity, cost, nextCursor, group

            if cfg.SummerStarOpen and trade.Group and stars and stars > 0 then
                kind = "Open"
            elseif cfg.SummerMarketBuy then
                if balance then
                    id, quantity, cost, nextCursor = BuyChoice(balance)
                    if id then
                        kind = "Buy"
                    else
                        Message("Buy", #cfg.SummerMarketItems == 0
                            and "เลือก Buy Items ก่อน"
                            or "เหรียญไม่พอซื้อรายการที่เลือก รอเหรียญเพิ่ม")
                    end
                else
                    Message("Buy", "รอ SummerPearls")
                end
            else
                Message("Buy", "ปิด Auto Buy")
            end

            if not kind and cfg.SummerStarOpen and stars and stars > 0 then
                kind = "Open"
            end
            if not kind then
                Message("Open", not cfg.SummerStarOpen and "ปิด Auto Open"
                    or (stars == nil and "รอจำนวน Sunny Star"
                        or "Sunny Star หมด รอของเพิ่ม"))
                return
            end

            if kind == "Open" then
                if not bindings.Rewards then
                    Message("Open", "รอ Event ข้อมูลรางวัล")
                    return
                end

                if not trade.Group then
                    trade.Group = {
                        Mode = cfg.SummerStarOpenBatch,
                        Remaining = math.min(cfg.SummerStarOpenBatch, stars),
                    }
                end

                group = trade.Group
                id = "capsule_summer2"
                quantity = group.Remaining >= 10 and stars >= 10
                    and group.Mode >= 10 and 10 or 1
            end

            local before = Count(id)
            if before == nil then
                Message(kind, "รอจำนวนไอเทม " .. id)
                return
            end

            local remote = Remote(
                kind == "Buy" and "buy_item_generic" or "use_item"
            )
            if not remote then
                Message(kind, "รอ Remote ของ " .. kind)
                return
            end

            local currentSession, currentInventory = Context()
            if R.Stopped or env[key] ~= R or not Idle()
                or currentSession ~= session
                or currentInventory ~= inventory
                or (kind == "Buy" and not cfg.SummerMarketBuy)
                or (kind == "Open" and not cfg.SummerStarOpen)
            then
                return
            end

            op = {
                Kind = kind,
                Id = id,
                Quantity = quantity,
                Before = before,
                BeforePearls = balance,
                LowestPearls = balance,
                Cost = cost,
                NextCursor = nextCursor,
                Group = group,
                Sent = true,
                Returned = false,
            }
            trade.Pending = op
            Message(kind, "ส่ง " .. kind .. " " .. id
                .. " x" .. quantity .. " แล้ว รอยืนยัน")

            local ok, result
            if kind == "Buy" then
                ok, result = pcall(
                    remote.InvokeServer,
                    remote,
                    id,
                    "event",
                    "event_shop",
                    tostring(quantity)
                )
            else
                ok, result = pcall(
                    remote.InvokeServer,
                    remote,
                    id,
                    {use10 = quantity == 10}
                )
            end
            op.TransportOK, op.Result, op.Returned = ok, result, true
        end

        task.spawn(function()
            while not R.Stopped do
                local ok, err = xpcall(function()
                    if os.clock() >= (trade.NextRead or 0) then
                        trade.NextRead = os.clock() + 0.5
                        StepMarket()
                    end
                end, debug.traceback)

                if not ok then
                    Message("Buy", "Summer Market: " .. tostring(err))
                    Message("Open", "Sunny Star: " .. tostring(err))
                end
                task.wait(ok and 0.25 or 3)
            end
        end)
    end

    task.spawn(function()
        while not R.Stopped do
            local ok, err = xpcall(Step, debug.traceback)
            if not ok then
                Status("พักตรวจสอบหลังข้อผิดพลาด: " .. tostring(err))
                warn("[Summer] " .. tostring(err))
            end
            task.wait(ok and 0.5 or 3)
        end
    end)
end

-- Insert after AAExtra.Save is defined, before the Macro block.
do
    local env, key = getgenv(), "__AASummon"
    local old = env[key]
    if old and old.Stop then old.Stop() end
    local R = {Stopped=false,Enabled=false,Pending=old and old.Pending,
        Events={},Pulls=0,NextPull=0}
    env[key]=R
    local cfg=AAExtra.Settings
    if cfg.SummonQuantity~=1 and cfg.SummonQuantity~=10 then cfg.SummonQuantity=1 end
    if type(cfg.SummonLimit)~="number" or cfg.SummonLimit~=cfg.SummonLimit
        or math.abs(cfg.SummonLimit)==math.huge or cfg.SummonLimit<0 or cfg.SummonLimit%1~=0 then
        cfg.SummonLimit=0
    end
    local tab=App:MakeTab({Title="summon",Description="ตู้สุ่ม",Icon=123909267283672,Selected=false})
    local section=tab:Section("Summon")
    local statusLabel=section:Paragraph({Title="Status",Description="กำลังโหลดระบบสุ่มของเกม"})
    local bannerLabels,targetLabels={},{}
    local applying=false
    local controlsReady=false
    local autoToggle,bannerDropdown,targetDropdown
    local function Status(message)
        if R.Status==message then return end
        R.Status=message
        if statusLabel.self.Parent then statusLabel.Desc.Text=message end
        print("[Summon] " .. message)
    end
    local function Save()
        if AAExtra.StorageOK then AAExtra.Save() end
    end
    local function Disable(message)
        R.Enabled=false
        if autoToggle and not R.Stopped then
            applying=true; autoToggle:SetValue(false); applying=false
        end
        Status(message)
    end
    autoToggle=section:Toggle({Title="Auto Summon",Value=false,
        Description="ระบบสุ่มอัตโนมัติ  ",
        Callback=function(_,enabled)
            if applying or not controlsReady then return end
            if not enabled then
                R.Enabled=false
                Status(R.Pending and "Stopped; observing the in-flight summon." or "Stopped.")
                return
            end
            if R.Pending then Disable("Previous summon is being reconciled. Wait before enabling again."); return end
            if not cfg.SummonBanner then
                Disable("Select a banner first."); return
            end
            R.Pulls=0; R.TargetHits=0; R.SingleFallback=false
            R.Enabled=true
            Status("Preparing summons...")
        end})
    bannerDropdown=section:Dropdown({Title="Banner",Value="--",List={"--"},Callback=function(_,value)
        if applying then return end
        local id=bannerLabels[value]
        if cfg.SummonBanner~=id then
            cfg.SummonBanner=id; cfg.SummonTarget=nil
            Disable("Banner changed. Enable Auto Summon when ready; target tracking is optional.")
            R.PoolSignature=nil; Save()
        end
    end})
    targetDropdown=section:Dropdown({Title="Target Character",Value="--",List={"--"},Callback=function(_,value)
        if applying then return end
        local id=targetLabels[value]
        if cfg.SummonTarget~=id then
            cfg.SummonTarget=id
            Status("Target tracking updated; obtaining it will not stop summoning.")
            Save()
        end
    end})
    section:Dropdown({Title="Summons per Request",Value=tostring(cfg.SummonQuantity),List={"1","10"},
        Callback=function(_,value)
            if applying then return end
            local quantity=tonumber(value)
            if quantity==1 or quantity==10 then
                cfg.SummonQuantity=quantity; R.SingleFallback=false; Save()
            end
        end})
    section:Textbox({Title="Total Summons (0 = Until Resources Run Out)",Value=tostring(cfg.SummonLimit),
        Callback=function(_,value)
            local limit=tonumber(value)
            if not limit or limit~=limit or math.abs(limit)==math.huge or limit<0 or limit%1~=0 then
                Status("Total Summons must be an integer >= 0."); return
            end
            cfg.SummonLimit=limit; Save()
        end})
    function R.Stop()
        R.Stopped=true; R.Enabled=false
        for _,entry in pairs(R.Events) do entry.Connection:Disconnect() end
        table.clear(R.Events)
    end
    statusLabel.self.Destroying:Connect(R.Stop)
    task.defer(function() if not R.Stopped then controlsReady=true end end)
    local function Child(parent,name,class)
        local object=parent and parent:FindFirstChild(name)
        return object and (not class or object:IsA(class)) and object or nil
    end
    task.spawn(function()
        local RS=game:GetService("ReplicatedStorage")
        local Loader,Collection,Summon,Units,Banners,Endpoints
        while not R.Stopped and not Endpoints do
            local module=Child(Child(RS,"src"),"Loader","ModuleScript")
            if module then
                local ok,value=pcall(function()
                    local loader=require(module)
                    return {loader,
                        loader.load_client_service(module,"UnitCollectionServiceClient"),
                        loader.load_client_service(module,"SummonServiceClient"),
                        loader.load_data(module,"Units"),loader.load_data(module,"Banners"),
                        loader.load_client_service(module,"EndpointsClient")}
                end)
                if ok and type(value[2])=="table" and type(value[3])=="table"
                    and type(value[4])=="table" and type(value[5])=="table"
                    and type(value[6])=="table" and type(value[6].invoke_server)=="function" then
                    Loader,Collection,Summon,Units,Banners,Endpoints=table.unpack(value)
                elseif not ok then warn("[Summon / Load] " .. tostring(value)) end
            end
            if not Endpoints then task.wait(3) end
        end
        if R.Stopped then return end
        -- Verified display-name fallbacks; availability and pools come from runtime data.
        local display={April2025="Event",SakamotoEvent="Assassin Event",EventClover="Special",Legacy="Legacy"}
        local available={}
        local currentTargets={}
        local function Pool(id)
            local all=Summon.BANNER_UNITS
            local record=type(all)=="table" and all[id]
            local rateup=type(record)=="table" and record.rateup_units
            local ids,seen={},{}
            if type(rateup)=="table" then
                for _,unitId in pairs(rateup) do
                    if type(unitId)=="string" and type(Units[unitId])=="table" and not seen[unitId] then
                        seen[unitId]=true; table.insert(ids,unitId)
                    end
                end
            end
            table.sort(ids)
            return ids,seen
        end
        local function Refresh()
            local bannerIds={}
            available={}
            for id,definition in pairs(Banners) do
                if type(id)=="string" and id~="ComingSoon" and type(definition)=="table" then
                    local ids=Pool(id)
                    if #ids>0 then available[id]=true; table.insert(bannerIds,id) end
                end
            end
            table.sort(bannerIds)
            local signature=table.concat(bannerIds,"|")
            if R.BannerSignature~=signature then
                R.BannerSignature=signature
                applying=true
                bannerLabels={}; bannerDropdown:ClearAll(); bannerDropdown:AddList("--")
                local selected="--"
                for _,id in ipairs(bannerIds) do
                    local label=(display[id] or id) .. " [" .. id .. "]"
                    bannerLabels[label]=id; bannerDropdown:AddList(label)
                    if id==cfg.SummonBanner then selected=label end
                end
                bannerDropdown:SetValue(selected)
                applying=false
            end
            local ids,seen=Pool(cfg.SummonBanner)
            currentTargets=seen
            signature=tostring(cfg.SummonBanner) .. ":" .. table.concat(ids,"|")
            if R.PoolSignature~=signature then
                R.PoolSignature=signature
                applying=true
                targetLabels={}; targetDropdown:ClearAll(); targetDropdown:AddList("--")
                local selected="--"
                for _,id in ipairs(ids) do
                    local name=type(Units[id].name)=="string" and Units[id].name or id
                    local label=name .. " [" .. id .. "]"
                    targetLabels[label]=id; targetDropdown:AddList(label)
                    if id==cfg.SummonTarget then selected=label end
                end
                targetDropdown:SetValue(selected)
                applying=false
            end
        end
        local function NewRecord(pending,record)
            if type(record)~="table" or type(record.uuid)~="string"
                or type(record.unit_id)~="string" or pending.Before[record.uuid] then return end
            pending.Records[record.uuid]=record
            if record.unit_id==pending.Target then
                pending.TargetUUIDs=pending.TargetUUIDs or {}
                if not pending.TargetUUIDs[record.uuid] then
                    pending.TargetUUIDs[record.uuid]=true
                    R.TargetHits=(R.TargetHits or 0)+1
                    print("[Summon / Target] Obtained " .. record.unit_id
                        .. " UUID=" .. record.uuid .. "; continuing.")
                end
            end
        end
        local function OnAdded(record)
            if not R.Stopped and R.Pending then NewRecord(R.Pending,record) end
        end
        local function OnHatched(uuids)
            local pending=R.Pending
            if R.Stopped or not pending or type(uuids)~="table" then return end
            for _,uuid in ipairs(uuids) do
                if type(uuid)=="string" and not pending.Before[uuid] then pending.Hatched[uuid]=true end
            end
        end
        local function Bind(name,callback)
            local folder=Child(Child(RS,"endpoints"),"server_to_client")
            local remote=Child(folder,name,"RemoteEvent")
            local oldEntry=R.Events[name]
            if oldEntry and oldEntry.Remote~=remote then
                oldEntry.Connection:Disconnect(); R.Events[name]=nil
            end
            if remote and not R.Events[name] then
                R.Events[name]={Remote=remote,Connection=remote.OnClientEvent:Connect(callback)}
            end
            return remote~=nil
        end
        local function Resolve()
            local pending=R.Pending
            if not pending then return end
            local session=Collection.session
            local collection=type(session)=="table" and session.collection
            local count,resolved=0,0
            local expected=pending.Quantity or 1
            for uuid in pairs(pending.Hatched) do
                count+=1
                local record=pending.Records[uuid]
                if not record and type(collection)=="table" and type(collection.get_unit_by_uuid)=="function" then
                    record=collection:get_unit_by_uuid(uuid)
                end
                if type(record)=="table" and type(record.uuid)=="string"
                    and record.uuid==uuid and type(record.unit_id)=="string" then
                    NewRecord(pending,record)
                    resolved+=1
                end
            end
            if not pending.Returned then return end
            if count>expected then
                Disable("Unexpected hatch count; waiting for manual review before spending more.")
                return
            end
            if count==expected and resolved==expected then
                R.Pulls+=expected
                R.Pending=nil
                R.NextPull=os.clock()+1
                if cfg.SummonLimit>0 and R.Pulls>=cfg.SummonLimit then
                    Disable("Summon limit reached: " .. R.Pulls .. "/" .. cfg.SummonLimit)
                else
                    Status("Summons confirmed: " .. R.Pulls
                        .. (cfg.SummonLimit>0 and "/" .. cfg.SummonLimit or " (no limit)")
                        .. " | Target hits=" .. (R.TargetHits or 0))
                end
            elseif pending.Rejected and count==0
                and os.clock()-(pending.ReturnedAt or os.clock())>=0.5 then
                R.Pending=nil
                if expected==10 and R.Enabled then
                    -- A rejected batch did not complete. Try a single to use the remaining balance.
                    R.SingleFallback=true
                    R.NextPull=os.clock()+1
                    Status("10x rejected; switching to single pulls. Pull count is unchanged.")
                else
                    Disable("Single summon rejected. Check remaining currency/items, capacity and banner availability.")
                end
            else
                Status("Waiting for complete summon results: " .. resolved .. "/" .. expected
                    .. "; no duplicate request.")
            end
        end

        local function Snapshot()
            local session=Collection.session
            local collection=type(session)=="table" and session.collection
            local profile=type(collection)=="table" and collection.collection_profile_data
            local owned=type(profile)=="table" and profile.owned_units
            if type(owned)~="table" then return end
            local before={}
            for uuid in pairs(owned) do if type(uuid)=="string" then before[uuid]=true end end
            return before
        end
        local function Step()
            local addedReady=Bind("unit_added",OnAdded)
            local hatchReady=Bind("units_hatched_through_banner",OnHatched)
            Bind("hatch_banner_changed",function() R.PoolSignature=nil; R.NextRefresh=0 end)
            if os.clock()>=(R.NextRefresh or 0) then R.NextRefresh=os.clock()+1; Refresh() end
            Resolve()
            if R.Pending or not R.Enabled then return end
            if not addedReady or not hatchReady then
                Status("Waiting for native unit_added / units_hatched_through_banner RemoteEvents.")
                return
            end
            if Loader.IsLobby~=true then Status("Waiting for Lobby."); return end
            if not available[cfg.SummonBanner] then
                Status("Waiting for the selected banner to become available.")
                return
            end
            if cfg.SummonLimit>0 and R.Pulls>=cfg.SummonLimit then
                Disable("Summon limit reached: " .. R.Pulls .. "/" .. cfg.SummonLimit)
                return
            end
            if os.clock()<R.NextPull then return end
            local quantity=cfg.SummonQuantity
            if R.SingleFallback or (cfg.SummonLimit>0 and cfg.SummonLimit-R.Pulls<10) then
                quantity=1
            end
            local mode=quantity==10 and "gems10" or "gems"
            local before=Snapshot()
            if not before then Status("Waiting for the owned-unit collection."); return end
            local remote=Child(Child(Child(RS,"endpoints"),"client_to_server"),"buy_from_banner","RemoteFunction")
            if not remote then Status("Waiting for buy_from_banner RemoteFunction."); return end
            local pending={Banner=cfg.SummonBanner,Target=cfg.SummonTarget,Quantity=quantity,
                Before=before,Records={},Hatched={}}
            R.Pending=pending
            Status("Summoning " .. quantity .. " from " .. pending.Banner .. "...")
            local ok,result=pcall(Endpoints.invoke_server,"buy_from_banner",pending.Banner,mode)
            pending.Returned=true; pending.ReturnedAt=os.clock()
            pending.Rejected=ok and (result==nil or result==false)
            print("[Summon / Return] Banner=" .. pending.Banner .. " Quantity=" .. quantity .. " TransportOK=" .. tostring(ok)
                .. " ReturnType=" .. typeof(result) .. " Return=" .. tostring(result))
            if not ok then warn("[Summon] Uncertain response; observing before any resend: " .. tostring(result)) end
        end
        while not R.Stopped do
            local ok,err=xpcall(Step,debug.traceback)
            if not ok then
                Status("Summon error; see console. No duplicate pending request will be sent.")
                warn("[Summon] " .. tostring(err))
            end
            task.wait(ok and 0.1 or 3)
        end
    end)
end

-- Insert after AAExtra.Save is defined, before Match and April Fool blocks.
do
    local env, key = getgenv(), "__AAMacro"
    local old = env[key]
    if old and not old.Stopped and (old.Busy or (old.NativeBusy or 0) > 0 or old.Pending or old.Mode~="Idle") then
        warn("[Macro] Previous request is unresolved; stop/reconcile it first.")
        return
    end
    if old and old.Stop then old.Stop() end
    local R = {
        PlaybackEnabled = false,
        Mode = "Idle", Busy = false, NativeBusy = 0, Pending = nil,
        Stopped = false, Models = {}, Queue = {}, Serial = 0,
        Seconds = 0, LastClock = os.clock(), Index = 1,
    }
    env[key] = R
    function AAExtra.MacroBusy()
        return R.Busy
