    local function PortalInventory()
        local session = LobbyService.session
        if type(session) ~= "table" then
            return nil
        end

        local inventory = session.inventory
        if type(inventory) ~= "table" then
            return nil
        end

        local profile = inventory.inventory_profile_data
        if type(profile) ~= "table" or type(profile.unique_items) ~= "table" then
            return nil
        end

        return profile.unique_items
    end

    local function PortalRecord(uuid)
        local records = PortalInventory()
        if not records then
            return nil, false
        end

        for _, record in pairs(records) do
            if type(record) == "table" and record.uuid == uuid then
                return record, true
            end
        end

        return nil, true
    end

    local function IsUsablePortal(record)
        if type(record) ~= "table"
            or type(record.uuid) ~= "string"
            or record.uuid == ""
            or type(record.item_id) ~= "string"
        then
            return false
        end

        local definition = PortalItems[record.item_id]
        return type(definition) == "table"
            and definition.item_group == "Portals"
            and type(definition.usage) == "table"
            and definition.usage.type == "open_portal"
    end

