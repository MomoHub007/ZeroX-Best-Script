        Value = settings.LeaveWhenChallengeChanges,
        Callback = function(_, enabled)
            if not ready then
                return
            end
            settings.LeaveWhenChallengeChanges = enabled == true
            AAExtra.Save()
        end,
    })

    local resultsGui
    local TowerCore

    TryContinue = function()
        if AAExtra.MacroBusy and AAExtra.MacroBusy() then return end
        if runtime.Stopped or runtime.Busy or runtime.Sent
            or not AAExtra.StorageOK
            or settings.Mode ~= "Mansion"
            or not resultsGui or not resultsGui.Parent or not resultsGui.Enabled
        then
            return
        end

        local levelData = Loader.LevelData
        local result = runtime.Result

        if type(levelData) ~= "table"
            or levelData._gamemode ~= "infinite_tower"
            or type(result) ~= "table"
            or type(result.victory) ~= "boolean"
        then
            return
        end

        if type(TowerCore) ~= "table"
            or type(TowerCore.get_group_replay_room) ~= "function"
        then
            warn("[Lobby Extra] Mansion replay decision is unavailable.")
            return
        end

        local checked, groupRoom = pcall(
            TowerCore.get_group_replay_room,
            levelData,
            result.victory
        )
        if not checked then
            warn("[Lobby Extra] Mansion decision failed: " .. tostring(groupRoom))
            return
        end

        if runtime.Stopped or settings.Mode ~= "Mansion"
            or not resultsGui.Enabled
        then
            return
        end

        -- Reserve before sending. Never duplicate an unresolved result action.
        runtime.Sent = true
        runtime.Busy = true

        if groupRoom then
            Invoke("set_game_finished_vote", "replay")
        else
            Invoke("request_start_infinite_tower_from_game")
        end

        runtime.Busy = false
        print("[Lobby Extra] Mansion continuation requested; completion is unverified.")
    end

    task.spawn(function()
        while not runtime.Stopped do
            TryContinue()
            task.wait(1)
        end
    end)

    local function BindFinished(remote)
        if runtime.Stopped
            or runtime.FinishedRemote
            or remote.Name ~= "game_finished"
            or not remote:IsA("RemoteEvent")
        then
            return
        end

        runtime.FinishedRemote = remote

        table.insert(
            runtime.Connections,
            remote.OnClientEvent:Connect(function(result)
                if runtime.Stopped then
                    return
                end

                if type(result) ~= "table"
                    or type(result.victory) ~= "boolean"
                then
                    warn(
                        "[Lobby Extra] Unsupported game_finished result data."
                    )
                    return
                end

                if runtime.Busy then
                    warn(
                        "[Lobby Extra] Result arrived while a request was pending."
                    )
                    return
                end

                runtime.Result = result
                runtime.Sent = false
                task.defer(TryContinue)
            end)
        )

        print("[Lobby Extra] Bound " .. remote:GetFullName())
    end

    -- Subscribe before checking existing children to avoid a loading race.
    table.insert(
        runtime.Connections,
        toClient.ChildAdded:Connect(BindFinished)
    )

    local finished = toClient:FindFirstChild("game_finished")

    if finished then
        BindFinished(finished)
    end

    if not runtime.FinishedRemote then
        warn("[Lobby Extra] Waiting for game_finished RemoteEvent.")
    end

    local rotation = toClient:FindFirstChild("normal_challenge_changed")
    if rotation and rotation:IsA("RemoteEvent") then
