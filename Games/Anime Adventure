    task.spawn(function()
        local RS = game:GetService("ReplicatedStorage")
        local player = game:GetService("Players").LocalPlayer

        local function Child(parent, name, class)
            local object = parent and parent:FindFirstChild(name)

            return object
                and (not class or object:IsA(class))
                and object or nil
        end

        local src = RS:WaitForChild("src", 30)
        local module = src and src:WaitForChild("Loader", 30)

        if state.Stopped then
            return
        end

        if not module or not module:IsA("ModuleScript") then
            Status("Loader unavailable; run again when loaded.")
            return
        end

        local Loader = require(module)
        local GUI, Collection, LevelCore
        local bound = {}
        local skipOpen = false
        local skipSent = false
        local startAt
        local portalSignature

        local function Call(name, ...)
            local remote = Child(
                Child(
                    Child(RS, "endpoints"),
                    "client_to_server"
                ),
                name,
                "RemoteFunction"
            )

            if not remote then
                Status("Waiting for Remote: " .. name)
                return false
            end

            state.Busy = true

            local ok, result = pcall(
                remote.InvokeServer, remote, ...
            )

            state.Busy = false

            if not ok then
                warn("[Math] " .. name .. ": " .. tostring(result))
            end

            return true, ok, result
        end

        local function Bind(name, callback)
            local folder = Child(
                Child(RS, "endpoints"), "server_to_client"
            )

            local remote = Child(folder, name, "RemoteEvent")

            if remote and bound[name] ~= remote then
                if bound[name .. ":connection"] then
                    bound[name .. ":connection"]:Disconnect()
                end

                bound[name] = remote

                local connection =
                    remote.OnClientEvent:Connect(callback)

                bound[name .. ":connection"] = connection
                table.insert(state.Connections, connection)
            end
        end

        local function LoadServices()
            if type(GUI) ~= "table" then
                local ok, value = pcall(
