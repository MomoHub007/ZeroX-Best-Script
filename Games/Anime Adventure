        local function Bind(key, object, signalName, callback)
            local old = bindings[key]
            if old and old.Object == object then return end
            if old then old.Connection:Disconnect() end
            bindings[key] = nil

            if object then
                bindings[key] = {
                    Object = object,
                    Connection = object[signalName]:Connect(callback),
                }
            end
        end

