    local function ValidateMacro(data)
        local function finite(value)
            return type(value) == "number"
                and value == value
                and math.abs(value) < math.huge
        end

        local function text(value)
            return type(value) == "string"
                and #value > 0
                and #value <= 512
        end

        local function integer(value)
            return finite(value)
                and value >= 0
                and value % 1 == 0
        end

        local function array(value, maximum)
            if type(value) ~= "table" or #value > maximum then
                return false
            end

            local count = 0

            for key in pairs(value) do
                if not integer(key) or key < 1 or key > #value then
                    return false
                end

                count = count + 1
            end

            return count == #value
        end

        if type(data) ~= "table"
            or data.Version ~= 1
            or not array(data.Actions, 2000)
        then
            return nil, "ต้องเป็น Macro Version 1 และมีไม่เกิน 2000 รายการ"
        end

        if #data.Actions > 0
            and (not text(data.LevelId) or not text(data.Map))
        then
            return nil, "มาโครที่มีคำสั่งต้องมี LevelId และ Map"
        end

        if data.LevelId ~= nil and not text(data.LevelId)
            or data.Map ~= nil and not text(data.Map)
        then
            return nil, "LevelId หรือ Map ไม่ถูกต้อง"
        end

        local clean = {
            Version = 1,
            LevelId = data.LevelId,
            Map = data.Map,
            Actions = {},
        }

        local available = {}
        local kinds = {
            Bind = true,
            Place = true,
            Upgrade = true,
            Sell = true,
            Skill = true,
            Spell = true,
        }

        for index, action in ipairs(data.Actions) do
            local function bad(reason)
                return nil, "รายการ " .. index .. ": " .. reason
            end

            if type(action) ~= "table" or not kinds[action.Type] then
                return bad("ประเภทคำสั่งไม่รองรับ")
            end

            local when = action.When

            if type(when) ~= "table"
                or not finite(when.Time) or when.Time < 0
                or not integer(when.Wave)
                or not finite(when.WaveTime)
                or not finite(when.Money) or when.Money < 0
            then
                return bad("เงื่อนไขเวลา เวฟ หรือเงินไม่ถูกต้อง")
            end

            local copy = {
                Type = action.Type,
                When = {
                    Time = when.Time,
                    Wave = when.Wave,
                    WaveTime = when.WaveTime,
                    Money = when.Money,
                },
            }

            if action.Type == "Bind" or action.Type == "Place" then
                if not text(action.Unit)
                    or available[action.Unit]
                    or not text(action.UnitId)
                    or not array(action.CFrame, 12)
                    or #action.CFrame ~= 12
                then
                    return bad("ข้อมูลยูนิตหรือ CFrame ไม่ถูกต้อง")
                end

                for _, component in ipairs(action.CFrame) do
                    if not finite(component) then
                        return bad("CFrame ต้องเป็นตัวเลขจำกัด")
                    end
                end

                copy.Unit = action.Unit
                copy.UnitId = action.UnitId
                copy.CFrame = table.clone(action.CFrame)

                if action.Type == "Bind" then
                    if not integer(action.Tier) then
                        return bad("Tier ไม่ถูกต้อง")
                    end

                    copy.Tier = action.Tier
                else
                    if type(action.Shiny) ~= "boolean" then
                        return bad("Shiny ต้องเป็น boolean")
                    end

                    copy.Shiny = action.Shiny
                    copy.Cosmetic = action.Cosmetic
                end

                available[action.Unit] = true

            elseif action.Type == "Spell" then
                if not text(action.SpellId) then
                    return bad("ไม่มี SpellId")
                end

                if action.Target ~= nil
                    and (
                        not text(action.Target)
                        or not available[action.Target]
                    )
                then
                    return bad("Target ต้องอ้างอิงยูนิตก่อนหน้า")
                end

                copy.SpellId = action.SpellId
                copy.Target = action.Target

            else
                if not text(action.Unit) or not available[action.Unit] then
                    return bad("Unit ต้องอ้างอิงยูนิตก่อนหน้า")
                end

                copy.Unit = action.Unit

                if action.Type == "Upgrade" then
                    if not integer(action.Tier) then
                        return bad("Tier ไม่ถูกต้อง")
                    end

                    copy.Tier = action.Tier

                elseif action.Type == "Skill" then
                    if not text(action.Active) then
                        return bad("ไม่มี Active")
                    end

                    if action.TargetRule ~= nil
                        and action.TargetRule ~= "HighestHPNonBossInRange"
                    then
                        return bad("TargetRule ไม่รองรับ")
                    end

                    copy.Active = action.Active
                    copy.TargetRule = action.TargetRule

                elseif action.Type == "Sell" then
                    available[action.Unit] = nil
                end
            end

            table.insert(clean.Actions, copy)
        end

        return clean
    end

