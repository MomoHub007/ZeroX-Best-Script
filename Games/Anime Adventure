-- Auto Party: native invitations; five intended members including the leader.
do
    local env = getgenv()
    local previous = env.__AAAutoParty
    if previous and previous.Stop then previous.Stop() end

    local cfg = AAExtra.Settings
    local Players = game:GetService("Players")
    local RS = game:GetService("ReplicatedStorage")
    local Tags = game:GetService("CollectionService")
    local player = Players.LocalPlayer

    local R = {
        Stopped = false,
        Shared = previous and previous.Shared or {},
        Connections = {},
    }

    env.__AAAutoParty = R
    AAExtra.Party = R

    local tab = App:MakeTab({
        Title = "Auto Party",
        Description = "จัดปาร์ตี้ 5 คนด้วยคำเชิญและ Leader UserId",
        Icon = 123909267283672,
        Selected = false,
    })

    local section = tab:Section("Party")

    local status = section:Paragraph({
        Title = "Status",
        Description = "กำลังโหลดระบบปาร์ตี้",
    })

    section:Paragraph({
        Title = "Leader UserId ของบัญชีนี้",
        Description = tostring(player.UserId),
    })

    local roster = section:Paragraph({
        Title = "Members",
        Description = "รอข้อมูลสมาชิก",
    })

    local function Status(message)
        if R.Stopped then return end

        message = message
            .. (R.Gate and R.Gate ~= message and ("\n" .. R.Gate) or "")

        if R.Status == message then return end
        R.Status = message

        if status.self.Parent then
            status.Desc.Text = message
        end
    end

    local function Child(parent, name, class)
        local value = parent and parent:FindFirstChild(name)
        return value and (not class or value:IsA(class)) and value or nil
    end

    local function UserId(text)
        if type(text) ~= "string" or not text:match("^%d+$") then
            return nil
        end

        local id = tonumber(text)

        return id and id > 0 and id <= 9007199254740991
            and id % 1 == 0 and id or nil
    end

    local function Expected()
        local result, count = {[player.UserId] = true}, 1
        local text = cfg.PartyMembers
        if type(text) ~= "string" then return nil end

        for token in text:gmatch("[^,%s]+") do
            local id = UserId(token)
            if not id or result[id] then return nil end

            result[id], count = true, count + 1
            if count > 5 then return nil end
        end

        return result, count
    end

    local function Members()
        local result = {}
        local id = player:GetAttribute("PartyId")

        if id == nil then return {player} end

        for _, member in ipairs(Players:GetPlayers()) do
            if member:GetAttribute("PartyId") == id then
                table.insert(result, member)
            end
        end

        table.sort(result, function(a, b)
            return a.UserId < b.UserId
        end)

        return result
    end

    local function Owner()
        return player:GetAttribute("PartyId") ~= nil
            and player:GetAttribute("PartyOwnerId") == player.UserId
    end

    local function Remote(name)
        return Child(
            Child(Child(RS, "endpoints"), "client_to_server"),
            name,
            "RemoteFunction"
        )
    end

    local Loader, GUI, Lobby, Core, Levels, loaderModule

    local function Load()
        local module = Child(Child(RS, "src"), "Loader", "ModuleScript")
        if not module then return false end

        if module ~= loaderModule then
            Loader, GUI, Lobby, Core, Levels = nil, nil, nil, nil, nil
            loaderModule = module
        end

        if not Loader then
            local ok, value = pcall(require, module)

            if not ok or type(value) ~= "table" then
                Status("โหลด Loader ไม่สำเร็จ: " .. tostring(value))
                return false
            end

            Loader = value
        end

        for _, spec in ipairs({
            {"GUIService", "load_client_service", GUI},
            {"LobbyServiceClient", "load_client_service", Lobby},
            {"LobbyServiceCore", "load_core_service", Core},
            {"Levels", "load_data", Levels},
        }) do
            if type(spec[3]) ~= "table" then
                local fn = Loader[spec[2]]
                if type(fn) ~= "function" then return false end

                local ok, value = pcall(fn, module, spec[1])

                if R.Stopped then return false end

                if not ok or type(value) ~= "table" then
                    Status("รอ " .. spec[1] .. ": " .. tostring(value))
                    return false
                end

                if spec[1] == "GUIService" then
                    GUI = value
                elseif spec[1] == "LobbyServiceClient" then
                    Lobby = value
                elseif spec[1] == "LobbyServiceCore" then
                    Core = value
                else
                    Levels = value
                end
            end
        end

        return true
    end

    local function InRoom(room)
        local present = {}
        local folder = Child(room, "Players")
        if not folder then return nil end

        for _, entry in ipairs(folder:GetChildren()) do
            if entry:IsA("ObjectValue") then
                local member = entry.Value

                if member and member:IsA("Player")
                    and member.Parent == Players
                then
                    present[member.UserId] = true
                end
            end
        end

        return present
    end

    function R.CheckFormation(ownPending)
        if R.Stopped then
            return false, "ระบบปาร์ตี้กำลังเปลี่ยนรุ่น"
        end

        if not cfg.PartyEnabled then return true end

        if (R.Shared.Pending and R.Shared.Pending ~= ownPending)
            or R.Shared.Delete
        then
            return false, "รอคำสั่งปาร์ตี้เดิมยืนยัน"
        end

        if cfg.PartyRole ~= "Leader" then
            return false, "สมาชิกให้หัวหน้าเป็นผู้เริ่มด่าน"
        end

        local expected, targetCount = Expected()

        if not expected then
            return false, "เลือกสมาชิกไม่เกิน 4 คน และไม่ซ้ำกับตัวเอง"
        end

        local solo = targetCount == 1
            and player:GetAttribute("PartyId") == nil

        if not solo and not Owner() then
            return false, "รอยืนยันว่าบัญชีนี้เป็นหัวหน้าปาร์ตี้"
        end

        local members = Members()

        if #members > targetCount then
            return false, "สมาชิกปาร์ตี้มากกว่าที่เลือก ไม่เริ่มด่านอัตโนมัติ"
        end

        if #members < targetCount then
            return false,
                "รอสมาชิกปาร์ตี้: " .. #members .. "/" .. targetCount
        end

        for _, member in ipairs(members) do
            if not expected[member.UserId]
                or (
                    not solo
                    and member:GetAttribute("PartyOwnerId") ~= player.UserId
                )
            then
                return false, "สมาชิกหรือหัวหน้าปาร์ตี้ไม่ตรงกับที่ตั้งค่า"
            end
        end

        return true
    end

    function R.CheckEntry(joinBy)
        if not cfg.PartyEnabled then return true end

        if joinBy == "Mansion" then
            return false,
                "Infinity Mansion ยังไม่มี Contract สำหรับปาร์ตี้ 5 คน จึงพักการเข้าด่าน"
        end

        if joinBy == "Matching" or joinBy == "Matchmaking" then
            return false,
                "Auto Party ใช้ Join By = Normal; รอเปลี่ยนวิธีเข้าด่าน"
        end

        return R.CheckFormation()
    end

    function R.WaitEntry(current, readJoinBy)
        while not R.Stopped and current() do
            local ready, reason = R.CheckEntry(readJoinBy())

            if ready then
                R.Gate = nil
                return true
            end

            R.Report(reason)
            task.wait(0.5)
        end

        R.Gate = nil
        return false
    end

    function R.CheckStart(room, ownPending)
        if R.Stopped then
            return false, "ระบบปาร์ตี้กำลังเปลี่ยนรุ่น"
        end

        if R.Shared.Pending and R.Shared.Pending ~= ownPending
            and R.Shared.Pending.Kind == "Start"
        then
            return false, "รอผล Start เดิม ไม่ส่งซ้ำ"
        end

        if not cfg.PartyEnabled then return true end

        if not cfg.PartyAutoStart then
            return false, "รอเปิด Auto Start Party"
        end

        if not Loader or Loader.IsLobby ~= true
            or Child(Child(RS, "src"), "Loader", "ModuleScript") ~= loaderModule
        then
            return false, "รอข้อมูล Lobby ปัจจุบัน"
        end

        if R.Shared.Pending and R.Shared.Pending ~= ownPending then
            return false, "รอคำสั่งปาร์ตี้เดิมยืนยัน"
        end

        local ready, reason = R.CheckFormation(ownPending)
        if not ready then return false, reason end

        local expected, targetCount = Expected()

        if typeof(room) ~= "Instance" or not room:IsA("Model")
            or not room.Parent
            or not Lobby or Lobby.current_lobby_model ~= room
            or Lobby.current_lobby ~= room.Name
        then
            return false, "รอห้องด่านปัจจุบันของหัวหน้า"
        end

        local owner = Child(room, "Owner", "ObjectValue")

        if not owner or owner.Value ~= player then
            return false, "ห้องด่านนี้ยังไม่ยืนยันเจ้าของเป็นหัวหน้าปาร์ตี้"
        end

        if not Core or type(Core.get_max_players) ~= "function" then
            return false, "รอข้อมูลความจุของด่าน"
        end

        local daily = Tags:HasTag(room, "_daily_challenge_lobby_models")
        local mode = "challenge"

        if not daily then
            local level = Child(room, "Level", "StringValue")
            local definition = level and Levels and Levels[level.Value]

            if type(definition) ~= "table"
                or type(Core.get_gamemode) ~= "function"
            then
                return false, "รอข้อมูลความจุของด่าน"
            end

            local ok, value = pcall(Core.get_gamemode, room, definition)

            if not ok then
                return false, "get_gamemode: " .. tostring(value)
            end

            mode = value
        end

        local checked, capacity = pcall(Core.get_max_players, mode, daily)

        if not checked or type(capacity) ~= "number" then
            return false, "ยังยืนยันความจุด่านไม่ได้"
        end

        if capacity < targetCount then
            return false, "ด่านนี้รองรับเพียง " .. capacity .. " คน"
        end

        local present = InRoom(room)
        if not present then return false, "รอรายชื่อในห้องด่าน" end

        local count = 0

        for id in pairs(present) do
            if not expected[id] then
                return false, "มีผู้เล่นนอกกลุ่มในห้องด่าน"
            end
            count = count + 1
        end

        if count ~= targetCount then
            return false,
                "รอสมาชิกเข้าห้องด่าน: " .. count .. "/" .. targetCount
        end

        return true
    end

    function R.WaitStart(room, current)
        while not R.Stopped and current() do
            local ready, reason = R.CheckStart(room)

            if ready then
                R.Gate = nil
                return true
            end

            R.Report(reason)
            task.wait(0.5)
        end

        return false
    end

    function R.Report(message)
        R.Gate = message
        Status(message)
    end

    function R.Stop()
        R.Stopped = true

        for _, connection in ipairs(R.Connections) do
            connection:Disconnect()
        end

        table.clear(R.Connections)
    end

    table.insert(R.Connections, status.self.Destroying:Connect(R.Stop))

    local function Save()
        if AAExtra.StorageOK then
            local ok, reason = AAExtra.Save()

            if not ok then
                Status("บันทึกไม่สำเร็จ: " .. tostring(reason))
            end
        end
    end

    local ready = false

    section:Toggle({
        Title = "Auto Party",
        Description = "หัวหน้าเชิญ 4 คนที่กำหนด สมาชิกตอบรับเฉพาะ Leader UserId",
        Value = cfg.PartyEnabled,
        Callback = function(_, value)
            if not ready or R.Stopped then return end

            cfg.PartyEnabled = value == true

            if not cfg.PartyEnabled then
                R.Shared.Plan, R.Shared.Delete = nil, nil
            end

            Save()
        end,
    })

    section:Dropdown({
        Title = "Party Role",
        Description = "เลือก Leader สำหรับหัวหน้า หรือ Member สำหรับสมาชิก",
        Value = cfg.PartyRole,
        List = {"Leader", "Member"},
        Callback = function(_, value)
            if not ready or R.Stopped then return end
            if value ~= "Leader" and value ~= "Member" then return end

            cfg.PartyRole = value
            R.Shared.Plan = nil
            Save()
        end,
    })

    local leaderDropdown, membersDropdown
    local playerIds, playerLabels = {}, {}
    local applyingPlayers, refreshQueued = false, false
    local departingPlayers = setmetatable({}, {__mode = "k"})

    local function SelectedMemberIds()
        local ids = {}

        if type(cfg.PartyMembers) == "string" then
            for token in cfg.PartyMembers:gmatch("[^,%s]+") do
                local id = UserId(token)

                if id and id ~= player.UserId then
                    ids[id] = true
                end
            end
        end

        return ids
    end

    local function RestoreMemberSelection()
        local selected = {}

        for id in pairs(SelectedMemberIds()) do
            if playerLabels[id] then
                table.insert(selected, playerLabels[id])
            end
        end

        table.sort(selected)
        membersDropdown:SetValue(selected)
    end

    local function RefreshPlayers()
        refreshQueued = false
        if R.Stopped then return end

        local ids, labels, list = {}, {}, {}

        for _, member in ipairs(Players:GetPlayers()) do
            if member ~= player and not departingPlayers[member] then
                local label = member.Name .. " [" .. member.UserId .. "]"

                ids[label] = member.UserId
                labels[member.UserId] = label
                table.insert(list, label)
            end
        end

        -- เก็บรายชื่อที่เลือกไว้ แม้ผู้เล่นออกจากเซิร์ฟเวอร์
        local retained = SelectedMemberIds()
        local leaderId = UserId(cfg.PartyLeaderId)

        if leaderId and leaderId ~= player.UserId then
            retained[leaderId] = true
        end

        for id in pairs(retained) do
            if not labels[id] then
                local label = "[" .. id .. "] (ไม่อยู่ในเซิร์ฟเวอร์)"

                ids[label] = id
                labels[id] = label
                table.insert(list, label)
            end
        end

        table.sort(list)
        playerIds, playerLabels = ids, labels

        applyingPlayers = true

        leaderDropdown:ClearAll()
        membersDropdown:ClearAll()
        leaderDropdown:AddList("--")

        for _, label in ipairs(list) do
            leaderDropdown:AddList(label)
            membersDropdown:AddList(label)
        end

        leaderDropdown:SetValue(labels[leaderId] or "--")
        RestoreMemberSelection()

        applyingPlayers = false
    end

    local function SchedulePlayerRefresh()
        if R.Stopped or refreshQueued then return end
        refreshQueued = true
        task.defer(RefreshPlayers)
    end

    leaderDropdown = section:Dropdown({
        Title = "Leader",
        Description = "สมาชิกเลือกหัวหน้าจากผู้เล่นในเซิร์ฟเวอร์",
        Value = "--",
        List = {"--"},
        Callback = function(_, value)
            if not ready or R.Stopped or applyingPlayers then return end
            if value ~= "--" and not playerIds[value] then return end

            local id = playerIds[value]
            cfg.PartyLeaderId = id and tostring(id) or ""

            Save()
            SchedulePlayerRefresh()
        end,
    })

    membersDropdown = section:Dropdown({
        Title = "Party Members",
        Description = "หัวหน้าเลือกสมาชิกได้ 0–4 คน รวมตัวเองสูงสุด 5 คน",
        Value = {},
        List = {},
        Callback = function(_, values)
            if not ready or R.Stopped or applyingPlayers then return end
