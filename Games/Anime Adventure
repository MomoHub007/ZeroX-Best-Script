                if Load() and IsSummer() then
                    local folder = Child(
                        Child(workspace, "_DATA"),
                        "Roguelike",
                        "Folder"
                    )

                    local waiting = Child(
                        folder,
                        "WaitingForRoguelikeChoice",
                        "BoolValue"
                    )

                    local endpoints = Child(RS, "endpoints")
                    local signals = Child(
                        endpoints,
                        "server_to_client"
                    )

                    local options = Child(
                        signals,
                        "show_roguelike_options",
                        "RemoteEvent"
                    )

                    local result = Child(
                        signals,
                        "show_roguelike_vote_result",
                        "RemoteEvent"
                    )

                    local remote = Remote(
                        "select_roguelike_option"
                    )

                    local gui = Child(
                        player,
                        "PlayerGui",
                        "PlayerGui"
                    )

                    local screen = Child(
                        gui,
                        "CardSelectRoguelike",
                        "ScreenGui"
                    )

                    if boundWaiting ~= waiting then
                        Disconnect("Waiting")
                        boundWaiting = waiting
                        currentRound = nil

                        if waiting then
                            connections.Waiting =
                                waiting.Changed:Connect(function(open)
                                    if R.Stopped then return end

                                    if not open then
                                        currentRound = nil

                                        if R.SummerCardSentWaiting == waiting then
                                            R.SummerCardSentWaiting = nil
                                        end
                                    end
                                end)
                        end
                    end

                    if boundOptions ~= options then
                        Disconnect("Options")
                        boundOptions = options
                        currentRound = nil

                        if options then
                            connections.Options =
                                options.OnClientEvent:Connect(OnOptions)
                        end
                    end

                    if boundResult ~= result then
                        Disconnect("Result")
                        boundResult = result

                        if result then
                            connections.Result =
                                result.OnClientEvent:Connect(function()
                                    if not R.Stopped then
                                        currentRound = nil
                                    end
                                end)
                        end
                    end

                    if waiting and not waiting.Value
                        and R.SummerCardSentWaiting == waiting
                    then
                        R.SummerCardSentWaiting = nil
                    end

                    local round = currentRound

                    if round
                        and os.clock() >= round.Deadline
                    then
                        currentRound = nil
                        round = nil
                    end

                    if cfg.SummerAutoCards == true
                        and round
                        and round.Source == options
                        and waiting
                        and waiting.Value
                        and screen
                        and screen.Enabled
                        and remote
                        and result
                        and R.SummerCardSentWaiting ~= waiting
                    then
                        local best = ChooseBest(
                            round.Options,
                            folder
                        )

                        if best
                            and not R.Stopped
                            and cfg.SummerAutoCards == true
                            and currentRound == round
                            and IsSummer()
                            and waiting.Parent == folder
                            and waiting.Value
                            and screen.Enabled
                            and os.clock() < round.Deadline
                        then
                            R.SummerCardSentWaiting = waiting

                            CardStatus(
                                "Voting: " .. best.Title
                            )

                            task.spawn(function()
                                local ok, response = pcall(
                                    remote.InvokeServer,
                                    remote,
                                    best.Slot
                                )

                                if R.Stopped then return end

                                if not ok then
                                    warn(
                                        "[Summer Cards / Vote] "
                                        .. tostring(response)
                                    )
                                else
                                    CardStatus(
                                        "Vote submitted: " .. best.Title
                                    )
                                end
                            end)
                        end
                    end
                else
                    Clear()
                end

                task.wait(0.3)
            end

            Clear()
        end)
    end

    local function UpdateLists()
        local pool = Order and Order.SUMMER2_HUNT_MAPS
        if type(pool) ~= "table" then
            Status("รอทะเบียนแมพ Summer")
            return false
        end

        local mapList, mapSet = {}, {}
        for _, id in ipairs(pool) do
            if type(id) ~= "string" then
                Status("รูปแบบทะเบียนแมพไม่ตรงกับข้อมูลที่ตรวจไว้")
                return false
            end
            if not mapSet[id] then
                mapSet[id] = true
                table.insert(mapList, id)
            end
        end
        if #mapList == 0 then return false end
        table.sort(mapList)

        local weatherList, ids, labels = {}, {}, {}
        for id, definition in pairs(Weather) do
            if type(id) == "string"
                and type(definition) == "table"
                and type(definition.name) == "string"
            then
                local name = definition.name .. " [" .. id .. "]"
                table.insert(weatherList, name)
                ids[name] = id
                labels[id] = name
            end
        end
        table.sort(weatherList)
        if #weatherList == 0 then return false end

        local signature = table.concat(mapList, "|")
            .. "\n" .. table.concat(weatherList, "|")

        if signature ~= R.ListSignature then
            R.Applying = true
            maps:ClearAll()
            weather:ClearAll()

            for _, id in ipairs(mapList) do maps:AddList(id) end
            for _, name in ipairs(weatherList) do weather:AddList(name) end
            weatherIds = ids

            local selectedMaps, selectedWeather = {}, {}
            for _, id in ipairs(cfg.SummerSkipMaps) do
                if mapSet[id] then table.insert(selectedMaps, id) end
            end
            for _, id in ipairs(cfg.SummerSkipWeather) do
                if labels[id] then
                    table.insert(selectedWeather, labels[id])
                end
            end

            maps:SetValue(selectedMaps)
            weather:SetValue(selectedWeather)
            R.Applying = false
            R.ListSignature = signature
        end

        return true
    end

    local function Snapshot()
        local all = Challenge and Challenge._CURRENT_EVENT_CHALLENGES
        local event = type(all) == "table" and all.summer2_event
        local level = type(event) == "table" and event.current_level_data

        if type(level) ~= "table"
            or level.id ~= "summer2_event"
            or type(level.map) ~= "string"
            or type(event.current_weather) ~= "string"
            or type(Weather[event.current_weather]) ~= "table"
        then
            return
        end

        return event, level.map, event.current_weather
    end

    local function Skipped(map, weatherId)
        return table.find(cfg.SummerSkipMaps, map) ~= nil
            or table.find(cfg.SummerSkipWeather, weatherId) ~= nil
    end

    local function Release(op, state)
        if state.Operation == op then
            state.Operation = nil
            state.Busy = false
        end
        if R.Operation == op then R.Operation = nil end
    end

    local function NormalStep(op, state, inLobby)
        if R.Stopped or state.Disposed or state.Operation ~= op then
            return
        end
        if not Lobby then
            Status("รอ LobbyServiceClient")
            return
        end

        local room = Lobby.current_lobby_model
        local name = Lobby.current_lobby
        local io = op.IO

        -- ทำ Native cleanup หลัง Leave ได้ผลตอบกลับเป็น truthy เท่านั้น
        if io and io.Kind == "LeavePortal" then
            if not io.TransportOK or not io.Result then
                Status("ยังยืนยันการออกจาก Portal ไม่ได้ ไม่ส่งซ้ำ")
                return
            end

            if room == op.Room and name == op.RoomName then
                if op.CleanupAttempted then
                    Status("รอตรวจผล cleanup ของ Portal เดิม")
                    return
                end
                if type(Lobby.cancel_selections) ~= "function" then
                    Status("รอ cancel_selections ของเกม")
                    return
                end

                op.CleanupAttempted = true
                local ok, err = pcall(Lobby.cancel_selections)
                if not ok then
                    Status("cleanup Portal ไม่สำเร็จ: " .. tostring(err))
                    return
                end
            end

            if R.Stopped or state.Disposed or state.Operation ~= op then
                return
            end

            if Lobby.current_lobby == nil
                and Lobby.current_lobby_model == nil
                and inLobby.Value == false
            then
                Release(op, state)
                Status("ยืนยันการออกจาก Portal แล้ว")
            else
                Status("รอแคชห้องและ AlreadyInLobby ยืนยันการออก")
            end
            return
        end

        -- รับห้องจากแคชที่ Native endpoint ของเกมเป็นผู้ตั้งค่า
        if not op.Room then
            local lobbies = Child(Child(workspace, "_PORTALS"), "Lobbies")

            if not lobbies
                or typeof(room) ~= "Instance"
                or not room:IsA("Model")
                or not room:IsDescendantOf(lobbies)
                or type(name) ~= "string"
                or room.Name ~= name
                or not inLobby.Value
            then
                Status("รอห้อง Portal ที่ Native Client ได้รับ ไม่ส่ง Open ซ้ำ")
                return
            end

            op.Room = room
            op.RoomName = name
        end

        if room ~= op.Room or name ~= op.RoomName then
            Status("อ้างอิง Portal เปลี่ยน รอยืนยันผลเดิม ไม่เปิดห้องซ้ำ")
            return
        end
        if not room.Parent or not inLobby.Value then
            Status("รอสถานะ Portal เดิมให้ชัดเจน")
            return
        end

        local _, map, weatherId = Snapshot()
        local cancel = cfg.SummerAutoJoin ~= true
            or (map ~= nil and Skipped(map, weatherId))
        local kind = cancel and "LeavePortal" or "StartPortal"

        if io and io.Kind == kind then
            Status(cancel and "รอผลออกจาก Portal"
                or ((not io.TransportOK or io.Result == false)
                    and "Start มีข้อผิดพลาดหรือถูกปฏิเสธ ไม่ส่งซ้ำ"
                    or "ส่ง Start แล้ว รอการนับถอยหลังหรือเทเลพอร์ต"))
            return
        end

        local remote = Remote(
            cancel and "request_leave_lobby" or "request_start_game"
        )
        if not remote then
            Status("รอ Remote " .. kind)
            return
        end

        if R.Stopped or state.Disposed or state.Operation ~= op
            or Lobby.current_lobby_model ~= room
            or Lobby.current_lobby ~= name
            or not inLobby.Value
        then
            return
        end

        local lock = Child(player, "TeleportingLock", "NumberValue")
        if not lock or lock.Value > 0 then return end
        if not cancel and cfg.SummerAutoJoin ~= true then return end

        if not cancel and AAExtra.Party then
            local allowed, reason = AAExtra.Party.CheckStart(room)

            if not allowed then
                AAExtra.Party.Report(reason)
                Status(reason)
                return
            end
        end

        io = {Kind = kind, Returned = false}
        op.IO = io

        Status(cancel
            and "ขอออกจาก Portal แล้ว"
            or "ส่ง Start ของ Summer แล้ว")

        local ok, result = pcall(remote.InvokeServer, remote, name)
        io.TransportOK, io.Result, io.Returned = ok, result, true

        if not ok then
            warn("[Summer / " .. kind .. "] " .. tostring(result))
        end
    end

    local function Step()
        local state = env["__AnimeAdventureLobbyAutoJoin"]
        local op = R.Operation
        local loaded = Load()
        if loaded then UpdateLists() end

        if op then
            if not state or state.Disposed or state.Operation ~= op then
                Status("รอคืนเจ้าของคิวร่วม ยังไม่ส่งคำสั่งซ้ำ")
                return
            end

            local io = op.IO
            if io and not io.Returned then
                Status("รอผลคำสั่ง Summer เดิม")
                return
            end

            local inLobby, teleport = Actor()
            if not inLobby or not teleport then
                Status("รอสถานะผู้เล่น")
                return
            end

            if teleport.Value > 0 or op.Teleporting then
                op.Teleporting = true
                Status("ตรวจพบการเทเลพอร์ต รอเปลี่ยนฉาก")
                return
            end

            if op.JoinBy == "Normal" then
                NormalStep(op, state, inLobby)
                return
            end

            local gui = Queue()
            if not gui or gui ~= op.QueueGui or not gui.Parent then
                Status("รอหน้าคิวเดิม ไม่ส่ง Join ซ้ำ")
                return
            end
            if gui.Enabled then op.QueueConfirmed = true end

            if io and io.Kind == "Leave" then
                if not gui.Enabled and inLobby.Value == false then
                    Release(op, state)
                    Status("ยืนยันว่าคิวปิดและผู้เล่นไม่ได้อยู่ในล็อบบี้แล้ว")
                else
                    Status("รอยืนยันการออกจากคิว ไม่ส่งคำสั่งซ้ำ")
                end
                return
            end

            local _, map, weatherId = Snapshot()
            local cancel = cfg.SummerAutoJoin ~= true
                or (map ~= nil and Skipped(map, weatherId))

            if cancel and op.QueueConfirmed and gui.Enabled then
                local remote = Remote("leave_matchmaking")
                if not remote then
                    Status("รอ leave_matchmaking")
                    return
                end

                io = {Kind = "Leave", Returned = false}
                op.IO = io
                Status("ขอออกจากคิว Summer แล้ว")

                local ok, result = pcall(remote.InvokeServer, remote)
                io.TransportOK, io.Result, io.Returned = ok, result, true
                if not ok then
                    warn("[Summer / Leave] " .. tostring(result))
                end
                return
            end

            Status(op.QueueConfirmed
                and (gui.Enabled
                    and "อยู่ในคิว Summer"
                    or "คิวปิดแล้ว รอผลจับคู่หรือเทเลพอร์ต")
                or "ยังยืนยันการเข้าคิวไม่ได้ กำลังติดตามผล")
            return
        end

        if R.Market and R.Market.Pending then
            Status("รอคำสั่งซื้อหรือเปิด Sunny Star ยืนยันก่อนเข้าด่าน")
            return
        end

        if not loaded or not R.ListSignature then return end

        if game.PlaceId ~= 8304191830 then
            Status("Auto Join รออยู่หน้า Lobby")
            return
        end

        local event, map, weatherId = Snapshot()
        if not event then
            Status("รอ Forecast ปัจจุบันของ Summer")
            return
        end
        forecast.Desc.Text = map .. " / " .. Weather[weatherId].name

        if cfg.SummerAutoJoin ~= true then
            Status("ปิด Auto Join Summer")
            return
        end
        if Skipped(map, weatherId) then
            Status("ข้ามแมพหรืออากาศปัจจุบัน รอข้อมูลกิจกรรมเปลี่ยน")
            return
        end

        if not state or state.Disposed or state.Busy or state.Operation
            or cfg.Mode ~= ""
            or (AAExtra.MacroBusy and AAExtra.MacroBusy())
        then
            Status("รอระบบเข้าห้องหรือ Macro เดิม")
            return
        end

        local gui = Queue()
        local inLobby, teleport = Actor()
        if not gui or not inLobby or not teleport then
            Status("รอข้อมูลคิวของเกม")
            return
        end
        if gui.Enabled or inLobby.Value or teleport.Value > 0 then
            Status("มีคิว ห้อง หรือการเทเลพอร์ตอยู่แล้ว")
            return
        end

        local joinBy = cfg.SummerJoinBy
        if joinBy ~= "Normal" and joinBy ~= "Matching" then
            Status("กรุณาเลือก Auto Join By")
            return
        end

        if joinBy == "Normal" and (not Lobby
            or Lobby.current_lobby ~= nil
            or Lobby.current_lobby_model ~= nil)
        then
            Status("รอห้องเดิมของ Native Client สิ้นสุด")
            return
        end

        if AAExtra.Party then
            local allowed, reason = AAExtra.Party.CheckEntry(joinBy)

            if not allowed then
                AAExtra.Party.Report(reason)
                Status(reason)
                return
            end
        end

        local endpoint = joinBy == "Normal"
            and "open_event_portal" or "request_matchmaking"

        local remote = Remote(endpoint)
        if not remote then
            Status("รอ " .. endpoint)
            return
        end

        local current, currentMap, currentWeather = Snapshot()
        if R.Stopped or cfg.SummerAutoJoin ~= true
            or cfg.SummerJoinBy ~= joinBy
            or current ~= event
            or currentMap ~= map
            or currentWeather ~= weatherId
            or Skipped(currentMap, currentWeather)
        then
            return
        end

        op = {
            Mode = "Summer",
            JoinBy = joinBy,
            QueueGui = gui,
            Map = map,
            Weather = weatherId,
            IO = {
                Kind = joinBy == "Normal" and "OpenPortal" or "Join",
                Returned = false,
            },
        }

        state.Operation, state.Busy, R.Operation = op, true, op
        Status("ส่งคำสั่ง Summer แบบ " .. joinBy .. " แล้ว")

        local io = op.IO
        local ok, result

        if joinBy == "Normal" then
            ok, result = pcall(
                remote.InvokeServer,
                remote,
                "summer2_event",
                {difficulty = "Hard"}
            )
        else
            ok, result = pcall(
                remote.InvokeServer,
                remote,
                "summer2_event"
            )
        end

        io.TransportOK, io.Result, io.Returned = ok, result, true

        if not ok then
            warn("[Summer / " .. joinBy .. "] " .. tostring(result))
        end
    end

