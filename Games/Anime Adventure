                    module,
                    "LevelServiceCore"
                )

                if ok then
                    LevelCore = value
                end
            end
        end

        local function Portals()
            local valid = {}

            local session = type(Collection) == "table"
                and Collection.session

            local inventory = type(session) == "table"
                and session.inventory

            local profile = inventory
                and inventory.inventory_profile_data

            local items = type(profile) == "table"
