    task.spawn(function()
        local RS=game:GetService("ReplicatedStorage")
        local CS=game:GetService("CollectionService")
        local player=game:GetService("Players").LocalPlayer
        local src=RS:WaitForChild("src",30)
        local module=src and src:WaitForChild("Loader",30)
        if not module or not module:IsA("ModuleScript") then Status("Loader is unavailable."); return end
        local Loader=require(module)
        local Endpoints,Collection,Core,Units,Spells
        while not R.Stopped do
            local ok,err=pcall(function()
                Endpoints=Loader.load_client_service(module,"EndpointsClient")
                Collection=Loader.load_client_service(module,"UnitCollectionServiceClient")
                Core=Loader.load_core_service(module,"UnitServiceCore")
                Units=Loader.load_data(module,"Units")
                Spells=Loader.load_data(module,"IngameSpells")
                assert(type(Endpoints)=="table" and type(Endpoints.invoke_server)=="function")
                assert(type(Collection)=="table" and type(Core)=="table" and type(Core.get_ground)=="function")
                assert(type(Units)=="table" and type(Spells)=="table")
            end)
            if ok then break end
            Status("Waiting for Macro dependencies: " .. tostring(err))
            task.wait(3)
        end
        if R.Stopped then return end
        local tag="player_units:" .. player.UserId
        local function Owned(m)
            return typeof(m)=="Instance" and m:IsA("Model")
                and m.Parent==Child(workspace,"_UNITS") and CS:HasTag(m,tag)
        end
        local function Models()
            local list={}
            for _,m in ipairs(CS:GetTagged(tag)) do if Owned(m) then table.insert(list,m) end end
            return list
        end
        local function Scene()
            local level=Loader.LevelData
            local map=Child(workspace,"_MAP_CONFIG")
            local loaded=Child(map,"MapLoaded","BoolValue")
            local lobby=Child(map,"IsLobby","BoolValue")
            return loaded and loaded.Value and lobby and not lobby.Value
                and type(level)=="table" and type(level.id)=="string"
                and type(level.map)=="string" and level or nil
        end
        local function State()
            local data=Child(workspace,"_DATA")
            local started=Child(data,"GameStarted","BoolValue")
            local freeze=Child(data,"GlobalFreeze","BoolValue")
            local finished=Child(data,"GameFinished","BoolValue")
            return started and started.Value,freeze and freeze.Value,finished and finished.Value
        end
        local function Clock()
            local now=os.clock()
            local started,freeze=State()
            if started and not freeze then R.Seconds=R.Seconds+now-R.LastClock end
            R.LastClock=now
        end
        local function Wallet() return Num(Child(player,"_stats"),"resource") end
        local function Conditions()
            Clock()
            return {Time=R.Seconds,Wave=Num(workspace,"_wave_num") or 0,
                WaveTime=Num(workspace,"_wave_time") or 0,Money=Wallet() or 0}
        end
        local function Roster()
            local session=Collection.session
            local result={}
            if type(session)~="table" or type(session.collection)~="table" then return result end
            local collection=session.collection
            if type(session.override_equipped_units)=="table" and type(collection.temporary_units)=="table" then
                for _,uuid in pairs(session.override_equipped_units) do
                    local record=collection.temporary_units[uuid]
                    if type(uuid)=="string" and type(record)=="table" then result[uuid]=record end
                end
            else
                local profile=collection.collection_profile_data
                local owned=type(profile)=="table" and profile.owned_units
                for uuid,record in pairs(type(owned)=="table" and owned or {}) do
                    if type(uuid)=="string" and type(record)=="table" and tonumber(record.equipped_slot) and tonumber(record.equipped_slot)>0 then
                        result[uuid]=record
                    end
                end
            end
            return result
        end
        local function Id(m)
            local v=Child(Child(m,"_stats"),"id","StringValue")
            return v and v.Value
        end
        local function Frame(cf) return {cf:GetComponents()} end
        local function Near(m,cf)
            return (Core.get_ground(m)-cf.Position).Magnitude<=0.2
        end
        local function FindPlacement(action,uuid,before)
            local found
            local cf=CFrame.new(table.unpack(action.CFrame))
            for _,m in ipairs(Models()) do
                local stats=Child(m,"_stats")
                local u=Child(stats,"uuid","StringValue")
                if Id(m)==action.UnitId and u and u.Value==uuid and not before[m] and Near(m,cf) then
                    if found then return nil end
                    found=m
                end
            end
            return found
        end
        local function NextId()
            R.Serial=R.Serial+1
            return "unit_" .. R.Serial
        end
        local function Reference(m)
            assert(Owned(m),"Action target is not an owned placed unit.")
            for id,model in pairs(R.Models) do if model==m then return id end end
            -- Reconcile a placement before a fast following manual action.
            for _,item in ipairs(R.Queue) do
                if item.Action.Type=="Place" and FindPlacement(item.Action,item.UUID,item.Before)==m then
                    R.Models[item.Action.Unit]=m
                    return item.Action.Unit
                end
            end
            local id=NextId()
            local action={Type="Bind",Unit=id,UnitId=Id(m),
                CFrame=Frame(CFrame.new(Core.get_ground(m))),
                Tier=Num(Child(m,"_stats"),"upgrade") or 0,When=Conditions()}
            table.insert(R.Queue,{Action=action,Done=true})
            R.Models[id]=m
            return id
        end
        local endpoints={spawn_unit="Place",upgrade_unit_ingame="Upgrade",
            sell_unit_ingame="Sell",use_active_attack="Skill",use_ingame_spell="Spell"}
        local function Capture(endpoint,args)
            local kind=endpoints[endpoint]
            if not kind then return nil end
            assert(#R.Queue<2000,"Recording action limit reached (2000).")
            local when=Conditions()
            local action={Type=kind,When=when}
            local item={Action=action}
            if kind=="Spell" then
                local session=Collection.session
                local slots=type(session)=="table" and session.ingame_spells
                assert(type(args[1])=="string" and type(slots)=="table","Spell slot state missing.")
                local spellId=slots[args[1]]
                local def=Spells[spellId]
                assert(type(spellId)=="string" and type(def)=="table" and type(def.apply)=="table","Unknown spell.")
                for _, prior in ipairs(R.Queue) do
                    if not prior.Done and prior.Action.Type=="Spell"
                        and prior.Slot==args[1] and prior.Action.SpellId==spellId then return nil end
                end
                action.SpellId=spellId
                item.Slot=args[1]
                if def.apply._t=="select_single_unit" then action.Target=Reference(args[2])
                else assert(def.apply._t=="instant","Unsupported spell application.") end
            elseif kind=="Place" then
                assert(type(args[1])=="string" and typeof(args[2])=="CFrame","Invalid placement arguments.")
                local record=Roster()[args[1]]
                assert(record and type(record.unit_id)=="string","Placement UUID not in current equipped roster.")
                action.Unit=NextId(); action.UnitId=record.unit_id
                action.Shiny=record.shiny==true
                action.Cosmetic=type(record.further_modifiers)=="table" and record.further_modifiers.cosmetic or nil
                action.CFrame=Frame(args[2]); item.UUID=args[1]; item.Before={}
                for _,m in ipairs(Models()) do item.Before[m]=true end
            else
                local m=args[1]
                action.Unit=Reference(m); item.Model=m
                local stats=Child(m,"_stats")
                if kind=="Upgrade" then
                    item.BeforeTier=assert(Num(stats,"upgrade"),"Upgrade tier missing.")
                    action.Tier=item.BeforeTier+1
                elseif kind=="Skill" then
                    item.BeforeCast=assert(Num(stats,"last_active_cast"),"Skill cast state missing.")
                    for _, prior in ipairs(R.Queue) do
                        if not prior.Done and prior.Action.Type=="Skill"
                            and prior.Model==m and prior.BeforeCast==item.BeforeCast then return nil end
                    end
                    local active=Child(stats,"active_attack","StringValue")
                    action.Active=active and active.Value
                    if args[2]~=nil then
                        assert(type(args[2])=="table" and typeof(args[2].death_note_active_target)=="Instance",
                            "Unsupported custom skill payload.")
                        for field in pairs(args[2]) do assert(field=="death_note_active_target","Unsupported custom skill field.") end
                        action.TargetRule="HighestHPNonBossInRange"
                    end
                end
            end
            table.insert(R.Queue,item)
            Status("Recording: " .. #R.Queue .. " actions")
            return item
        end
        local function Observe(item)
            local action=item.Action
            if action.Type=="Spell" then
                local session=Collection.session
                local slots=type(session)=="table" and session.ingame_spells
                return type(slots)=="table" and slots[item.Slot]~=action.SpellId
            elseif action.Type=="Place" then
                local m=FindPlacement(action,item.UUID,item.Before)
                if m then R.Models[action.Unit]=m; return true end
            elseif action.Type=="Sell" then return not Owned(item.Model)
            elseif action.Type=="Upgrade" then
                local tier=Num(Child(item.Model,"_stats"),"upgrade")
                return tier and tier>=action.Tier
            elseif action.Type=="Skill" then
                local cast=Num(Child(item.Model,"_stats"),"last_active_cast")
                return cast and cast>item.BeforeCast
            end
            return false
        end
        R.ObserveRecorded = Observe
        R.Endpoints=Endpoints; R.Original=Endpoints.invoke_server
        R.Wrapper=function(endpoint,...)
            local args=table.pack(...)
            local item
            if not R.Stopped and R.Mode=="Record" then
                local ok,value=pcall(Capture,endpoint,args)
                if ok then item=value else
                    R.Mode="FinishRecord"; Status("Recorder paused: " .. tostring(value))
                end
            end
            R.NativeBusy=R.NativeBusy+1
            local result=table.pack(pcall(R.Original,endpoint,table.unpack(args,1,args.n)))
            R.NativeBusy=R.NativeBusy-1
            if item then
                item.Returned=true
                if result[1] and result[2]==false then item.Rejected=true; item.Done=true end
            end
            if not result[1] then error(result[2],0) end
            return table.unpack(result,2,result.n)
        end
        Endpoints.invoke_server=R.Wrapper
        R.Ready=true
        Status("Ready. Native unit actions and active skills are recorded.")
        local function IdleAutomation()
            local april=env["__AAAprilSelection"]
            local normal=env["__AANormalAutoPlay"]
            local match=env["__AAMathControls"]
            if match and match.WavePending
                and match.WavePending.Model.Parent~=match.WavePending.Folder
            then match.WavePending=nil end
            return not (april and (april.PlacementBusy or april.PendingSpawn or april.SpellPending
                    or (april.PendingActions and #april.PendingActions>0)))
                and not (match and (match.Busy or match.WavePending))
                and not (normal and (normal.Busy or (normal.Pending and #normal.Pending>0)))
        end
        local function Due(action)
            if cfg.MacroCondition == "Ready" then
                return true
            end

            local c = action.When
            local wave = Num(workspace, "_wave_num")
            local remaining = Num(workspace, "_wave_time")
            local money = Wallet()

            if not wave or not remaining or not money then
                return false, "รอข้อมูลเวฟ เวลา หรือเงิน"
            end

            local time = R.Seconds >= c.Time
            local waveReady = wave > c.Wave
                or (wave == c.Wave and remaining <= c.WaveTime)
            local cash = money >= c.Money
            local mode = cfg.MacroCondition

            local ready = mode == "Time" and time
                or mode == "Wave" and waveReady
                or mode == "Money" and cash
                or mode == "All" and time and waveReady and cash

            return ready, string.format(
                "%s | เวลา %.1f/%.1f | เวฟ %s/%s | เวลาเวฟ %.1f/%.1f | เงิน %.0f/%.0f",
                tostring(mode),
                R.Seconds,
                c.Time,
                tostring(wave),
                tostring(c.Wave),
                remaining,
                c.WaveTime,
                money,
                c.Money
            )
        end
        local function BindExisting(action)
            local exact, candidates = {}, {}
            local target = CFrame.new(table.unpack(action.CFrame))

            for _, model in ipairs(Models()) do
                local mapped = false

                for _, used in pairs(R.Models) do
                    if used == model then
                        mapped = true
                        break
                    end
                end

                local tier = Num(Child(model, "_stats"), "upgrade")

                if not mapped
                    and not CS:HasTag(model, "dying_units")
                    and Id(model) == action.UnitId
                    and tier ~= nil
                    and tier >= action.Tier
                then
                    table.insert(candidates, model)

                    if Near(model, target) then
                        table.insert(exact, model)
                    end
                end
            end

            if #exact == 1 then
                return exact[1], "เชื่อมกับยูนิตที่ตำแหน่งเดิม"

            elseif #exact > 1 then
                return nil, "พบยูนิตตรงตำแหน่งหลายตัว ยังระบุตัวเป้าหมายไม่ได้"

            elseif #candidates == 1 then
                return candidates[1],
                    "เชื่อมกับยูนิตชนิดเดียวกันเพียงตัวเดียว แม้ตำแหน่งต่างกัน"

            elseif #candidates > 1 then
                return nil, "พบ " .. #candidates
                    .. " ตัวที่เข้าเงื่อนไข กรุณาวางตัวเป้าหมายที่ตำแหน่งบันทึก"
            end

            return nil, "รอ " .. tostring(action.UnitId)
                .. " ของคุณที่ยังไม่ถูกผูกกับรายการอื่น และมี Tier อย่างน้อย "
                .. tostring(action.Tier)
        end
        local function Prepare(action)
            local model=R.Models[action.Unit]
            local item={Action=action}
            local wallet=Wallet()
            if not wallet then return end
            if action.Type=="Spell" then
                local session=Collection.session
                local slots=type(session)=="table" and session.ingame_spells
                local def=Spells[action.SpellId]
                if type(slots)~="table" or type(def)~="table" or type(def.cost)~="number"
                    or wallet<math.ceil(def.cost) then return end
                local keys={}
                for slot,id in pairs(slots) do
                    if type(slot)=="string" and id==action.SpellId then table.insert(keys,slot) end
                end
                table.sort(keys)
                if not keys[1] then return end
                item.Slot=keys[1]
                if action.Target then
                    local target=R.Models[action.Target]
                    if not Owned(target) or CS:HasTag(target,"dying_units") then return end
                    return item,"use_ingame_spell",table.pack(item.Slot,target)
                end
                return item,"use_ingame_spell",table.pack(item.Slot)
            elseif action.Type=="Place" then
                local candidates={}
                for uuid,record in pairs(Roster()) do
                    local cosmetic=type(record.further_modifiers)=="table" and record.further_modifiers.cosmetic or nil
                    if record.unit_id==action.UnitId and (record.shiny==true)==action.Shiny
                        and cosmetic==action.Cosmetic then table.insert(candidates,uuid) end
                end
                table.sort(candidates)
                if not candidates[1] then return end
                local def=Units[action.UnitId]
                if type(def)~="table" or type(def.cost)~="number" then return end
                local cost=math.ceil(def.cost*Core.calculate_spawn_cost_multiplier(Collection.session))
                if wallet<cost then return end
                item.UUID=candidates[1]; item.Before={}
                for _,m in ipairs(Models()) do item.Before[m]=true end
                return item,"spawn_unit",table.pack(item.UUID,CFrame.new(table.unpack(action.CFrame)))
            end
            if not Owned(model) or CS:HasTag(model,"dying_units") then return end
            item.Model=model
            local stats=Child(model,"_stats")
            if action.Type=="Upgrade" then
                local tier=Num(stats,"upgrade")
                if not tier then return end
                if tier>=action.Tier then return "Done" end
                local def=Units[Id(model)]
                local nextTier=def and def.upgrade and def.upgrade[tier+1]
                if type(nextTier)~="table" or type(nextTier.cost)~="number" then return end
                local cost=math.ceil(nextTier.cost*Core.calculate_upgrade_cost_multiplier(model,Collection.session))
                if wallet<cost then return end
                return item,"upgrade_unit_ingame",table.pack(model)
            elseif action.Type=="Sell" then
                if Units[Id(model)] and Units[Id(model)].unsellable then return end
                return item,"sell_unit_ingame",table.pack(model)
            elseif action.Type=="Skill" then
                local cast=Num(stats,"last_active_cast")
                local cooldown=Num(stats,"active_attack_cooldown")
                local lock=Num(stats,"attack_lock")
                local active=Child(stats,"active_attack","StringValue")
                if not cast or not cooldown or lock~=0 or not active
                    or active.Value~=action.Active or cooldown-(tick()-cast)>0 then return end
                item.BeforeCast=cast
                if action.TargetRule then
                    local best,hp=nil,-1
                    for _,enemy in ipairs(CS:GetTagged("pve_minions_alive")) do
                        local health=Num(Child(enemy,"_stats"),"health")
                        if enemy:IsA("Model") and enemy.Parent==Child(workspace,"_UNITS")
                            and CS:HasTag(enemy,"pve_units") and not CS:HasTag(enemy,"bosses")
                            and not CS:HasTag(enemy,"dying_units") and health and health>0
                            and health>hp and Core.is_unit_in_range(model,enemy)
                        then best,hp=enemy,health end
                    end
                    if not best then return end
                    return item,"use_active_attack",table.pack(model,{death_note_active_target=best})
                end
                return item,"use_active_attack",table.pack(model)
            end
        end
        local function Tick()
            Clock()

            local startedNow, freezeNow, finishedNow = State()

            if R.PlaybackEnabled
                and finishedNow == true
                and (
                    R.Mode == "Play"
                    or (R.Mode == "Idle" and R.PlaybackCompleted)
                )
            then
                R.LastStopped = {
                    Index = R.Index,
                    Action = R.Play and R.Play.Actions[R.Index],
                    Blocked = R.LastBlocked,
                    Pending = R.Pending,
                    Seconds = R.Seconds,
                }

                R.Mode = "WaitRound"
                Status("จบตาแล้ว รอรอบใหม่ โดยคง Playback เปิดไว้")
            end

            if R.Mode == "WaitRound" then
                if not R.PlaybackEnabled then
                    R.Mode = R.Pending and "Stopping" or "Idle"
                    return
                end

                if R.Pending then
                    if R.Pending.Returned and finishedNow == true then
                        -- ปลดรายการของตาที่จบแล้ว โดยไม่ถือว่าคำสั่งสำเร็จ
                        R.Pending = nil
                    else
                        Status("รอผลคำสั่งของตาเดิม ยังไม่เริ่มมาโครซ้ำ")
                        return
                    end
                end

                if R.Busy or R.NativeBusy > 0 then
                    Status("รอคำสั่งของตาเดิมทำงานเสร็จ")
                    return
                end

                local scene = Scene()

                if finishedNow ~= false
                    or startedNow ~= true
                    or freezeNow ~= false
                    or not scene
                then
                    return
                end

                if type(R.Play) ~= "table"
                    or type(R.Play.Actions) ~= "table"
                then
                    Status("ไม่พบข้อมูลมาโครสำหรับรอบใหม่ กรุณาเลือกมาโคร")
                    return
                end

                if scene.id ~= R.Play.LevelId
                    or scene.map ~= R.Play.Map
                then
                    Status("รอรอบใหม่ที่ตรงกับด่านและแผนที่ของมาโคร")
                    return
                end

                R.Mode = "ArmPlay"
            end

            for _, item in ipairs(R.Queue) do
                if not item.Done
                    and item.Returned
                    and not item.Rejected
                    and Observe(item)
                then
                    item.Success = true
                    item.Done = true
                end
            end

            if R.Pending then
                if Observe(R.Pending) then
                    R.Pending = nil
                    R.Index = R.Index + 1

                    if R.Mode == "Stopping" then
                        R.Mode = "Idle"
                    end
                else
                    Status("Waiting for step confirmation: " .. R.Index)
                    return
                end
            end

            if R.Mode == "Stopping"
                and not R.Pending
                and not R.Busy
                and R.NativeBusy == 0
            then
                R.Mode = "Idle"

                if R.CloseRequested then
                    Stop()
                end

                return
            end

            if R.Mode == "FinishRecord" and R.NativeBusy == 0 then
                SaveDraft()
                return
            end

            if R.Mode == "ArmRecord" or R.Mode == "ArmPlay" then
                local scene = Scene()

                if not scene or not IdleAutomation() then
                    Status("Waiting for map / existing automation actions.")
                    return
                end

                if R.Mode == "ArmPlay"
                    and (
                        scene.id ~= R.Play.LevelId
                        or scene.map ~= R.Play.Map
                    )
                then
                    R.Mode = "Idle"
                    Status("Macro level/map does not match this match.")
                    return
                end

                R.Models = {}
                R.Queue = {}
                R.Serial = 0
                R.Index = 1
                R.Seconds = 0
                R.LastClock = os.clock()
                R.PlaybackCompleted = false
                R.LastBlocked = nil
                R.RetryAt = nil

                if R.Mode == "ArmRecord" then
                    R.Draft = {
                        Version = 1,
                        LevelId = scene.id,
                        Map = scene.map,
                        Actions = {},
                    }

                    R.Mode = "Record"
                    Status("Recording native actions...")
                else
                    R.Mode = "Play"
                    Status("Playing macro...")
                end
            end

            local _, freeze, finished = State()

            if R.Mode == "Record" and finished then
                R.Mode = "FinishRecord"
                return
            end

            if R.Mode ~= "Play" or R.Busy then
                return
            end

            if finished then
                return
            end

            local scene = Scene()

            if not scene or freeze then
                return
            end

            if scene.id ~= R.Play.LevelId or scene.map ~= R.Play.Map then
                R.Mode = "Idle"
                Status("Level/map changed; playback stopped.")
                return
            end

            if os.clock() < (R.RetryAt or 0) then
                return
            end

            local action = R.Play.Actions[R.Index]

            if not action then
                R.PlaybackCompleted = true
                R.Mode = "Idle"
                Status("Macro completed. Toggle Playback off and on to replay.")
                return
            end

            local due, reason = Due(action)

            if not due then
                R.LastBlocked = {
                    Index = R.Index,
                    Action = action,
                    Reason = reason,
                    Seconds = R.Seconds,
                }

                Status(
                    "รอขั้น " .. R.Index
                    .. " [" .. action.Type .. "]: "
                    .. tostring(reason)
                )
                return
            end

            if action.Type == "Bind" then
                local model, bindReason = BindExisting(action)

                if model then
                    R.Models[action.Unit] = model
                    R.Index = R.Index + 1
                    Status("Bind " .. action.Unit .. ": " .. bindReason)
                else
                    R.LastBlocked = {
                        Index = R.Index,
                        Action = action,
                        Reason = bindReason,
                        Seconds = R.Seconds,
                    }

                    Status("รอ Bind " .. action.Unit .. ": " .. bindReason)
                end

                return
            end

            local item, endpoint, args = Prepare(action)

            if item == "Done" then
                R.Index = R.Index + 1
                return
            end

            if not item then
                local model = R.Models[action.Unit or action.Target]

                local waitReason = "ยูนิต/เงิน/สกิลยังไม่พร้อม | Unit="
                    .. tostring(action.Unit or action.Target)
                    .. " | Owned=" .. tostring(Owned(model))
                    .. " | Tier="
                    .. tostring(Num(Child(model, "_stats"), "upgrade"))
                    .. " | เงิน=" .. tostring(Wallet())

                R.LastBlocked = {
                    Index = R.Index,
                    Action = action,
                    Reason = waitReason,
                    Seconds = R.Seconds,
                }

                Status(
                    "รอขั้น " .. R.Index
                    .. " [" .. action.Type .. "]: " .. waitReason
                )
                return
            end

            if R.Stopped
                or not R.PlaybackEnabled
                or R.Mode ~= "Play"
            then
                return
            end

            R.Pending = item
            R.Busy = true

            local result = table.pack(pcall(
                R.Original,
                endpoint,
                table.unpack(args, 1, args.n)
            ))

            R.Busy = false
            item.Returned = true

            if result[1]
                and result[2] == false
                and not Observe(item)
            then
                R.Pending = nil
                R.RetryAt = os.clock() + 1

                if R.Mode == "Stopping" then
                    R.Mode = "Idle"
                end

                Status("Server rejected step; retrying after readiness checks.")

            elseif not result[1] then
                warn(
                    "[Macro] Request error; observing before any resend: "
                    .. tostring(result[2])
                )
            end
        end
        while not R.Stopped do
            local ok,err=xpcall(Tick,debug.traceback)
            if R.SyncControls then
                R.SyncControls()
            end
            if not ok then
                Status("Macro paused after error; see console.")
                warn("[Macro] " .. tostring(err))
                if not R.Pending then R.Mode="Idle" end
                task.wait(2)
            end
            task.wait(0.1)
        end
    end)
end


-- Unit & Buff: added section
do
    local env, key = getgenv(), "__AAUnitBuff"
    local old = env[key]

    if old and old.Stop then
        old.Stop()
    end

    local R = {
        Stopped = false,
        Connections = {},
        Units = {},
        Groups = {},
    }

    env[key] = R

    local cfg = AAExtra.Settings

    local tab = App:MakeTab({
        Title = "unit & buff",
        Description = "วนใช้สกิลบัฟ",
        Icon = 123909267283672,
        Selected = false,
    })

    local section = tab:Section("Buff Rotation")

    local function AddGroup(id, title, setting)
        local previous = old and old.Groups and old.Groups[id]

        local group = {
            Id = id,
            Setting = setting,
            Elapsed = math.huge,
            Pending = previous and previous.Pending,
        }

        R.Groups[id] = group

        group.Toggle = section:Toggle({
            Title = "Auto Buff " .. title,
            Value = cfg[setting] == true,
            Description = "วนใช้สกิลของยูนิตที่คุณวางไว้ โดยยังขึ้นกับระยะและคูลดาวน์ของสกิล",
            Callback = function(_, value)
                cfg[setting] = value == true

                if AAExtra.StorageOK then
                    AAExtra.Save()
                end
            end,
        })
    end

    AddGroup("erwin", "Erwin", "UnitBuffErwin")
    AddGroup("wendy", "Windy", "UnitBuffWindy")

    function R.Stop()
        R.Stopped = true

        for _, connection in ipairs(R.Connections) do
            connection:Disconnect()
        end

        table.clear(R.Connections)
    end

    table.insert(
        R.Connections,
        R.Groups.erwin.Toggle.self.Destroying:Connect(R.Stop)
    )

    local function Status(group, message)
        if group.Status == message then
            return
        end

        group.Status = message

        print("[Unit Buff / " .. group.Id .. "] " .. message)
    end

    local function Child(parent, name, class)
        local value = parent and parent:FindFirstChild(name)

        return value
            and (not class or value:IsA(class))
            and value or nil
    end

    local function Number(parent, name)
        local value = Child(parent, name, "NumberValue")
        local n = value and value.Value

        return type(n) == "number"
            and n == n
            and math.abs(n) < math.huge
            and n or nil
    end

    task.spawn(function()
        local RS = game:GetService("ReplicatedStorage")
        local CS = game:GetService("CollectionService")
        local player = game:GetService("Players").LocalPlayer
        local tag = "player_units:" .. player.UserId

        local Endpoints, Units

        while not R.Stopped and not Endpoints do
            local src = Child(RS, "src")
            local module = Child(src, "Loader", "ModuleScript")

            if module then
                local ok, endpoints, units = pcall(function()
                    local loader = require(module)

                    return loader.load_client_service(
                        module, "EndpointsClient"
                    ), loader.load_data(module, "Units")
                end)

                if ok
                    and type(endpoints) == "table"
                    and type(endpoints.invoke_server) == "function"
                    and type(units) == "table"
                then
                    Endpoints, Units = endpoints, units
                elseif not ok then
                    warn("[Unit Buff / Load] " .. tostring(endpoints))
                end
            end

            if not Endpoints then
                task.wait(3)
            end
        end

        if R.Stopped then
            return
        end

        local function Add(model)
            if model:IsA("Model") then
                R.Units[model] = true
            end
        end

        table.insert(
            R.Connections,
            CS:GetInstanceAddedSignal(tag):Connect(Add)
        )

        table.insert(
            R.Connections,
            CS:GetInstanceRemovedSignal(tag):Connect(function(model)
                R.Units[model] = nil
            end)
        )

        for _, model in ipairs(CS:GetTagged(tag)) do
            Add(model)
        end

        local function Owned(model)
            return typeof(model) == "Instance"
                and model:IsA("Model")
                and model.Parent == Child(workspace, "_UNITS")
                and CS:HasTag(model, tag)
                and not CS:HasTag(model, "dying_units")
        end

        local function Step(group, active, dt)
            local pending = group.Pending

            if pending then
                local cast = Number(
                    Child(pending.Model, "_stats"),
                    "last_active_cast"
                )

                if cast and cast > pending.Before then
                    group.Pending = nil
                    group.Elapsed = 0
                    Status(group, "Cast confirmed.")

                elseif not Owned(pending.Model) then
                    group.Pending = nil

                elseif pending.Returned and pending.Rejected then
                    group.Pending = nil
                    group.RetryAt = os.clock() + 1

                    Status(
                        group,
                        "Server rejected cast; waiting before retry."
                    )
                else
                    Status(
                        group,
                        "Waiting for cast confirmation; no duplicate request."
                    )
                end

                return
            end

            if not active or cfg[group.Setting] ~= true then
                return
            end

            group.Elapsed = group.Elapsed + dt

            local candidates = {}
            local latest = -math.huge
            local shortest = math.huge
            local definition = Units[group.Id]

            local expected = type(definition) == "table"
                and definition.active_attack

            for model in pairs(R.Units) do
                if Owned(model) then
                    local stats = Child(model, "_stats")
                    local id = Child(stats, "id", "StringValue")

                    local ability = Child(
                        stats, "active_attack", "StringValue"
                    )

                    local cast = Number(stats, "last_active_cast")

                    local cooldown = Number(
                        stats, "active_attack_cooldown"
                    )

                    local lock = Number(stats, "attack_lock")

                    if id
                        and id.Value == group.Id
                        and type(expected) == "string"
                        and ability
                        and ability.Value == expected
                        and cast
                        and cooldown
                        and cooldown > 0
                        and lock ~= nil
                    then
                        table.insert(candidates, {
                            Model = model,
                            Cast = cast,
                            Cooldown = cooldown,
                            Lock = lock,
                        })

                        latest = math.max(latest, cast)
                        shortest = math.min(shortest, cooldown)
                    end
                end
            end

            if #candidates == 0 then
                Status(
                    group,
                    "No eligible placed unit, or required active stats are unavailable."
                )
                return
            end

            local interval = shortest / math.min(3, #candidates)

            if group.LastObserved ~= latest then
                group.LastObserved = latest

                -- รับรู้การกดสกิลเองด้วย
                group.Elapsed = math.min(
                    group.Elapsed,
                    math.max(0, tick() - latest)
                )
            end

            if group.Elapsed < interval
                or os.clock() < (group.RetryAt or 0)
            then
                return
            end

            table.sort(candidates, function(a, b)
                return a.Cast < b.Cast
            end)

            for _, candidate in ipairs(candidates) do
                if candidate.Lock == 0
                    and tick() - candidate.Cast >= candidate.Cooldown
                then
                    if candidate.Model:GetAttribute("_auto_active") == true then
                        Status(
                            group,
                            "Turn native Auto off on rotating units to avoid competing casts."
                        )
                        return
                    end

                    local item = {
                        Model = candidate.Model,
                        Before = candidate.Cast,
                    }

                    group.Pending = item

                    local ok, result = pcall(
                        Endpoints.invoke_server,
                        "use_active_attack",
                        candidate.Model
                    )

                    item.Returned = true
                    item.Rejected = ok and result == false

                    if not ok then
                        warn("[Unit Buff / Cast] " .. tostring(result))
                    end

                    return
                end
            end

            Status(group, "Waiting for cooldown / attack lock.")
        end

        local previous = os.clock()

        while not R.Stopped do
            local now = os.clock()
            local dt = now - previous
            previous = now

            local data = Child(workspace, "_DATA")
            local started = Child(data, "GameStarted", "BoolValue")
            local finished = Child(data, "GameFinished", "BoolValue")
            local freeze = Child(data, "GlobalFreeze", "BoolValue")

            local active = started and started.Value
                and finished and not finished.Value
                and freeze and not freeze.Value

            if AAExtra.MacroBusy and AAExtra.MacroBusy() then
                active = false
            end

            for _, group in pairs(R.Groups) do
                local ok, err = xpcall(function()
                    Step(group, active, dt)
                end, debug.traceback)

                if not ok then
                    Status(
                        group,
                        "Error; retrying observation. See console."
                    )

                    warn("[Unit Buff] " .. tostring(err))
                end
            end

            task.wait(0.2)
        end
    end)
end


