            table.insert(R.RejectedPositions,{
                UUID=pending.UUID,Position=pending.CFrame.Position,
                Expires=os.clock()+REJECT_SECONDS,
            })
            if #R.RejectedPositions>REJECT_CACHE_LIMIT then table.remove(R.RejectedPositions,1) end
            print("[Auto Play / Placement] Skipping rejected point: "
                .. tostring(pending.UUID) .. " @ " .. tostring(pending.CFrame.Position))
        end

        local function LegacyTargetReached(pending, models)
            if pending.Kind ~= "Place"
                or not pending.Returned
                or pending.ResponseKnown
                or not models
            then
                return false
            end

            for _, slot in ipairs(slots) do
                local row = Equipped(slot)

                if row
                    and row.UUID == pending.UUID
                    and row.Id == pending.Id
                    and row.Options.Count > 0
                then
                    local count = 0

                    for _, unit in ipairs(models) do
                        if unit.Owned
                            and unit.UUID == pending.UUID
                            and unit.Id == pending.Id
                        then
                            count += 1
                        end
                    end

                    return count >= row.Options.Count
                end
            end

            return false
        end

        local function Reconcile(models)
            for i=#R.Pending,1,-1 do
                local pending=R.Pending[i]
                local confirmed=false
                local retired=false
                local targetReached = LegacyTargetReached(pending, models)
                local data=Child(workspace,"_DATA")
                local finished=Child(data,"GameFinished","BoolValue")
                if pending.Returned and ((finished and finished.Value)
                    or (pending.Scene and pending.Scene~=data and pending.Scene.Parent==nil)) then
                    retired=true
                end
                if pending.Kind=="Upgrade" then
                    local tier=Number(Child(pending.Model,"_stats"),"upgrade")
                    confirmed=tier and tier>pending.Before
                    if pending.Model.Parent~=pending.Folder then retired=true end
                else
                    local found
                    for _,unit in ipairs(models or {}) do
                        if unit.Owned and unit.UUID==pending.UUID and unit.Id==pending.Id
                            and not pending.Before[unit.Model]
                            and (Core.get_ground(unit.Model)-pending.CFrame.Position).Magnitude<=0.25 then
                            if found then found=false; break end
                            found=unit.Model
                        end
                    end
                    confirmed=found~=nil and found~=false
                end
                if confirmed
                    or retired
                    or targetReached
                    or (pending.Returned and pending.Rejected)
                then
                    table.remove(R.Pending, i)

                    if not confirmed and not retired and not targetReached then
                        RejectPlacementPoint(pending)
                        R.Retry[pending.Key] = os.clock() + 3
                    end

                    Status(
                        targetReached
                            and "Slot target already reached; legacy reservation released without confirming the old request."
                        or retired
                            and "Previous target / match ended; reservation released."
                        or confirmed
                            and "Action confirmed: " .. pending.Kind
                        or "Server rejected action; rechecking before retry."
                    )
                end
            end
        end
        local function Counts(row,models)
            local count,owned,byId,global=0,0,0,0
            for _,unit in ipairs(models) do
                if unit.Id==row.Id then global+=1 end
                if unit.Owned then
                    owned+=1
                    if unit.Id==row.Id then byId+=1 end
                    if unit.UUID==row.UUID then count+=1 end
                end
            end
            for _,pending in ipairs(R.Pending) do
                if pending.Kind=="Place" then
                    owned+=1
                    if pending.Id==row.Id then byId+=1; global+=1 end
                end
            end
            return count,owned,byId,global
        end
        local function BelowCap(value,count)
            return value==nil or (Integer(value,1) and count<value)
        end
        local function PlacementEligible(row,session,models)
            local count,total,byId,global=Counts(row,models)
            if count>=row.Options.Count or PendingFor(row.UUID) then return false end
            if not BelowCap(row.Definition.spawn_cap,byId)
                or not BelowCap(row.Definition.global_spawn_cap,global)
                or not BelowCap(Loader.LevelData.max_placed_units,total) then return false end
            if type(session.collection)~="table"
                or type(session.collection.is_unit_on_cooldown)~="function"
                or session.collection:is_unit_on_cooldown(row.UUID) then return false end
            return true
        end
        local function Cost(value,multiplier)
            if Finite(value) and value>=0 and Finite(multiplier) and multiplier>0 then
                local n=value*multiplier
                if Finite(n) then return math.ceil(n) end
            end
        end
        local function Send(item, name, ...)
            item.Scene = Child(workspace, "_DATA")
            table.insert(R.Pending, item)

            local ok, result = pcall(Endpoints.invoke_server, name, ...)

            item.TransportOK = ok
            item.ResponseKnown = true
            item.ReturnType = typeof(result)
            item.Returned = true

            -- ใช้ nil = ไม่สำเร็จ เฉพาะ spawn_unit ตาม Native Caller
            item.Rejected = ok and (
                result == false
                or (name == "spawn_unit" and result == nil)
            )

            print(string.format(
                "[Auto Play / Return] Endpoint=%s UUID=%s TransportOK=%s "
                    .. "ReturnType=%s Return=%s Rejected=%s",
                name,
                tostring(item.UUID),
                tostring(ok),
                item.ReturnType,
                tostring(result),
                tostring(item.Rejected)
            ))

            if not ok then
                warn("[Auto Play / RPC] " .. tostring(result))
            end

            Status(item.Rejected
                and "Server rejected action; retrying after readiness checks."
                or "Requested " .. item.Kind .. "; observing replicated result.")
        end
        local placementWaitReason

        local function TryPlace(rows, models)
            placementWaitReason = nil
            local generation = R.Generation

            local function Wait(message)
                placementWaitReason = placementWaitReason or message
                Status(placementWaitReason)
            end

            table.sort(rows, function(a, b)
                if a.Options.PlacePriority ~= b.Options.PlacePriority then
                    return a.Options.PlacePriority < b.Options.PlacePriority
                end
                return tonumber(a.Slot) < tonumber(b.Slot)
            end)

            for _, row in ipairs(rows) do
                if not Active() or cfg.NormalAutoPlace ~= true
                    or R.Generation ~= generation
                then
                    return true
                end

                local count, _, byId, global = Counts(row, models)

                if row.Options.Count <= 0
                    or count >= row.Options.Count
                then
                    continue
                end

                if PendingFor(row.UUID) then
                    Wait("รอยืนยันการวาง: Slot " .. row.Slot)
                    continue
                end

                if not BelowCap(row.Definition.spawn_cap, byId)
                    or not BelowCap(
                        row.Definition.global_spawn_cap, global
                    )
                then
                    continue
                end

                local live, session = Equipped(row.Slot)

                if not live or live.UUID ~= row.UUID
                    or live.Record ~= row.Record
                then
                    Wait("รอข้อมูลยูนิต: Slot " .. row.Slot)
                    continue
                end

                if os.clock() < (R.Retry[row.UUID] or 0) then
                    Wait("รอค้นหาจุดวางใหม่: Slot " .. row.Slot)
                    continue
                end

                if not PlacementEligible(row, session, models) then
                    Wait(
                        "รอเงื่อนไขจำนวนหรือคูลดาวน์: Slot "
                        .. row.Slot
                    )
                    continue
                end

                local cost = Cost(
                    row.Definition.cost,
                    Core.calculate_spawn_cost_multiplier(session)
                )
                local money = Wallet()

                if not cost then
                    Wait("รอราคาวางยูนิต: Slot " .. row.Slot)
                    continue
                end

                if not money then
                    Wait("รอข้อมูลเงินสำหรับวางยูนิต")
                    return false
                end

                if money < cost then
                    Wait("Saving for placement: Slot " .. row.Slot)
                    continue
                end

                local bridge = env["__AAAprilSelection"]

                if not bridge or bridge.Stopped
                    or type(bridge.NormalCandidate) ~= "function"
                    or type(bridge.NormalPositionClear) ~= "function"
                then
                    Wait("Waiting for shared placement geometry.")
                    return false
                end

                local token = {Normal = true}

                token.Check = function()
                    local current = Equipped(row.Slot)

                    return Active()
                        and cfg.NormalAutoPlace == true
                        and R.Generation == generation
                        and env["__AAAprilSelection"] == bridge
                        and not bridge.Stopped
                        and current
                        and current.UUID == row.UUID
                        and current.Record == row.Record
                end

                local options = {
                    AntiLeak = cfg.NormalAntiLeak == true,
                    StartRatio = 0,
                    PositionAllowed = function(position)
                        return PositionAllowed(row.UUID, position)
                    end,
                }

                local cf, reason, validation = bridge.NormalCandidate(
                    row.Record, row.Definition, token, options
                )

                if not token.Check() then return true end

                if not cf then
                    R.LastPlacementFailure = {
                        Slot = row.Slot,
                        UUID = row.UUID,
                        Reason = tostring(
                            reason or "No valid placement point."
                        ),
                        StartRatio = options.StartRatio,
                        AntiLeak = options.AntiLeak,
                        At = os.clock(),
                    }

                    R.Retry[row.UUID] = os.clock() + 3

                    Wait(
                        "Slot " .. row.Slot .. ": "
                        .. R.LastPlacementFailure.Reason
                    )
                    continue
                end

                local latest = Placed()

                if not latest then
                    Wait("Waiting for complete unit attribution.")
                    return false
                end

                models = latest

                cost = Cost(
                    row.Definition.cost,
                    Core.calculate_spawn_cost_multiplier(session)
                )

                if not token.Check() then return true end

                if not PlacementEligible(row, session, latest)
                    or not cost
                    or (Wallet() or -1) < cost
                then
                    Wait(
                        "เงื่อนไขวางเปลี่ยนหลังค้นหา: Slot "
                        .. row.Slot
                    )
                    continue
                end

                if not PositionAllowed(row.UUID, cf.Position)
                    or not bridge.NormalPositionClear(
                        validation, row.Definition
                    )
                then
                    Wait(
                        "จุดวางเปลี่ยนหลังค้นหา: Slot "
                        .. row.Slot
                    )
                    continue
                end

                if not token.Check() then return true end

                local before = {}

                for _, unit in ipairs(latest) do
                    if unit.Owned then
                        before[unit.Model] = true
                    end
                end

                placementWaitReason = nil

                Send({
                    Kind = "Place",
                    Key = row.UUID,
                    UUID = row.UUID,
                    Id = row.Id,
                    Before = before,
                    CFrame = cf,
                    Folder = Child(workspace, "_UNITS"),
                }, "spawn_unit", row.UUID, cf)

                return true
            end

            return false
        end
        local function TryUpgrade(rows,models)
            local choices={}
            for _,row in ipairs(rows) do
                if row.Options.Count>0 and row.Options.Tier>0 then
                    for _,unit in ipairs(models) do
                        if unit.Owned and unit.UUID==row.UUID and unit.Id==row.Id
                            and unit.Tier and unit.Tier<row.Options.Tier
                            and not CS:HasTag(unit.Model,"dying_units")
                            and not PendingFor(row.UUID,unit.Model)
                            and os.clock()>=(R.Retry[unit.Model] or 0)
                            and type(row.Definition.upgrade)=="table" then
                            local nextInfo,maxed=GUI.get_next_upgrade_info(unit.Model,row.Record)
                            if not maxed and type(nextInfo)=="table" then
                                table.insert(choices,{Row=row,Unit=unit,Next=nextInfo})
                            end
                        end
                    end
                end
            end
            table.sort(choices,function(a,b)
                if a.Row.Options.UpgradePriority~=b.Row.Options.UpgradePriority then
                    return a.Row.Options.UpgradePriority<b.Row.Options.UpgradePriority
                end
                if a.Row.Slot~=b.Row.Slot then return tonumber(a.Row.Slot)<tonumber(b.Row.Slot) end
                if a.Unit.Tier~=b.Unit.Tier then return a.Unit.Tier>b.Unit.Tier end
                return a.Unit.Order<b.Unit.Order
            end)
            local chosen=choices[1]
            if not chosen then return false end
            local row,unit=chosen.Row,chosen.Unit
            local current,session=Equipped(row.Slot)
            if not current or current.UUID~=row.UUID or not Active() then return true end
            local cost=Cost(chosen.Next.cost,Core.calculate_upgrade_cost_multiplier(unit.Model,session))
            if not cost then Status("Upgrade cost unavailable."); return true end
            if (Wallet() or -1)<cost then Status("Saving for upgrade: Slot " .. row.Slot); return true end
            Send({Kind="Upgrade",Key=unit.Model,Model=unit.Model,UUID=row.UUID,
                Before=unit.Tier,Folder=Child(workspace,"_UNITS")},"upgrade_unit_ingame",unit.Model)
            return true
        end
        local function DebugPlacement()
            if not cfg.NormalAutoPlace
                or os.clock() < (R.NextPlacementDebug or 0)
            then
                return
            end

            R.NextPlacementDebug = os.clock() + 5

            local function Describe(object)
                if not object then return "Missing" end

                if object:IsA("ValueBase") then
                    return object.ClassName .. ":" .. tostring(object.Value)
                end

                return object.ClassName
            end

            local data = Child(workspace, "_DATA")
            local map = Child(workspace, "_MAP_CONFIG")
            local bridge = env["__AAAprilSelection"]
            local match = env["__AAMathControls"]
            local activeOK, active = pcall(Active)
            local models = Placed()

            print(string.format(
                "[Auto Play / State] Active=%s ActiveOK=%s "
                    .. "MapLoaded=%s Started=%s Finished=%s Freeze=%s "
                    .. "Resource=%s ModelsReady=%s Pending=%d "
                    .. "Bridge=%s MacroHold=%s WaveHold=%s Status=%s",
                tostring(active),
                tostring(activeOK),
                Describe(Child(map, "MapLoaded")),
                Describe(Child(data, "GameStarted")),
                Describe(Child(data, "GameFinished")),
                Describe(Child(data, "GlobalFreeze")),
                tostring(Wallet()),
                tostring(models ~= nil),
                #R.Pending,
                tostring(
                    bridge and not bridge.Stopped
                        and type(bridge.NormalCandidate) == "function"
                ),
                tostring(AAExtra.MacroBusy and AAExtra.MacroBusy()),
                tostring(match and match.WaveHold),
                tostring(R.Status)
            ))

            for _, slot in ipairs(slots) do
                local ok, uuid, record = pcall(
                    Collection.get_unit_in_equipped_slot, slot
                )

                local rowOK, row = pcall(Equipped, slot)
                if not rowOK then row = nil end

                local count
                local eligibleOK, eligible = false, "Not evaluated"

                if row and models then
                    count = Counts(row, models)

                    eligibleOK, eligible = pcall(
                        PlacementEligible,
                        row,
                        Collection.session,
                        models
                    )
                end

                local options = cfg.NormalAutoSlots[slot]

                print(string.format(
                    "[Auto Play / Slot] Slot=%s ReadOK=%s UUID=%s "
                        .. "RecordType=%s RecordUUID=%s UnitId=%s "
                        .. "RowReady=%s Count=%s Target=%s "
                        .. "EligibleOK=%s Eligible=%s",
                    slot,
                    tostring(ok),
                    tostring(uuid),
                    typeof(record),
                    tostring(type(record) == "table" and record.uuid),
                    tostring(type(record) == "table" and record.unit_id),
                    tostring(row ~= nil),
                    tostring(count),
                    tostring(options and options.Count),
                    tostring(eligibleOK),
                    tostring(eligible)
                ))
            end

            if not models then
                for _, model in ipairs(CS:GetTagged("player_units")) do
                    if model:IsA("Model")
                        and model.Parent == Child(workspace, "_UNITS")
                        and CS:HasTag(model, "nonminion_units")
                    then
                        local stats = Child(model, "_stats")

                        if not Child(stats, "parent_unit", "ObjectValue")
                            or not Child(stats, "id", "StringValue")
                            or not Child(stats, "uuid", "StringValue")
                        then
                            print(
                                "[Auto Play / Attribution] Path="
                                    .. model:GetFullName()
                                    .. " ParentUnit="
                                    .. Describe(Child(stats, "parent_unit"))
                                    .. " ID=" .. Describe(Child(stats, "id"))
                                    .. " UUID=" .. Describe(Child(stats, "uuid"))
                            )
                        end
                    end
                end
            end
        end

        local function Step()
            DebugPlacement()
            placementWaitReason = nil

            local models=Placed()
            Reconcile(models)
            local rows={}
            for _,slot in ipairs(slots) do
                local row=Equipped(slot)
                local text=row and ((row.Definition.name or row.Id) .. " [" .. row.Id .. "]") or "ช่องว่างหรือข้อมูลทีมปกติยังไม่พร้อม"
                if labels[slot].Desc.Text~=text then labels[slot].Desc.Text=text end
                if row then table.insert(rows,row) end
            end
            UpdatePriorityLabels()
            if not cfg.NormalAutoPlace and not cfg.NormalAutoUpgrade then return end
            if not Active() then Status("Waiting for an active normal match / automation hold."); return end
            if not models then Status("Waiting for complete unit attribution."); return end
            for _,pending in ipairs(R.Pending) do
                if not pending.Returned then Status("Waiting for in-flight request."); return end
            end
            R.UpgradeTurn=not R.UpgradeTurn
            if R.UpgradeTurn and cfg.NormalAutoUpgrade and TryUpgrade(rows,models) then return end
            if cfg.NormalAutoPlace and TryPlace(rows,models) then return end
            if cfg.NormalAutoUpgrade and TryUpgrade(rows,models) then return end
            Status(placementWaitReason
                or (
                    #R.Pending > 0
                    and "Observing unresolved actions; other targets remain eligible."
                    or "Configured targets complete, or native limits reached."
                ))
        end
        while not R.Stopped do
            R.Busy=true
            local ok,err=xpcall(Step,debug.traceback)
            R.Busy=false
            if not ok then Status("Error; retrying. See console."); warn("[Auto Play] " .. tostring(err)) end
            task.wait(ok and 0.75 or 3)
        end
    end)
end

