    local function LoadModule(name)
        local modules = ReplicatedStorage:FindFirstChild("Modules")
        local instance = modules and modules:FindFirstChild(name)

        if not instance or not instance:IsA("ModuleScript") then
            return nil, name .. " unavailable"
        end

        local record = moduleCache[name]
        if not record or record.Instance ~= instance then
            record = { Instance = instance }
            moduleCache[name] = record

            local ok, result = pcall(require, instance)
            if not Active() then return nil, "Cancelled" end

            if ok and type(result) == "table" then
                record.Value = result
            else
                record.Error = tostring(result)
            end
        end

        return record.Value, record.Error
    end

