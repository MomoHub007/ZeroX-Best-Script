                        "Unverified core event")

                    local level = mine[def.Field]
                    assert(Integer(level), "Core level not ready: " .. def.Field)

                    local pips = Native(Config.GetCoreNodePips, mine, node)
                    assert(Number(pips), "Invalid core pips")

                    if level < def.Max and pips < node.Pips
                        and Native(Config.IsCoreNodeOpen, mine, node) == true then
                        Add({
                            Kind = "Core",
                            Event = def.Event,
                            Field = def.Field,
