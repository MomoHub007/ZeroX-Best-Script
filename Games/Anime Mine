    local function SignaturePart(value)
        local text = tostring(value)
        return typeof(value) .. ":" .. tostring(#text) .. ":" .. text
    end

    local function MinerSignature(items, isHolders)
        if type(items) ~= "table" then return nil end

        local keys = {}
        for key in pairs(items) do
            if type(key) ~= "string" then return nil end
            table.insert(keys, key)
        end
        table.sort(keys)

        local parts = {}
        for _, key in ipairs(keys) do
            table.insert(parts, SignaturePart(key))
            local value = items[key]

            if isHolders then
                if type(value) ~= "table" then return nil end

                for _, field in ipairs({
                    "CharName",
                    "Variant",
                    "CharLevel",
                    "CharSpeedLevel",
                    "CharMineSpeedLevel",
                }) do
                    local fieldValue = value[field]
                    local kind = typeof(fieldValue)

                    if kind ~= "nil" and kind ~= "string"
                        and kind ~= "number" and kind ~= "boolean" then
                        return nil
                    end
                    table.insert(parts, SignaturePart(fieldValue))
                end
            else
                if type(value) ~= "number" then return nil end
                table.insert(parts, SignaturePart(value))
            end
        end

        return table.concat(parts, "|")
    end

