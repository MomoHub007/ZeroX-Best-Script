    local function Child(parent, name)
        return parent and parent:FindFirstChild(name)
    end

    local function Root()
        local character = LocalPlayer.Character
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")
        local root = humanoid and humanoid.RootPart
        if not humanoid or humanoid.Health <= 0
            or not root or not root:IsA("BasePart")
            or not root:IsDescendantOf(character) then
            return nil
        end
        return root, humanoid, character
    end

    local cachedPlot
    local function Plot()
        local plots = Child(Child(workspace, "MineWorld"), "Plots")
        if not plots then
            cachedPlot = nil
            return nil
        end

        if cachedPlot and cachedPlot.Parent == plots
            and cachedPlot:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
            return cachedPlot
        end

        cachedPlot = nil
        for _, plot in ipairs(plots:GetChildren()) do
            if plot:IsA("Model")
                and plot:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
                cachedPlot = plot
                break
            end
        end
        return cachedPlot
    end

    local function Sum(items)
        local total = 0
        for _, count in pairs(items) do
            if type(count) == "number" and count > 0 then
                total = total + count
            end
        end
        return total
    end

    local function Within(root, part, radius)
        return part and part:IsA("BasePart")
            and part:IsDescendantOf(workspace)
            and (root.Position - part.Position).Magnitude <= radius
    end


    local gameState
    local moduleRef
    local moduleError
    local stateConnection
    local dirty = true
    local nextRead = 0
    local data

    local function State()
        local candidate = Child(Child(ReplicatedStorage, "Modules"), "GameState")
        if candidate ~= moduleRef then
            if stateConnection then
                stateConnection:Disconnect()
                stateConnection = nil
            end
            moduleRef = candidate
            gameState = nil
            moduleError = nil
            data = nil
            dirty = true

            if candidate and candidate:IsA("ModuleScript") then
                local ok, result = pcall(require, candidate)
                if not Active() then return nil, "Cancelled" end

                if ok and type(result) == "table"
                    and type(result.GetData2) == "function" then
                    gameState = result

                    if type(result.Listen) == "function" then
                        local connected, connection = pcall(
                            result.Listen,
                            function()
                                dirty = true
                            end,
                            nil,
                            "me"
                        )
                        if connected and connection
                            and type(connection.Disconnect) == "function" then
                            stateConnection = connection
                        end
                    end
                else
                    moduleError = tostring(result)
                end
            end
        end

        if not gameState then
            return nil, moduleError or "GameState unavailable"
        end

        local now = os.clock()
        if dirty or now >= nextRead then
            dirty = false
            nextRead = now + 1
            local ok, result = pcall(gameState.GetData2)
            if not ok then
                data = nil
                return nil, "GetData2: " .. tostring(result)
            end
            data = result
        end

        if type(data) ~= "table"
            or type(data.MineGame) ~= "table"
            or type(data.MineGame.Ores) ~= "table"
            or type(data.MineGame.Chest) ~= "table" then
            return nil, "MineGame inventory not ready"
        end
        return data
    end

    local function Remote()
        local remote = Child(Child(ReplicatedStorage, "Remotes"), "GamestateEvent")
        return remote and remote:IsA("RemoteEvent") and remote or nil
    end

    local COLLECT_DEBUG = true
    local COLLECT_DEBUG_INTERVAL = 5
    local collectDebugLast = -math.huge
    local DebugHttpService = game:GetService("HttpService")

    local function DebugCounts(items)
        if type(items) ~= "table" then
            return { DataType = typeof(items) }
        end

        local result = {
            Total = 0,
            KeyCount = 0,
            Entries = {},
        }

        for key, count in pairs(items) do
            result.KeyCount = result.KeyCount + 1

            if type(count) == "number" and count > 0 then
                result.Total = result.Total + count
            end

            -- จำกัดขนาด Log; ไม่เปลี่ยนข้อมูล Inventory จริง
            if #result.Entries < 24 then
                table.insert(result.Entries, {
                    Key = tostring(key),
                    Value = type(count) == "number"
                        and count or tostring(count),
                    ValueType = typeof(count),
                })
            end
        end

        result.Truncated = result.KeyCount > #result.Entries
        return result
    end

    local function CollectSnapshot(current)
        local mine = type(current) == "table"
            and current.MineGame or nil
        if type(mine) ~= "table" then mine = nil end

        local root = Root()
        local plot = Plot()
        local base = Child(Child(plot, "Chest"), "ChestBase")
        local prompt = Child(base, "ChestPrompt")

        local snapshot = {
            StateAvailable = mine ~= nil,
            Chest = DebugCounts(mine and mine.Chest),
            Ores = DebugCounts(mine and mine.Ores),
            Characters = DebugCounts(mine and mine.Characters),
            Money = type(current) == "table"
                and current.Money or nil,
            Plot = plot and plot:GetFullName() or "Unavailable",
        }

        if root then
            snapshot.Position = {
                X = root.Position.X,
                Y = root.Position.Y,
                Z = root.Position.Z,
            }
        end

        if root and base and base:IsA("BasePart") then
            snapshot.ChestDistance =
                (root.Position - base.Position).Magnitude
        end

        if prompt and prompt:IsA("ProximityPrompt") then
            snapshot.PromptEnabled = prompt.Enabled
            snapshot.PromptRange = prompt.MaxActivationDistance
        end

        return snapshot
    end

    local function DebugCollect(operation, current)
        if not COLLECT_DEBUG or not Active() then return end

        local now = os.clock()
        if now - collectDebugLast < COLLECT_DEBUG_INTERVAL then
            return
        end
        collectDebugLast = now

        local age = type(operation.At) == "number"
            and now - operation.At or nil
        local remote = Remote()

        local payload = {
            Operation = tostring(operation),
            At = operation.At,
            AgeSeconds = age,
            Stage = age and age >= OBSERVE_AFTER
                and "UnknownOutcome" or "AwaitingState",
            Action = operation.Action,
            CollectEnabled = settings.Collect,
            SellEnabled = settings.Sell,
            TravelPending = runtime.Pending.Travel ~= nil,
            SellPending = runtime.Pending.Sell ~= nil,
            RemotePath = remote and remote:GetFullName()
                or "Unavailable",
            DispatchError = operation.Error or "None recorded",
            DispatchPcallOK = type(operation.DebugTransportOK) == "boolean"
                and tostring(operation.DebugTransportOK) or "Not recorded",
            Execution = operation.DebugOwner == nil
                and "Unknown: operation has no debug marker"
                or (operation.DebugOwner == owner
                    and "Current execution" or "Earlier execution"),
            Before = operation.DebugBefore
                or "Unavailable: dispatched before debug was added",
            Now = CollectSnapshot(current),
        }

        local encoded, result = pcall(function()
            return DebugHttpService:JSONEncode(payload)
        end)

        if encoded then
            warn("[Zero X / Collect Debug] " .. result)
        else
            warn("[Zero X / Collect Debug] JSONEncode failed: "
                .. tostring(result))
        end
    end

    local function Send(key, record, action, ...)
        local remote = Remote()
        if not Active() or not settings[key]
            or runtime.Pending[key] or not remote then
            return false
        end

        -- Record before sending: an error does not prove non-delivery.
        record.At = os.clock()
        record.Action = action
        runtime.Pending[key] = record

        local ok, err = pcall(remote.FireServer, remote, action, ...)
        if not Active() then return true end

        if not ok then
            record.Error = tostring(err)
        end
        Status(key, ok and "Request Sent: " .. action
            or "Unknown: " .. tostring(err))
        return true
    end

    local area
    local areaCharacter

    local function CollectCount(items, key)
        if type(items) ~= "table" then return nil end
        local value = items[key]
        if value == nil then return 0 end
        return type(value) == "number" and value or nil
    end

    local function CaptureCollectTargets(current)
        local mine = current and current.MineGame
        if type(mine) ~= "table"
            or type(mine.Chest) ~= "table" then
            return nil
        end

        local targets = {}
        for key, quantity in pairs(mine.Chest) do
            if type(key) ~= "string"
                or type(quantity) ~= "number" or quantity < 0 then
                return nil
            end

            if quantity > 0 then
                targets[key] = {
                    Quantity = quantity,
                    OreBefore = CollectCount(mine.Ores, key),
                    CharacterBefore = CollectCount(mine.Characters, key),
                }
            end
        end

        return next(targets) and targets or nil
    end

    -- รองรับ Pending ที่ส่งพร้อม Debug ก่อนติดตั้งแพตช์นี้
    local function DebugSummaryCount(summary, key)
        if type(summary) ~= "table"
            or type(summary.Entries) ~= "table" then
            return nil
        end

        for _, entry in ipairs(summary.Entries) do
            if entry.Key == key then
                return type(entry.Value) == "number"
                    and entry.Value or nil
            end
        end

        -- รายการถูกตัด: ห้ามถือว่าคีย์ที่ไม่แสดงมีจำนวนเป็นศูนย์
        if summary.Truncated == false then return 0 end
        return nil
    end

    local function RecoverCollectTargets(before)
        if type(before) ~= "table" then return nil end

        local chest = before.Chest
        if type(chest) ~= "table"
            or chest.Truncated ~= false
            or type(chest.Entries) ~= "table"
            or chest.KeyCount ~= #chest.Entries then
            return nil
        end

        local targets = {}
        for _, entry in ipairs(chest.Entries) do
            if type(entry.Key) ~= "string"
                or type(entry.Value) ~= "number" or entry.Value < 0 then
                return nil
            end

            if entry.Value > 0 then
                targets[entry.Key] = {
                    Quantity = entry.Value,
                    OreBefore = DebugSummaryCount(before.Ores, entry.Key),
                    CharacterBefore = DebugSummaryCount(
                        before.Characters, entry.Key
                    ),
                }
            end
        end

        return next(targets) and targets or nil
    end

    local function CollectTargetsObserved(targets, mine)
        if type(targets) ~= "table" or not next(targets) then
            return false
        end

        for key, target in pairs(targets) do
            local ores = CollectCount(mine.Ores, key)
            local characters = CollectCount(mine.Characters, key)

            local oreGoal = type(target.OreBefore) == "number"
                and ores ~= nil
                and ores >= target.OreBefore + target.Quantity

            local characterGoal = type(target.CharacterBefore) == "number"
                and characters ~= nil
                and characters >= target.CharacterBefore + target.Quantity

            if not oreGoal and not characterGoal then
                return false
            end
        end

        return true
    end

    local function Reconcile(current)
        local pending = runtime.Pending
        local root, _, character = Root()

        local travel = pending.Travel
        if travel then
            if root and character == travel.Character
                and Within(root, travel.Spawn, ARRIVAL_RADIUS) then
                area = travel.Mode
                areaCharacter = character
                pending.Travel = nil
                Status(travel.Key, "Destination observed: " .. travel.Mode)
            else
                Status(travel.Key, os.clock() - travel.At >= OBSERVE_AFTER
                    and "Unknown: travel outcome; waiting for destination"
                    or "Request Sent: traveling to " .. travel.Mode)
            end
        end

        local tap = pending.Tap
        if tap then
            local node = tap.Node
            local hp = node and node:GetAttribute("NodeHP")
            if not node or not node:IsDescendantOf(workspace)
                or node.Parent ~= tap.Parent
                or node:GetAttribute("NodeBroken") == true
                or (type(hp) == "number" and hp < tap.HP) then
                pending.Tap = nil
                Status("Tap", "Progress / target lifecycle change observed")
            else
                Status("Tap", os.clock() - tap.At >= OBSERVE_AFTER
                    and "Blocked: no HP progress; observing current target"
                    or "Request Sent: waiting for HP update")
            end
        end

        if pending.Collect then
            DebugCollect(pending.Collect, current)
        end

        if not current then return end

        if pending.Collect then
            local operation = pending.Collect

            if not operation.CollectTargets then
                operation.CollectTargets =
                    RecoverCollectTargets(operation.DebugBefore)
            end

            local chestEmpty = next(current.MineGame.Chest) == nil
            local targetsObserved = CollectTargetsObserved(
                operation.CollectTargets,
                current.MineGame
            )

            if chestEmpty or targetsObserved then
                if pending.Collect == operation then
                    pending.Collect = nil
                    Status("Collect", chestEmpty
                        and "Completed: chest empty observed"
                        or "Completed: snapshot quantities observed")
                end
            else
                Status("Collect",
                    os.clock() - operation.At >= OBSERVE_AFTER
                        and "Unknown: snapshot quantities not confirmed"
                        or "Request Sent: waiting for snapshot quantities")
            end
        end

        local sell = pending.Sell
        if sell then
            if type(sell.Keys) ~= "table" or #sell.Keys == 0 then
                Status("Sell", "Blocked: invalid pending sale keys")
                return
            end

            local cleared = true
            for _, key in ipairs(sell.Keys) do
                if type(key) ~= "string" or key == "" then
                    Status("Sell", "Blocked: invalid pending sale key")
                    return
                end

                local count = current.MineGame.Ores[key]
                -- Accept only absent or exactly zero quantities.
                if count ~= nil and count ~= 0 then
                    cleared = false
                    break
                end
            end

            if cleared then
                if Active() and pending.Sell == sell then
                    pending.Sell = nil
                    runtime.ReturnAfterSell = true
                    Status("Sell", "State Updated: requested ores cleared; returning to Base")
                end
            else
                Status("Sell", os.clock() - sell.At >= OBSERVE_AFTER
                    and "Unknown: requested ores remain; observing without resend"
                    or "Request Sent: waiting for requested ores to clear")
            end
        end
    end

    local function EnsureArea(key, mode, spawn, character)
        if area == mode and areaCharacter == character then
            return true
        end

        if not spawn or not spawn:IsA("BasePart")
            or not spawn:IsDescendantOf(workspace) then
            Status(key, "Waiting: " .. mode .. " spawn unavailable")
            return false
        end

        if runtime.Pending.Travel then return false end
        local remote = Remote()
        if not remote or not Active() or not settings[key] then
            Status(key, "Blocked: travel transport unavailable")
            return false
        end

        local record = {
            At = os.clock(),
            Mode = mode,
            Spawn = spawn,
            Character = character,
            Key = key,
        }
        runtime.Pending.Travel = record
        area = nil
        areaCharacter = nil

        local ok, err = pcall(remote.FireServer, remote, "MineTeleport", mode)
        if not Active() then return false end
        if not ok then record.Error = tostring(err) end
        Status(key, ok and "Request Sent: travel to " .. mode
            or "Unknown: travel dispatch " .. tostring(err))
        return false
    end

    local function Weakest(plot, root)
        local nodes = Child(plot, "Nodes")
        if not nodes then return nil end

        local bestNode, bestPart, bestDetector
        local bestHP = math.huge

        for _, node in ipairs(nodes:GetChildren()) do
            if not node:IsA("Model") or node:GetAttribute("NodeBroken") == true then
                continue
            end

            local hp = node:GetAttribute("NodeHP")
            if type(hp) ~= "number" or hp <= 0 or hp >= bestHP then
                continue
            end

            local part = node.PrimaryPart or Child(node, "Rock")
            if not part or not part:IsA("BasePart") then continue end

            local detector = Child(node, "NodeClick") or Child(part, "NodeClick")
            if not detector or not detector:IsA("ClickDetector") then continue end

            local range = detector.MaxActivationDistance
            if range > 0 and (root.Position - part.Position).Magnitude <= range then
                bestNode, bestPart, bestDetector, bestHP = node, part, detector, hp
            end
        end

        return bestNode, bestPart, bestDetector, bestHP
    end

    local function Step()
        local current, stateError = State()
        if not Active() then return end

        Reconcile(current)

        if not settings.Tap and not settings.Collect and not settings.Sell then
            return
        end

        if not current then
            for _, key in ipairs({ "Tap", "Collect", "Sell" }) do
                if settings[key] then
                    Status(key, "Waiting: " .. tostring(stateError))
                end
            end
            return
        end

        local mine = current.MineGame
        local bag = Sum(mine.Ores)
        local chestCount = Sum(mine.Chest)

        local inventoryText = "Bag: " .. tostring(bag)
            .. " | Chest: " .. tostring(chestCount)

        WriteFarmLabel("Inventory", inventoryLabel, inventoryText)

        local root, _, character = Root()
        if not root then
            for _, key in ipairs({ "Tap", "Collect", "Sell" }) do
                if settings[key] then
                    Status(key, "Waiting: character alive")
                end
            end
            return
        end

        -- Observe an already dispatched teleport before starting other actions.
        if runtime.Pending.Travel then return end

        -- Do not issue another sale while its previous outcome is unknown.
        if runtime.Pending.Sell then
            local sell = runtime.Pending.Sell

            if settings.Tap then
                Status("Tap", "Waiting: sale reconciliation")
            end

            if not settings.Sell then return end

            if type(sell.Keys) ~= "table" or #sell.Keys == 0 then
                Status("Sell", "Blocked: invalid pending sale keys")
                return
            end

            local lastAttempt = math.max(
                runtime.LastSellSent,
                type(sell.At) == "number" and sell.At or 0
            )

            if os.clock() - lastAttempt < settings.Interval then
                Status("Sell", "Waiting: minimum sale interval")
                return
            end

            if mine.PendingTrade == true
                or current.MineTradeSettling == true then
                Status("Sell", "Waiting: trading / settling")
                return
            end

            local hubSpawn = Child(
                Child(Child(workspace, "MineWorld"), "Hub"),
                "MineSpawn"
            )

            if not Within(root, hubSpawn, ARRIVAL_RADIUS) then
                area = nil
                areaCharacter = nil
                EnsureArea("Sell", "Hub", hubSpawn, character)
                return
            end

            local keys = {}

            for _, key in ipairs(sell.Keys) do
                if type(key) ~= "string" or key == "" then
                    Status("Sell", "Blocked: invalid pending sale key")
                    return
                end

                local count = mine.Ores[key]

                if count ~= nil then
                    if type(count) ~= "number" or count < 0 then
                        Status("Sell", "Waiting: valid ore quantities")
                        return
                    end

                    if count > 0 then
                        table.insert(keys, key)
                    end
                end
            end

            -- Reconcile() ตรวจรายการที่หมดแล้วในรอบถัดไป
            if #keys == 0 then return end

            local Event = Remote()
            if not Event then
                Status("Sell", "Waiting: GamestateEvent available")
                return
            end

            if not Active() or not settings.Sell
                or runtime.Pending.Sell ~= sell
                or runtime.Pending.Travel then
                return
            end

            -- ผู้ใช้อนุญาตให้ Auto Sell ส่งซ้ำขณะผลเดิมยัง Unknown
            -- บันทึกเวลาก่อนส่ง เพื่อเว้นช่วงแม้การเรียกเกิด Error
            runtime.LastSellSent = os.clock()

            local ok, err = pcall(function()
                Event:FireServer("MineSellItems", keys)
            end)

            if not Active() or runtime.Pending.Sell ~= sell then
                return
            end

            sell.Error = ok and nil or tostring(err)

            Status("Sell", ok
                and "Request Sent: sale retry; awaiting ore update"
                or ("Unknown: sale retry | " .. tostring(err)))

            return
        end

        -- Return before starting another sale cycle.
        if settings.Sell and runtime.ReturnAfterSell then
            local plot = Plot()
            local baseSpawn = Child(plot, "PlotSpawn")

            if not plot then
                Status("Sell", "Waiting: owned Base available")
                return
            end

            if Within(root, baseSpawn, ARRIVAL_RADIUS) then
                runtime.ReturnAfterSell = nil
                Status("Sell", "Completed: returned to Base")
            else
                -- Require current arrival evidence, not a cached area value.
                area = nil
                areaCharacter = nil

                EnsureArea(
                    "Sell",
                    "Plot",
                    baseSpawn,
                    character
                )
            end
            return
        end

        if settings.Sell and bag >= settings.Threshold
            and os.clock() - runtime.LastSellSent >= settings.Interval then

            if runtime.Pending.Collect then
                Status("Sell", "Waiting: collection reconciliation")
                -- Collection is pending; independent tapping may continue below.
            elseif type(current.Money) ~= "number" then
                Status("Sell", "Blocked: money state unavailable")
            elseif not Remote() then
                Status("Sell", "Waiting: GamestateEvent available")
            else
                local hubSpawn = Child(
                    Child(Child(workspace, "MineWorld"), "Hub"),
                    "MineSpawn"
                )

                -- Verify current position instead of trusting an old area cache.
                if not Within(root, hubSpawn, ARRIVAL_RADIUS) then
                    area = nil
                    areaCharacter = nil
                    EnsureArea("Sell", "Hub", hubSpawn, character)
                    return
                end

                if not Active() or not settings.Sell
                    or runtime.Pending.Travel or runtime.Pending.Sell then
                    return
                end

                local keys = {}
                for key, count in pairs(mine.Ores) do
                    if type(key) == "string"
                        and type(count) == "number" and count > 0 then
                        table.insert(keys, key)
                    end
                end
                table.sort(keys)

                if #keys > 0 and Send("Sell", {
                    Keys = keys,
                    Money = current.Money,
                }, "MineSellItems", keys) then
                    runtime.LastSellSent = os.clock()
                end
                return
            end
        elseif settings.Sell then
            Status("Sell", bag < settings.Threshold
                and "Waiting: bag threshold"
                or "Waiting: minimum sale interval")
        end

        -- Direct chest request: no ChestPrompt, distance check, or movement.
        if settings.Collect and not runtime.Pending.Collect then
            if chestCount > 0 then
                if not Remote() then
                    Status("Collect", "Waiting: GamestateEvent available")
                else
                    local Event = Remote()

                    if Active() and settings.Collect
                        and not runtime.Pending.Collect
                        and Event then

                        local operation = {
                            Action = "MineTakeChest",
                            At = os.clock(),
                            CollectTargets = CaptureCollectTargets(current),
                            DebugBefore = CollectSnapshot(current),
                            DebugOwner = owner,
                        }
                        runtime.Pending.Collect = operation

                        local ok, err = pcall(function()
                            Event:FireServer("MineTakeChest")
                        end)

                        if not ok then
                            operation.Error = tostring(err)
                        end

                        operation.DebugTransportOK = ok

                        if Active() then
                            Status("Collect", ok
                                and "Request Sent: MineTakeChest"
                                or ("Unknown: " .. tostring(err)))
                        end
                    end
                end
            else
                Status("Collect", "Waiting: chest contents")
            end
        end

        if not settings.Tap or runtime.Pending.Tap then return end

        local plot = Plot()
        if not plot then
            Status("Tap", "Waiting: owned plot")
            return
        end

        local click = env.fireclickdetector
        if type(click) ~= "function" then
            Status("Tap", "Blocked: fireclickdetector unavailable")
            return
        end

        local node, part, detector, hp = Weakest(plot, root)
        if not node then
            Status("Tap", "Waiting: eligible rock within click range")
            return
        end

        if not Active() or not settings.Tap or runtime.Pending.Tap
            or node.Parent ~= Child(plot, "Nodes")
            or plot:GetAttribute("OwnerUserId") ~= LocalPlayer.UserId
            or node:GetAttribute("NodeBroken") == true
            or node:GetAttribute("NodeHP") ~= hp
            or not part:IsDescendantOf(node)
            or not detector:IsDescendantOf(node)
            or detector.MaxActivationDistance <= 0
            or (root.Position - part.Position).Magnitude > detector.MaxActivationDistance then
            return
        end

        runtime.Pending.Tap = {
            Node = node,
            Parent = node.Parent,
            HP = hp,
            At = os.clock(),
        }

        local ok, err = pcall(click, detector)
        if not Active() then return end

        Status("Tap", ok
            and ("Request Sent: " .. node.Name .. " | HP " .. tostring(hp))
            or ("Unknown: click dispatch " .. tostring(err)))
    end

    MacUI:OnUnload(function()
        alive = false
        if stateConnection then
            stateConnection:Disconnect()
            stateConnection = nil
        end
        -- Preserve dispatched operations for reconciliation after re-execution.
        -- Never reset user toggles or assume a server cancellation.
    end)

    task.spawn(function()
        local failureDelay = 1
        local nextWarningAt = 0

        while Active() do
            local ok, err = xpcall(Step, function(reason)
                return debug.traceback(tostring(reason), 2)
            end)

            if not Active() then break end

            if not ok then
                local now = os.clock()
                if now >= nextWarningAt then
                    nextWarningAt = now + 5
                    warn("[Zero X / Farm Worker / Step] " .. tostring(err))
                end

                -- Existing reconciliation owns any already-sent operation.
                task.wait(failureDelay)
                failureDelay = math.min(failureDelay * 2, 8)
            else
                failureDelay = 1
                task.wait(TICK)
            end
        end
    end)
end

