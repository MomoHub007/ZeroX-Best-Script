        local function Remote()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local event = remotes and remotes:FindFirstChild("GamestateEvent")
            return event and event:IsA("RemoteEvent") and event or nil
        end

        local function ResultRemote()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local result = remotes and remotes:FindFirstChild("MineFX")
            return result and result:IsA("RemoteEvent") and result or nil
        end

        local function BindResults(event)
            local observer = runtime.EnchantObserver
            if observer and observer.Remote == event
                and observer.Connection and observer.Connection.Connected then
                return
            end

            if observer and observer.Connection then
                observer.Connection:Disconnect()
            end

            observer = { Remote = event }
            runtime.EnchantObserver = observer

            -- Capture sent-operation results across UI re-execution/unload.
            -- This callback never dispatches actions.
            observer.Connection = event.OnClientEvent:Connect(function(packet)
                if runtime.EnchantObserver ~= observer then return end
                if type(packet) ~= "table" or packet.t ~= "enchant" then
                    return
                end

                local pending = runtime.EnchantPending
                if type(pending) ~= "table"
                    or pending.Kind ~= "Roll"
                    or pending.ResultRemote ~= event
                    or pending.Receipt then
                    return
                end

                if packet.refused == true then
                    pending.Receipt = { Refused = true }
                    return
                end

                local validRefused = packet.refused == nil
                    or packet.refused == false
                local validNames = packet.names == nil
                    or (type(packet.names) == "table"
                        and #packet.names == 1
                        and packet.names[1] == packet.best)

                if validRefused and validNames
                    and type(packet.best) == "string"
                    and packet.best ~= "" then
                    pending.Receipt = { Name = packet.best }
                else
                    pending.PacketIssue =
                        "Unknown: unsupported enchant result packet"
                end
            end)
        end

        local function DiceKind(label)
            if label == "Enchanted Dice" then return nil, true end
            if label == "Halloween Dice" then return "Halloween", true end
            return nil, false
        end

        local function DiceCount(mine, Config, Catalog, label)
            local kind, valid = DiceKind(label)
            if not valid then return nil end

            local count
            if kind == nil then
                count = Config.GetEnchantDiceCount(mine)
            else
                count = Catalog.DiceCount(mine, kind)
            end

            return Integer(count) and count or nil
        end

        local function SaverCharges(mine)
            if type(mine.Boosts) ~= "table" then return nil end
            local boost = mine.Boosts.DiceSaver
            if boost == nil then return 0 end
            if type(boost) ~= "table" then return nil end

            local count = boost.Charges == nil
                and 0 or tonumber(boost.Charges)
            return Integer(count) and count or nil
        end

        local function SpareCount(mine, Config, name)
            local count = Config.GetEnchantItemCount(mine, name)
            return Integer(count) and count or nil
        end

        local function SpareSnapshot(mine)
            if mine.EnchantItems ~= nil
                and type(mine.EnchantItems) ~= "table" then
                return nil
            end

            local snapshot = {}
            for name, count in pairs(mine.EnchantItems or {}) do
                if type(name) ~= "string" or not Integer(count) then
                    return nil
                end
                snapshot[name] = count
            end
            return snapshot
        end

        local function AtLeast(Catalog, current, target)
            return current ~= nil
                and (current.Name == target.Name
                    or Catalog.Rarer(current, target) == true)
        end

        local function RollConflict(kind)
            local potion = runtime.PotionPending
            if potion and (type(potion) ~= "table"
                or potion.Family == nil
                or potion.Family == "DiceSaver") then
                return "Waiting: Dice Saver potion reconciliation"
            end

            local purchase = runtime.GemShopPending
            if kind == "Halloween" and type(purchase) == "table"
                and purchase.Kind == "HalloweenDice" then
                return "Waiting: Halloween Dice purchase"
            end

            return nil
        end

        local function Eligible(holder)
            return type(holder) == "table"
                and type(holder.CharName) == "string"
                and holder.CharName ~= ""
                and holder.Pickaxe ~= nil
        end

        local function Plan(mine, Config, Catalog, target)
            local lowest
            local eligibleCount = 0

            for key, holder in pairs(mine.Holders) do
                if Eligible(holder) then
                    if type(key) ~= "string" then
                        return nil, "Invalid holder key"
                    end

                    eligibleCount += 1
                    local name = Config.GetHolderEnchantName(mine, key)
                    local def

                    if name ~= nil then
                        if type(name) ~= "string" then
                            return nil, "Invalid equipped enchant"
                        end
                        def = Catalog.ByName(name)
                        if type(def) ~= "table" then
                            return nil, "Equipped enchant definition unavailable"
                        end
                    end

                    if not AtLeast(Catalog, def, target) then
                        local candidate = {
                            HolderKey = key,
                            CharName = holder.CharName,
                            Variant = NormalVariant(holder.Variant),
                            Current = def,
                        }

                        local replace = lowest == nil
                        if lowest then
                            if def == nil then
                                replace = lowest.Current ~= nil
                                    or key < lowest.HolderKey
                            elseif lowest.Current ~= nil then
                                replace = Catalog.Rarer(lowest.Current, def)
                                    or (not Catalog.Rarer(def, lowest.Current)
                                        and key < lowest.HolderKey)
                            end
                        end

                        if replace then lowest = candidate end
                    end
                end
            end

            if eligibleCount == 0 then
                return nil, "Waiting: no eligible placed miners"
            end
            if not lowest then
                return { Complete = true }
            end

            local best
            for name, rawCount in pairs(mine.EnchantItems or {}) do
                if type(name) ~= "string" or not Integer(rawCount) then
                    return nil, "Invalid spare enchant inventory"
                end

                if rawCount > 0 then
                    local def = Catalog.ByName(name)
                    if type(def) == "table"
                        and (lowest.Current == nil
                            or Catalog.Rarer(def, lowest.Current))
                        and (best == nil or Catalog.Rarer(def, best)) then
                        best = def
                    end
                end
            end

            if best then
                lowest.Kind = "Equip"
                lowest.Name = best.Name
                lowest.InitialCount = SpareCount(mine, Config, best.Name)
            else
                lowest.Kind = "Roll"
            end

            return lowest
        end

        local function StepEnchant()
            local now = os.clock()
            if now < nextCheckAt then return end
            nextCheckAt = now + 1 -- Local planning interval, not server cooldown.

            stage = "Catalog"
            local Catalog, catalogError = LoadModule("MineEnchantCatalog")
            if not Active() then return end

            local pending = runtime.EnchantPending
            if autoRoll.Value ~= true and not manualRequest and not pending then
                return
            end

            if not Catalog then
                Log("Waiting: " .. tostring(catalogError))
                return
            end

            for _, name in ipairs({
                "ByName", "Rarer", "Unlocked", "DiceCount", "Rollable",
            }) do
                if type(Catalog[name]) ~= "function" then
                    Log("Blocked: MineEnchantCatalog." .. name .. " unavailable")
                    return
                end
            end

            stage = "Dependencies"
            local Config, configError = LoadModule("MineConfig")
            if not Active() then return end
            local GameState, stateError = LoadModule("GameState")
            if not Active() then return end

            if not Config or not GameState then
                Log("Waiting: " .. tostring(configError or stateError))
                return
            end

            for _, name in ipairs({
                "GetEnchantDiceCount",
                "GetHolderEnchantName",
                "GetEnchantItemCount",
            }) do
                if type(Config[name]) ~= "function" then
                    Log("Blocked: MineConfig." .. name .. " unavailable")
                    return
                end
            end

            local event = Remote()
            if not event then
                Log("Waiting: GamestateEvent")
                return
            end

            local resultEvent = ResultRemote()
            if not resultEvent then
                Log("Waiting: MineFX result remote")
                return
            end

            BindResults(resultEvent)

            local current, readError = ReadData(GameState)
            if not Active() then return end
            if not current then
                Log("Waiting: " .. tostring(readError))
                return
            end

            local mine = current.MineGame
            stage = "Reconcile"
            pending = runtime.EnchantPending

            if pending then
                if pending.Kind == "Equip" then
                    local holder = mine.Holders[pending.HolderKey]
                    local sameHolder = Eligible(holder)
                        and holder.CharName == pending.CharName
                        and NormalVariant(holder.Variant) == pending.Variant

                    local count = SpareCount(mine, Config, pending.Name)
                    local equipped = Config.GetHolderEnchantName(
                        mine, pending.HolderKey
                    )

                    if sameHolder and equipped == pending.Name
                        and count ~= nil
                        and count <= pending.InitialCount - 1 then
                        if runtime.EnchantPending == pending then
                            runtime.EnchantPending = nil
                        end
                        Log("State Updated: " .. pending.Name
                            .. " on " .. pending.HolderKey)
                    else
                        Log("Unknown: awaiting equip state | "
                            .. tostring(pending.HolderKey)
                            .. (pending.Error and (" | " .. pending.Error) or ""))
                    end
                    return
                elseif pending.Kind ~= "Roll" then
                    Log("Blocked: invalid EnchantPending kind")
                    return
                end

                local receipt = pending.Receipt
                if receipt and receipt.Refused then
                    runtime.EnchantRollBlocked = {
                        Reason = "Server refused enchant roll",
                    }
                    if runtime.EnchantPending == pending then
                        runtime.EnchantPending = nil
                    end
                    Log("Blocked: roll refused; inspect rejection before retrying")
                    return
                end

                local count = DiceCount(
                    mine, Config, Catalog, pending.DiceLabel
                )
                local saver = SaverCharges(mine)

                if count == nil or saver == nil then
                    Log("Waiting: dice / Dice Saver state")
                    return
                end

                if count < pending.InitialDice
                    or saver < pending.InitialSaver then
                    pending.CostObserved = true
                end

                if receipt and type(receipt.Name) == "string" then
                    local def = Catalog.ByName(receipt.Name)

                    -- Native result packet confirms the rolled result.
                    -- Still wait for resource reconciliation before another roll.
                    if type(def) == "table" and pending.CostObserved then
                        if runtime.EnchantPending == pending then
                            runtime.EnchantPending = nil
                        end

                        Log("State Updated: rolled " .. receipt.Name)
                        return
                    end
                end

                Log(pending.PacketIssue
                    or ("Unknown: awaiting roll receipt / inventory state"
                        .. (pending.Error and (" | " .. pending.Error) or "")))
                return
            end

            if manualRequest
                and manualRequest.DiceLabel ~= diceOption.Value then
                manualRequest = nil
                Log("Cancelled: manual dice selection changed")
                return
            end

            if autoRoll.Value ~= true and not manualRequest then return end

            if mine.PendingTrade == true
                or current.MineTradeSettling == true
                or LocalPlayer:GetAttribute("MineTradeSettling") == true
                or LocalPlayer:GetAttribute("ReloadingPlayerData") == true
                or current.SaveTooLarge == true then
                Log("Waiting: native trade / data guards")
                return
            end

            if Catalog.Unlocked(mine) ~= true then
                Log("Waiting: enchant altar not unlocked")
                return
            end

            -- Auto and manual rolls use the selected dice reserve.
            -- Existing pending operations are reconciled above this point.
            local action

            if runtime.EnchantRollBlocked then
                Log("Blocked: prior roll refused; investigation required")
                return
            end

            local kind, validKind = DiceKind(diceOption.Value)
            if not validKind then
                Log("Blocked: unsupported dice selection")
                return
            end

            local conflict = RollConflict(kind)
            if conflict then Log(conflict); return end

            local reserve = tonumber(keepOption.Value)
            local count = DiceCount(mine, Config, Catalog, diceOption.Value)
            local saver = SaverCharges(mine)

            if not Integer(reserve) then
                Log("Waiting: Keep dice must be a non-negative integer")
                return
            end
            if count == nil or saver == nil then
                Log("Waiting: dice / Dice Saver state")
                return
            end
            if count <= reserve then
                Log("Waiting: dice above Keep dice reserve")
                return
            end

            local pool = Catalog.Rollable(nil, kind)
            if type(pool) ~= "table" or #pool == 0 then
                Log("Waiting: selected dice pool available")
                return
            end


            local snapshot = SpareSnapshot(mine)
            if not snapshot then
                Log("Blocked: invalid spare enchant inventory")
                return
            end

            if not Active() or runtime.EnchantPending
                or (autoRoll.Value ~= true and not manualRequest)
                or RollConflict(kind) or Remote() ~= event
                or ResultRemote() ~= resultEvent then
                return
            end

            action = {
                Kind = "Roll",
                DiceKind = kind,
                DiceLabel = diceOption.Value,
                InitialDice = count,
                InitialSaver = saver,
                ItemsBefore = snapshot,
                Remote = event,
                ResultRemote = resultEvent,
                At = os.clock(),
            }

            runtime.EnchantPending = action
            manualRequest = nil
            stage = "Roll"

            local ok, err = pcall(
                event.FireServer, event,
                "MineRollEnchant", 1, kind
            )
            if not ok then action.Error = tostring(err) end

            Log(ok
                and ("Request Sent: one " .. action.DiceLabel)
                or ("Unknown: roll dispatch | " .. tostring(err)))
        end

        function EnchantAuto.Step()
            if not Active() then return end
            local ok, err = pcall(StepEnchant)
            if not ok then
                Log(stage .. ": " .. tostring(err))
            end
        end
    end

    local PotionAuto = {}
    runtime.PotionGemGuardOwner = owner

    do
        local nextCheckAt = 0
        local lastLogAt = -math.huge
        local lastLog
        local stage = "Idle"

        local function Log(message)
            if not Active() then return end

            local now = os.clock()
            if now - lastLogAt < 5 then return end
            if message == lastLog and now - lastLogAt < 30 then return end

            lastLog = message
            lastLogAt = now
            warn("[Zero X / Potions] " .. message)
        end

        local function Integer(value)
            return Number(value) and value == math.floor(value)
        end

        local function CatalogRows(Catalog)
            if type(Catalog) ~= "table"
                or type(Catalog.Potions) ~= "table" then
                return nil, nil, nil, nil
            end

            local families = {}
            local rows = {}
            local labels = {}
            local labelsByItem = {}

            for _, def in pairs(Catalog.Potions) do
                if type(def) == "table"
                    and type(def.ItemName) == "string"
                    and def.ItemName ~= ""
                    and type(def.Family) == "string"
                    and def.Family ~= ""
                    and (def.Kind == "Timed" or def.Kind == "Charge")
                    and not labelsByItem[def.ItemName] then

                    local label = def.ItemName
                    local rarity = type(def.Rarity) == "table"
                        and def.Rarity.Rarity or nil

                    if type(rarity) == "string" and rarity ~= "" then
                        label = label .. " [" .. rarity .. "]"
                    end

                    labelsByItem[def.ItemName] = label
                    labels[#labels + 1] = label

                    if not rows[def.Family] then
                        rows[def.Family] = {}
                        families[#families + 1] = def.Family
                    end

                    table.insert(rows[def.Family], def)
                end
            end

            table.sort(families)
            table.sort(labels)
            return families, rows, labels, labelsByItem
        end

        local initialCatalog = LoadModule("MinePotionCatalog")
