    local function StepEquipBest(current)
        local mine = current.MineGame
        local holderSignature = MinerSignature(mine.Holders, true)
        local bagSignature = MinerSignature(mine.Characters, false)
        local pending = runtime.EquipBestPending

        if pending then
            if holderSignature
                and holderSignature ~= pending.HoldersBefore then

                if runtime.EquipBestPending == pending then
                    runtime.EquipBestPending = nil
                    runtime.LastEquipBestBag = bagSignature
                    EquipReport("Holders update observed after Equip Best")
                end
            else
                EquipReport(os.clock() - pending.At >= OBSERVE_AFTER
                    and "Unknown: Equip Best outcome; no resend"
                    or "Request Sent: waiting for Holders update")
            end
            return true
        end

        if type(runtime.EnchantPending) == "table"
            and runtime.EnchantPending.Kind == "Equip" then
            if autoEquipBest.Value == true or manualEquipRequested then
                EquipReport("Waiting: Enchant equip reconciliation")
            end
            return false
        end

        if runtime.PickaxePending then
            if autoEquipBest.Value == true or manualEquipRequested then
                EquipReport("Waiting: Pickaxe reconciliation")
            end
            return false
        end

        local automatic = autoEquipBest.Value == true
        if not automatic and not manualEquipRequested then
            return false
        end

        if not holderSignature or not bagSignature then
            EquipReport("Waiting: Holders / Characters schema")
            return true
        end

        local now = os.clock()
        local periodicDue = runtime.LastEquipBestSent == nil
            or now - runtime.LastEquipBestSent >= 60
        local bagChanged = bagSignature ~= runtime.LastEquipBestBag

        if not manualEquipRequested
            and not (automatic and (bagChanged or periodicDue)) then
            return false
        end

        if runtime.Pending then
            EquipReport("Waiting: upgrade reconciliation")
            return true
        end

        local plot = OwnedPlot()
        if not plot then
            EquipReport("Waiting: owned plot")
            return true
        end

        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local Event = remotes and remotes:FindFirstChild("GamestateEvent")

        if not Event or not Event:IsA("RemoteEvent") then
            EquipReport("Waiting: GamestateEvent")
            return true
        end

        if not Active() or runtime.Pending or runtime.EquipBestPending
            or not plot:IsDescendantOf(workspace)
            or plot:GetAttribute("OwnerUserId") ~= LocalPlayer.UserId then
            return true
        end

        if not manualEquipRequested and autoEquipBest.Value ~= true then
            return false
        end

        local operation = {
            At = now,
            Source = manualEquipRequested and "Manual" or "Auto",
            HoldersBefore = holderSignature,
            BagBefore = bagSignature,
        }

        runtime.EquipBestPending = operation
        runtime.LastEquipBestSent = now
        runtime.LastEquipBestBag = bagSignature
        manualEquipRequested = false

        local ok, err = pcall(function()
            Event:FireServer("MineEquipBest")
        end)

        operation.DispatchPcallOK = ok
        if not ok then operation.Error = tostring(err) end

        if Active() then
            EquipReport(ok
                and "Request Sent: MineEquipBest"
                or ("Unknown: Equip Best dispatch " .. tostring(err)))
        end

        return true
    end

