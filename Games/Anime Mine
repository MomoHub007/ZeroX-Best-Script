        local function BindResults(remote)
            local record = runtime.SummonObserver

            if type(record) == "table"
                and record.Remote == remote
                and record.Connection
                and record.Connection.Connected then
                return
            end

            if type(record) == "table" and record.Connection then
                record.Connection:Disconnect()
            end

            record = { Remote = remote }
            runtime.SummonObserver = record

            -- Keep observing a sent request when this UI unloads.
            -- This callback records receipts only; it never dispatches actions.
            record.Connection = remote.OnClientEvent:Connect(function(packet)
                if runtime.SummonObserver ~= record then return end
                if type(packet) ~= "table" or packet.t ~= "summon" then
                    return
                end

                local pending = runtime.SummonPending
                if type(pending) ~= "table"
                    or pending.Remote ~= remote
                    or pending.Receipt then
                    return
                end

                if packet.refused == true then
                    pending.Receipt = {
                        Kind = "Refused",
                        At = os.clock(),
                    }
                elseif packet.refused == nil or packet.refused == false then
                    -- This worker dispatches single summons only.
                    -- Do not interpret a batch result as its receipt.
                    if type(packet.name) == "string"
                        and packet.name ~= ""
                        and packet.pulls == nil then
                        pending.Receipt = {
                            Kind = "Result",
                            Name = packet.name,
                            At = os.clock(),
                        }
                    else
                        pending.PacketIssue =
                            "Unknown: summon packet has an unsupported result shape"
                    end
                else
                    pending.PacketIssue =
                        "Unknown: invalid summon refusal field"
                end
            end)
        end

        local function BlueMoonActive(Weather)
            local events = Weather.GetActive()
            if type(events) ~= "table" then
                return nil, "GetActive returned an invalid value"
            end

            for _, event in ipairs(events) do
                if type(event) == "table"
                    and event.Name == "Blue Moon" then
                    return true
                end
            end

            return false
        end

        local function BagRoom(mine, Config)
            if type(mine.Characters) ~= "table" then
                return nil, "Characters not ready"
            end

            local maximum = Config.MaxCharStacks
            if not Integer(maximum) or maximum < 1 then
                return nil, "MaxCharStacks unavailable / invalid"
            end

            local used = 0
            for _, count in pairs(mine.Characters) do
                if not Integer(count) then
                    return nil, "Invalid character stack count"
                end
                if count > 0 then
                    used += 1
                end
            end

            return used < maximum
        end

        local function StepSummon()
            if not Active() then return end

            local pending = runtime.SummonPending
            if autoSummon.Value ~= true and not pending then
                return
            end

            local now = os.clock()
            if now < nextCheckAt then return end

            -- Local observation/planning interval, not a server cooldown.
            nextCheckAt = now + 1

            stage = "BindResults"
            local remote = GetRemote()
            if not remote then
                Log("Waiting: GamestateEvent unavailable")
                return
            end
            BindResults(remote)

            stage = "ReadData"
            local GameState, stateError = LoadModule("GameState")
            if not Active() then return end
            if not GameState then
                Log("Waiting: " .. tostring(stateError))
                return
            end

            local Config, configError = LoadModule("MineConfig")
            if not Active() then return end
            if not Config then
                Log("Waiting: " .. tostring(configError))
                return
            end

            if type(Config.GetSummonScrollCount) ~= "function" then
                Log("Blocked: GetSummonScrollCount unavailable")
                return
            end

            local current, readError = ReadData(GameState)
            if not Active() then return end
            if not current then
                Log("Waiting: " .. tostring(readError))
                return
            end

            local mine = current.MineGame
            local scrolls = Config.GetSummonScrollCount(mine)
            if not Integer(scrolls) then
                Log("Blocked: invalid Summon Scroll count")
                return
            end

            stage = "Reconcile"
            pending = runtime.SummonPending

            if pending then
                local receipt = pending.Receipt

                if receipt and receipt.Kind == "Refused" then
                    -- The response is terminal, but its rejection reason
                    -- and a valid retry condition are not available.
                    runtime.SummonBlocked = {
                        At = receipt.At,
                        Reason = "Server refused the summon",
                    }

                    if runtime.SummonPending == pending then
                        runtime.SummonPending = nil
                    end

                    Log("Blocked: server refused; inspect the rejection before retrying")
                    return
                end

                if receipt and receipt.Kind == "Result" then
                    if Integer(pending.InitialScrolls)
                        and scrolls <= pending.InitialScrolls - 1 then
                        if runtime.SummonPending == pending then
                            runtime.SummonPending = nil
                        end

                        Log("Completed: " .. receipt.Name)
                    else
                        Log("Result received: waiting for Scroll state")
                    end
                    return
                end

                Log(pending.PacketIssue
                    or (pending.Error
                        and ("Unknown: dispatch | " .. pending.Error))
                    or "Unknown: awaiting summon response; no duplicate request")
                return
            end

            if autoSummon.Value ~= true then return end

            if runtime.SummonBlocked then
                Log("Blocked: server refused; rejection requires investigation")
                return
            end

            stage = "LoadEligibility"
            local Catalog, catalogError = LoadModule("MineSummonCatalog")
            if not Active() then return end
            if not Catalog then
                Log("Waiting: " .. tostring(catalogError))
                return
            end
            if type(Catalog.Unlocked) ~= "function" then
                Log("Blocked: MineSummonCatalog.Unlocked unavailable")
                return
            end

            local Weather
            if holdBlueMoon.Value == true then
                local weatherError
                Weather, weatherError = LoadModule("MineWeather")
                if not Active() then return end
                if not Weather then
                    Log("Waiting: " .. tostring(weatherError))
                    return
                end
                if type(Weather.GetActive) ~= "function" then
                    Log("Blocked: MineWeather.GetActive unavailable")
                    return
                end
            end

            -- Refresh after module loading, which may yield.
            stage = "ValidateBeforeDispatch"
            current, readError = ReadData(GameState)
            if not Active() then return end
            if not current then
                Log("Waiting: " .. tostring(readError))
                return
            end

            mine = current.MineGame
            scrolls = Config.GetSummonScrollCount(mine)
            if not Integer(scrolls) then
                Log("Blocked: invalid Summon Scroll count")
                return
            end

            if Catalog.Unlocked(mine) ~= true then
                Log("Waiting: shrine not unlocked")
                return
            end

            if scrolls < 1 then
                Log("Waiting: Summon Scrolls")
                return
            end

            local room, roomError = BagRoom(mine, Config)
            if room ~= true then
                Log(room == false
                    and "Waiting: character bag full"
                    or ("Waiting: " .. tostring(roomError)))
                return
            end

            if mine.PendingTrade == true
                or current.MineTradeSettling == true
                or LocalPlayer:GetAttribute("MineTradeSettling") == true
                or LocalPlayer:GetAttribute("ReloadingPlayerData") == true
                or current.SaveTooLarge == true then
                Log("Waiting: native trade / data guards")
                return
            end

            if holdBlueMoon.Value == true then
                if not Weather then return end

                local blue, weatherError = BlueMoonActive(Weather)
                if blue ~= true then
                    Log(blue == false
                        and "Waiting: Blue Moon"
                        or ("Waiting: " .. tostring(weatherError)))
                    return
                end
            end

            if not Active()
                or autoSummon.Value ~= true
                or runtime.SummonPending
                or runtime.SummonBlocked
                or GetRemote() ~= remote then
                return
            end

            local observer = runtime.SummonObserver
            if not observer or observer.Remote ~= remote
                or not observer.Connection
                or not observer.Connection.Connected then
                Log("Waiting: summon result observer")
                return
            end

            local operation = {
                Count = 1,
                InitialScrolls = scrolls,
                Remote = remote,
                At = os.clock(),
            }

            -- Record before dispatch so an early response is not lost.
            runtime.SummonPending = operation
            stage = "Dispatch"

            local sent, sendError = pcall(
                remote.FireServer, remote, "MineSummon", 1
            )

            if not sent then
                operation.Error = tostring(sendError)
            end

            if not Active() then return end
            Log(sent
                and "Request Sent: MineSummon / 1"
                or ("Unknown: dispatch | " .. tostring(sendError)))
        end

        function SummonAuto.Step()
            if not Active() then return end

            -- Contain errors in this feature without terminating the
            -- existing worker or releasing an unresolved transaction.
            local ok, err = pcall(StepSummon)
            if not ok then
                Log(stage .. ": " .. tostring(err))
            end
        end
    end

    -- แต่ละระบบมีผู้เรียก Step ของตัวเองเพียงหนึ่งตัว
    for _, feature in ipairs({
        EnchantAuto,
        GemShopAuto,
        PotionAuto,
        RewardAuto,
        SummonAuto,
    }) do
        local currentFeature = feature

        task.spawn(function()
            local failureDelay = 1

            while Active() do
                local ok, err = xpcall(function()
                    if Active() then
                        currentFeature.Step()
                    end
                end, function(reason)
                    return debug.traceback(tostring(reason), 2)
                end)

                if not Active() then break end

                if ok then
                    failureDelay = 1
                    task.wait(TICK)
                else
                    -- ใช้ช่องรายงานภายในเดิม
                    -- ตั้งเวลารอใหม่ โดยเก็บ Pending เดิมไว้
                    TreeUpgrade.Report(tostring(err))
                    task.wait(failureDelay)
                    failureDelay = math.min(failureDelay * 2, 8)
                end
            end
        end)
    end

    local function Step()

        if enabled.Value ~= true
            and autoEquipBest.Value ~= true
            and not manualEquipRequested
            and not runtime.Pending
            and not runtime.EquipBestPending
            and not ManagementMode()
            and not runtime.PlaceJob
            and not TreeUpgrade.Enabled()
            and not runtime.TreePending
            and not ZoneGear.Enabled()
            and not runtime.ZonePending
            and not PickaxeAuto.Enabled()
            and not PickaxeAuto.NeedsCatalog()
            and not runtime.PickaxePending then
            ZoneGear.Report("Disabled")
            TreeUpgrade.Report("Disabled")
            Report("Disabled")
            return
        end

        local GameState, stateError = LoadModule("GameState")
        if not Active() then return end
        if not GameState then
            PickaxeAuto.Log("Waiting: " .. tostring(stateError))
            ZoneGear.Report("Waiting: " .. tostring(stateError))
            TreeUpgrade.Report("Waiting: " .. tostring(stateError))
            Report("Waiting: " .. tostring(stateError))
            return
        end

        local current, dataError = ReadData(GameState)
        if not current then
            PickaxeAuto.Log("Waiting: " .. tostring(dataError))
            ZoneGear.Report("Waiting: " .. tostring(dataError))
            TreeUpgrade.Report("Waiting: " .. tostring(dataError))
            Report("Waiting: " .. tostring(dataError))
            return
        end

        -- Reconcile purchases and equip owned gear even while Money upgrades wait.
        PickaxeAuto.Step(current, GameState, true)
        if not Active() then return end

        if ZoneGear.Step(current, GameState) then
            if not Active() then return end

            local zonePending = runtime.ZonePending
            local unlocked = current.MineGame.UnlockedZones

            -- A pending selection of an already-unlocked zone
            -- must not starve physical Miner management.
            if zonePending
                and zonePending.Kind == "Select"
                and type(unlocked) == "table"
                and unlocked[zonePending.Key] == true then
                StepMinerManagement(current, GameState)
            else
                local mode = ManagementMode()
                if mode then
                    ManagementReport(
                        mode,
                        "Waiting: zone transition reconciliation"
                    )
                end
            end

            return
        end

        if runtime.TreePending then
            if not Active() then return end

            -- Physical Miner management does not dispatch Money upgrades.
            StepMinerManagement(current, GameState)
            return
        end

        if runtime.Pending
            and (autoEquipBest.Value == true or manualEquipRequested) then
            EquipReport("Waiting: upgrade reconciliation")
        end

        local pending = runtime.Pending
        if pending then
            DebugUpgrade(pending, current)

            local correctField = fields[pending.Stat]

            if not correctField or pending.Field ~= correctField then
                Report("Blocked: legacy pending uses incorrect field "
                    .. tostring(pending.Field)
                    .. " | Native field: " .. tostring(correctField)
                    .. " | Start a fresh game session")
                return
            end

            local holder = current.MineGame.Holders[pending.HolderKey]
            local sameMiner = type(holder) == "table"
                and holder.CharName == pending.CharName
                and holder.Variant == pending.Variant

            local level = sameMiner and Level(holder, pending.Field)

            if level and level >= pending.ExpectedLevel then
                if runtime.Pending == pending then
                    runtime.Pending = nil
                    Report("Level observed: " .. pending.HolderKey
                        .. " / " .. pending.Stat .. " = " .. tostring(level))
                end
            else
                local stage = os.clock() - pending.At >= OBSERVE_AFTER
                    and "Unknown: awaiting upgrade state"
                    or "Request Sent: awaiting level"

                Report(stage .. " | " .. pending.HolderKey
                    .. "/" .. pending.Stat
                    .. (sameMiner and "" or " | miner missing/replaced")
                    .. (enabled.Value == true and "" or " | Toggle Off"))
            end
            return
        end

        -- Finish dispatched work before selecting another operation.
        if runtime.PlaceJob then
            StepMinerManagement(current, GameState)
            if not Active() then return end

            return
        end

        if runtime.EquipBestPending or manualEquipRequested then
            if StepEquipBest(current) then return end
        end

        if StepMinerManagement(current, GameState) then return end

        if PickaxeAuto.Step(current, GameState, false) then return end

        -- Prevent native Equip Best from undoing a custom selection policy.
        if ManagementOn("ZeroXZoneRarityEquip")
            or ManagementOn("ZeroXSmartSwapMiners") then
            if autoEquipBest.Value == true then
                EquipReport("Waiting: custom miner selection has priority")
            end
        elseif StepEquipBest(current) then
            return
        end

        if enabled.Value ~= true then return end

        local plot = OwnedPlot()
        if not plot then
            Report("Waiting: owned plot")
            return
        end

        local Config, configError = LoadModule("MineConfig")
        if not Active() then return end
        if not Config then
            Report("Blocked: " .. tostring(configError))
            return
        end

        local Items, itemsError = LoadModule("Items")
        if not Active() then return end
        if not Items then
            Report("Blocked: " .. tostring(itemsError))
            return
        end

        -- Refresh after module loads, which may yield.
        current, dataError = ReadData(GameState)
        if not current then
            Report("Waiting: " .. tostring(dataError))
            return
        end

        local cap = levelCap.Value
        if not Number(cap) or cap < 1 then
            Report("Blocked: invalid Level cap")
            return
        end
        cap = math.floor(math.min(cap, 200))

        local candidate, candidateError = SelectCandidate(
            current, Config, Items, priority.Value, cap
        )

        if candidateError then
            Report("Blocked: " .. candidateError)
            return
        end

        if not candidate then
            Report("Completed / Waiting: no upgrades below current caps")
            return
        end

        if current.Money < candidate.Cost then
            Report("Waiting funds: " .. candidate.HolderKey
                .. "/" .. candidate.Stat
                .. " | Cost " .. tostring(candidate.Cost))
            return
        end

        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local Event = remotes and remotes:FindFirstChild("GamestateEvent")
        if not Event or not Event:IsA("RemoteEvent") then
            Report("Waiting: GamestateEvent")
            return
        end

        if not Active() or enabled.Value ~= true or runtime.Pending
            or runtime.TreePending
            or runtime.ZonePending
            or (runtime.PickaxePending
                and runtime.PickaxePending.Kind == "Buy")
            or runtime.EquipBestPending
            or runtime.PlaceJob
            or not plot:IsDescendantOf(workspace)
            or plot:GetAttribute("OwnerUserId") ~= LocalPlayer.UserId then
            return
        end

        local operation = {
            HolderKey = candidate.HolderKey,
            CharName = candidate.CharName,
            Variant = candidate.Variant,
            Stat = candidate.Stat,
            Field = candidate.Field,
            ExpectedLevel = candidate.Level + 1,
            LevelBefore = candidate.Level,
            MoneyBefore = current.Money,
            Cost = candidate.Cost,
            At = os.clock(),
        }
        runtime.Pending = operation

        local ok, err = pcall(function()
            Event:FireServer(
                "MineUpgradeCharacter",
                operation.HolderKey,
                operation.Stat,
                nil
            )
        end)

        if not ok then operation.Error = tostring(err) end
        operation.DispatchPcallOK = ok
        if not Active() then return end

        Report(ok
            and ("Request Sent: " .. operation.HolderKey
                .. "/" .. operation.Stat
                .. " -> " .. tostring(operation.ExpectedLevel))
            or ("Unknown: dispatch " .. tostring(err)))
    end

    MacUI:OnUnload(function()
        alive = false
        -- Keep sent transactions for reconciliation after re-execution.
    end)

    task.spawn(function()
        local failureDelay = 1
        local nextWarningAt = 0

        while Active() do
            local ok, err = xpcall(Step, function(reason)
                return debug.traceback(tostring(reason), 2)
            end)

            if not Active() then break end

            if not ok then
                local now = os.clock()
                if now >= nextWarningAt then
                    nextWarningAt = now + 5
                    warn("[Zero X / Miner Worker / Step] " .. tostring(err))
                end

                -- Preserve pending transactions and user intent.
                -- Re-enter Step to observe state; do not resend here.
                task.wait(failureDelay)
                failureDelay = math.min(failureDelay * 2, 8)
            else
                failureDelay = 1

                local job = runtime.PlaceJob
                local fast = type(job) == "table"
                    and IsFastManagement(job.Control)

                task.wait(fast and FAST_MANAGEMENT_TICK or TICK)
            end
        end
    end)
end

