    local function Level(holder, field)
        if field ~= "CharLevel"
            and field ~= "CharSpeedLevel"
            and field ~= "CharMineSpeedLevel" then
            return nil
        end

        local value = holder[field]
        if value == nil then return 1 end
        if type(value) ~= "number" or value < 1
            or value ~= math.floor(value) then
            return nil
        end
        return value
    end

    local function Number(value)
        return type(value) == "number"
            and value == value
            and value >= 0
            and value < math.huge
    end

    local function SelectCandidate(current, Config, Items, mode, cap)
        local order = orders[mode]
        if not order then return nil, "Unknown priority" end

        if type(Items.GetItemData) ~= "function" then
            return nil, "Items.GetItemData unavailable"
        end

        local candidates = {}

        for holderKey, holder in pairs(current.MineGame.Holders) do
            if type(holderKey) == "string" and type(holder) == "table"
                and type(holder.CharName) == "string"
                and holder.CharName ~= "" then

                local ok, itemData = pcall(Items.GetItemData, holder.CharName)
                if not ok or type(itemData) ~= "table" then
                    return nil, "Item data unavailable: " .. holderKey
                end

                for rank, stat in ipairs(order) do
                    local field = fields[stat]
                    local level = Level(holder, field)
                    if not level then
                        return nil, "Invalid " .. field .. ": " .. holderKey
                    end

                    local nativeCap
                    if stat == "Damage" then
                        if type(Config.GetCharLevelCap) ~= "function" then
                            return nil, "GetCharLevelCap unavailable"
                        end

                        local capOK, result = pcall(
                            Config.GetCharLevelCap,
                            current.MineGame,
                            holderKey,
                            holder,
                            itemData,
                            Items.GetItemData
                        )
                        if not capOK then
                            return nil, "GetCharLevelCap: " .. tostring(result)
                        end
                        nativeCap = result
                    elseif stat == "MineSpeed" then
                        nativeCap = Config.CharMineSpeedMaxLevel
                    else
                        nativeCap = Config.CharSpeedMaxLevel
                    end

                    if not Number(nativeCap) then
                        return nil, "Native cap unavailable: " .. stat
                    end

                    if level < math.min(cap, nativeCap) then
                        local costFunction = Config[costFunctions[stat]]
                        if type(costFunction) ~= "function" then
                            return nil, "Cost function unavailable: " .. stat
                        end

                        local costOK, cost = pcall(costFunction, level, itemData)
                        if not costOK or not Number(cost) then
                            return nil, "Invalid upgrade cost: "
                                .. holderKey .. "/" .. stat
                        end

                        table.insert(candidates, {
                            HolderKey = holderKey,
                            CharName = holder.CharName,
                            Variant = holder.Variant,
                            Stat = stat,
                            Field = field,
                            Level = level,
                            Cost = cost,
                            Rank = rank,
                        })
                    end
                end
            end
        end

        table.sort(candidates, function(a, b)
            if mode ~= "Cheapest first" and a.Rank ~= b.Rank then
                return a.Rank < b.Rank
            end
            if a.Cost ~= b.Cost then return a.Cost < b.Cost end
            if a.Rank ~= b.Rank then return a.Rank < b.Rank end
            return a.HolderKey < b.HolderKey
        end)

        return candidates[1]
    end

