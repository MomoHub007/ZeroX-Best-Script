    local labelWarnAt = {}

    local function WriteFarmLabel(key, label, message)
        if shown[key] == message then return end

        local now = os.clock()
        if now < (labelRetryAt[key] or 0) then return end

        local ok, err = pcall(function()
            label:SetValue(message)
        end)

        if ok then
            shown[key] = message
            labelRetryAt[key] = nil
            return
        end

        labelRetryAt[key] = now + 1
        if now >= (labelWarnAt[key] or 0) then
            labelWarnAt[key] = now + 5
            warn("[Zero X / Farm UI / " .. tostring(key) .. "] " .. tostring(err))
        end
    end

    local function Status(key, message)
        if not alive or runtime.Owner ~= owner then return end
        WriteFarmLabel(key, labels[key], message)
    end

