            assert(type(mine.Pickaxes) == "table", "Pickaxe inventory not ready")
            assert(Integer(mine.MinerSlots), "MinerSlots not ready")

            local plot = OwnedPlot()
            local holders = plot and plot:FindFirstChild("Holders")
            assert(holders, "Owned holder models not ready")

            local definitions = {}

            for index, def in ipairs(Config.Pickaxes) do
                assert(type(def) == "table"
                    and type(def.Name) == "string", "Invalid pickaxe definition")

                local multiplier = tonumber(def.Multiplier) or 1
                assert(Number(multiplier), "Invalid pickaxe multiplier")

                local total, assigned, spare =
                    Config.GetPickaxeStock(mine, def.Name)

                assert(Integer(total) and Integer(assigned) and Integer(spare),
                    "Invalid pickaxe copy counts: " .. def.Name)

                table.insert(definitions, {
                    Index = index,
                    Def = def,
                    Name = def.Name,
                    Multiplier = multiplier,
                    Free = Config.IsPickaxeFree(def) == true,
                    Spare = spare,
                })
            end

            table.sort(definitions, function(a, b)
                if a.Multiplier ~= b.Multiplier then
                    return a.Multiplier > b.Multiplier
                end
                return a.Name < b.Name
            end)

            local pads = {}

            for _, model in ipairs(holders:GetChildren()) do
                local index = tonumber(model.Name:match("^M(%d+)$"))
                local holder = mine.Holders[model.Name]

                if index and index >= 1 and index <= mine.MinerSlots
                    and model:GetAttribute("HolderType") == "Miner"
                    and type(holder) == "table"
                    and type(holder.CharName) == "string"
                    and holder.CharName ~= "" then

                    local item = Items.GetItemData(holder.CharName)
                    assert(type(item) == "table",
                        "Miner item data unavailable: " .. holder.CharName)

                    if item.MineRole ~= "Hauler" then
                        local equipped = Config.GetHolderPickaxe(holder)
                        assert(type(equipped) == "table",
                            "Equipped pickaxe definition unavailable")

                        local multiplier = tonumber(equipped.Multiplier) or 1
                        assert(Number(multiplier), "Invalid equipped multiplier")

                        table.insert(pads, {
                            Key = model.Name,
                            Index = index,
                            Multiplier = multiplier,
                        })
                    end
                end
            end

            table.sort(pads, function(a, b)
                if a.Multiplier ~= b.Multiplier then
                    return a.Multiplier < b.Multiplier
                end
                return a.Index < b.Index
            end)

            if #pads == 0 then
                return { Message = "Waiting: placed Miner pads" }
            end

            -- Use existing copies first; never downgrade a pad.
            for _, entry in ipairs(definitions) do
                if (entry.Free or entry.Spare > 0)
                    and entry.Multiplier > pads[1].Multiplier then
                    return {
                        Kind = "Equip",
                        Name = entry.Name,
                        HolderKey = pads[1].Key,
                    }
                end
            end

            if equipOnly then
                return { Message = "Completed / Waiting: best owned gear equipped" }
            end

            assert(type(Stock.GetRemaining) == "function",
                "MineStock.GetRemaining unavailable")
            assert(type(mine.UnlockedZones) == "table",
                "UnlockedZones unavailable")
            assert(Number(current.Money), "Invalid Money")

            local selected = selection.Value
            local selectedExists = selected == AUTO

            for _, entry in ipairs(definitions) do
                if entry.Name == selected then selectedExists = true end
            end
            assert(selectedExists, "Selected pickaxe is no longer in the catalog")

            for _, entry in ipairs(definitions) do
                local def = entry.Def
                local matches = selected == AUTO or selected == entry.Name

                if matches and not entry.Free and not def.RobuxOnly
                    and Number(def.Cost) and def.Cost > 0
                    and mine.UnlockedZones[def.ZoneReq] == true then

                    local weakerPads = 0
                    for _, pad in ipairs(pads) do
                        if pad.Multiplier < entry.Multiplier then
                            weakerPads = weakerPads + 1
                        end
                    end

                    local needsCopies = weakerPads > entry.Spare
                    local surplusAllowed = keepBuying.Value == true
                        and (selected ~= AUTO
                            or entry.Multiplier >= pads[1].Multiplier)

                    if needsCopies or surplusAllowed then
                        -- Root data is required, not mine.
                        local remaining = Stock.GetRemaining(current, entry.Name)

                        if remaining ~= nil then
                            assert(Number(remaining),
                                "Invalid shop stock: " .. entry.Name)

                            if remaining > 0 and current.Money >= def.Cost then
                                return {
                                    Kind = "Buy",
                                    Name = entry.Name,
                                    Index = entry.Index,
                                    Cost = def.Cost,
                                    Selection = selected,
                                    RequiresKeep = not needsCopies,
                                }
                            end
                        end
                    end
                end
            end

            return {
                Message = "Completed / Waiting: copies sufficient, or funds / stock / zone required",
            }
        end

        function PickaxeAuto.Step(current, GameState, equipOnly)
            local pending = runtime.PickaxePending
            if not pending and not PickaxeAuto.Enabled() and catalogReady then
                return false
            end

            local now = os.clock()
            if not pending then
                local due = equipOnly and nextEquipCheck or nextBuyCheck
                if now < due then return false end

                if equipOnly then
                    nextEquipCheck = now + 1
                else
                    nextBuyCheck = now + 1
                end
            end

            local Config, configError = LoadModule("MineConfig")
            if not Active() then return false end
            if not Config then
                PickaxeAuto.Log("Waiting: " .. tostring(configError))
                return false
            end

            local names = CatalogNames(Config)
            local signature = table.concat(names, "\n")
            if signature ~= catalogSignature then
                catalogSignature = signature
                pendingUi[selection] = { Values = names }
            end
            catalogReady = type(Config.Pickaxes) == "table"

            local Items, Stock
            if not pending and PickaxeAuto.Enabled() then
                local itemsError
                Items, itemsError = LoadModule("Items")
                if not Active() then return false end
                if not Items then
                    PickaxeAuto.Log("Waiting: " .. tostring(itemsError))
                    return false
                end

                if not equipOnly then
                    local stockError
                    Stock, stockError = LoadModule("MineStock")
                    if not Active() then return false end
                    if not Stock then
                        PickaxeAuto.Log("Waiting: " .. tostring(stockError))
                        return false
                    end
                end
            end

            local fresh, readError = ReadData(GameState)
            if not Active() then return false end
            if not fresh then
                PickaxeAuto.Log("Waiting: " .. tostring(readError))
                return false
            end
            current = fresh

            if pending then
                if runtime.PickaxePending ~= pending then return false end
                local observed = false

                if pending.Kind == "Buy" then
                    local inventory = current.MineGame.Pickaxes
                    local count = type(inventory) == "table"
                        and inventory[pending.Name]
                    observed = Integer(count)
                        and count >= pending.ExpectedCount
                elseif pending.Kind == "Equip" then
                    local holder = current.MineGame.Holders[pending.HolderKey]
                    if type(holder) == "table"
                        and type(Config.GetHolderPickaxe) == "function" then
                        local ok, def = pcall(Config.GetHolderPickaxe, holder)
                        observed = ok and type(def) == "table"
                            and def.Name == pending.Name
                    end
                end

                if observed then
                    if Active() and runtime.PickaxePending == pending then
                        runtime.PickaxePending = nil
                        nextEquipCheck = 0
                        nextBuyCheck = 0
                        PickaxeAuto.Log("State Updated: "
                            .. pending.Kind .. " / " .. pending.Name)
                    end
                else
                    PickaxeAuto.Log(
                        (os.clock() - pending.At >= 3
                            and "Unknown: " or "Request Sent: ")
                        .. pending.Kind .. " / " .. pending.Name
                        .. (pending.Error and (" | " .. pending.Error) or "")
                    )
                end
                return false
            end

            if not PickaxeAuto.Enabled() then return false end

            if runtime.PlaceJob or runtime.EquipBestPending then
                PickaxeAuto.Log("Waiting: placement / Equip Best")
                return false
            end

            local mine = current.MineGame
            if mine.PendingTrade == true or current.MineTradeSettling == true
                or LocalPlayer:GetAttribute("MineTradeSettling") == true
                or LocalPlayer:GetAttribute("ReloadingPlayerData") == true
                or current.SaveTooLarge == true then
                PickaxeAuto.Log("Waiting: native trade / data guards")
                return false
            end

            local ok, action = pcall(
                BuildPlan, current, Config, Stock, Items, equipOnly
            )
            if not Active() then return false end
            if not ok then
                PickaxeAuto.Log("BuildPlan: " .. tostring(action))
                return false
            end

            if not action.Kind then
                if not equipOnly then PickaxeAuto.Log(action.Message) end
                return false
            end

            if action.Kind == "Buy"
                and (runtime.Pending or runtime.TreePending
                    or runtime.ZonePending) then
                PickaxeAuto.Log("Waiting: Money upgrade / zone reconciliation")
                return false
            end

            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local Event = remotes and remotes:FindFirstChild("GamestateEvent")
            if not Event or not Event:IsA("RemoteEvent") then
                PickaxeAuto.Log("Waiting: GamestateEvent")
                return false
            end

            if not Active() or not PickaxeAuto.Enabled()
                or runtime.PickaxePending or runtime.PlaceJob
                or runtime.EquipBestPending then
                return false
            end

            if action.Kind == "Buy" then
                if runtime.Pending or runtime.TreePending or runtime.ZonePending
                    or selection.Value ~= action.Selection
                    or (action.RequiresKeep and keepBuying.Value ~= true) then
                    return false
                end

                local count = mine.Pickaxes[action.Name] or 0
                if not Integer(count) then
                    PickaxeAuto.Log("Blocked: invalid owned count")
                    return false
                end
                action.ExpectedCount = count + 1
            end

            action.At = os.clock()
            runtime.PickaxePending = action

            local sent, sendError
            if action.Kind == "Buy" then
                sent, sendError = pcall(
                    Event.FireServer, Event, "MineBuyPickaxe", action.Index
                )
            else
                sent, sendError = pcall(
                    Event.FireServer, Event, "MineEquipPickaxe",
                    action.HolderKey, action.Name
                )
            end

            if not Active() or runtime.PickaxePending ~= action then
                return true
            end
            if not sent then action.Error = tostring(sendError) end

            PickaxeAuto.Log("Request Sent: "
                .. action.Kind .. " / " .. action.Name
                .. (action.HolderKey and (" / " .. action.HolderKey) or "")
                .. (action.Error and (" | " .. action.Error) or ""))
            return true
        end
    end

    local RewardAuto = {}

