        local function Log(feature, message)
            if not Active() then return end

            local now = os.clock()
            local previous = logs[feature]

            if previous then
                if now - previous.At < 5 then return end
                if previous.Message == message
                    and now - previous.At < 30 then
                    return
                end
            end

            logs[feature] = {
                At = now,
                Message = message,
            }

            warn("[Zero X / Reward / " .. feature .. "] " .. message)
        end

        local function FreshData(GameState)
            local current, err = ReadData(GameState)
            if not current then
                error("ReadData: " .. tostring(err))
            end
            return current
        end

        local function GuardsReady(current)
            return current.MineGame.PendingTrade ~= true
                and current.MineTradeSettling ~= true
                and LocalPlayer:GetAttribute("MineTradeSettling") ~= true
                and LocalPlayer:GetAttribute("ReloadingPlayerData") ~= true
                and current.SaveTooLarge ~= true
        end

        local function Send(feature, toggle, current, operation, ...)
            if not Active() or toggle.Value ~= true
                or claims[feature] then
                return
            end

            if not GuardsReady(current) then
                Log(feature, "Waiting: native trade / data guards")
                return
            end

            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local remote = remotes
                and remotes:FindFirstChild("GamestateEvent")

            if not remote or not remote:IsA("RemoteEvent") then
                Log(feature, "Waiting: GamestateEvent unavailable")
                return
            end

            -- Register before dispatch. Never clear solely because time passed.
            operation.At = os.clock()
            claims[feature] = operation

            local ok, err = pcall(remote.FireServer, remote, ...)
            if not ok then
                operation.Error = tostring(err)
            end

            Log(feature, ok
                and "Request Sent: awaiting replicated claim state"
                or ("Unknown: dispatch | " .. tostring(err)))
        end

        local function ObserveWaiting(feature, operation)
            Log(feature,
                operation.Error
                    and ("Unknown: dispatch | " .. operation.Error)
                    or "Unknown: awaiting claim state; no duplicate request"
            )
        end

        local function DailyStep(GameState)
            if dailyToggle.Value ~= true and not claims.Daily then
                return
            end

            local current = FreshData(GameState)
            if not Active() then return end

            local mine = current.MineGame
            local spin = mine.DailySpin
            local pending = claims.Daily

            if pending then
                local nextAt = type(spin) == "table"
                    and tonumber(spin.NextAt)

                if Number(nextAt) and nextAt > pending.PreviousNextAt then
                    if claims.Daily == pending then
                        claims.Daily = nil
                    end
                    Log("Daily", "State Updated: DailySpin.NextAt advanced")
                else
                    ObserveWaiting("Daily", pending)
                end
                return
            end

            if dailyToggle.Value ~= true then return end

            local Config, configError = LoadModule("MineDailySpinConfig")
            if not Active() then return end
            if not Config then
                Log("Daily", "Waiting: " .. tostring(configError))
                return
            end

            if type(Config.Unlocked) ~= "function"
                or type(Config.Ready) ~= "function" then
                Log("Daily", "Blocked: daily eligibility helpers unavailable")
                return
            end

            -- Loading a module may yield; read current data again.
            current = FreshData(GameState)
            if not Active() or dailyToggle.Value ~= true then return end

            mine = current.MineGame
            spin = mine.DailySpin

            if Config.Unlocked(mine) ~= true then
                Log("Daily", "Waiting: Daily Reward not unlocked")
                return
            end

            -- Ready uses the native ServerClock internally.
            if Config.Ready(spin) ~= true then
                Log("Daily", "Waiting: next free Daily Reward")
                return
            end

            local previousNextAt = type(spin) == "table"
                and (tonumber(spin.NextAt) or 0) or 0

            if not Number(previousNextAt) then
                Log("Daily", "Blocked: invalid DailySpin.NextAt")
                return
            end

            Send("Daily", dailyToggle, current, {
                PreviousNextAt = previousNextAt,
            }, "MineDailySpin")
        end

        local function SameMail(message, id)
            return type(message) == "table"
                and (type(message.Id) == "string"
                    or type(message.Id) == "number")
                and tostring(message.Id) == id
        end

        local function FindMail(messages, key, id)
            local message = messages[key]
            if SameMail(message, id) then return message end

            -- Dictionary keys may differ from the outbound string ID.
            for _, candidate in pairs(messages) do
                if SameMail(candidate, id) then
                    return candidate
                end
            end
            return nil
        end

        local function MailStep(GameState)
            if mailToggle.Value ~= true and not claims.Mail then
                return
            end

            local current = FreshData(GameState)
            if not Active() then return end

            local mailbox = current.Mailbox
            local messages = type(mailbox) == "table"
                and mailbox.Messages

            if type(messages) ~= "table" then
                Log("Mail", "Waiting: Mailbox.Messages not ready")
                return
            end

            local pending = claims.Mail
            if pending then
                local message = FindMail(
                    messages, pending.MessageKey, pending.MailId
                )
                local rewards = message and message.Rewards
                local reward = type(rewards) == "table"
                    and rewards[pending.Index]

                local sameReward = type(reward) == "table"
                    and reward.Kind == pending.Kind
                    and reward.Name == pending.Name
                    and reward.Amount == pending.Amount

                local completed = message and (
                    message.Claimed == true
                    or (sameReward and reward.Claimed == true)
                )

                if completed then
                    if claims.Mail == pending then
                        claims.Mail = nil
                    end
                    Log("Mail", "State Updated: mailbox reward claimed")
                else
                    -- Missing mail/reward alone is not a completion receipt.
                    ObserveWaiting("Mail", pending)
                end
                return
            end

            if mailToggle.Value ~= true then return end

            for key, message in pairs(messages) do
                if type(message) == "table"
                    and (type(message.Id) == "string"
                        or type(message.Id) == "number")
                    and message.Claimed ~= true
                    and type(message.Rewards) == "table" then

                    for index, reward in ipairs(message.Rewards) do
                        if type(reward) == "table"
                            and reward.Claimed ~= true then
                            Send("Mail", mailToggle, current, {
                                MessageKey = key,
                                MailId = tostring(message.Id),
                                Index = index,
                                Kind = reward.Kind,
                                Name = reward.Name,
                                Amount = reward.Amount,
                            }, "ClaimMailboxReward",
                                tostring(message.Id), index)
                            return
                        end
                    end
                end
            end

            Log("Mail", "Waiting: no unclaimed mailbox rewards")
        end

        local function IndexStep(GameState)
            if indexToggle.Value ~= true and not claims.Index then
                return
            end

            local Config, configError = LoadModule("MineIndexRewardsConfig")
            if not Active() then return end
            if not Config then
                Log("Index", "Waiting: " .. tostring(configError))
                return
            end

            if type(Config.ClaimedReward) ~= "function" then
                Log("Index", "Blocked: ClaimedReward unavailable")
                return
            end

            local current = FreshData(GameState)
            if not Active() then return end

            local mine = current.MineGame
            local pending = claims.Index

            -- Reconcile sent work even after the user switches the toggle Off.
            if pending then
                if Config.ClaimedReward(
                    mine,
                    pending.Category,
                    pending.TierKey,
                    pending.Index
                ) == true then
                    if claims.Index == pending then
                        claims.Index = nil
                    end

                    Log("Index",
                        "State Updated: "
                            .. pending.Category
                            .. " / " .. pending.TierKey
                            .. " / R" .. tostring(pending.Index)
                    )
                else
                    ObserveWaiting("Index", pending)
                end
                return
            end

            if indexToggle.Value ~= true then return end

            if Config.Enabled ~= true then
                Log("Index", "Waiting: native Index rewards disabled")
                return
            end

            for _, name in ipairs({
                "Keys",
                "Category",
                "Total",
                "HeldNames",
                "State",
            }) do
                if type(Config[name]) ~= "function" then
                    Log("Index", "Blocked: " .. name .. " unavailable")
                    return
                end
            end

            if type(Config.Events) ~= "table"
                or Config.Events.Claim ~= "MineIndexClaim" then
                Log("Index", "Blocked: Index claim contract changed")
                return
            end

            local keys = Config.Keys()
            local heldNames = Config.HeldNames(mine)
            local unlocked = mine.UnlockedZones

            if type(keys) ~= "table"
                or type(heldNames) ~= "table"
                or type(unlocked) ~= "table" then
                Log("Index", "Waiting: category / discovery / zone data")
                return
            end

            -- Match native ClaimableTiers eligibility.
            for _, categoryKey in ipairs(keys) do
                if type(categoryKey) ~= "string" then
                    Log("Index", "Blocked: invalid category key")
                    return
                end

                local category = Config.Category(categoryKey)
                local eligibleCategory = type(category) == "table"
                    and (category.Zone == nil
                        or unlocked[categoryKey] == true)

                if eligibleCategory then
                    local total = Config.Total(categoryKey)
                    if not Number(total) then
                        Log("Index", "Blocked: invalid category total")
                        return
                    end

                    if total > 0 then
                        local state = Config.State(
                            mine, categoryKey, heldNames
                        )

                        if type(state) ~= "table"
                            or type(state.Track) ~= "table" then
                            Log("Index", "Waiting: native Index track")
                            return
                        end

                        for _, tier in ipairs(state.Track) do
                            if type(tier) == "table"
                                and tier.Reached == true then

                                local tierKey = tier.Key

                                if type(tierKey) ~= "string"
                                    or tierKey == ""
                                    or type(tier.Rewards) ~= "table" then
                                    Log("Index", "Blocked: invalid tier schema")
                                    return
                                end

                                for rewardIndex, reward in ipairs(tier.Rewards) do
                                    if type(reward) ~= "table" then
                                        Log("Index", "Blocked: invalid reward schema")
                                        return
                                    end

                                    local claimed = Config.ClaimedReward(
                                        mine,
                                        categoryKey,
                                        tierKey,
                                        rewardIndex
                                    )

                                    if claimed ~= true then
                                        if not Active()
                                            or indexToggle.Value ~= true
                                            or claims.Index then
                                            return
                                        end

                                        Send("Index", indexToggle, current, {
                                            Category = categoryKey,
                                            TierKey = tierKey,
                                            Index = rewardIndex,
                                        }, Config.Events.Claim,
                                            categoryKey,
                                            tierKey,
                                            rewardIndex)
                                        return
                                    end
                                end
                            end
                        end
                    end
                end
            end

            Log("Index", "Waiting: no eligible unclaimed Index rewards")
        end

        local function EventRewardClaimed(rec, tier, rewardIndex)
            if type(rec) ~= "table" then
                return nil, "Event record unavailable"
            end

            if rec.C ~= nil and type(rec.C) ~= "table" then
                return nil, "Invalid event claimed map"
            end

            if type(rec.C) == "table"
                and rec.C[tostring(tier)] == true then
                return true
            end

            if rec.CM ~= nil and type(rec.CM) ~= "table" then
                return nil, "Invalid event reward mask map"
            end

            local mask = type(rec.CM) == "table"
                and rec.CM[tostring(tier)] or nil

            if mask == nil then mask = 0 end

            if not Number(mask)
                or mask ~= math.floor(mask)
                or mask > 4294967295
                or rewardIndex < 1
                or rewardIndex > 32 then
                return nil, "Unsupported event reward bitmask"
            end

            return bit32.btest(mask, 2 ^ (rewardIndex - 1))
        end

        local function EnsureEventsObserver(GameState, stateEvent)
            local observer = runtime.RewardEventsObserver

            if observer then
                -- Reuse the same subscription across UI re-executions.
                -- No assumed Disconnect API or duplicate registrations.
                if observer.GameState ~= GameState
                    or observer.Event ~= stateEvent then
                    return nil,
                        "Events subscription source changed; lifecycle inspection required"
                end

                if observer.Error then
                    return nil, observer.Error
                end

                return observer.Ready and observer or nil,
                    observer.Ready and nil or "Events subscription not ready"
            end

            if type(GameState.ListenToEvent) ~= "function" then
                return nil, "ListenToEvent unavailable"
            end

            observer = {
                GameState = GameState,
                Event = stateEvent,
                Rows = {},
                Ready = false,
            }
            runtime.RewardEventsObserver = observer

            local function Receive(payload)
                if runtime.RewardEventsObserver ~= observer then return end
                if type(payload) ~= "table"
                    or type(payload.Events) ~= "table" then
                    return
                end

                local rows = {}

                local function Capture(ladder, parentId, personal)
                    if type(ladder) ~= "table"
                        or type(ladder.Id) ~= "string"
                        or type(ladder.Thresholds) ~= "table" then
                        return
                    end

                    local thresholds = {}
                    for key, value in pairs(ladder.Thresholds) do
                        if Number(value) then
                            thresholds[key] = value
                        end
                    end

                    rows[#rows + 1] = {
                        Id = ladder.Id,
                        ParentId = parentId,
                        Personal = personal,
                        Thresholds = thresholds,
                    }
                end

                for _, ladder in ipairs(payload.Events) do
                    if type(ladder) == "table"
                        and type(ladder.Id) == "string" then
                        Capture(ladder, ladder.Id, false)
                        Capture(ladder.Personal, ladder.Id, true)
                    end
                end

                -- Keep only the latest snapshot, never an expanding queue.
                -- Copy thresholds rather than retaining the native UI table.
                observer.Rows = rows
                observer.Received = true
            end

            -- This listener only captures state; it never dispatches gameplay.
            -- It remains registered for this client context across UI unloads.
            local ok, err = pcall(
                GameState.ListenToEvent, stateEvent, Receive
            )

            if not ok then
                observer.Error = "Subscribe: " .. tostring(err)
                return nil, observer.Error
            end

            observer.Ready = true
            return observer
        end

        local function EventsStep(GameState)
            if eventsToggle.Value ~= true and not claims.Events then
                return
            end

            local current = FreshData(GameState)
            if not Active() then return end

            local mine = current.MineGame
            local events = mine.Events
            local recs = type(events) == "table" and events.Recs

            if type(recs) ~= "table" then
                Log("Events", "Waiting: Events.Recs not ready")
                return
            end

            local pending = claims.Events
            if pending then
                local claimed, reason = EventRewardClaimed(
                    recs[pending.Id],
                    pending.Tier,
                    pending.Index
                )

                if claimed == true then
                    if claims.Events == pending then
                        claims.Events = nil
                    end

                    Log("Events",
                        "State Updated: " .. pending.Id
                            .. " / Tier " .. tostring(pending.Tier)
                            .. " / Reward " .. tostring(pending.Index)
                    )
                elseif reason then
                    Log("Events", "Unknown: " .. reason)
                else
                    ObserveWaiting("Events", pending)
                end
                return
            end

            if eventsToggle.Value ~= true then return end

            local Config, configError = LoadModule("MineEventsConfig")
            if not Active() then return end
            if not Config then
                Log("Events", "Waiting: " .. tostring(configError))
                return
            end

            if type(Config.Events) ~= "table"
                or Config.Events.State ~= "MineEventsState"
                or Config.Events.Claim ~= "MineEventsClaim" then
                Log("Events", "Blocked: event transport contract changed")
                return
            end

            for _, name in ipairs({ "Active", "Tiers", "Shown" }) do
                if type(Config[name]) ~= "function" then
                    Log("Events", "Blocked: " .. name .. " unavailable")
                    return
                end
            end

            if type(Config.Catalog) ~= "table" then
                Log("Events", "Waiting: event catalog")
                return
            end

            local observer, observerError = EnsureEventsObserver(
                GameState, Config.Events.State
            )
            if not Active() then return end
            if not observer then
                Log("Events", "Blocked: " .. tostring(observerError))
                return
            end

            if not observer.Received then
                Log("Events", "Waiting: passive MineEventsState packet")
                return
            end

            -- Module loading/subscription may yield.
            current = FreshData(GameState)
            if not Active() or eventsToggle.Value ~= true then return end

            mine = current.MineGame
            events = mine.Events
            recs = type(events) == "table" and events.Recs

            if type(recs) ~= "table" then
                Log("Events", "Waiting: Events.Recs not ready")
                return
            end

            -- Native Active() filters the current event schedule.
            local activeList = Config.Active()
            if type(activeList) ~= "table" then
                Log("Events", "Blocked: invalid active event list")
                return
            end

            local activeById = {}
            for _, event in ipairs(activeList) do
                if type(event) == "table"
                    and type(event.Id) == "string" then
                    activeById[event.Id] = event
                end
            end

            local waitingReason

            for _, row in ipairs(observer.Rows) do
                local activeEvent = activeById[row.ParentId]
                local rec = recs[row.Id]

                if activeEvent and type(rec) == "table" then
                    local tiers

                    if row.Personal then
                        if type(Config.PersonalTiers) == "function" then
                            tiers = Config.PersonalTiers()
                        end
                    else
                        local catalog = Config.Catalog[activeEvent.Key]
                        if type(catalog) == "table"
                            and Number(activeEvent.Days) then
                            tiers = Config.Tiers(activeEvent.Days, catalog)
                        end
                    end

                    if type(tiers) ~= "table" then
                        waitingReason = "Event tier definitions not ready"
                    elseif not Number(rec.P) then
                        waitingReason = "Event progress not ready"
                    else
                        for tierIndex, tier in ipairs(tiers) do
                            local threshold = row.Thresholds[tierIndex]
                            if threshold == nil then
                                threshold = row.Thresholds[tostring(tierIndex)]
                            end

                            if type(tier) == "table"
                                and Number(threshold)
                                and rec.P >= threshold
                                and type(tier.Rewards) == "table" then

                                local shown = Config.Shown(tier.Rewards)
                                if type(shown) ~= "table" then
                                    Log("Events", "Blocked: invalid shown rewards")
                                    return
                                end

                                for _, reward in ipairs(shown) do
                                    -- Preserve the native reward slot mapping.
                                    local rewardIndex = table.find(
                                        tier.Rewards, reward
                                    )

                                    if rewardIndex then
                                        local claimed, reason = EventRewardClaimed(
                                            rec, tierIndex, rewardIndex
                                        )

                                        if claimed == false then
                                            Send("Events",
                                                eventsToggle,
                                                current,
                                                {
                                                    Id = row.Id,
                                                    Tier = tierIndex,
                                                    Index = rewardIndex,
                                                },
                                                Config.Events.Claim,
                                                row.Id,
                                                tierIndex,
                                                rewardIndex
                                            )
                                            return
                                        elseif reason then
                                            waitingReason = reason
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end

            Log("Events", "Waiting: "
                .. (waitingReason or "no eligible unclaimed event rewards"))
        end

