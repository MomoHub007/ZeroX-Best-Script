        local function Selected(itemName)
            local label = itemLabels and itemLabels[itemName]

            return label ~= nil
                and type(selection.Value) == "table"
                and selection.Value[label] == true
        end

        local function FamilySelected(definitions)
            for _, def in ipairs(definitions) do
                if Selected(def.ItemName) then
                    return true
                end
            end

            return false
        end

        local function Count(mine, itemName)
            if type(mine.Potions) ~= "table" then return nil end

            local value = mine.Potions[itemName]
            if value == nil then return 0 end

            return Integer(value) and value or nil
        end

        local function BoostState(mine, family)
            if type(mine.Boosts) ~= "table" then
                return nil, nil, "Boosts not ready"
            end

            local boost = mine.Boosts[family]
            if boost == nil then return 0, 0 end

            if type(boost) ~= "table" then
                return nil, nil, "Invalid boost record"
            end

            local untilSec = boost.Until == nil
                and 0 or tonumber(boost.Until)
            local charges = boost.Charges == nil
                and 0 or tonumber(boost.Charges)

            if not Number(untilSec) or not Integer(charges) then
                return nil, nil, "Invalid Until / Charges"
            end

            return untilSec, charges
        end

        local function Strength(def)
            local power

            if def.Mult ~= nil then
                if not Number(def.Mult) or def.Mult <= 0 then
                    return nil
                end
                power = def.Mult
            elseif def.Add ~= nil then
                if not Number(def.Add) then return nil end
                power = 1 + def.Add
            else
                -- Do not guess potency from item names or catalog order.
                return nil
            end

            local capacity
            if def.Kind == "Timed" then
                if not Number(def.Duration) or def.Duration <= 0 then
                    return nil
                end
                capacity = def.Duration
            elseif def.Kind == "Charge" then
                if not Integer(def.Charges) or def.Charges < 1 then
                    return nil
                end
                capacity = def.Charges
            else
                return nil
            end

            return power, capacity
        end

        local function StepPotions()
            local now = os.clock()
            if now < nextCheckAt then return end
            nextCheckAt = now + 1 -- Local observation interval only.

            stage = "Catalog"
            local Catalog, catalogError = LoadModule("MinePotionCatalog")
            if not Active() then return end

            local families, rows, labels, currentItemLabels =
                CatalogRows(Catalog)

            itemLabels = currentItemLabels

            if labels then
                local signature = table.concat(labels, "\n")
                if signature ~= catalogSignature then
                    catalogSignature = signature
                    pendingUi[selection] = { Values = labels }
                end
            end

            local pending = runtime.PotionPending
            if autoUse.Value ~= true and not pending then return end

            if not rows and not pending then
                Log("Waiting: "
                    .. tostring(catalogError or "Potion definitions unavailable"))
                return
            end

            stage = "ReadData"
            local GameState, stateError = LoadModule("GameState")
            if not Active() then return end
            if not GameState then
                Log("Waiting: " .. tostring(stateError))
                return
            end

            local Clock, clockError = LoadModule("ServerClock")
            if not Active() then return end
            if not Clock or type(Clock.Now) ~= "function" then
                Log("Waiting: " .. tostring(clockError or "ServerClock.Now"))
                return
            end

            local current, readError = ReadData(GameState)
            if not Active() then return end
            if not current then
                Log("Waiting: " .. tostring(readError))
                return
            end

            local mine = current.MineGame
            local serverNow = Clock.Now()
            if not Number(serverNow) then
                Log("Blocked: invalid server clock")
                return
            end

            stage = "Reconcile"
            pending = runtime.PotionPending

            if pending then
                if type(pending.ItemName) ~= "string"
                    or type(pending.Family) ~= "string"
                    or not Integer(pending.InitialCount)
                    or not Number(pending.InitialUntil)
                    or not Integer(pending.InitialCharges)
                    or not Number(pending.ServerAt) then
                    Log("Blocked: invalid existing PotionPending; inspect state")
                    return
                end

                local count = Count(mine, pending.ItemName)
                local untilSec, charges, boostError =
                    BoostState(mine, pending.Family)

                if count == nil or untilSec == nil then
                    Log("Waiting: "
                        .. tostring(boostError or "Potion inventory not ready"))
                    return
                end

                if count <= pending.InitialCount - 1 then
                    pending.InventoryObserved = true
                end

                if pending.Kind == "Timed" then
                    if untilSec > pending.InitialUntil
                        and untilSec > pending.ServerAt then
                        pending.BoostObserved = true
                    end
                elseif pending.Kind == "Charge" then
                    if charges > pending.InitialCharges then
                        pending.BoostObserved = true
                    end
                else
                    Log("Blocked: unsupported pending potion kind")
                    return
                end

                if pending.InventoryObserved and pending.BoostObserved then
                    if runtime.PotionPending == pending then
                        runtime.PotionPending = nil
                    end
                    Log("State Updated: " .. pending.ItemName
                        .. " consumed and effect observed")
                else
                    Log("Unknown: awaiting potion state"
                        .. " | Item=" .. pending.ItemName
                        .. " | Inventory="
                        .. tostring(pending.InventoryObserved == true)
                        .. " | Boost="
                        .. tostring(pending.BoostObserved == true)
                        .. (pending.Error and (" | " .. pending.Error) or ""))
                end
                return
            end

            if autoUse.Value ~= true or not rows then return end

            if type(mine.Potions) ~= "table"
                or type(mine.Boosts) ~= "table" then
                Log("Waiting: Potions / Boosts not ready")
                return
            end

            if mine.PendingTrade == true
                or current.MineTradeSettling == true
                or LocalPlayer:GetAttribute("MineTradeSettling") == true
                or LocalPlayer:GetAttribute("ReloadingPlayerData") == true
                or current.SaveTooLarge == true then
                Log("Waiting: native trade / data guards")
                return
            end

            stage = "SelectPotion"
            local action
            local reason = "no selected eligible owned potion"

            for _, family in ipairs(families) do
                local gemPending = runtime.GemShopPending
                local buyingThisFamily = type(gemPending) == "table"
                    and gemPending.Family == family

                local enchantPending = runtime.EnchantPending
                local rollingDice = family == "DiceSaver"
                    and type(enchantPending) == "table"
                    and enchantPending.Kind == "Roll"

                if FamilySelected(rows[family])
                    and not buyingThisFamily
                    and not rollingDice then
                    local untilSec, charges, boostError =
                        BoostState(mine, family)

                    if untilSec == nil then
                        reason = tostring(boostError)
                    elseif untilSec <= serverNow and charges == 0 then
                        local best
                        local familyBlocked

                        for _, def in ipairs(rows[family]) do
                            local count = 0
                            if Selected(def.ItemName) then
                                count = Count(mine, def.ItemName)
                            end

                            if count == nil then
                                familyBlocked = "invalid count: " .. def.ItemName
                                break
                            elseif count > 0 then
                                local power, capacity = Strength(def)

                                if not power then
                                    familyBlocked =
                                        "unsupported potency / kind: " .. def.ItemName
                                    break
                                end

                                if not best
                                    or power > best.Power
                                    or (power == best.Power
                                        and capacity > best.Capacity)
                                    or (power == best.Power
                                        and capacity == best.Capacity
                                        and def.ItemName < best.ItemName) then

                                    best = {
                                        ItemName = def.ItemName,
                                        Family = family,
                                        Kind = def.Kind,
                                        Power = power,
                                        Capacity = capacity,
                                        InitialCount = count,
                                        InitialUntil = untilSec,
                                        InitialCharges = charges,
                                    }
                                end
                            end
                        end

                        if familyBlocked then
                            reason = familyBlocked
                        elseif best then
                            action = best
                            break
                        end
                    else
                        reason = "selected effects still active"
                    end
                end
            end

            if not action then
                Log("Waiting: " .. reason)
                return
            end

            stage = "Dispatch"
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local remote = remotes
                and remotes:FindFirstChild("GamestateEvent")

            if not remote or not remote:IsA("RemoteEvent") then
                Log("Waiting: GamestateEvent unavailable")
                return
            end

            if not Active()
                or autoUse.Value ~= true
                or not Selected(action.ItemName)
                or runtime.PotionPending then
                return
            end

            -- No yield occurs between the validated snapshot and dispatch.
            action.At = os.clock()
            action.ServerAt = serverNow
            runtime.PotionPending = action

            local sent, sendError = pcall(
                remote.FireServer, remote,
                "MineUsePotion", action.ItemName, 1
            )

            if not sent then
                action.Error = tostring(sendError)
            end

            Log(sent
                and ("Request Sent: " .. action.ItemName .. " / 1")
                or ("Unknown: dispatch | " .. tostring(sendError)))
        end

        function PotionAuto.Step()
            if not Active() then return end

            -- Isolate this feature without discarding unresolved work.
            local ok, err = pcall(StepPotions)
            if not ok then
                Log(stage .. ": " .. tostring(err))
            end
        end
    end

