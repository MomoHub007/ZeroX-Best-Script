            if runtime.Pending or runtime.TreePending
                or runtime.EquipBestPending
                or (runtime.PickaxePending
                    and runtime.PickaxePending.Kind == "Buy") then
                Show(kind, "Waiting: existing upgrade / Equip Best")
                return false
            end

            if mine.PendingTrade == true
                or current.MineTradeSettling == true then
                Show(kind, "Waiting: trading / settling")
                return false
            end

            if EventActive() then
                Show(kind, "Waiting: active Meteor Core / Titan Geode")
                return false
            end

            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local Event = remotes and remotes:FindFirstChild("GamestateEvent")
            if not Event or not Event:IsA("RemoteEvent") then
                Show(kind, "Waiting: GamestateEvent")
                return false
            end

            if not Active() or controls[kind].Value ~= true
                or runtime.ZonePending or runtime.PlaceJob
                or runtime.Pending or runtime.TreePending
                or runtime.EquipBestPending
                or (runtime.PickaxePending
                    and runtime.PickaxePending.Kind == "Buy")
                or EventActive() then
                return false
            end

            local record = {
                Kind = kind,
                Key = targetKey,
                Number = targetNumber,
                At = os.clock(),
