            record.LastSentAt = record.At
            record.LastRemote = Event
            record.Attempts = 1

            local sent, sendError = pcall(
                Event.FireServer,
                Event,
                "MineSelectZone",
                targetKey
            )

            if not Active() then return true end
            if not sent then record.Error = tostring(sendError) end

            Show(kind,
                (sent and "Request Sent: " or "Unknown: dispatch ")
                .. targetKey
                .. (record.Error and (" | " .. record.Error) or ""))
            return true
        end
