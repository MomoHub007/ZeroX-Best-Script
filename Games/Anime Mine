                                and Native(Config.IsSkillNodeOpen, skills, node) == true then

                                local level = skills[node.Family] or 0
                                assert(Integer(level), "Invalid research family level")

                                local requirement = Native(
                                    Config.GetSkillPowerReq,
                                    zoneKey,
                                    node.Family,
                                    level + 1
                                )

                                if requirement ~= nil then
                                    assert(Number(requirement), "Invalid power requirement")
                                    if teamPower == nil then
                                        teamPower = Native(
                                            Config.GetTeamPower,
                                            mine,
                                            Items.GetItemData
                                        )
                                        assert(Number(teamPower), "Invalid team power")
                                    end
                                end

                                if requirement == nil or requirement <= teamPower then
                                    Add({
                                        Kind = "Research",
                                        Event = "MineBuySkill",
                                        ZoneKey = zoneKey,
                                        ZoneOrder = zoneIndex,
                                        Id = node.Id,
                                        Family = node.Family,
                                        LevelBefore = level,
                                        Cost = Native(
                                            Config.GetSkillCost,
                                            zoneKey,
                                            level,
                                            node.Family
