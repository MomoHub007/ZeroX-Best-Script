-- MINER
--------------------------------------------------------------------------------
do
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local env = type(getgenv) == "function" and getgenv() or _G
    local runtimeKey = "__ZEROX_MINER_UPGRADE_V1"
    local context = tostring(game.PlaceId) .. ":" .. game.JobId
        .. ":" .. tostring(LocalPlayer.UserId)

    local runtime = env[runtimeKey]
    if type(runtime) ~= "table" or runtime.Context ~= context then
        runtime = { Context = context }
        env[runtimeKey] = runtime
    end

    local owner = {}
    runtime.Owner = owner
    local alive = true

    -- Local worker timing; not a verified server cooldown or request expiry.
    local TICK = 0.5
    local OBSERVE_AFTER = 2

    local section = Tabs.Miner:AddSection({
        Title = "Automatic Upgrades",
        Icon = "hammer",
    })

    local status = CreateInternalReadout({
        Title = "Upgrade Status",
        Value = "Disabled",
    })

    local lastStatus
    local function Active()
        return alive and runtime.Owner == owner and not MacUI.Unloaded
    end

    local pendingUi = {}
    local appliedUi = {}
    local retryUiAt = {}
    local nextUiFlush = 0
    local nextUiWarning = 0

    local function QueueMinerStatus(control, message)
        if not Active() or not control then return end

        message = tostring(message)

        if pendingUi[control] == message then return end
        if pendingUi[control] == nil
            and appliedUi[control] == message then
            return
        end

        -- เก็บเฉพาะข้อความล่าสุดของแต่ละ Label
        pendingUi[control] = message
    end

    -- ลงทะเบียนตรงส่วนสร้าง UI ก่อนเริ่ม Worker
    local minerUiConnection =
        game:GetService("RunService").Heartbeat:Connect(function()
            if not Active() then return end

            local now = os.clock()
            if now < nextUiFlush then return end
            nextUiFlush = now + 0.1

            for control, message in pairs(pendingUi) do
                if now >= (retryUiAt[control] or 0) then
                    -- ป้องกันเฉพาะการเขียน UI พร้อมรายงาน Error จริง
                    local setter = control.SetValue
                    local value = message

                    if type(message) == "table" then
                        setter = control.SetValues
                        value = message.Values
                    end

                    local ok, err = pcall(setter, control, value)

                    if ok then
                        appliedUi[control] = message
                        retryUiAt[control] = nil

                        if pendingUi[control] == message then
                            pendingUi[control] = nil
                        end
                    else
                        retryUiAt[control] = now + 1

                        if now >= nextUiWarning then
                            nextUiWarning = now + 5
                            warn("[Zero X / Miner UI] "
                                .. tostring(err)
                                .. " | Update: " .. tostring(message))
                        end
                    end
                end
            end
        end)

    MacUI:OnUnload(function()
        minerUiConnection:Disconnect()
        table.clear(pendingUi)
        table.clear(appliedUi)
        table.clear(retryUiAt)
    end)

    local function Report(message)
        if not Active() or lastStatus == message then return end
        lastStatus = message
        QueueMinerStatus(status, message)
    end

    local enabled = section:AddToggle("ZeroXAutoUpgradeMiners", {
        Title = "Auto Upgrade Miners",
        Description = "อัปเกรดคนงานที่วางบนแท่นแล้ว ตามลำดับความสำคัญและเพดานระดับที่กำหนด",
        Default = false,
        Callback = function(value)
            Report(value and "Waiting: checking miners"
                or "Disabled: no new upgrades")
        end,
    })

    local priority = section:AddDropdown("ZeroXMinerUpgradePriority", {
        Title = "Priority",
        Description = "เลือกลำดับคุณสมบัติที่จะอัปเกรด ระบบอาจรอเงินสำหรับคุณสมบัติอันดับแรกที่ยังอัปเกรดได้",
        Values = {
            "Cheapest first",
            "Damage first",
            "Mining speed first",
            "Move speed first",
        },
        Default = "Cheapest first",
    })

    local levelCap = section:AddStepper("ZeroXMinerUpgradeLevelCap", {
        Title = "Level cap",
        Description = "ระดับสูงสุดที่อนุญาตให้ระบบอัปเกรดคนงาน",
        Min = 1,
        Max = 200,
        Step = 1,
        Default = 200,
    })

    local placement = Tabs.Miner:AddSection({
        Title = "Miner Management",
        Icon = "users",
    })

    local managementStatus = {}

    local function AddMinerControl(index, title, description)
        local readout = CreateInternalReadout({
            Title = title .. " Status",
            Value = "Disabled",
        })

        managementStatus[index] = readout

        placement:AddToggle(index, {
            Title = title,
            Description = description,
            Default = false,
            Callback = function(value)
                if not Active() then return end

                local job = runtime.PlaceJob
                if value == false and job and job.Control == index then
                    job.Cancelled = true
                end

                QueueMinerStatus(readout, value
                    and "Waiting: Miner worker"
                    or "Disabled")
            end,
        })

        return readout
    end

    AddMinerControl(
        "ZeroXAutoPlaceMiners",
        "Auto Place Miners",
        "นำคนงานจากกระเป๋าไปวางบนแท่นที่ยังว่าง"
    )

    local equipBestStatus = CreateInternalReadout({
        Title = "Auto Equip Best Status",
        Value = "Disabled",
    })

    local autoEquipBest = placement:AddToggle("ZeroXAutoEquipBest", {
        Title = "Auto Equip Best",
        Description = "เรียกใช้ระบบจัดตัวที่ดีที่สุดเมื่อกระเป๋าตัวละครเปลี่ยน และตรวจซ้ำทุก 60 วินาที",
        Default = false,
        Callback = function(value)
            if not Active() then return end
            QueueMinerStatus(equipBestStatus, value
                and "Waiting: checking character inventory"
                or "Disabled: no new automatic requests")
        end,
    })

    local equipNowStatus = CreateInternalReadout({
        Title = "Equip Best now Status",
        Value = "Idle",
    })

    local manualEquipRequested = false

    placement:AddButton({
        Title = "Equip Best now",
        Description = "ส่งคำขอจัดตัวที่ดีที่สุดหนึ่งครั้งเมื่อกดปุ่ม",
        ButtonText = "Equip",
        Callback = function()
            if not Active() then return end

            if runtime.EquipBestPending then
                QueueMinerStatus(equipNowStatus,
                    "Waiting: existing Equip Best outcome"
                )
                return
            end

            -- รวมการกดซ้ำเป็นคำขอเดียว ไม่สะสม Queue
            manualEquipRequested = true
            QueueMinerStatus(equipNowStatus, "Queued: waiting for Miner worker")
        end,
    })

    AddMinerControl(
        "ZeroXSmartSwapMiners",
        "Smart Swap (best miners for what you can afford)",
        "เลือกและสลับคนงานโดยพิจารณาดาเมจที่อัปเกรดได้จากเงินและรายได้ปัจจุบัน"
