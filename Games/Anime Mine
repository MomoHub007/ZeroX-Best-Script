    local function PromptAt(plot, holderKey)
        local holders = plot and plot:FindFirstChild("Holders")
        local model = holders and holders:FindFirstChild(holderKey)
        local pad = model and model:FindFirstChild("Pad")
        local prompt = pad and pad:FindFirstChild("HolderPrompt")

        if not pad or not pad:IsA("BasePart")
            or not prompt or not prompt:IsA("ProximityPrompt") then
            return nil
        end

        return prompt, pad
    end

    local function PromptReachable(prompt, pad)
        if not pad or not pad:IsA("BasePart")
            or not pad:IsDescendantOf(workspace) then
            return false, "Waiting: native pad available"
        end

        if not prompt or not prompt:IsA("ProximityPrompt")
            or prompt.Parent ~= pad then
            return false, "Waiting: native HolderPrompt available"
        end

        if not prompt.Enabled then
            return false, "Waiting: HolderPrompt enabled"
        end

        local maxDistance = prompt.MaxActivationDistance
        if maxDistance <= 0 then
            return false, "Waiting: native prompt activation distance"
        end

        local character = LocalPlayer.Character
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")
        local root = humanoid and humanoid.RootPart

        if not humanoid or humanoid.Health <= 0
            or not root or not root:IsA("BasePart")
            or not root:IsDescendantOf(character) then
            return false, "Waiting: living character / RootPart"
        end

        local distance = (root.Position - pad.Position).Magnitude
        if distance > maxDistance then
            return false, string.format(
                "Waiting: walk near pad | distance %.1f / range %.1f studs",
                distance,
                maxDistance
            )
        end

        return true
    end

    local function EnsureMinerPad(plot, holderKey, control, job)
        if not Active() or not ManagementOn(control)
            or (job and (runtime.PlaceJob ~= job or job.Cancelled))
            or (not job and runtime.PlaceJob)
            or runtime.Pending or runtime.EquipBestPending then
            return false, "Waiting: current Miner operation"
        end

        if OwnedPlot() ~= plot then
            return false, "Waiting: original owned plot"
        end

        local farm = env.__ZEROX_ANIME_MINE_FARM_V1
        if type(farm) == "table" then
            local pending = farm.Pending
            if farm.ReturnAfterSell
                or (type(pending) == "table"
                    and (pending.Travel or pending.Sell)) then
                return false, "Waiting: Farm sell / travel"
            end
        end

        local prompt, pad = PromptAt(plot, holderKey)
        local reachable, reason = PromptReachable(prompt, pad)
        if reachable then
            runtime.PadWarp = nil
            return true
        end

        -- Warp only when the native prompt and character are usable.
        if not prompt or not pad
            or not prompt.Enabled
            or prompt.MaxActivationDistance <= 0 then
            return false, reason
        end

        local character = LocalPlayer.Character
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")
        local root = humanoid and humanoid.RootPart

        if not humanoid or humanoid.Health <= 0
            or not root or not root:IsA("BasePart")
            or not root:IsDescendantOf(character) then
            return false, reason
        end

        local previous = runtime.PadWarp
        local warpNow = os.clock()
        if previous and previous.Character == character
            and previous.Root == root and previous.Pad == pad
            and previous.Prompt == prompt
            and (warpNow - (previous.At or 0) < 1.0) then
            return false, previous.Error
                and ("Blocked: pad warp | " .. previous.Error)
                or ("Waiting: pad warp arrival | " .. tostring(reason))
        end

        local top = pad.CFrame:PointToWorldSpace(
            Vector3.new(0, pad.Size.Y / 2, 0)
        )
        local clearance = math.max(0, humanoid.HipHeight)
            + root.Size.Y / 2
        local destination = top + Vector3.new(0, clearance, 0)

        if (destination - pad.Position).Magnitude
            > prompt.MaxActivationDistance then
            return false, "Blocked: pad-top position exceeds prompt range"
        end

        if not Active() or not ManagementOn(control)
            or LocalPlayer.Character ~= character
            or OwnedPlot() ~= plot
            or (job and (runtime.PlaceJob ~= job or job.Cancelled)) then
            return false, "Waiting: current character / operation"
        end

        local record = {
            Character = character,
            Root = root,
            Pad = pad,
            Prompt = prompt,
            At = warpNow,
        }
        runtime.PadWarp = record

        local ok, err = pcall(function()
            root.CFrame = CFrame.new(destination) * root.CFrame.Rotation
            if root:IsA("BasePart") then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end)

        if not ok then
            record.Error = tostring(err)
            return false, "Blocked: pad warp | " .. record.Error
        end

        return false, "Warp applied: awaiting pad range observation"
    end

    local function DamageScore(candidate, holderKey, holder,
        current, Config, Items, projectedBudget)

        if type(Items.GetItemData) ~= "function" then
            return nil, "GetItemData unavailable"
        end

        local ok, item = pcall(Items.GetItemData, candidate.Name)
        if not ok or type(item) ~= "table" then
            return nil, "Character item data unavailable"
        end
        if item.MineRole == "Hauler" then
            return nil, "Hauler excluded"
        end

        local level = candidate.Level

        if projectedBudget ~= nil then
            local simulatedHolder = {
                CharName = candidate.Name,
                CharLevel = candidate.Level,
                CharSpeedLevel = candidate.Speed,
                CharMineSpeedLevel = candidate.Mining,
                Variant = candidate.Variant,
                Pickaxe = type(holder) == "table" and holder.Pickaxe or nil,
            }

            local cap, capError = NativeNumber(
                Config.GetCharLevelCap,
                current.MineGame,
                holderKey,
                simulatedHolder,
                item,
                Items.GetItemData
            )
            if cap == nil then return nil, capError end

            local userCap = levelCap.Value
            if not Number(userCap) then return nil, "Invalid Level cap" end
            cap = math.floor(math.min(cap, userCap, 200))

            local budget = projectedBudget
            while level < cap do
                local cost, costError = NativeNumber(
                    Config.GetCharacterUpgradeCost, level, item
                )
                if cost == nil then return nil, costError end
                if cost > budget then break end
                budget = budget - cost
                level = level + 1
            end
        end

        local base, baseError = NativeNumber(Config.GetCharacterDamage, item)
        if base == nil then return nil, baseError end

        local multiplier, levelError = NativeNumber(
            Config.GetCharacterLevelMultiplier, level
        )
        if multiplier == nil then return nil, levelError end

        local variant, variantError = NativeNumber(
            Config.GetVariantMult, candidate.Variant
        )
        if variant == nil then return nil, variantError end

        local score = base * multiplier * variant
        if not Number(score) then return nil, "Invalid damage score" end
        return score
    end

    local function ZoneOdds(mine, Config, Inventory)
        local zone = mine.CurrentZone
        if type(zone) ~= "number" or zone < 1
            or zone ~= math.floor(zone)
            or type(Config.Zones) ~= "table"
            or type(Inventory.ZoneDropTable) ~= "function" then
            return nil, nil, "Zone data unavailable"
        end

        local now = os.clock()
        if zoneCache and zoneCache.Config == Config
            and zoneCache.Zone == zone and now - zoneCache.At < 30 then
            return zoneCache.Odds, zoneCache.Origins
        end

        local odds, origins = {}, {}
        for zoneKey in pairs(Config.Zones) do
            local index = type(zoneKey) == "string"
                and tonumber(zoneKey:match("^Z(%d+)$"))

            if index then
                local ok, entries = pcall(
                    Inventory.ZoneDropTable, nil, zoneKey
                )
                if not ok or type(entries) ~= "table" then
                    return nil, nil, "ZoneDropTable unavailable: " .. zoneKey
                end

                for _, entry in ipairs(entries) do
                    if type(entry.Name) == "string"
                        and Number(entry.Chance) and entry.Chance > 0
                        and entry.Chance <= 1 then

                        origins[entry.Name] = math.min(
                            origins[entry.Name] or math.huge, index
                        )
                        if index == zone then
                            odds[entry.Name] = entry.Chance
                        end
                    end
                end
            end
        end

        if not next(odds) then
            return nil, nil, "Current zone drop pool unavailable"
        end

        zoneCache = {
            Config = Config,
            Zone = zone,
            At = now,
            Odds = odds,
            Origins = origins,
        }
        return odds, origins
    end

    local function ChoosePlacement(current, plot, mode, Config, Inventory, Items)
        local mine = current.MineGame

        if type(mine.Characters) ~= "table" then
            return nil, "Waiting: MineGame.Characters"
        end

        if type(Inventory.Resolve) ~= "function" then
            return nil, "Blocked: MineInventory.Resolve unavailable"
        end

        local candidates = {}

        for stackKey, count in pairs(mine.Characters) do
            if type(stackKey) ~= "string"
                or not Number(count)
                or count % 1 ~= 0 then
                return nil, "Blocked: invalid character inventory entry"
            end

            if count > 0 then
                local ok, entry = pcall(
                    Inventory.Resolve,
                    mine,
                    stackKey
                )

                if not ok then
                    return nil, "MineInventory.Resolve error ["
                        .. stackKey .. "]: " .. tostring(entry)
                end

                if entry ~= nil and type(entry) ~= "table" then
                    return nil, "Invalid MineInventory.Resolve return ["
                        .. stackKey .. "]: " .. typeof(entry)
                end

                if entry and entry.Kind == "Character"
                    and entry.Role == "Miner" then
                    local candidate, parseError =
                        ParseMiner(stackKey, Config)

                    if not candidate then
                        return nil, "ParseMiner error ["
                            .. stackKey .. "]: " .. tostring(parseError)
                    end

                    table.insert(candidates, candidate)
                end
            end
        end

        table.sort(candidates, function(a, b)
            return a.Key < b.Key
        end)

        if #candidates == 0 then return nil, "Waiting: bag miners" end

        local odds, origins
        if mode == "ZeroXZoneRarityEquip" then
            local zoneError
            odds, origins, zoneError = ZoneOdds(mine, Config, Inventory)
            if not odds then return nil, zoneError end
        end

        local holderFolder = plot:FindFirstChild("Holders")
        if not holderFolder then return nil, "Waiting: holder pads" end

        local pads = {}
        for _, model in ipairs(holderFolder:GetChildren()) do
            local index = tonumber(model.Name:match("^M(%d+)$"))
            if index then
                table.insert(pads, { Key = model.Name, Index = index })
            end
        end
        table.sort(pads, function(a, b) return a.Index < b.Index end)

        local best
        local projectedBudget = current.Money + netIncomeRate * SMART_HORIZON
        if not Number(projectedBudget) then
            return nil, "Invalid projected budget"
        end

        for _, padInfo in ipairs(pads) do
            local key = padInfo.Key
            local holder = mine.Holders[key]
            local empty = HolderEmpty(holder)
            local old = not empty and HolderCandidate(holder) or nil
            local prompt, pad = PromptAt(plot, key)

            local available = prompt
                and prompt.Parent == pad
                and pad:IsDescendantOf(workspace)
                and prompt.Enabled
                and prompt.MaxActivationDistance > 0
                and ((empty and (prompt.ActionText == "Place" or prompt.ActionText:match("^Place .+") ~= nil) and prompt.ObjectText == "Empty Slot") or (old and prompt.ActionText == "Pick up"))

            if available and (mode ~= "ZeroXAutoPlaceMiners" or empty) then
                for _, candidate in ipairs(candidates) do
                    local eligible = true
                    local rank

                    if mode == "ZeroXZoneRarityEquip" then
                        local chance = odds[candidate.Name]
                        local oldChance = old and odds[old.Name]
                        local olderZone = old and not oldChance
                            and origins[old.Name]
                            and origins[old.Name] < mine.CurrentZone

                        eligible = chance ~= nil and (empty or olderZone
                            or (oldChance and chance < oldChance))
                        rank = chance and -chance
                    else
                        local budget = mode == "ZeroXSmartSwapMiners"
                            and projectedBudget or nil

                        local score, scoreError = DamageScore(
                            candidate, key, holder,
                            current, Config, Items, budget
                        )
                        if score == nil then return nil, scoreError end

                        local oldScore = 0
                        if old then
                            local oldError
                            oldScore, oldError = DamageScore(
                                old, key, holder,
                                current, Config, Items, budget
                            )
                            if oldScore == nil then return nil, oldError end
                        end

                        eligible = empty or score > oldScore
                        rank = score - oldScore
                    end

                    if eligible and rank ~= nil
                        and (not best or rank > best.Rank) then
                        best = {
                            Control = mode,
                            HolderKey = key,
                            Candidate = candidate,
                            Old = old,
                            Rank = rank,
                            Plot = plot,
                        }
                    end
                end
            end
        end

        if best then
            return best
        end

        return nil, mode == "ZeroXAutoPlaceMiners"
            and "Waiting: empty unlocked pad with native Place prompt"
            or "Waiting: eligible improvement on an unlocked native pad"
    end

    local function CopyBag(mine)
        local result = {}
        for key, count in pairs(mine.Characters) do
            if type(count) == "number" then result[key] = count end
        end
        return result
    end

    local function ReturnedMiner(job, mine, Config)
        for key, count in pairs(mine.Characters) do
            if type(key) == "string" and type(count) == "number"
                and count > (job.BagBeforePickup[key] or 0) then
                local candidate = ParseMiner(key, Config)
                local old = job.Old
                if candidate and old and candidate.Name == old.Name
                    and candidate.Level == old.Level
                    and candidate.Speed == old.Speed
                    and candidate.Mining == old.Mining
                    and NormalVariant(candidate.Variant)
                        == NormalVariant(old.Variant) then
                    return true
                end
            end
        end
        return false
    end

    local function ManagementWire(job, waitKind, nextStage, eventName, ...)
        if not Active() or runtime.PlaceJob ~= job
            or runtime.Pending or runtime.EquipBestPending then
            return
        end

        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local Event = remotes and remotes:FindFirstChild("GamestateEvent")
        if not Event or not Event:IsA("RemoteEvent") then
            ManagementReport(job.Control, "Waiting: GamestateEvent")
            return
        end

        job.Wait = waitKind
        job.NextStage = nextStage
        job.At = os.clock()
        job.Error = nil

        local ok, err = pcall(Event.FireServer, Event, eventName, ...)
        if not ok then job.Error = tostring(err) end
    end

    local function StepMinerManagement(current, GameState)
        local job = runtime.PlaceJob
        local mode = ManagementMode()
        if not job and not mode then return false end

        if not job and type(runtime.EnchantPending) == "table"
            and runtime.EnchantPending.Kind == "Equip" then
            ManagementReport(mode, "Waiting: Enchant equip reconciliation")
            return false
        end

        if not job and runtime.PickaxePending
            and runtime.PickaxePending.Kind == "Equip" then
            ManagementReport(mode, "Waiting: Pickaxe equip reconciliation")
            return false
        end

        local selectedControl = job and job.Control or mode
        local modeNames = {
            ZeroXZoneRarityEquip = "Zone Rarity",
            ZeroXSmartSwapMiners = "Smart Swap",
            ZeroXAutoPlaceMiners = "Auto Place",
        }

        for _, index in ipairs(managementOrder) do
            if ManagementOn(index) and index ~= selectedControl then
                ManagementReport(index,
                    "Waiting: "
                    .. (job and "active operation (" or "higher priority (")
                    .. tostring(modeNames[selectedControl] or selectedControl)
                    .. ")")
            end
        end

        local Config, configError = LoadModule("MineConfig")
        if not Active() then return true end
        local Inventory, inventoryError = LoadModule("MineInventory")
        if not Active() then return true end
        local Items, itemsError = LoadModule("Items")
        if not Active() then return true end

        if not Config or not Inventory or not Items then
            ManagementReport(job and job.Control or mode,
                "Waiting: " .. tostring(configError or inventoryError or itemsError))
            return job ~= nil
        end

        local fresh, readError = ReadData(GameState)
        if not fresh then
            ManagementReport(job and job.Control or mode,
                "Waiting: " .. tostring(readError))
            return job ~= nil
        end
        current = fresh
        local mine = current.MineGame

        -- Re-evaluate plans created for a different zone.
        -- Already-sent operations still pass through job.Wait reconciliation.
        if job and (job.PlanZone == nil
            or job.PlanZone ~= mine.CurrentZone) then
            job.Cancelled = true
        end

        if type(mine.Characters) ~= "table"
            or type(mine.Hotbar) ~= "table" then
            ManagementReport(job and job.Control or mode,
                "Waiting: Characters / Hotbar")
            return job ~= nil
        end

        local now = os.clock()
        if not incomeSample then
            incomeSample = { At = now, Money = current.Money }
        elseif now - incomeSample.At >= 10 then
            netIncomeRate = math.max(0,
                (current.Money - incomeSample.Money) / (now - incomeSample.At))
            incomeSample = { At = now, Money = current.Money }
        end

        if not job then
            if now < nextManagementPlan then return false end
            nextManagementPlan = now
                + (IsFastManagement(mode)
                    and FAST_PLAN_INTERVAL or PLAN_INTERVAL)

            if mine.PendingTrade == true or current.MineTradeSettling == true then
                ManagementReport(mode, "Waiting: trading / settling")
                return false
            end

            local plot = OwnedPlot()
            if not plot then
                ManagementReport(mode, "Waiting: owned plot")
                return false
            end

            local selected, selectError = ChoosePlacement(
                current, plot, mode, Config, Inventory, Items
            )
            if not Active() then return true end
            if not selected then
                ManagementReport(mode, tostring(selectError))
                return false
            end

            local prompt, pad = PromptAt(plot, selected.HolderKey)
            local reachable, waitReason = EnsureMinerPad(
                plot, selected.HolderKey, mode, nil
            )

            if not reachable then
                ManagementReport(mode,
                    tostring(waitReason)
                    .. " | Pad: " .. selected.HolderKey
                    .. " | Miner: " .. selected.Candidate.Name)
                return false
            end

            local slot
            for i = 1, 9 do
                local key = tostring(i)
                if mine.Hotbar[key] == selected.Candidate.Key then
                    slot = key
                    break
                end
            end
            if not slot then
                for i = 1, 9 do
                    local key = tostring(i)
                    if mine.Hotbar[key] == nil or mine.Hotbar[key] == "" then
                        slot = key
                        break
                    end
                end
            end
            if not slot then
                slot = "9"
            end

            selected.PlanZone = mine.CurrentZone
            selected.Slot = slot
            selected.PreviousSlotBinding = mine.Hotbar[slot]
            selected.ReplaceSlotBinding =
                type(selected.PreviousSlotBinding) == "string"
                and selected.PreviousSlotBinding ~= ""
                and selected.PreviousSlotBinding ~= selected.Candidate.Key
            selected.PreviousEquipped = mine.Equipped or ""
            selected.PreviousBinding = mine.Hotbar[selected.PreviousEquipped]
            selected.Stage = selected.Old and "PreparePickup" or "Assign"
            runtime.PlaceJob = selected
            ManagementReport(mode, "Selected: " .. selected.Candidate.Key
                .. " -> " .. selected.HolderKey)
            return true
        end

        if not ManagementOn(job.Control) then job.Cancelled = true end

        local holder = mine.Holders[job.HolderKey]
        local bound = mine.Hotbar[job.Slot]
        local equipped = mine.Equipped or ""

        if job.Wait then
            local observed = false

            if job.Wait == "Assign" then
                observed = bound == job.Candidate.Key
            elseif job.Wait == "Equip" then
                observed = equipped == job.Slot
            elseif job.Wait == "Unequip" then
                observed = equipped == ""
            elseif job.Wait == "Pickup" then
                observed = HolderEmpty(holder)
                    and ReturnedMiner(job, mine, Config)
            elseif job.Wait == "Place" then
                observed = SameMiner(holder, job.Candidate)
            elseif job.Wait == "ClearSlot" then
                observed = (bound or "") == (job.CleanupBinding or "")
            elseif job.Wait == "RestoreEquip" then
                observed = equipped == job.RestoreSlot
            end

            if observed then
                job.Wait = nil
                job.Stage = job.NextStage
                job.NextStage = nil
                job.Error = nil
            else
                -- Preserve the unresolved pickup; only recover movement
                -- while the original miner still occupies the target.
                if job.Wait == "Pickup"
                    and not job.Cancelled
                    and ManagementOn(job.Control)
                    and SameMiner(holder, job.Old) then

                    local waitingPlot = OwnedPlot()

                    if waitingPlot == job.Plot then
                        local inRange, rangeReason = EnsureMinerPad(
                            waitingPlot,
                            job.HolderKey,
                            job.Control,
                            job
                        )

                        if not Active() or runtime.PlaceJob ~= job then
                            return true
                        end

                        if not inRange then
                            ManagementReport(job.Control,
                                "Unknown: Pickup | " .. job.HolderKey
                                .. " | " .. tostring(rangeReason))
                            return true
                        end
                    end
                end

                ManagementReport(job.Control,
                    (now - job.At >= OBSERVE_AFTER
                        and "Unknown: " or "Request Sent: ")
                    .. job.Wait .. " | " .. job.HolderKey
                    .. (job.Error and (" | " .. job.Error) or ""))
            end
            return true
        end

        -- Observe the target state before movement or another placement.
        -- Do not retire any transaction still tracked by job.Wait.
        if job.Stage == "Place" and SameMiner(holder, job.Candidate) then
            if not Active() or runtime.PlaceJob ~= job then
                return true
            end

            job.Stage = "CleanupSlot"
            job.NextStage = nil
            job.Error = nil

            ManagementReport(job.Control,
                "State observed: target miner already on "
                .. job.HolderKey .. " | Cleanup pending")
            return true
        end

        if job.Cancelled and job.Stage ~= "CleanupSlot"
            and job.Stage ~= "CleanupEquip" and job.Stage ~= "Done" then
            job.Stage = "CleanupSlot"
        end

        if mine.PendingTrade == true or current.MineTradeSettling == true then
            ManagementReport(job.Control, "Waiting: trading / settling")
            return true
        end

        if job.Stage == "CleanupSlot" then
            local restoreBinding = job.ReplaceSlotBinding
                and job.PreviousSlotBinding or ""

            if job.TouchedSlot
                and (bound == job.Candidate.Key
                    or bound == nil or bound == "") then

                if (bound or "") == restoreBinding then
                    job.Stage = "CleanupEquip"
                else
                    job.CleanupBinding = restoreBinding
                    ManagementWire(job, "ClearSlot", "CleanupEquip",
                        "MineAssignHotbar", job.Slot, restoreBinding)
                end
            else
                -- Preserve a different binding changed during the operation.
                job.Stage = "CleanupEquip"
            end
            return true
        end

        if job.Stage == "CleanupEquip" then
            if job.EquippedByUs and equipped == job.Slot then
                local restore = ""
                if job.PreviousEquipped ~= ""
                    and job.PreviousBinding ~= nil
                    and mine.Hotbar[job.PreviousEquipped] == job.PreviousBinding then
                    restore = job.PreviousEquipped
                end

                if restore ~= equipped then
                    job.RestoreSlot = restore
                    ManagementWire(job, "RestoreEquip", "Done",
                        "MineEquipSlot", restore)
                else
                    job.Stage = "Done"
                end
            else
                job.Stage = "Done"
            end
            return true
        end

        if job.Stage == "Done" then
            if runtime.PlaceJob == job then
                runtime.PlaceJob = nil
                ManagementReport(job.Control, job.Cancelled
                    and "Cancelled: inventory state retained"
                    or ("Completed: " .. job.HolderKey))
            end
            return true
        end

        if not Active() or runtime.Pending or runtime.EquipBestPending then
            return true
        end

        local plot = OwnedPlot()
        if plot ~= job.Plot then
            ManagementReport(job.Control, "Waiting: original owned plot")
            return true
        end

        local targetPrompt, targetPad = PromptAt(plot, job.HolderKey)
        local targetReachable, targetWaitReason = EnsureMinerPad(
            plot, job.HolderKey, job.Control, job
        )

        if not targetReachable then
            ManagementReport(job.Control,
                tostring(targetWaitReason)
                .. " | Pad: " .. job.HolderKey)
            return true
        end

        if job.Stage == "PreparePickup" then
            if equipped ~= "" then
                ManagementWire(job, "Unequip", "Pickup", "MineEquipSlot", "")
            else
                job.Stage = "Pickup"
            end
            return true
        end

        if job.Stage == "Assign" then
            if not Active() or runtime.PlaceJob ~= job then
                return true
            end

            if not ManagementOn(job.Control) then
                job.Cancelled = true
                return true
            end

            if BagCount(mine, job.Candidate.Key) <= 0 then
                job.Cancelled = true
                return true
            end

            local bindingAllowed = bound == job.Candidate.Key
                or bound == nil
                or bound == ""
                or (job.ReplaceSlotBinding
                    and bound == job.PreviousSlotBinding)

            if not bindingAllowed then
                -- Keep cleanup ownership attached to its original slot.
                if job.TouchedSlot or job.EquippedByUs then
                    job.Cancelled = true
                    ManagementReport(job.Control,
                        "Recovery: hotbar changed; cleanup before replanning")
                    return true
                end

                local replacementSlot

                -- Prefer a slot that already contains the candidate.
                for i = 1, 9 do
                    local key = tostring(i)
                    if mine.Hotbar[key] == job.Candidate.Key then
                        replacementSlot = key
                        break
                    end
                end

                -- Otherwise use a currently empty slot.
                if not replacementSlot then
                    for i = 1, 9 do
                        local key = tostring(i)
                        local binding = mine.Hotbar[key]
                        if binding == nil or binding == "" then
                            replacementSlot = key
                            break
                        end
                    end
                end

                if not replacementSlot then
                    -- Match the existing full-hotbar policy.
                    replacementSlot = "9"
                end

                local replacementBinding = mine.Hotbar[replacementSlot]

                if replacementBinding ~= nil
                    and type(replacementBinding) ~= "string" then
                    ManagementReport(job.Control,
                        "Blocked: invalid hotbar binding | Slot "
                        .. replacementSlot)
                    return true
                end

                local previousSlot = job.Slot

                job.Slot = replacementSlot
                job.PreviousSlotBinding = replacementBinding
                job.ReplaceSlotBinding =
                    type(replacementBinding) == "string"
                    and replacementBinding ~= ""
                    and replacementBinding ~= job.Candidate.Key

                job.CleanupBinding = nil
                job.RestoreSlot = nil
                job.Error = nil

                ManagementReport(job.Control,
                    "Recovery: hotbar slot "
                    .. tostring(previousSlot)
                    .. " -> " .. replacementSlot)

                -- Re-read replicated state on the next existing worker tick.
                return true
            end

            if bound == job.Candidate.Key then
                job.Stage = "Equip"
            else
                job.TouchedSlot = true
                ManagementWire(job, "Assign", "Equip",
                    "MineAssignHotbar", job.Slot, job.Candidate.Key)
            end
            return true
        end

        if job.Stage == "Equip" then
            if bound ~= job.Candidate.Key then
                ManagementReport(job.Control, "Waiting: selected hotbar binding")
            elseif equipped == job.Slot then
                job.Stage = "Place"
            else
                job.EquippedByUs = true
                ManagementWire(job, "Equip", "Place", "MineEquipSlot", job.Slot)
            end
            return true
        end

        local prompt, pad = PromptAt(plot, job.HolderKey)
        local reachable, waitReason = EnsureMinerPad(
            plot, job.HolderKey, job.Control, job
        )

        if not reachable then
            ManagementReport(job.Control,
                tostring(waitReason) .. " | Pad: " .. job.HolderKey)
            return true
        end

        if type(env.fireproximityprompt) ~= "function" then
            ManagementReport(job.Control, "Blocked: fireproximityprompt unavailable")
            return true
        end

        local promptWait
        local promptNextStage
        local pickupBagSnapshot

        if job.Stage == "Pickup" then
            if not SameMiner(holder, job.Old)
                or prompt.ActionText ~= "Pick up" or equipped ~= "" then
                ManagementReport(job.Control, "Waiting: original miner / empty hands")
                return true
            end

            local maxStacks = Config.MaxCharStacks
            if Number(maxStacks) then
                local count = 0
                for _ in pairs(mine.Characters) do count = count + 1 end
                if count >= maxStacks then
                    ManagementReport(job.Control, "Waiting: character stack capacity")
                    return true
                end
            end

            pickupBagSnapshot = CopyBag(mine)
            promptWait = "Pickup"
            promptNextStage = "Assign"
        elseif job.Stage == "Place" then
            if not HolderEmpty(holder)
                or (prompt.ActionText ~= "Place" and prompt.ActionText ~= "Place " .. job.Candidate.Name)
                or prompt.ObjectText ~= "Empty Slot"
                or bound ~= job.Candidate.Key
                or equipped ~= job.Slot
                or BagCount(mine, job.Candidate.Key) <= 0 then
                ManagementReport(job.Control,
                    "Waiting: placement preconditions"
                    .. " | Pad=" .. job.HolderKey
                    .. " | Empty=" .. tostring(HolderEmpty(holder))
                    .. " | ActionText=" .. tostring(prompt.ActionText)
                    .. " | ObjectText=" .. tostring(prompt.ObjectText)
                    .. " | Bound=" .. tostring(bound)
                    .. " | ExpectedKey=" .. tostring(job.Candidate.Key)
                    .. " | Equipped=" .. tostring(equipped)
                    .. " | ExpectedSlot=" .. tostring(job.Slot)
                    .. " | BagCount="
                    .. tostring(BagCount(mine, job.Candidate.Key)))
                return true
            end

            promptWait = "Place"
            promptNextStage = "CleanupSlot"
        else
            ManagementReport(job.Control, "Blocked: unknown placement stage")
            return true
        end

        if not Active() or runtime.PlaceJob ~= job then
            return true
        end

        if not ManagementOn(job.Control) or job.Cancelled then
            job.Cancelled = true
            return true
        end

        if runtime.Pending or runtime.EquipBestPending or job.Wait then
            return true
        end

        local currentPlot = OwnedPlot()
        if currentPlot ~= job.Plot then
            ManagementReport(job.Control, "Waiting: original owned plot")
            return true
        end

        local currentPrompt, currentPad = PromptAt(
            currentPlot, job.HolderKey
        )

        if currentPrompt ~= prompt or currentPad ~= pad then
            ManagementReport(job.Control,
                "Waiting: current HolderPrompt / Pad")
            return true
        end

        local inRange, rangeReason = PromptReachable(
            currentPrompt, currentPad
        )

        if not inRange then
            -- No prompt request has been dispatched on this path.
            -- Leave job.Wait unset so the normal movement stage can resume.
            ManagementReport(job.Control, tostring(rangeReason))
            return true
        end

        local farm = env.__ZEROX_ANIME_MINE_FARM_V1
        local farmPending = type(farm) == "table" and farm.Pending

        if type(farm) == "table"
            and (farm.ReturnAfterSell
                or (type(farmPending) == "table"
                    and (farmPending.Travel or farmPending.Sell))) then
            ManagementReport(job.Control, "Waiting: Farm sell / travel")
            return true
        end

        if promptWait ~= "Pickup" and promptWait ~= "Place" then
            ManagementReport(job.Control, "Blocked: invalid prompt stage")
            return true
        end

        -- Register only after all final local preconditions pass.
        if promptWait == "Pickup" then
            job.BagBeforePickup = pickupBagSnapshot
        end

        job.Wait = promptWait
        job.NextStage = promptNextStage
        job.At = os.clock()
        job.Error = nil

        local ok, err = pcall(env.fireproximityprompt, currentPrompt)
        if not ok then
            job.Error = tostring(err)
        end

        return true
    end

    local TreeUpgrade = {}

    do
        local upgradeSection = Tabs.Upgrade:AddSection({
            Title = "Automatic Upgrades",
            Icon = "trending-up",
        })

        local upgradeStatus = CreateInternalReadout({
            Title = "Upgrade Status",
            Value = "Disabled",
        })

        local researchToggle = upgradeSection:AddToggle("ZeroXAutoResearch", {
            Title = "Auto Research",
            Description = "ซื้อโหนดวิจัยที่ผ่านเงื่อนไขในทุกโซนที่ปลดล็อกแล้ว",
            Default = false,
        })

        local coreToggle = upgradeSection:AddToggle("ZeroXAutoCoreUpgrades", {
            Title = "Auto Core Upgrades",
            Description = "ซื้อการอัปเกรดพลังตีและจำนวนช่องคนงานเมื่อผ่านเงื่อนไขและมีเงินเพียงพอ",
            Default = false,
        })

        local focusOption = upgradeSection:AddDropdown("ZeroXUpgradeFocus", {
            Title = "Focus families",
            Description = "ให้ความสำคัญกับสายวิจัยที่เลือก หากซื้อไม่ได้จะพิจารณาการอัปเกรดอื่นที่ซื้อได้",
            Values = {
                "Luck", "NodeCount", "NodeHealth", "NodeLevel",
                "OreYield", "Prospect", "Slots", "Tap", "Unearth",
            },
            Multi = true,
            Searchable = true,
            AllowNull = true,
            Default = {},
        })

        local nextPlanAt = 0

        function TreeUpgrade.Enabled()
            return researchToggle.Value == true or coreToggle.Value == true
        end

        function TreeUpgrade.Report(message)
            QueueMinerStatus(upgradeStatus, message)
        end

        local function Integer(value)
            return Number(value) and value == math.floor(value)
        end

        local function Native(fn, ...)
            assert(type(fn) == "function", "Required native function unavailable")
            return fn(...)
        end

        local function CurrentLevel(mine, candidate)
            if candidate.Kind == "Core" then
                local value = mine[candidate.Field]
                return Integer(value) and value or nil
            end

            if type(mine.Skills) ~= "table" then return nil end
            local zoneSkills = mine.Skills[candidate.ZoneKey]
            if zoneSkills == nil then return 0 end
            if type(zoneSkills) ~= "table" then return nil end

            local value = zoneSkills[candidate.Family]
            if value == nil then return 0 end
            return Integer(value) and value or nil
        end

        local function BuildCandidates(current, Config, Items)
            local mine = current.MineGame
            local rows = {}

            local function Add(candidate)
                assert(Number(candidate.Cost), "Invalid native upgrade cost")
                candidate.ExpectedLevel = candidate.LevelBefore + 1
                table.insert(rows, candidate)
            end

            if researchToggle.Value == true then
                assert(type(Config.ZoneKeys) == "table", "ZoneKeys unavailable")
                assert(type(mine.UnlockedZones) == "table", "UnlockedZones unavailable")
                assert(type(mine.Skills) == "table", "Skills unavailable")
                assert(type(Items.GetItemData) == "function", "GetItemData unavailable")

                local teamPower

                for zoneIndex, zoneKey in ipairs(Config.ZoneKeys) do
                    assert(type(zoneKey) == "string", "Invalid zone key")

                    if mine.UnlockedZones[zoneKey] == true then
                        local skills = mine.Skills[zoneKey] or {}
                        assert(type(skills) == "table", "Invalid zone skills")

                        local nodes = Native(Config.GetSkillNodes, zoneKey)
                        assert(type(nodes) == "table", "Invalid GetSkillNodes result")

                        for _, node in ipairs(nodes) do
                            assert(type(node) == "table"
