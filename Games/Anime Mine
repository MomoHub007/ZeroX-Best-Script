        end

        local function Product(row, PotionCatalog)
            if row.Dice ~= nil then
                if row.Dice == "Halloween" then
                    return { Kind = "HalloweenDice", Item = row.Item }
                end
                return nil, "Unsupported dice inventory mapping"
            end

            if row.Block ~= nil then
                if type(row.Block) == "string" and row.Block ~= "" then
                    return {
                        Kind = "Block",
                        Item = row.Item,
                        Block = row.Block,
                    }
                end
                return nil, "Invalid lucky block mapping"
            end

            if row.Switch == "Geode" then
                return { Kind = "Geode", Item = row.Item }
            elseif row.Switch == "Meteor" then
                return { Kind = "Meteor", Item = row.Item }
            end

            if type(PotionCatalog) == "table"
                and type(PotionCatalog.Potions) == "table" then

                for _, def in pairs(PotionCatalog.Potions) do
                    if type(def) == "table"
                        and def.ItemName == row.Item
                        and type(def.Family) == "string"
                        and def.Family ~= "" then
                        return {
                            Kind = "Potion",
                            Item = row.Item,
                            Family = def.Family,
                        }
                    end
                end
            end

            return nil, "Potion definition / inventory mapping unavailable"
        end

        local function OwnedCount(mine, product)
            local value

            if product.Kind == "Potion" then
                if type(mine.Potions) ~= "table" then
                    return nil, "Potions not ready"
                end
                value = mine.Potions[product.Item]

            elseif product.Kind == "HalloweenDice" then
                value = mine.HalloweenDice

            elseif product.Kind == "Block" then
                if type(mine.MysteryBlocks) ~= "table" then
                    return nil, "MysteryBlocks not ready"
                end
                value = mine.MysteryBlocks[product.Block]

            elseif product.Kind == "Geode" then
                value = mine.TitanGeodes

            elseif product.Kind == "Meteor" then
                value = mine.MeteorCores

            else
                return nil, "Unsupported inventory mapping"
            end

            if value == nil then return 0 end
            if not Integer(value) then
                return nil, "Invalid owned count"
            end

            return value
        end

        local function PotionConflict(product)
            local enchantPending = runtime.EnchantPending
            if product.Kind == "HalloweenDice"
                and type(enchantPending) == "table"
                and enchantPending.Kind == "Roll"
                and enchantPending.DiceKind == "Halloween" then
                return "Waiting: Halloween Dice roll reconciliation"
            end

            if not product.Family then return nil end

            local pending = runtime.PotionPending
            if pending then
                if type(pending) ~= "table"
                    or type(pending.Family) ~= "string"
                    or pending.Family == product.Family then
                    return "Waiting: potion use reconciliation"
                end
            end

            local toggle = Options.ZeroXAutoUsePotions
            local potionSelection = Options.ZeroXPotionsToUse

            if toggle and toggle.Value == true
                and potionSelection
                and type(potionSelection.Value) == "table"
                and runtime.PotionGemGuardOwner ~= owner then

                -- Coordination ownership is unavailable.
                -- Preserve the guard for either old or item-based selections.
                local hasSelection = false
                for _, enabled in pairs(potionSelection.Value) do
                    if enabled == true then
                        hasSelection = true
                        break
                    end
                end

                if hasSelection then
                    return "Waiting: add Potion/Gem coordination patch"
                end
            end

            return nil
        end

        local function StepGemShop()
            local now = os.clock()
            if now < nextCheckAt then return end
            nextCheckAt = now + 1 -- Local observation interval only.

            stage = "Catalog"
            local Config, configError = LoadModule("MineGemsConfig")
            if not Active() then return end

            local names, rows = CatalogRows(Config)
            if names then
                local signature = table.concat(names, "\n")
                if signature ~= catalogSignature then
                    catalogSignature = signature
                    pendingUi[selection] = { Values = names }
                end
            end

            local pending = runtime.GemShopPending
            if autoBuy.Value ~= true and not pending then return end

            if not rows and not pending then
                Log("Waiting: "
                    .. tostring(configError or "Invalid Gem Shop catalog"))
                return
            end

            stage = "LoadDependencies"
            local GameState, stateError = LoadModule("GameState")
            if not Active() then return end
            if not GameState then
                Log("Waiting: " .. tostring(stateError))
                return
            end

            local MineConfig, mineError = LoadModule("MineConfig")
            if not Active() then return end
            if not MineConfig
                or type(MineConfig.GetGemCount) ~= "function" then
                Log("Waiting: "
                    .. tostring(mineError or "GetGemCount unavailable"))
                return
            end

            local PotionCatalog
            if not pending then
                PotionCatalog = LoadModule("MinePotionCatalog")
                if not Active() then return end
            end

            stage = "ReadData"
            local current, readError = ReadData(GameState)
            if not Active() then return end
            if not current then
                Log("Waiting: " .. tostring(readError))
                return
            end

            local mine = current.MineGame
            local gems = MineConfig.GetGemCount(mine)

            if not Integer(gems) then
                Log("Blocked: invalid Gems balance")
                return
            end

            stage = "Reconcile"
            pending = runtime.GemShopPending

            if pending then
                if type(pending) ~= "table"
                    or type(pending.Item) ~= "string"
                    or not Integer(pending.InitialCount)
                    or not Integer(pending.GemsBefore)
                    or not Integer(pending.Price)
                    or pending.Price < 1 then
                    Log("Blocked: invalid existing GemShopPending")
                    return
                end

                local count, countError = OwnedCount(mine, pending)
                if count == nil then
                    Log("Waiting: " .. tostring(countError))
                    return
                end

                if count >= pending.InitialCount + 1 then
                    pending.GrantObserved = true
                end

                if gems <= pending.GemsBefore - pending.Price then
                    pending.DebitObserved = true
                end

                -- Keep both observations; a currency change alone is insufficient.
                if pending.GrantObserved and pending.DebitObserved then
                    if runtime.GemShopPending == pending then
                        runtime.GemShopPending = nil
                        runtime.GemShopLastItem = pending.Item
                    end

                    Log("State Updated: item grant and Gems debit observed"
                        .. " | " .. pending.Item)
                else
                    Log("Unknown: awaiting purchase state"
                        .. " | Item=" .. pending.Item
                        .. " | Grant="
                        .. tostring(pending.GrantObserved == true)
                        .. " | Debit="
                        .. tostring(pending.DebitObserved == true)
                        .. (pending.Error and (" | " .. pending.Error) or ""))
                end
                return
            end

            if autoBuy.Value ~= true then return end

            if not Config or type(Config.RowOpen) ~= "function" then
                Log("Blocked: RowOpen unavailable")
                return
            end

            if mine.PendingTrade == true
                or current.MineTradeSettling == true
                or LocalPlayer:GetAttribute("MineTradeSettling") == true
                or LocalPlayer:GetAttribute("ReloadingPlayerData") == true
                or current.SaveTooLarge == true then
                Log("Waiting: native trade / data guards")
                return
            end

            stage = "SelectItem"

            -- Rotate after a settled purchase so one item does not monopolize Gems.
            local startAt = 1
            for index, row in ipairs(rows) do
                if row.Item == runtime.GemShopLastItem then
                    startAt = index % #rows + 1
                    break
                end
            end

            local action
            local reason = "no selected affordable unlocked item"

            for offset = 0, #rows - 1 do
                local row = rows[(startAt + offset - 1) % #rows + 1]

                if Selected(row.Item)
                    and Config.RowOpen(row, mine) == true
                    and gems >= row.Price then

                    local product, productError = Product(row, PotionCatalog)

                    if not product then
                        reason = row.Item .. ": " .. tostring(productError)
                    else
                        local conflict = PotionConflict(product)
                        local count, countError = OwnedCount(mine, product)

                        if conflict then
                            reason = conflict
                        elseif count == nil then
                            reason = row.Item .. ": " .. tostring(countError)
                        else
                            product.Price = row.Price
                            product.InitialCount = count
                            product.GemsBefore = gems
                            action = product
                            break
                        end
                    end
                end
            end

            if not action then
                Log("Waiting: " .. reason)
                return
            end

            stage = "Dispatch"
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local Event = remotes
                and remotes:FindFirstChild("GamestateEvent")

            if not Event or not Event:IsA("RemoteEvent") then
                Log("Waiting: GamestateEvent unavailable")
                return
            end

            if not Active()
                or autoBuy.Value ~= true
                or not Selected(action.Item)
                or runtime.GemShopPending
                or PotionConflict(action) then
                return
            end

            action.At = os.clock()
            runtime.GemShopPending = action

            local sent, sendError = pcall(
                Event.FireServer, Event,
                "MineGemShopBuy", action.Item
            )

            if not sent then
                action.Error = tostring(sendError)
            end

            Log(sent
                and ("Request Sent: " .. action.Item)
                or ("Unknown: dispatch | " .. tostring(sendError)))
        end

        function GemShopAuto.Step()
            if not Active() then return end

            local ok, err = pcall(StepGemShop)
            if not ok then
                Log(stage .. ": " .. tostring(err))
            end
        end
    end

