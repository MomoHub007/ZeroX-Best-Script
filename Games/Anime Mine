        function TreeUpgrade.Step(current, GameState)
            local pending = runtime.TreePending

            -- Reconcile even after the user turns the feature off.
            if pending then
                local level = CurrentLevel(current.MineGame, pending)

                if level and level >= pending.ExpectedLevel then
                    if Active() and runtime.TreePending == pending then
                        runtime.TreePending = nil
                        nextPlanAt = 0
                        TreeUpgrade.Report(
                            "State Updated: " .. pending.Family
                                .. " = " .. tostring(level)
                        )
                    end
                else
                    TreeUpgrade.Report(
                        (os.clock() - pending.At >= OBSERVE_AFTER
                            and "Unknown: awaiting upgrade state"
                            or "Request Sent: awaiting upgrade state")
                        .. " | " .. pending.Kind
                        .. " / " .. pending.Family
                        .. (pending.ZoneKey and (" / " .. pending.ZoneKey) or "")
                        .. (pending.Error and (" | " .. pending.Error) or "")
                    )
                end

                return true
            end

            if not TreeUpgrade.Enabled() then
                TreeUpgrade.Report("Disabled")
                return false
            end

            local now = os.clock()
            if now < nextPlanAt then return false end
            nextPlanAt = now + 1

            local Config, configError = LoadModule("MineConfig")
            if not Active() then return true end

            local Items, itemsError
            if researchToggle.Value == true then
                Items, itemsError = LoadModule("Items")
                if not Active() then return true end
            end

            if not Config or (researchToggle.Value == true and not Items) then
                TreeUpgrade.Report(
                    "Waiting: " .. tostring(configError or itemsError)
                )
                return false
            end

            -- Modules may yield: refresh state before planning.
            local fresh, readError = ReadData(GameState)
            if not Active() then return true end
            if not fresh then
                TreeUpgrade.Report("Waiting: " .. tostring(readError))
                return false
            end
            current = fresh

            if not Number(current.Money) then
                TreeUpgrade.Report("Waiting: valid Money")
                return false
            end

            if current.MineGame.PendingTrade == true
                or current.MineTradeSettling == true then
                TreeUpgrade.Report("Waiting: trading / settling")
                return false
            end

            -- Protect only native read-only enumeration/calculation.
            -- Preserve the actual error instead of reporting success.
            local ok, rows = pcall(BuildCandidates, current, Config, Items)
            if not Active() then return true end
            if not ok then
                TreeUpgrade.Report("Blocked: BuildCandidates | " .. tostring(rows))
                return false
            end

            local focused = type(focusOption.Value) == "table"
                and focusOption.Value or {}
            local affordable = {}

            for _, candidate in ipairs(rows) do
                if candidate.Cost <= current.Money then
                    candidate.Focused = focused[candidate.Family] == true
                    table.insert(affordable, candidate)
                end
            end

            local currentZone = "Z" .. tostring(current.MineGame.CurrentZone)

            table.sort(affordable, function(a, b)
                if a.Focused ~= b.Focused then return a.Focused end
                if a.Cost ~= b.Cost then return a.Cost < b.Cost end
                if a.Kind ~= b.Kind then return a.Kind == "Core" end

                if a.Kind == "Core" and a.Family ~= b.Family then
                    return a.Family == "Slots"
                end

                local aCurrent = a.ZoneKey == currentZone
                local bCurrent = b.ZoneKey == currentZone
                if aCurrent ~= bCurrent then return aCurrent end

                if a.ZoneOrder ~= b.ZoneOrder then
                    return (a.ZoneOrder or 0) > (b.ZoneOrder or 0)
                end

                return (a.Id .. ":" .. a.Family)
                    < (b.Id .. ":" .. b.Family)
            end)

            local candidate = affordable[1]
            if not candidate then
                TreeUpgrade.Report(#rows == 0
                    and "Completed / Waiting: no open upgrades passing native gates"
                    or "Waiting: funds for an eligible upgrade")
                return false
            end

            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local Event = remotes and remotes:FindFirstChild("GamestateEvent")
            if not Event or not Event:IsA("RemoteEvent") then
                TreeUpgrade.Report("Waiting: GamestateEvent")
                return false
            end

            local selectedEnabled = candidate.Kind == "Research"
                and researchToggle.Value == true
                or candidate.Kind == "Core" and coreToggle.Value == true

            if not Active() or not selectedEnabled
                or runtime.TreePending then
                return false
            end

            candidate.At = os.clock()
            runtime.TreePending = candidate

            -- Keep Pending until replicated state confirms completion.
            local sent, sendError
            if candidate.Kind == "Research" then
                sent, sendError = pcall(
                    Event.FireServer,
                    Event,
                    candidate.Event,
                    candidate.ZoneKey,
                    candidate.Family,
                    candidate.Id
                )
            else
                sent, sendError = pcall(
                    Event.FireServer,
                    Event,
                    candidate.Event
                )
            end

            if not Active() then return true end
            if not sent then candidate.Error = tostring(sendError) end

            TreeUpgrade.Report(
                "Request Sent: " .. candidate.Kind
                    .. " / " .. candidate.Family
                    .. (candidate.ZoneKey and (" / " .. candidate.ZoneKey) or "")
                    .. (candidate.Error and (" | " .. candidate.Error) or "")
            )
            return true
        end
    end

    task.spawn(function()
        local failureDelay = 1

        while Active() do
