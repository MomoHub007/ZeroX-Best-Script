        local function RepeatZoneSelection(pending, GameState)
            if not Active() or runtime.ZonePending ~= pending then
                return nil
            end

            if controls.Select.Value ~= true then
                return "Paused: Auto Select Best Zone is Off; observing sent request"
            end

            local now = os.clock()
            local lastSent = pending.LastSentAt or pending.At

            if now < lastSent + 1
                or now < (pending.NextRetryCheckAt or 0) then
                return nil
            end
            pending.NextRetryCheckAt = now + 1

            local fresh, readError = ReadData(GameState)
            if not Active() or runtime.ZonePending ~= pending then
                return nil
            end
            if not fresh then
                return "Waiting: " .. tostring(readError)
            end

            local mine = fresh.MineGame
            local unlocked = type(mine.UnlockedZones) == "table"
                and mine.UnlockedZones[pending.Key] == true

            if unlocked and mine.CurrentZone == pending.Number then
                runtime.ZonePending = nil
                nextCheckAt = 0
                return "Completed: " .. pending.Key
            end

            if not unlocked then
                return "Blocked: retry target is not unlocked"
            end

            if runtime.PlaceJob then
                return "Waiting: Miner placement reconciliation"
            end

            if runtime.Pending or runtime.TreePending
                or runtime.EquipBestPending
                or (runtime.PickaxePending
                    and runtime.PickaxePending.Kind == "Buy") then
                return "Waiting: existing upgrade / Equip Best"
            end

            if mine.PendingTrade == true
                or fresh.MineTradeSettling == true
                or LocalPlayer:GetAttribute("MineTradeSettling") == true then
                return "Waiting: trading / settling"
            end

            if LocalPlayer:GetAttribute("ReloadingPlayerData") == true then
                return "Waiting: player data reload"
            end

            if fresh.SaveTooLarge == true then
                return "Blocked: SaveTooLarge"
            end

            if EventActive() then
                return "Waiting: active Meteor Core / Titan Geode"
            end

            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local Event = remotes and remotes:FindFirstChild("GamestateEvent")

            if not Event or not Event:IsA("RemoteEvent") then
                return "Waiting: GamestateEvent"
            end

            -- A local dispatch error must be diagnosed rather than repeated
            -- against the same failing Remote instance.
            if pending.Error and pending.LastRemote == Event then
                return "Blocked: dispatch error | " .. pending.Error
            end

            if not Active() or controls.Select.Value ~= true
                or runtime.ZonePending ~= pending
                or runtime.PlaceJob or runtime.Pending
                or runtime.TreePending or runtime.EquipBestPending
                or (runtime.PickaxePending
                    and runtime.PickaxePending.Kind == "Buy")
                or EventActive() then
                return nil
            end

            pending.LastSentAt = os.clock()
            pending.LastRemote = Event
            pending.Attempts = (pending.Attempts or 1) + 1
            pending.Error = nil

            local sent, sendError = pcall(
                Event.FireServer,
                Event,
                "MineSelectZone",
                pending.Key
            )

            if not Active() or runtime.ZonePending ~= pending then
                return nil
            end

            if not sent then
                pending.Error = tostring(sendError)
            end

            return (sent and "Request Sent: select " or "Unknown: dispatch ")
                .. pending.Key
                .. " | Attempts=" .. tostring(pending.Attempts)
                .. (pending.Error and (" | " .. pending.Error) or "")
        end

        function ZoneGear.Step(current, GameState)
            local mine = current.MineGame
            local pending = runtime.ZonePending

            if pending then
                local unlocked = type(mine.UnlockedZones) == "table"
