    end
    local attr = workspace:GetAttribute("LobbyHeight")
    if type(attr) == "number" then
        return attr
    end
    return WorldSupport.GetWorld() >= 2 and 24 or 0
end

function WorldSupport.GetSafeZoneCFrame()
    local spawnLoc = workspace:FindFirstChild("SpawnLocation")
    if spawnLoc and spawnLoc:IsA("BasePart") then
        local cf = CFrame.new(
            spawnLoc.Position.X,
            spawnLoc.Position.Y + spawnLoc.Size.Y * 0.5 + 3.2,
            spawnLoc.Position.Z + 2
        )
        WorldSupport.CachedSafeZoneCF = cf
        return cf
    end
    if WorldSupport.CachedSafeZoneCF then
        return WorldSupport.CachedSafeZoneCF
    end
    local lobbyH = WorldSupport.GetLobbyHeight()
    return CFrame.new(0, lobbyH > 0 and (lobbyH + 3) or 4, 2)
end

function WorldSupport.ParseCFrameString(raw)
    if typeof(raw) == "CFrame" then return raw end
    if type(raw) ~= "string" then return nil end
    local nums = {}
    for token in string.gmatch(raw, "[^,%s]+") do
        local n = tonumber(token)
        if not n then return nil end
        table.insert(nums, n)
    end
    if #nums >= 12 then
        return CFrame.new(table.unpack(nums, 1, 12))
    elseif #nums >= 3 then
        return CFrame.new(nums[1], nums[2], nums[3])
    end
    return nil
end

function WorldSupport.GetMyBaseCFrame()
    local bases = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Bases")
    if bases then
        for _, base in ipairs(bases:GetChildren()) do
            if base:GetAttribute("Owner") == LocalPlayer.UserId then
                local ok, pivot = pcall(function() return base:GetPivot() end)
                if ok and typeof(pivot) == "CFrame" then
                    return pivot
                end
            end
        end
    end
    return WorldSupport.ParseCFrameString(LocalPlayer:GetAttribute("BaseSpawn"))
end

function WorldSupport.GetZoneDisplayName(gate)
    local ok, zc = pcall(require, ReplicatedStorage.Shared.Config.ZoneConfig)
    if ok and type(zc) == "table" then
        local info = zc[gate] or (gate == "Tutorial" and zc.StageTutorial)
        if type(info) == "table" and type(info.Name) == "string" and info.Name ~= "" then
            return info.Name
        end
    end
    return gate
end

function WorldSupport.GetZones()
    local padsFolder = ReplicatedStorage:FindFirstChild("EnemyPads")
    local padByGate = {}
    local padList = {}
    if padsFolder then
        for _, pad in ipairs(padsFolder:GetChildren()) do
            local gate = pad:GetAttribute("Gate")
            local padCF = pad:GetAttribute("PadCFrame")
            if type(gate) == "string" and gate ~= "" then
                table.insert(padList, { Pad = pad, Gate = gate, PadCFrame = padCF })
                if not padByGate[gate] or typeof(padCF) == "CFrame" then
                    padByGate[gate] = pad
                end
            end
        end
    end

    local zones, seen = {}, {}
    local pc = WorldSupport.GetPlaceConfig()
    local worldCfg = pc and pc.Worlds and pc.Worlds[WorldSupport.GetWorld()]
    local bosses = worldCfg and worldCfg.Bosses
    if type(bosses) == "table" and #bosses > 0 then
        for _, entry in ipairs(bosses) do
            local gate = type(entry) == "table" and entry.Gate
            if type(gate) == "string" and gate ~= "" and not seen[gate] then
                seen[gate] = true
                local pad = padByGate[gate]
                local padCF = pad and pad:GetAttribute("PadCFrame")
                table.insert(zones, {
                    Key = gate,
                    Name = WorldSupport.GetZoneDisplayName(gate),
                    Pad = pad,
                    CFrame = typeof(padCF) == "CFrame" and (padCF * CFrame.new(0, 4, 0)) or nil,
                    MinZ = pad and pad:GetAttribute("ZoneMinZ"),
                    MaxZ = pad and pad:GetAttribute("ZoneMaxZ"),
                })
            end
        end
    end

    -- Fallback: populate directly from EnemyPads sorted from lobby (-Z progression)
    table.sort(padList, function(a, b)
        local za = typeof(a.PadCFrame) == "CFrame" and a.PadCFrame.Position.Z or 0
        local zb = typeof(b.PadCFrame) == "CFrame" and b.PadCFrame.Position.Z or 0
        return za > zb
    end)
    for _, item in ipairs(padList) do
        if not seen[item.Gate] then
            seen[item.Gate] = true
            local padCF = item.PadCFrame
            table.insert(zones, {
                Key = item.Gate,
                Name = WorldSupport.GetZoneDisplayName(item.Gate),
                Pad = item.Pad,
                CFrame = typeof(padCF) == "CFrame" and (padCF * CFrame.new(0, 4, 0)) or nil,
                MinZ = item.Pad:GetAttribute("ZoneMinZ"),
                MaxZ = item.Pad:GetAttribute("ZoneMaxZ"),
            })
        end
    end
    return zones
end

function WorldSupport.GetWorldMobs()
    local seen, mobs = {}, {}
    local padsFolder = ReplicatedStorage:FindFirstChild("EnemyPads")
    if padsFolder then
        for _, pad in ipairs(padsFolder:GetChildren()) do
            local enemyName = pad:GetAttribute("Enemy")
            if type(enemyName) == "string" and enemyName ~= "" and not seen[enemyName] then
                seen[enemyName] = true
                table.insert(mobs, enemyName)
            end
        end
    end
    if #mobs == 0 then
        pcall(function()
            local ec = require(ReplicatedStorage.Shared.Config.EnemyConfig)
            for name in pairs(ec.Enemies or ec.Types or {}) do
                if not seen[name] then
                    seen[name] = true
                    table.insert(mobs, name)
                end
            end
        end)
    end
    table.sort(mobs)
    table.insert(mobs, 1, "All")
    return mobs
end

function WorldSupport.IsEnemyBoss(enemy)
    if not enemy then return false end
    if enemy:GetAttribute("Boss") == true then return true end
    local ok, ec = pcall(require, ReplicatedStorage.Shared.Config.EnemyConfig)
    if ok and type(ec) == "table" and type(ec.Types) == "table" then
        local eType = enemy:GetAttribute("Type") or enemy.Name
        local cfg = ec.Types[eType]
        if type(cfg) == "table" and cfg.Boss == true then
            return true
        end
    end
    return enemy.Name:find("Dominus") ~= nil
        or enemy.Name:find("Lord") ~= nil
        or enemy.Name:find("King") ~= nil
end

function WorldSupport.GetAbilityModules()
    if WorldSupport.AbilityConfig == nil then
        local ok, mod = pcall(require, ReplicatedStorage.Shared.Config.AbilityConfig)
        WorldSupport.AbilityConfig = (ok and type(mod) == "table") and mod or false
    end
    if WorldSupport.PredictedCast == nil then
        local ok, mod = pcall(require, ReplicatedStorage.Client.Core.PredictedCast)
        WorldSupport.PredictedCast = (ok and type(mod) == "table") and mod or false
    end
    return WorldSupport.AbilityConfig or nil, WorldSupport.PredictedCast or nil
end

function WorldSupport.CastEquippedAbilitiesAt(targetPos, burstAll)
    local useAbility = Remotes and Remotes:FindFirstChild("UseAbility")
    if not (useAbility and useAbility:IsA("RemoteEvent")) then
        return false
    end
    local data = PlayerState and PlayerState.Data
    local equipped = data and data.Equipped
    if type(equipped) ~= "table" or #equipped == 0 then
        return false
    end

    local abilityCfg, predictedCast = WorldSupport.GetAbilityModules()
    local now = os.clock()
    local fired = false

    local function fireMove(card, abId, cooldown)
        local key = tostring(card) .. "/" .. tostring(abId)
        if (WorldSupport.AbilityCooldowns[key] or 0) > now then
            return
        end
        local def = abilityCfg and abilityCfg.Get and abilityCfg.Get(abId)
        local predict = def and def.Predict == true or false
        local castId = (predictedCast and type(predictedCast.NextCastId) == "function")
            and predictedCast.NextCastId()
            or math.floor(now * 1000) % 1000000
        pcall(function()
            useAbility:FireServer(card, abId, targetPos, predict, castId)
        end)
        WorldSupport.AbilityCooldowns[key] = now + cooldown
        fired = true
    end

    for _, card in ipairs(equipped) do
        if type(card) == "string" and card ~= "" then
            local cardData = data.Cards and data.Cards[card]
            local cardLevel = (type(cardData) == "table" and tonumber(cardData.Level)) or 1
            local primaryId = abilityCfg and abilityCfg.PrimaryFor and abilityCfg.PrimaryFor(card)
            if type(primaryId) == "string" and primaryId ~= "" then
                fireMove(card, primaryId, burstAll and 0.12 or 0.18)
            end
            if abilityCfg and abilityCfg.ForCard then
                for _, ab in ipairs(abilityCfg.ForCard(card) or {}) do
                    if type(ab) == "table" and type(ab.Id) == "string" and cardLevel >= (tonumber(ab.Level) or 1) then
                        fireMove(card, ab.Id, burstAll and 0.35 or 0.65)
                    end
                end
            elseif not primaryId then
                fireMove(card, card, 0.2)
            end
        end
    end

    return fired
end

local function GetRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function DamageEnemy(model, damageAmount)
    if not (model and model:IsA("Model")) or model:GetAttribute("Dead") then
        return false
    end
    if not (LocalEnemyRegistry and type(LocalEnemyRegistry.Damage) == "function") then
        return false
    end

    local hum = model:FindFirstChildOfClass("Humanoid")
    local hu = tonumber(model:GetAttribute("HealthUnit")) or 1
    local currentHp = hum and hum.Health or 100

    -- Dynamic lethal calculation: (Health * HealthUnit) accounts for world-tier health scaling
    local lethal = (currentHp + 1e10) * hu * 2
    local finalAmount = (damageAmount and damageAmount > lethal) and damageAmount or lethal

    local ok, defeated = pcall(LocalEnemyRegistry.Damage, model, finalAmount)
    if not ok then
        warn("[Zero X] Damage failed: " .. tostring(defeated))
        return false
    end
    return defeated == true
end

