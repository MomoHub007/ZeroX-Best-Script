    -- Dungeon Loop
    do
        local lastNudgeAt = 0

        local function ZeroBodyVelocity(root)
            if root and root:IsA("BasePart") then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end

        local function IsPointInPartVolume(pos, part, xzMargin)
            if not (part and part:IsA("BasePart")) then
                return false
            end
            local rel = part.CFrame:PointToObjectSpace(pos)
            local half = part.Size * 0.5
            local margin = xzMargin or 2
            return math.abs(rel.X) <= math.max(1, half.X - margin)
                and math.abs(rel.Z) <= math.max(1, half.Z - margin)
                and math.abs(rel.Y) <= (half.Y + 12)
        end

        local function GetExitPortalPositions(myRun)
            local portals = {}
            local bossPortals = workspace:FindFirstChild("BossPortals")
            if bossPortals then
                for _, portal in ipairs(bossPortals:GetChildren()) do
                    local pPart = portal:IsA("BasePart") and portal
                        or (portal:IsA("Model") and (portal.PrimaryPart or portal:FindFirstChildWhichIsA("BasePart")))
                    if pPart then
                        table.insert(portals, pPart.Position)
                    elseif portal:IsA("Model") then
                        table.insert(portals, portal:GetPivot().Position)
                    end
                end
            end
            local dungeonMaps = workspace:FindFirstChild("DungeonMaps")
            if dungeonMaps then
                for _, map in ipairs(dungeonMaps:GetChildren()) do
                    local mRun = map:GetAttribute("Run")
                    if myRun == nil or mRun == myRun or (mRun == nil and map.Name:match("^Run" .. tostring(myRun) .. "_")) then
                        local ep = map:FindFirstChild("ExitPortal")
                        if ep then
                            local pos = ep:IsA("BasePart") and ep.Position or (ep:IsA("Model") and ep:GetPivot().Position)
                            if pos then
                                table.insert(portals, pos)
                            end
                        end
                    end
                end
            end
            return portals
        end

        local function IsNearAnyPortal(pos, portalPositions, safeRadius)
            local radius = safeRadius or 22
            for _, pPos in ipairs(portalPositions) do
                if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(pPos.X, 0, pPos.Z)).Magnitude < radius then
                    return true, pPos
                end
            end
            return false, nil
        end

        local function ParseDungeonFloor(map)
            local floorAttr = tonumber(map:GetAttribute("Floor"))
            if floorAttr then
                return floorAttr
            end
            return tonumber(
                map.Name:match("_Floor_?(%d+)$")
                    or map.Name:match("Floor_?(%d+)$")
                    or map.Name:match("_(%d+)$")
            )
        end

        local function CollectRunMaps(dungeonMaps, myRun)
            local entries = {}
            for _, map in ipairs(dungeonMaps:GetChildren()) do
                if map:IsA("Model") or map:IsA("Folder") then
                    local mapRun = map:GetAttribute("Run")
                    local nameRun = tonumber(map.Name:match("^Run(%d+)_"))
                    local belongs = false
                    if myRun ~= nil then
                        if mapRun ~= nil then
                            belongs = (mapRun == myRun) or (tonumber(mapRun) == tonumber(myRun))
                        elseif nameRun ~= nil then
                            belongs = (nameRun == tonumber(myRun))
                        else
                            belongs = map.Name:find("Run" .. tostring(myRun) .. "_", 1, true) ~= nil
                        end
                    else
                        belongs = true
                    end

                    if belongs then
                        local floorNum = ParseDungeonFloor(map)
                        if floorNum then
                            table.insert(entries, {
                                Map = map,
                                Floor = floorNum,
                                Bounds = map:FindFirstChild("Bounds"),
                                Entry = map:FindFirstChild("Entry"),
                                EntryDoor = map:FindFirstChild("EntryDoor"),
                                ExitDoor = map:FindFirstChild("ExitDoor"),
                                WalkCorridor = map:FindFirstChild("WalkCorridor"),
                                WalkFloor = map:FindFirstChild("WalkFloor"),
                                FloorPart = map:FindFirstChild("Floor"),
                                BossSpot = map:FindFirstChild("BossSpot"),
                            })
                        end
                    end
                end
            end
            table.sort(entries, function(a, b) return a.Floor < b.Floor end)
            return entries
        end

        local function GetStandY(entry)
            if entry.WalkFloor and entry.WalkFloor:IsA("BasePart") then
                return entry.WalkFloor.Position.Y + entry.WalkFloor.Size.Y * 0.5 + 3.2
            elseif entry.FloorPart and entry.FloorPart:IsA("BasePart") then
                return entry.FloorPart.Position.Y + entry.FloorPart.Size.Y * 0.5 + 3.2
            elseif entry.Entry and entry.Entry:IsA("BasePart") then
                return entry.Entry.Position.Y
            end
            return nil
        end

        local function MoveRootThroughWaypoints(root, humanoid, waypoints, portalPositions)
            if #waypoints == 0 then
                return false
            end

            -- Build segmented path so distance per step stays small (~30 studs) across floor -> corridor -> entry
            local steps = {}
            local cursor = root.Position
            for _, wp in ipairs(waypoints) do
                local safeWp = wp
                local nearPortal, pPos = IsNearAnyPortal(safeWp, portalPositions, 22)
                if nearPortal and pPos then
                    local away = Vector3.new(safeWp.X - pPos.X, 0, safeWp.Z - pPos.Z)
                    local dir = away.Magnitude > 0.1 and away.Unit or Vector3.new(0, 0, 1)
                    safeWp = Vector3.new(pPos.X + dir.X * 24, safeWp.Y, pPos.Z + dir.Z * 24)
                end

                local delta = safeWp - cursor
                local dist = delta.Magnitude
                if dist > 1.5 then
                    local subCount = math.max(1, math.ceil(dist / 30))
                    for i = 1, subCount do
                        local pt = cursor:Lerp(safeWp, i / subCount)
                        local subNear = IsNearAnyPortal(pt, portalPositions, 20)
                        if not subNear then
                            table.insert(steps, pt)
                        end
                    end
                    cursor = safeWp
                end
            end

            if #steps == 0 then
                table.insert(steps, waypoints[#waypoints])
            end

            if humanoid then
                pcall(function()
                    if humanoid.Sit then humanoid.Sit = false end
                end)
            end
            root.Anchored = false

            for idx, pt in ipairs(steps) do
                if MacUI.Unloaded
                    or not DungeonSettings.AutoAdvanceRooms
                    or GetRoot() ~= root
                    or not root.Parent
                    or LocalPlayer:GetAttribute("DungeonRun") == nil
                    or LocalPlayer:GetAttribute("DungeonFight") == true
                    or LocalPlayer:GetAttribute("Downed") == true then
                    return false
                end

                local lookTarget = steps[idx + 1] or waypoints[#waypoints]
                local flatLook = Vector3.new(lookTarget.X, pt.Y, lookTarget.Z)
                ZeroBodyVelocity(root)
                if (flatLook - pt).Magnitude > 0.5 then
                    root.CFrame = CFrame.lookAt(pt, flatLook)
                else
                    root.CFrame = CFrame.new(pt)
                end
                ZeroBodyVelocity(root)

                if idx < #steps then
                    task.wait(0.05)
                end
            end

            if humanoid and humanoid.Parent and GetRoot() == root then
                local finalGoal = steps[#steps]
                pcall(function()
                    humanoid:MoveTo(finalGoal)
                end)
            end
            return true
        end

        local function AdvanceToNextDungeonRoom(root, humanoid, myRun, dungeonFloor)
            local dungeonMaps = workspace:FindFirstChild("DungeonMaps")
            local portalPositions = GetExitPortalPositions(myRun)

            if dungeonMaps then
                local entries = CollectRunMaps(dungeonMaps, myRun)
                if #entries > 0 then
                    -- Server increments DungeonFloor BEFORE the player walks into the new room
                    -- (e.g. clearing Floor 20 sets DungeonFloor=21 while Run1_Floor21 spawns ahead).
                    local targetEntry = nil
                    local prevEntry = nil

                    for idx, e in ipairs(entries) do
                        if e.Floor == dungeonFloor then
                            targetEntry = e
                            prevEntry = idx > 1 and entries[idx - 1] or nil
                            break
                        end
                    end

                    -- Fallback if DungeonFloor wasn't incremented yet or room isn't in exact slot
                    if not targetEntry then
                        for idx, e in ipairs(entries) do
                            if e.Floor > dungeonFloor and not IsPointInPartVolume(root.Position, e.Bounds, 3) then
                                targetEntry = e
                                prevEntry = idx > 1 and entries[idx - 1] or nil
                                break
                            end
                        end
                    end

                    -- Last fallback: highest floor model for our run that we are not yet inside
                    if not targetEntry then
                        for idx = #entries, 1, -1 do
                            local e = entries[idx]
                            if not IsPointInPartVolume(root.Position, e.Bounds, 3) then
                                targetEntry = e
                                prevEntry = idx > 1 and entries[idx - 1] or nil
                                break
                            end
                        end
                    end

                    if targetEntry then
                        local standY = GetStandY(targetEntry) or root.Position.Y
                        local insideTarget = IsPointInPartVolume(root.Position, targetEntry.Bounds, 4)

                        local entryDoorOpen = not (targetEntry.EntryDoor and targetEntry.EntryDoor:IsA("BasePart"))
                            or targetEntry.EntryDoor.CanCollide == false
                            or targetEntry.EntryDoor:GetAttribute("Open") == true
                        local prevExitOpen = not (prevEntry and prevEntry.ExitDoor and prevEntry.ExitDoor:IsA("BasePart"))
                            or prevEntry.ExitDoor.CanCollide == false
                            or prevEntry.ExitDoor:GetAttribute("Open") == true

                        if not insideTarget then
                            if not entryDoorOpen and not prevExitOpen then
                                return false
                            end

                            local waypoints = {}
                            if prevEntry and prevEntry.ExitDoor and prevEntry.ExitDoor:IsA("BasePart")
                                and (prevEntry.ExitDoor.CanCollide == false or prevEntry.ExitDoor:GetAttribute("Open") == true) then
                                local p = prevEntry.ExitDoor.Position
                                table.insert(waypoints, Vector3.new(p.X, standY, p.Z))
                            end

                            if targetEntry.WalkCorridor and targetEntry.WalkCorridor:IsA("BasePart") then
                                local wc = targetEntry.WalkCorridor
                                local wcY = wc.Position.Y + wc.Size.Y * 0.5 + 3.2
                                table.insert(waypoints, Vector3.new(wc.Position.X, wcY, wc.Position.Z))
                            end

                            if targetEntry.EntryDoor and targetEntry.EntryDoor:IsA("BasePart")
                                and (targetEntry.EntryDoor.CanCollide == false or targetEntry.EntryDoor:GetAttribute("Open") == true) then
                                local ed = targetEntry.EntryDoor.Position
                                table.insert(waypoints, Vector3.new(ed.X, standY, ed.Z))
                            end

                            if targetEntry.Entry and targetEntry.Entry:IsA("BasePart") then
                                local ep = targetEntry.Entry.Position
                                table.insert(waypoints, Vector3.new(ep.X, standY, ep.Z))
                            end

                            if targetEntry.WalkFloor and targetEntry.WalkFloor:IsA("BasePart") then
                                local wf = targetEntry.WalkFloor.Position
                                local walkPos = Vector3.new(wf.X, standY, wf.Z)
                                if targetEntry.Entry and targetEntry.Entry:IsA("BasePart") then
                                    walkPos = targetEntry.Entry.Position:Lerp(walkPos, 0.45)
                                    walkPos = Vector3.new(walkPos.X, standY, walkPos.Z)
                                end
                                table.insert(waypoints, walkPos)
                            elseif targetEntry.BossSpot and targetEntry.BossSpot:IsA("BasePart") then
                                local bs = targetEntry.BossSpot.Position
                                table.insert(waypoints, Vector3.new(bs.X, standY, bs.Z))
                            elseif targetEntry.Map:IsA("Model") then
                                local pv = targetEntry.Map:GetPivot().Position
                                table.insert(waypoints, Vector3.new(pv.X, standY, pv.Z))
                            end

                            if #waypoints > 0 then
                                lastNudgeAt = os.clock()
                                return MoveRootThroughWaypoints(root, humanoid, waypoints, portalPositions)
                            end
                        elseif (os.clock() - lastNudgeAt) >= 0.9 then
                            -- Already inside Bounds while DungeonFight is still false:
                            -- step gently toward WalkFloor / Entry in case room trigger waits further inside
                            local centerTarget = nil
                            if targetEntry.WalkFloor and targetEntry.WalkFloor:IsA("BasePart") then
                                local wf = targetEntry.WalkFloor.Position
                                centerTarget = Vector3.new(wf.X, standY, wf.Z)
                            elseif targetEntry.Entry and targetEntry.Entry:IsA("BasePart") then
                                local ep = targetEntry.Entry.Position
                                centerTarget = Vector3.new(ep.X, standY, ep.Z)
                            end
                            if centerTarget and (root.Position - centerTarget).Magnitude > 6 then
                                local nearPortal = IsNearAnyPortal(centerTarget, portalPositions, 22)
                                if not nearPortal then
                                    lastNudgeAt = os.clock()
                                    return MoveRootThroughWaypoints(root, humanoid, { centerTarget }, portalPositions)
                                end
                            end
                        end
                    end
                end
            end

            -- Safety avoidance against HomePortal/ExitPortal when no target room moved us
            local nearPortal, pPos = IsNearAnyPortal(root.Position, portalPositions, 22)
            if nearPortal and pPos and GetRoot() == root and root.Parent then
                local away = Vector3.new(root.Position.X - pPos.X, 0, root.Position.Z - pPos.Z)
                local dir = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
                local safePos = Vector3.new(pPos.X + dir.X * 26, root.Position.Y, pPos.Z + dir.Z * 26)
                ZeroBodyVelocity(root)
                root.CFrame = CFrame.new(safePos)
            end
            return false
        end

        task.spawn(function()
            while task.wait(0.2) do
                if MacUI.Unloaded then break end
                local root = GetRoot()
                local myRun = LocalPlayer:GetAttribute("DungeonRun")
                local inDungeon = myRun ~= nil

                -- 1. Auto Enter Portal (World 2 only)
                if DungeonSettings.AutoEnterDungeon and not inDungeon and root then
                    local portal = workspace:FindFirstChild("DungeonPortal")
                    if not portal and not WorldSupport.IsDungeonAvailable() then
                        DungeonSettings.AutoEnterDungeon = false
                        Window:Toast("Dungeon", { Detail = "Dungeon mode is only available in World 2!" })
                        pcall(function()
                            if Options.AutoEnterDungeonToggle and Options.AutoEnterDungeonToggle.SetValue then
                                Options.AutoEnterDungeonToggle:SetValue(false)
                            end
                        end)
                    end
                    local humanoid = GetHumanoid()
                    if portal and portal:IsA("Model") and humanoid and humanoid.Health > 0 then
                        local center = portal:GetPivot().Position
                        local radius = tonumber(portal:GetAttribute("Radius")) or 11
                        local offset = root.Position - center
                        local inside = Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and math.abs(offset.Y) < 12
                        if not inside and DungeonSettings.AutoEnterDungeon and LocalPlayer:GetAttribute("DungeonRun") == nil
                            and GetRoot() == root and root.Parent then
                            ZeroBodyVelocity(root)
                            root.CFrame = CFrame.new(center + Vector3.new(0, 3, 0))
                        end
                    end
                end

                -- 2. Auto Clear Mobs in Dungeon (Kill Aura + 1-Hit / Abilities + Auto Advance)
                if inDungeon and root and LocalPlayer:GetAttribute("Downed") ~= true then
                    pcall(function()
                        local dungeonFight = LocalPlayer:GetAttribute("DungeonFight") == true
                        local dungeonFloor = tonumber(LocalPlayer:GetAttribute("DungeonFloor")) or 1
                        local enemyContainer = workspace:FindFirstChild("Enemies")

                        if dungeonFight and DungeonSettings.AutoFarmDungeonRooms and enemyContainer then
                            local validTargets = {}
                            local currentPos = root.Position
                            local maxRadius = tonumber(DungeonSettings.DungeonRadius) or 350

                            for _, enemy in ipairs(enemyContainer:GetChildren()) do
                                if enemy:IsA("Model") and not enemy:GetAttribute("Dead") then
                                    local enemyRun = enemy:GetAttribute("Dungeon")
                                    if enemyRun == nil or enemyRun == myRun then
                                        local hum = enemy:FindFirstChildOfClass("Humanoid")
                                        local eRoot = enemy.PrimaryPart
                                            or enemy:FindFirstChild("HumanoidRootPart")
                                            or enemy:FindFirstChild("SimRoot", true)
                                        if (not hum or hum.Health > 0) and eRoot and eRoot:IsA("BasePart") then
                                            local dist = (eRoot.Position - currentPos).Magnitude
                                            if dist <= maxRadius or enemyRun == myRun then
                                                table.insert(validTargets, {
                                                    Model = enemy,
                                                    Root = eRoot,
                                                    Dist = dist,
                                                    IsLocal = LocalEnemyRegistry
                                                        and type(LocalEnemyRegistry.Is) == "function"
                                                        and LocalEnemyRegistry.Is(enemy) == true,
                                                })
                                            end
                                        end
                                    end
                                end
                            end

                            table.sort(validTargets, function(a, b) return a.Dist < b.Dist end)
                            local dmg = DungeonSettings.DungeonOneHit and 1e35 or 1e12

                            if #validTargets > 0 then
                                for _, target in ipairs(validTargets) do
                                    if MacUI.Unloaded or not DungeonSettings.AutoFarmDungeonRooms
                                        or GetRoot() ~= root or not root.Parent
                                        or LocalPlayer:GetAttribute("DungeonRun") == nil
                                        or LocalPlayer:GetAttribute("DungeonFight") ~= true
                                        or LocalPlayer:GetAttribute("Downed") == true then
                                        break
                                    end

                                    if target.Model and target.Model.Parent and not target.Model:GetAttribute("Dead")
                                        and target.Root and target.Root.Parent then
                                        local tPos = target.Root.Position
                                        if DungeonSettings.DungeonKillAura then
                                            local standPos = tPos + Vector3.new(0, 4.5, 0)
                                            ZeroBodyVelocity(root)
                                            root.CFrame = CFrame.lookAt(standPos, tPos)
                                            ZeroBodyVelocity(root)
                                        end

                                        if target.IsLocal then
                                            DamageEnemy(target.Model, dmg)
                                        else
                                            WorldSupport.CastEquippedAbilitiesAt(tPos, DungeonSettings.DungeonOneHit)
                                        end

                                        if DungeonSettings.DungeonKillAura then
                                            task.wait(0.05)
                                        end
                                    end
                                end
                            end
                        elseif not dungeonFight and DungeonSettings.AutoAdvanceRooms then
                            AdvanceToNextDungeonRoom(root, GetHumanoid(), myRun, dungeonFloor)
                        end
                    end)
                end

                -- 3. Auto Buy Trinkets with Tokens
                if DungeonSettings.AutoBuyTrinkets and Remotes and Remotes:FindFirstChild("DungeonBuy") then
                    pcall(function()
                        local data = PlayerState and PlayerState.Data
                        if not data then return end
                        local DungeonConfig = require(ReplicatedStorage.Shared.Config.DungeonConfig)
                        local offers = type(DungeonConfig.Offers) == "function" and DungeonConfig.Offers() or {}
                        for _, offer in ipairs(offers) do
                            if not DungeonSettings.AutoBuyTrinkets or MacUI.Unloaded then break end
                            if offer.Kind == "Trinket" and type(DungeonConfig.CanBuy) == "function"
                                and DungeonConfig.CanBuy(data, offer.Id) then
                                Remotes.DungeonBuy:InvokeServer(offer.Id)
                                task.wait(0.25)
                            end
                        end
                    end)
                end
            end
        end)
    end
end

