        Callback = function(enabled) state.Noclip = enabled end,
    })

    -- Flight
    local FlySection = Tabs.Player:AddSection({ Title = "Flight", Icon = "plane" })

    local function StartFlight()
        local root = GetRoot()
        local hum = GetHumanoid()
        if not root or not hum then return end

        local camera = workspace.CurrentCamera
        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.P = 9e4
        bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.CFrame = root.CFrame
        bodyGyro.Parent = root

        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bodyVelocity.Parent = root

        flight = { Gyro = bodyGyro, Velocity = bodyVelocity }

        motionConnection = RunService.RenderStepped:Connect(function()
            if not flight or not root.Parent then return end
            flight.Gyro.CFrame = camera.CFrame
            local direction = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction = direction + camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction = direction - camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction = direction - camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction = direction + camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction = direction + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then direction = direction - Vector3.new(0, 1, 0) end

            if direction.Magnitude > 0 then
                flight.Velocity.Velocity = direction.Unit * state.FlySpeed
            else
                flight.Velocity.Velocity = Vector3.zero
            end
        end)
    end

    local function StopFlight()
        if motionConnection then motionConnection:Disconnect(); motionConnection = nil end
        if flight then
            if flight.Gyro then flight.Gyro:Destroy() end
            if flight.Velocity then flight.Velocity:Destroy() end
            flight = nil
        end
    end

    FlySection:AddToggle("FlyEnabled", {
        Title = "Enable Fly",
        Description = "ควบคุมการบินของตัวละครด้วยความเร็วที่กำหนด",
