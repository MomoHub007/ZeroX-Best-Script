    local function ProcessPotionShop(mode)
        if potionBusy then return "A potion request is already pending." end
        local data = PlayerState and PlayerState.Data
        local buy = Remotes and Remotes:FindFirstChild("BuyCosmetic")
        local equip = Remotes and Remotes:FindFirstChild("EquipCosmetic")
        local remote = mode == "use" and equip or buy
        if not data or not remote or not remote:IsA("RemoteFunction") or type(data.Backpack) ~= "table" then
            return "Potion state or remote unavailable.", true
        end
        local now = workspace:GetServerTimeNow()
        local function invoke(remote, id, tier, signature)
            potionBusy = true
            if mode == "use" then
                potionUseAttempts[id] = signature
            else
                potionAttempts[signature] = true
            end
            local ok, success, reason = pcall(function()
                return remote:InvokeServer("Potion", id, tier)
            end)
            potionBusy = false
            if not ok then return id .. ": request failed; result unknown (" .. tostring(success) .. ").", true end
            if success ~= true then return id .. ": " .. tostring(reason or "request rejected or unknown"), true end
            return id .. " tier " .. tostring(tier) .. ": request accepted."
        end
        local pendingUse = {}
        if mode == "use" or mode == "buy" then
            for key, count in pairs(data.Backpack) do
                if type(key) == "string" and type(count) == "number" and count > 0 then
                    local id, tierText = string.match(key, "^Potion|([%w_]+)|(%d+)$")
                    local tier = tierText and tonumber(tierText)
                    local active = id and type(data.Potions) == "table" and data.Potions[id]
                    local ends = type(active) == "table" and active.Ends
                    if id and tier and (active == nil or type(ends) == "number" and ends <= now) then
                        pendingUse[id] = true
                        local signature = "use:" .. key .. ":" .. tostring(count) .. ":" .. tostring(ends)
                        if mode == "use" and potionUseAttempts[id] ~= signature then return invoke(equip, id, tier, signature) end
                    end
                end
            end
        end
        if mode == "use" then return "No eligible potion available." end
        local config = require(ReplicatedStorage.Shared.Config.CosmeticConfig)
        local Big = require(ReplicatedStorage.Shared.Util.Big)
        local slot = config.PotionShelf(data, now)
        if type(slot) ~= "number" then return "Potion shop state unavailable.", true end
        local stock = config.PotionStock(LocalPlayer.UserId, slot)
        if type(stock) ~= "table" then return "Potion shop state unavailable.", true end
        if potionAttemptSlot ~= slot then
            for signature in pairs(potionAttempts) do
                if string.sub(signature, 1, 4) == "buy:" then potionAttempts[signature] = nil end
            end
            potionAttemptSlot = slot
        end
        for _, item in ipairs(stock) do
            local id = item.Type and item.Type.Id
            local tier = item.Tier and item.Tier.Tier
            local price = item.Tier and item.Tier.Price
            local active = id and type(data.Potions) == "table" and data.Potions[id]
            local ends = type(active) == "table" and active.Ends
            if type(id) == "string" and type(tier) == "number" and price ~= nil and data.Cash ~= nil
