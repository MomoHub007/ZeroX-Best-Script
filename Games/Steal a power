    local ESPFolder = Instance.new("Folder")
    ESPFolder.Name = "ZeroX_ESP"
    ESPFolder.Parent = game:GetService("CoreGui")

    local function ClearESP()
        ESPFolder:ClearAllChildren()
    end

    local VisualSection = Tabs.Visuals:AddSection({ Title = "ESP & Highlights", Icon = "eye" })

    VisualSection:AddToggle("EnemyESPToggle", {
        Title = "Enemy ESP",
        Description = "แสดงชื่อ ระยะทาง และพลังชีวิตของศัตรู",
        Default = false,
        Callback = function(val)
            VisualSettings.EnemyESP = val
            if not val then ClearESP() end
        end
    })

    VisualSection:AddToggle("BossESPToggle", {
        Title = "Boss Highlight ESP",
        Description = "ไฮไลต์บอสด้วยสีส้ม",
        Default = false,
        Callback = function(val)
            VisualSettings.BossESP = val
            if not val then ClearESP() end
        end
    })

    VisualSection:AddToggle("PlayerESPToggle", {
        Title = "Player ESP",
        Description = "แสดงกรอบและระยะห่างของผู้เล่นอื่น",
        Default = false,
        Callback = function(val)
            VisualSettings.PlayerESP = val
            if not val then ClearESP() end
        end
    })

    -- ESP Render Loop
    task.spawn(function()
        while task.wait(0.5) do
            if MacUI.Unloaded then
                ClearESP()
                ESPFolder:Destroy()
                break
            end

            if not (VisualSettings.EnemyESP or VisualSettings.BossESP or VisualSettings.PlayerESP) then
                ClearESP()
                continue
            end

            local myRoot = GetRoot()
            if not myRoot then continue end

            -- 1. Enemy ESP
            if VisualSettings.EnemyESP or VisualSettings.BossESP then
                local enemies = workspace:FindFirstChild("Enemies")
                if enemies then
                    for _, enemy in ipairs(enemies:GetChildren()) do
                        if enemy:IsA("Model") and not enemy:GetAttribute("Dead") then
                            local enemyRoot = enemy.PrimaryPart or enemy:FindFirstChild("HumanoidRootPart")
                            if enemyRoot then
                                local isBoss = WorldSupport.IsEnemyBoss(enemy)
                                if (VisualSettings.BossESP and isBoss) or (VisualSettings.EnemyESP and not isBoss) then
                                    local espTag = ESPFolder:FindFirstChild("ESP_" .. enemy.Name .. "_" .. enemyRoot:GetDebugId())
                                    if not espTag then
                                        local hl = Instance.new("Highlight")
                                        hl.Name = "ESP_" .. enemy.Name .. "_" .. enemyRoot:GetDebugId()
                                        hl.Adornee = enemy
                                        hl.FillColor = isBoss and Color3.fromRGB(255, 170, 0) or Color3.fromRGB(255, 60, 60)
                                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                        hl.FillTransparency = 0.6
                                        hl.OutlineTransparency = 0.1
                                        hl.Parent = ESPFolder
                                    end
                                end
                            end
                        end
                    end
                end
            end

            -- 2. Player ESP
            if VisualSettings.PlayerESP then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local char = p.Character
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            local hl = ESPFolder:FindFirstChild("ESP_Player_" .. p.Name)
                            if not hl then
                                hl = Instance.new("Highlight")
                                hl.Name = "ESP_Player_" .. p.Name
