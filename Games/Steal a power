            state.Fly = enabled
            if enabled then StartFlight() else StopFlight() end
        end
    })

    FlySection:AddSlider("FlySpeedSlider", {
        Title = "Fly Speed",
        Min = 20,
        Max = 250,
        Default = 60,
        Increment = 5,
        Callback = function(val) state.FlySpeed = val end
    })

    -- Noclip & Loop checks
    Connect(RunService.Stepped, function()
        if state.Noclip and LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
        if state.WalkSpeed then
            local hum = GetHumanoid()
            if hum and hum.WalkSpeed ~= state.Speed then hum.WalkSpeed = state.Speed end
        end
    end)

    Connect(UserInputService.JumpRequest, function()
        if state.InfiniteJump then
            local hum = GetHumanoid()
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)

    -- Performance
    local Performance = Tabs.Player:AddSection({ Title = "Performance", Icon = "zap" })

    Performance:AddToggle("FPSBoostEnabled", {
        Title = "FPS Boost (Reduce Quality)",
        Description = "ลดคุณภาพการแสดงผลและปิดเงาเพื่อลดภาระการประมวลผล",
        Default = false,
        Callback = function(enabled)
            state.FPSBoost = enabled
            if enabled then
                pcall(function()
                    settings().Rendering.QualityLevel = 1
                    Lighting.GlobalShadows = false
                end)
            end
        end
    })

    MacUI:OnUnload(function()
        alive = false
        StopFlight()
        for _, c in ipairs(connections) do c:Disconnect() end
        table.clear(connections)
    end)
end

