    local ShrineSection = Tabs.Shrine:AddSection({ Title = "Card Shrine & Shards", Icon = "flame" })

    local ShrineSettings = {
        AutoSacrificeCommons = false,
        SelectedRarities = {},
    }
    local shrineBusy = false
    local shrineRequests = {}
    local shrineModulesOk, CardConfig, Shrine = pcall(function()
        return require(ReplicatedStorage.Shared.Config.CardConfig), require(ReplicatedStorage.Shared.Rules.Shrine)
    end)
    local sacrificeRarities = {}
    if shrineModulesOk and type(CardConfig.RarityOrder) == "table" and type(CardConfig.RarityRank) == "table" then
        local exoticRank = CardConfig.RarityRank.Exotic
        if type(exoticRank) == "number" then
            for _, rarity in ipairs(CardConfig.RarityOrder) do
                if type(rarity) == "string" and type(CardConfig.RarityRank[rarity]) == "number"
                    and CardConfig.RarityRank[rarity] < exoticRank then
                    table.insert(sacrificeRarities, rarity)
                end
            end
        end
    end
    if #sacrificeRarities == 0 then
        table.insert(sacrificeRarities, "Unavailable")
    end

    ShrineSection:AddDropdown("SacrificeRarityDropdown", {
        Title = "Sacrifice Rarities",
        Values = sacrificeRarities,
        Default = {},
        Multi = true,
        Callback = function(value)
            ShrineSettings.SelectedRarities = type(value) == "table" and value or {}
        end
    })

    local function SacrificeNextCard()
        if shrineBusy then return "A sacrifice request is already pending." end
        if not shrineModulesOk or #sacrificeRarities == 0 or sacrificeRarities[1] == "Unavailable" then
            return "Shrine configuration unavailable.", true
        end
        local remote = Remotes and Remotes:FindFirstChild("Sacrifice")
        local data = PlayerState and PlayerState.Data
        if not remote or not remote:IsA("RemoteFunction") or not data or type(data.Cards) ~= "table" then
            return "Sacrifice remote or card inventory unavailable.", true
        end
        for cardId, info in pairs(data.Cards) do
            local cfg = CardConfig.ById and CardConfig.ById[cardId]
            if type(cardId) == "string" and type(info) == "table" and type(info.Count) == "number"
                and cfg and ShrineSettings.SelectedRarities[cfg.Rarity] == true then
                local spare = Shrine.Spare(data, cardId)
                local amount = type(spare) == "number" and math.min(math.floor(spare), 1000) or 0
                if amount > 0 and shrineRequests[cardId] ~= info.Count then
                    shrineBusy = true
                    shrineRequests[cardId] = info.Count
                    local ok, success, reason = pcall(function()
                        return remote:InvokeServer(cardId, amount)
                    end)
                    shrineBusy = false
                    if not ok then return "Request failed; result unknown for " .. cardId .. ".", true end
                    if not success then return type(reason) == "string" and reason or "Sacrifice rejected.", true end
                    return "Sacrificed " .. tostring(amount) .. " copies of " .. cardId .. "."
                end
            end
        end
        return "No eligible cards ready."
    end

    ShrineSection:AddToggle("AutoSacrificeCommonsToggle", {
        Title = "Auto Sacrifice Selected Rarities",
        Description = "สละการ์ดส่วนเกินของระดับที่เลือก",
        Default = false,
        Callback = function(val)
            ShrineSettings.AutoSacrificeCommons = val
        end
