    task.spawn(function()
        while task.wait(0.5) do
            if MacUI.Unloaded then break end
            if treeEnabled and not treePending then
                local data = PlayerState and PlayerState.Data
                local remote = Remotes and Remotes:FindFirstChild("TreeBuy")
                if data and remote and remote:IsA("RemoteFunction") then
                    local ok, shrine = pcall(function()
                        return require(ReplicatedStorage.Shared.Rules.Shrine)
                    end)
                    if not ok or type(shrine) ~= "table" or type(shrine.Tree) ~= "table" or type(shrine.CantBuy) ~= "function" then
                        treeEnabled = false
                        Window:Toast("Skill Tree", { Detail = "Tree configuration unavailable; automation stopped." })
                    else
                        if treeAwaiting and type(data.TreeBought) == "table" and data.TreeBought[treeAwaiting] == true then
                            treeAwaiting = nil
                        end
                        if not treeAwaiting then
                            for _, node in ipairs(shrine.Tree) do
                                if not treeEnabled or MacUI.Unloaded then break end
                                local nodeId = type(node) == "table" and node.Id
                                if type(nodeId) == "string" and not treeAttempts[nodeId]
                                    and shrine.CantBuy(data, nodeId) == nil then
                                    local generation = treeGeneration
                                    treePending = true
                                    treeAttempts[nodeId] = true
                                    local requestOk, success, reason = pcall(function()
                                        return remote:InvokeServer(nodeId)
                                    end)
                                    treePending = false
                                    if requestOk and success == true then
                                        treeAwaiting = nodeId
                                    elseif generation == treeGeneration and not MacUI.Unloaded then
                                        treeEnabled = false
                                        Window:Toast("Skill Tree", { Detail = nodeId .. ": " .. tostring(requestOk and (reason or "rejected") or success) })
                                    end
                                    if generation ~= treeGeneration or MacUI.Unloaded then break end
                                    break
