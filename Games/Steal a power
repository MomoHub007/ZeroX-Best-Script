    local function FillBestBaseHolders(delayPerSlot)
        local placed = 0
        pcall(function()
            if not (Remotes and Remotes:FindFirstChild("BasePlace") and PlayerState and PlayerState.Data) then return end
            local data = PlayerState.Data
            local BaseConfig = require(ReplicatedStorage.Shared.Config.BaseConfig)
            local maxSlots = math.min((BaseConfig and BaseConfig.MaxHolders) or 10, (data.Base and tonumber(data.Base.Slots)) or 10)
            local currentHolders = (data.Base and data.Base.Holders) or {}
            local desiredHolders = nil

            if BaseConfig and type(BaseConfig.BestHolders) == "function" then
                local best, hasChanges = BaseConfig.BestHolders(data)
                if type(best) == "table" then
                    if hasChanges == false then return end
                    desiredHolders = best
                end
            end

            if not desiredHolders then
                local CardConfig = require(ReplicatedStorage.Shared.Config.CardConfig)
                local equippedSet = {}
                if type(data.Equipped) == "table" then
                    for _, id in ipairs(data.Equipped) do equippedSet[id] = true end
                end
                local sorted = {}
                for cardId, info in pairs(data.Cards or {}) do
                    if not equippedSet[cardId] then
                        local cfg = CardConfig.ById and CardConfig.ById[cardId]
                        local power = BaseConfig and type(BaseConfig.CardCash) == "function"
                            and tonumber(BaseConfig.CardCash(data, cardId, info.Level or 1))
                            or ((info.Level or 1) * (cfg and cfg.Damage or 10))
                        table.insert(sorted, { Id = cardId, Power = power or 0 })
                    end
                end
                table.sort(sorted, function(a, b) return a.Power > b.Power end)
                desiredHolders = {}
                for slot = 1, maxSlots do
                    if sorted[slot] then
                        desiredHolders[tostring(slot)] = sorted[slot].Id
                    end
                end
            end

            for slot = 1, maxSlots do
                local neededCard = desiredHolders[tostring(slot)]
                if neededCard and currentHolders[tostring(slot)] ~= neededCard then
                    local ok, res = pcall(function() return Remotes.BasePlace:InvokeServer(slot, neededCard) end)
                    if ok and res then placed = placed + 1 end
                    if delayPerSlot and delayPerSlot > 0 then task.wait(delayPerSlot) end
                end
            end
        end)
        return placed
    end

