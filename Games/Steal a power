            if not MacUI.Unloaded then
                Window:Toast("Card Shrine", { Detail = ok and result or ("Error: " .. tostring(result)) })
            end
        end
    })

    -- Auto Open Loop
    task.spawn(function()
        while task.wait(PackSettings.Speed) do
            if MacUI.Unloaded then break end
            if PackSettings.AutoOpen and Remotes and Remotes:FindFirstChild("OpenPack") then
                pcall(function()
                    if PlayerState and PlayerState.Data and PlayerState.Data.Packs then
                        local userPacks = PlayerState.Data.Packs
                        if PackSettings.SelectedPack == "All" then
                            for packName, count in pairs(userPacks) do
                                if type(count) == "number" and count > 0 then
                                    Remotes.OpenPack:InvokeServer(packName, math.min(count, PackSettings.BatchCount))
                                    break
                                end
                            end
                        else
                            local count = userPacks[PackSettings.SelectedPack]
                            if type(count) == "number" and count > 0 then
                                Remotes.OpenPack:InvokeServer(PackSettings.SelectedPack, math.min(count, PackSettings.BatchCount))
                            end
                        end
                    end
                end)
            end
        end
    end)

    -- Auto Fuse & Equip Loop
    task.spawn(function()
        while task.wait(3.0) do
            if MacUI.Unloaded then break end
            if PackSettings.AutoFuseAll and Remotes and Remotes:FindFirstChild("FuseAll") then
                pcall(function() Remotes.FuseAll:InvokeServer() end)
            end
            if PackSettings.AutoEquipBest and Remotes and Remotes:FindFirstChild("EquipBest") then
                pcall(function() Remotes.EquipBest:InvokeServer() end)
            end

            -- Index Automation
            if CardIndexSettings.AutoClaimIndex and Remotes and Remotes:FindFirstChild("ClaimIndex") then
                pcall(function()
                    local CardIndex = require(ReplicatedStorage.Shared.Rules.CardIndex)
                    for _, rarity in ipairs(GetIndexRarities()) do
                        if CardIndex.CanClaim(PlayerState.Data, rarity) and not (PlayerState.Data and PlayerState.Data.IndexClaims and PlayerState.Data.IndexClaims[rarity]) then
                            Remotes.ClaimIndex:InvokeServer(rarity)
                        end
                    end
                end)
            end

            -- Base Holders Automation
            if BaseSettings.AutoFillHolders and Remotes and Remotes:FindFirstChild("BasePlace") and PlayerState and PlayerState.Data then
                FillBestBaseHolders(0.1)
            end

            -- Bench Upgrade Automation
            if BaseSettings.AutoUpgradeBench and Remotes and Remotes:FindFirstChild("BenchUpgrade") then
                local ok, err = pcall(function()
                    local BaseConfig = require(ReplicatedStorage.Shared.Config.BaseConfig)
                    local Big = require(ReplicatedStorage.Shared.Util.Big)
                    local data = PlayerState and PlayerState.Data
                    local currentLevel = data and data.Base and data.Base.Bench
                    if type(currentLevel) ~= "number" or data.Cash == nil then return end
                    if currentLevel >= BaseConfig.BenchMaxLevel or currentLevel == lastRequestedBenchLevel then return end
                    local cost = BaseConfig.BenchCost(currentLevel)
                    if not Big.lt(data.Cash, cost) then
                        lastRequestedBenchLevel = currentLevel
                        Remotes.BenchUpgrade:FireServer()
                    end
                end)
                if not ok then
                    BaseSettings.AutoUpgradeBench = false
                    warn("[Zero X] Auto Upgrade Workout Bench failed:", err)
                    Window:Toast("Workout Bench", { Detail = "Upgrade stopped; check console for details." })
                end
            end

            -- Shrine Sacrifice Automation
            if ShrineSettings.AutoSacrificeCommons then
                local ok, result, stop = pcall(SacrificeNextCard)
                if not ok then
                    ShrineSettings.AutoSacrificeCommons = false
                    warn("[Zero X] Auto Sacrifice failed:", result)
                    Window:Toast("Card Shrine", { Detail = "Auto Sacrifice stopped; check console." })
                elseif result ~= "No eligible cards ready." and result ~= "A sacrifice request is already pending."
                    and not MacUI.Unloaded then
                    if stop then ShrineSettings.AutoSacrificeCommons = false end
                    Window:Toast("Card Shrine", { Detail = result })
                end
            end
        end
    end)

    -- Auto Train Bench Loop
    task.spawn(function()
        while task.wait(2.0) do
            if MacUI.Unloaded then break end
            if BaseSettings.AutoTrainBench then
                pcall(function()
                    if not LocalPlayer:GetAttribute("Lifting") then
                        local function findMyBase()
                            local bases = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Bases")
                            for _, b in ipairs(bases and bases:GetChildren() or {}) do
                                if b:GetAttribute("Owner") == LocalPlayer.UserId then
                                    return b
                                end
                            end
                            return nil
                        end

                        local root = GetRoot()
                        local myBase = findMyBase()
                        local liePoint = myBase and myBase:FindFirstChild("LiePoint", true)
                        if root and not liePoint then
                            local baseCF = WorldSupport.GetMyBaseCFrame()
                            if baseCF and (root.Position - baseCF.Position).Magnitude > 40 then
                                root.CFrame = baseCF * CFrame.new(0, 3.5, 0)
                                task.wait(0.4)
                                myBase = findMyBase()
                                liePoint = myBase and myBase:FindFirstChild("LiePoint", true)
                            end
                        end
                        root = GetRoot()
                        if root and liePoint then
                            if (root.Position - liePoint.Position).Magnitude > 8 then
                                root.CFrame = liePoint.CFrame
                                task.wait(0.3)
                            end
                            if Remotes:FindFirstChild("BenchStart") then
                                Remotes.BenchStart:FireServer()
                            end
                        end
                    end
                end)
            end
        end
    end)
end

