                local selectedZoneCount = 0
                local activeZone = nil
                if FarmConfig.AutoFarmTeleport then
                    local selected = {}
                    for _, zoneKey in ipairs(zoneKeys) do
                        if FarmConfig.SelectedZones[zoneKey] == true then
                            table.insert(selected, zoneKey)
                        end
                    end
                    selectedZoneCount = #selected
                    if selectedZoneCount > 0 then
                        if FarmConfig.ZoneIndex > selectedZoneCount then FarmConfig.ZoneIndex = 1 end
                        if FarmConfig.NextZoneTime and os.clock() >= FarmConfig.NextZoneTime and selectedZoneCount > 1 then
                            FarmConfig.ZoneIndex = FarmConfig.ZoneIndex % selectedZoneCount + 1
                            FarmConfig.ZoneTravelPending = true
                            FarmConfig.NextZoneTime = nil
                        end
                        activeZone = selected[FarmConfig.ZoneIndex]
                        zonePad = GetZonePad(activeZone)
                    end
                    if FarmConfig.ZoneTravelPending and zonePad then
                        local padCFrame = zonePad:GetAttribute("PadCFrame")
                        if typeof(padCFrame) == "CFrame" then
                            root.CFrame = padCFrame * CFrame.new(0, FarmConfig.HoverHeight, 0)
                            FarmConfig.ZoneTravelPending = false
                            FarmConfig.NextZoneTime = os.clock() + FarmConfig.ZoneDuration
                        end
                    end
                    if selectedZoneCount > 1 and not FarmConfig.NextZoneTime then
                        FarmConfig.NextZoneTime = os.clock() + FarmConfig.ZoneDuration
                    end
                end
                local enemies = workspace:FindFirstChild("Enemies")
                if enemies then
                    local mobList = enemies:GetChildren()
                    local validTargets = {}

                    for _, enemy in ipairs(mobList) do
                        if enemy:IsA("Model") and not enemy:GetAttribute("Dead")
                            and (not FarmConfig.AutoFarmTeleport or selectedZoneCount == 0 or IsEnemyInZone(enemy, zonePad)) then
                            local enemyRoot = enemy.PrimaryPart or enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChildWhichIsA("BasePart")
                            if enemyRoot then
                                local dist = (enemyRoot.Position - root.Position).Magnitude
                                local isBoss = WorldSupport.IsEnemyBoss(enemy)
                                
                                local match = false
                                if FarmConfig.TargetMode == "All" then
                                    match = true
                                elseif FarmConfig.TargetMode == "Bosses Only" then
                                    match = isBoss
                                elseif FarmConfig.TargetMode == "Selected Mob Only" then
                                    match = (FarmConfig.SelectedMob == "All" or enemy.Name == FarmConfig.SelectedMob)
                                elseif FarmConfig.TargetMode == "Closest" then
                                    match = true
                                end

                                if match and (FarmConfig.AutoFarmTeleport or dist <= FarmConfig.KillRange) then
                                    table.insert(validTargets, { Model = enemy, Root = enemyRoot, Dist = dist, IsBoss = isBoss })
                                end
                            end
                        end
                    end

                    -- Sort by distance
                    table.sort(validTargets, function(a, b) return a.Dist < b.Dist end)

                    if #validTargets > 0 then
                        local dmg = FarmConfig.OneHit and 1e35 or 1000

                        if FarmConfig.AutoFarmTeleport then
                            local target = validTargets[1]
                            if root and target.Root and target.Root.Parent then
                                root.CFrame = target.Root.CFrame * CFrame.new(0, FarmConfig.HoverHeight, 0)
                                if not DamageEnemy(target.Model, dmg) then
                                    WorldSupport.CastEquippedAbilitiesAt(target.Root.Position, FarmConfig.OneHit)
                                end
                            end
                        else
                            for _, target in ipairs(validTargets) do
                                if not DamageEnemy(target.Model, dmg) and target.Root and target.Root.Parent then
                                    WorldSupport.CastEquippedAbilitiesAt(target.Root.Position, FarmConfig.OneHit)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end

