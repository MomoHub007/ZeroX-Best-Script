-- Auto Execute on Teleport
--------------------------------------------------------------------------------
do
    local LOADER_URL = "https://raw.githubusercontent.com/MomoHub007/ZeroX-Best-Script/refs/heads/main/loader.lua"
    local env = type(getgenv) == "function" and getgenv() or _G
    local queueFn = env.queue_on_teleport or env.queueonteleport
    local flagFile = "ZeroX/AutoExecute/" .. tostring(game.GameId) .. ".txt"

    local section = Tabs.Profiles:AddSection({
        Title = "Auto Execute",
        Icon = "play",
    })

    local status = section:AddLabel({
        Title = "Status",
        Value = "Disabled",
    })

    local function WriteFlag(enabled)
        if type(env.makefolder) ~= "function" or type(env.writefile) ~= "function" or type(env.isfolder) ~= "function" then
            return false
        end
        return pcall(function()
            if not env.isfolder("ZeroX") then env.makefolder("ZeroX") end
            if not env.isfolder("ZeroX/AutoExecute") then env.makefolder("ZeroX/AutoExecute") end
            env.writefile(flagFile, enabled and "1" or "0")
        end)
    end

    local initialEnabled = false
    if type(env.isfile) == "function" and type(env.readfile) == "function" then
        pcall(function()
            initialEnabled = env.isfile(flagFile) and env.readfile(flagFile) == "1"
        end)
    end

    local queued = false
    local function QueueLoader()
        if queued then return true end
        if type(queueFn) ~= "function" then return false end
        local payload = string.format([[
            local env = type(getgenv) == "function" and getgenv() or _G
            if type(env.isfile) == "function" and type(env.readfile) == "function"
                and env.isfile(%q) and env.readfile(%q) == "1" then
                loadstring(game:HttpGet(%q))()
            end
        ]], flagFile, flagFile, LOADER_URL)
        local ok = pcall(queueFn, payload)
        queued = ok
        return ok
    end

    local toggle = section:AddToggle("ZeroXAutoExecute", {
        Title = "Auto Execute",
        Description = "ระบบรันสคริปต์ใหม่หลังเทเลพอร์ตหรือย้ายเซิร์ฟเวอร์",
        Default = initialEnabled,
        Callback = function(enabled)
            local saved = WriteFlag(enabled)
            if enabled then
                status:SetValue(saved and QueueLoader() and "Enabled" or "Unavailable: executor support required")
            else
                status:SetValue(saved and "Disabled" or "Could not save setting")
            end
        end,
    })

    if initialEnabled then
        status:SetValue(QueueLoader() and "Enabled" or "Unavailable: teleport queue missing")
    end
end

