do
    local UpgradesSection = Tabs.Progress:AddSection({
        Title = "Smart Auto Upgrade",
        Icon = "trending-up",
    })

    local autoUpgradeEnabled = false
    local autoPrestigeUpgradeEnabled = false
    local queueUpgradeCheck = function() end

    -- Calculate upgrade price dynamically from game config
    local function GetUpgradeCost(statName, currentLevel)
        local cfg = UpgradeConfig[statName]
        if not cfg then return nil, "NoConfig" end
        local maxLv = cfg.MaxLevel or cfg.MaxLv or 999
        if currentLevel >= maxLv then
            return nil, "Max"
        end
        local cost = nil
        if cfg.Prices then
            cost = cfg.Prices[currentLevel + 1]
        elseif cfg.BasePrice and cfg.GrowthRate then
            cost = math.floor(cfg.BasePrice * cfg.GrowthRate ^ (currentLevel - (cfg.ExponentOffset or 0)))
        end
        return cost, cfg.Currency or "Money"
    end

    UpgradesSection:AddToggle("ZeroXAutoUpgradeEnabled", {
        Title = "Enable Auto Upgrade",
        Description = "ระบบอัปเกรดค่าสถานะด้วยเงินเมื่อซื้อไหว",
        Default = false,
        Callback = function(val)
            autoUpgradeEnabled = val
            queueUpgradeCheck()
        end,
    })

    UpgradesSection:AddToggle("ZeroXAutoPrestigeUpgrade", {
        Title = "Auto Upgrade Prestige",
        Description = "ระบบใช้แต้ม Prestige ซื้ออัปเกรดให้อัตโนมัติ",
        Default = false,
        Callback = function(val)
            autoPrestigeUpgradeEnabled = val
            queueUpgradeCheck()
        end,
    })

    local upgradeStats = {}
    local watchedAttributes = {}
    for statName, cfg in pairs(UpgradeConfig) do
        if type(statName) == "string" and type(cfg) == "table"
            and (type(cfg.Prices) == "table" or (cfg.BasePrice and cfg.GrowthRate)) then
            table.insert(upgradeStats, statName)
            watchedAttributes[statName] = true
            watchedAttributes[cfg.Currency or "Money"] = true
        end
    end
    table.sort(upgradeStats)
    local nextUpgradeIndex = 1

    local upgradeConnections = {}
    local moneyConnection = nil
    local checkQueued = false
    local pendingUpgrade = nil
    local upgradeRetrySeconds = 1

    local function GetUpgradeBalance(currency)
        if currency == "Money" or currency == "Gold" then
            return GetPlayerMoney()
        end
        return LocalPlayer:GetAttribute(currency) or 0
    end

    local function CheckUpgrades()
        if MacUI.Unloaded or (not autoUpgradeEnabled and not autoPrestigeUpgradeEnabled) or not UpgradeRequestEvent then return end

        if pendingUpgrade then
            local level = LocalPlayer:GetAttribute(pendingUpgrade.Stat) or 0
            local balance = GetUpgradeBalance(pendingUpgrade.Currency)
            -- Level and currency can replicate separately; wait for both before spending again.
            if level == pendingUpgrade.Level
                or (pendingUpgrade.Cost > 0 and balance == pendingUpgrade.Balance) then
                return
            end
            pendingUpgrade = nil
        end

        for offset = 0, #upgradeStats - 1 do
            local index = (nextUpgradeIndex + offset - 1) % #upgradeStats + 1
            local statName = upgradeStats[index]
            local currentLv = LocalPlayer:GetAttribute(statName) or 0
            local cost, currency = GetUpgradeCost(statName, currentLv)
            local enabled = currency == "PrestigePoints" and autoPrestigeUpgradeEnabled
                or ((currency == "Money" or currency == "Gold") and autoUpgradeEnabled)
            local balance = GetUpgradeBalance(currency)
            if enabled and type(cost) == "number" and cost >= 0 and balance >= cost then
                local request = {
                    Stat = statName, Level = currentLv, Cost = cost,
                    Currency = currency, Balance = balance,
                }
                pendingUpgrade = request
                nextUpgradeIndex = index % #upgradeStats + 1
                local ok, err = pcall(function()
                    UpgradeRequestEvent:FireServer(statName)
                end)
                if not ok then
                    warn("[Zero X] Auto upgrade failed for " .. statName .. ": " .. tostring(err))
                end
                -- Retry only an unconfirmed request; normal upgrades continue from signals.
                task.delay(upgradeRetrySeconds, function()
                    if pendingUpgrade == request then
                        pendingUpgrade = nil
                        queueUpgradeCheck()
                    end
                end)
                return
            end
        end
    end

    queueUpgradeCheck = function()
        if checkQueued or MacUI.Unloaded then return end
        checkQueued = true
        task.defer(function()
            checkQueued = false
            CheckUpgrades()
        end)
    end

    local function BindUpgradeMoney()
        if moneyConnection then
            moneyConnection:Disconnect()
            moneyConnection = nil
        end
        local stats = LocalPlayer:FindFirstChild("leaderstats")
        local money = stats and (stats:FindFirstChild("Money") or stats:FindFirstChild("Gold"))
        if money and (money:IsA("IntValue") or money:IsA("NumberValue")) then
            moneyConnection = money:GetPropertyChangedSignal("Value"):Connect(queueUpgradeCheck)
        end
        queueUpgradeCheck()
    end

    table.insert(upgradeConnections, LocalPlayer.AttributeChanged:Connect(function(attribute)
        if watchedAttributes[attribute] then queueUpgradeCheck() end
    end))

    local function OnUpgradeMoneyHierarchyChanged(instance)
        if instance.Name == "leaderstats"
            or ((instance.Name == "Money" or instance.Name == "Gold")
                and instance.Parent and instance.Parent.Name == "leaderstats") then
            task.defer(function()
                if not MacUI.Unloaded then BindUpgradeMoney() end
            end)
        end
    end
    table.insert(upgradeConnections, LocalPlayer.DescendantAdded:Connect(OnUpgradeMoneyHierarchyChanged))
    table.insert(upgradeConnections, LocalPlayer.DescendantRemoving:Connect(OnUpgradeMoneyHierarchyChanged))
    MacUI:OnUnload(function()
        for _, connection in ipairs(upgradeConnections) do connection:Disconnect() end
        if moneyConnection then moneyConnection:Disconnect() end
        pendingUpgrade = nil
    end)
    BindUpgradeMoney()

    --------------------------------------------------------------------------
    -- Zone Progression
    --------------------------------------------------------------------------
    local ZoneSection = Tabs.Progress:AddSection({
        Title = "Zone Progression & Teleport",
        Icon = "map",
    })

    local autoBuyZone = false
    local autoTravelHighest = false
    local WorldConfig = SafeRequire("WorldConfig")

    local PrestigeSection = Tabs.Progress:AddSection({
        Title = "Prestige",
        Icon = "award",
    })
    local prestigeStatus = PrestigeSection:AddLabel({ Title = "Prestige Status", Value = "Checking..." })
    local autoPrestige = false
    local prestigeConfig = SafeRequire("XPConfig")
    local prestigeEvent = GetRemote("PrestigeEvent")
    local lastPrestigeRequest = 0

    PrestigeSection:AddToggle("ZeroXAutoPrestige", {
        Title = "Auto Prestige",
        Description = "ระบบทำ Prestige เมื่อถึงเลเวลที่กำหนด โดยเงินและโซนจะถูกรีเซ็ต",
        Default = false,
        Callback = function(enabled)
            autoPrestige = enabled
        end,
    })

    task.spawn(function()
        while not MacUI.Unloaded do
            local level = LocalPlayer:GetAttribute("Level")
            local prestige = LocalPlayer:GetAttribute("Prestige")
            if type(level) == "number" and type(prestige) == "number" and prestigeConfig and type(prestigeConfig.RequiredLevelForPrestige) == "function" then
                local ok, required = pcall(prestigeConfig.RequiredLevelForPrestige, prestige)
                if ok and type(required) == "number" then
                    prestigeStatus:SetValue(string.format("Prestige %d | Level %d / %d", prestige, level, required))
                    if autoPrestige and prestigeEvent and level >= required and os.clock() - lastPrestigeRequest >= 5 then
                        lastPrestigeRequest = os.clock()
                        local sent, err = pcall(function() prestigeEvent:FireServer() end)
                        if not sent then warn("[Zero X] Auto Prestige: " .. tostring(err)) end
                    end
                else
                    prestigeStatus:SetValue("Prestige requirement unavailable")
                end
            else
                prestigeStatus:SetValue("Waiting for prestige data")
            end
            task.wait(1)
        end
    end)

    local function GetNextZoneInfo()
        local unlockedZone = LocalPlayer:GetAttribute("Zone")
        for index, zone in ipairs(ZoneDatabase) do
            if zone.Name == unlockedZone then
                local nextZone = ZoneDatabase[index + 1]
                if not nextZone then return nil, nil, nil end
                if not WorldConfig then return nextZone.Name, nil, false end
                local ok, world = pcall(WorldConfig.GetWorld, nextZone.Name)
                if not ok then return nextZone.Name, nil, false end
                if world == 2 then
                    local blockOk, block = pcall(function()
                        return WorldConfig.GetBlock(nextZone.Name, LocalPlayer:GetAttribute("Prestige") or 0,
                            WorldConfig.KillsFromAttributes(LocalPlayer), LocalPlayer:GetAttribute("World2KillReqLv"))
                    end)
                    return nextZone.DisplayName or nextZone.Name, 0, blockOk and block == nil
                end
                return nextZone.DisplayName or nextZone.Name, nextZone.Price, type(nextZone.Price) == "number"
            end
        end
        return nil, nil, false
    end

    local NextZoneInfoLabel = ZoneSection:AddLabel({
        Title = "Next Zone",
        Value = "Checking...",
    })

    ZoneSection:AddToggle("ZeroXAutoBuyZone", {
        Title = "Auto Buy Next Zone",
        Description = "ระบบปลดล็อกโซนถัดไปเมื่อผ่านเงื่อนไขและมีเงินพอ",
        Default = false,
        Callback = function(val)
            autoBuyZone = val
        end,
    })

    ZoneSection:AddToggle("ZeroXAutoTravelHighest", {
        Title = "Auto Travel to Highest Zone",
        Description = "ระบบย้ายฐานไปโซนที่ปลดล็อกสูงที่สุด",
        Default = false,
        Callback = function(val)
            autoTravelHighest = val
        end,
    })

    -- Zone Table & Names
    local zoneList = {}
    for k, v in pairs(ZoneDatabase) do
        if typeof(v) == "table" and (v.DisplayName or v.Name) then
            local zName = v.Name or v.DisplayName
            table.insert(zoneList, {
                Key = tostring(k),
                Name = zName,
                Cost = v.Cost or v.Price or 0,
                Order = v.Order or v.Index or tonumber(k) or 1
            })
        end
    end
    table.sort(zoneList, function(a, b) return a.Order < b.Order end)

    local zoneNames = {}
    for _, z in ipairs(zoneList) do
        table.insert(zoneNames, z.Name)
    end

    local selectedZone = zoneNames[1]

    local function GetHighestUnlockedZone()
        if not WorldConfig or not WorldConfig.GetBlock or not WorldConfig.GetWorld or not WorldConfig.KillsFromAttributes then return nil end
        local unlockedName = LocalPlayer:GetAttribute("Zone")
        local unlockedIndex = nil
        for index, zone in ipairs(ZoneDatabase) do
            if zone.Name == unlockedName then unlockedIndex = index break end
        end
        if not unlockedIndex then return nil end
        local prestige = LocalPlayer:GetAttribute("Prestige") or 0
        local kills = WorldConfig.KillsFromAttributes(LocalPlayer)
        local killRequirement = LocalPlayer:GetAttribute("World2KillReqLv")
        local highest = nil
        for index, zone in ipairs(ZoneDatabase) do
            local block = WorldConfig.GetBlock(zone.Name, prestige, kills, killRequirement)
            if not block and (index <= unlockedIndex or WorldConfig.GetWorld(zone.Name) == 2) then
                highest = zone.Name
            end
        end
        return highest
    end

    ZoneSection:AddDropdown("ZeroXManualZoneTravel", {
        Title = "Travel to Zone",
        Description = "เลือกโซนที่ต้องการไป แล้วกดปุ่ม Travel",
        Values = zoneNames,
        Default = zoneNames[1],
        Callback = function(zoneName)
            selectedZone = zoneName
        end,
    })

    ZoneSection:AddButton({
        Title = "Travel to Selected Zone", Description = "กดเพื่อย้ายฐานไปโซนที่เลือก",
        ButtonText = "Travel",
        Callback = function()
            if selectedZone and ZoneTravelRequestEvent then
                pcall(function()
                    ZoneTravelRequestEvent:FireServer(selectedZone)
                end)
            end
        end,
    })

    task.spawn(function()
        while not MacUI.Unloaded do
            local nextName, nextCost, eligible = GetNextZoneInfo()
            if nextName then
                local costStr = nextCost and (nextCost > 0 and string.format(" (Cost: %d)", nextCost) or " (Free)") or ""
                NextZoneInfoLabel:SetValue(nextName .. costStr)
            else
                NextZoneInfoLabel:SetValue(LocalPlayer:GetAttribute("Zone") and "Max Zone Reached" or "Waiting for zone data")
            end

            if autoBuyZone and ZonePurchaseRequestEvent and eligible and nextCost then
                local money = GetPlayerMoney()
                if money >= nextCost then
                    pcall(function()
                        ZonePurchaseRequestEvent:FireServer()
                    end)
                    task.wait(1)
                end
            end

            if autoTravelHighest and ZoneTravelRequestEvent and #zoneList > 0 then
                local currentZ = GetCurrentZoneName()
                local ok, highestAccessible = pcall(GetHighestUnlockedZone)
                if ok and highestAccessible and currentZ ~= highestAccessible then
                    pcall(function()
                        ZoneTravelRequestEvent:FireServer(highestAccessible)
                    end)
                end
            end
            task.wait(2)
        end
    end)
end

