                local base = GetPlayerBase()
                if base then
                    local eh = base:FindFirstChild("EnemiesHolder")
                    local bh = base:FindFirstChild("BossHolder")

                    local activeModels = {}

                    local function ProcessList(folder, isBoss)
                        if not folder then return end
                        for _, model in ipairs(folder:GetChildren()) do
                            local hum = model:FindFirstChildOfClass("Humanoid")
                            if hum and hum.Health > 0 then
                                activeModels[model] = true
                                if not bossHighlightOnly or isBoss then
                                    if not espHighlights[model] then
                                        local hl = Instance.new("Highlight")
                                        hl.Name = "ZeroX_ESP"
                                        hl.Adornee = model
                                        hl.FillColor = isBoss and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(80, 160, 255)
                                        hl.FillTransparency = 0.4
                                        hl.OutlineColor = isBoss and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 210, 255)
                                        hl.OutlineTransparency = 0
                                        hl.Parent = model
                                        espHighlights[model] = hl
                                    end
                                end
                            end
                        end
                    end

                    ProcessList(bh, true)
                    ProcessList(eh, false)

                    for m, hl in pairs(espHighlights) do
                        if not activeModels[m] or not m.Parent then
                            hl:Destroy()
                            espHighlights[m] = nil
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)

