        -- Keep one tier below the target for fusion as well.
        local keepRank = math.max(1, targetRank - 1)
        for rarity, rank in pairs(RarityRank) do
            -- In AutoRollToggleRarityEvent:
            -- true = ADD to DisabledRarities (SKIP/DISABLE)
            -- false = REMOVE from DisabledRarities (KEEP/PAUSE ON THIS RARITY)
            local shouldDisable = (rank < keepRank)
            pcall(function()
