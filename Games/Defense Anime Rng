    local function CountOwnedUnits(unitName)
        if not UnitInventory or typeof(UnitInventory.getTools) ~= "function" then return nil end
        local ok, items = pcall(UnitInventory.getTools)
        if not ok or type(items) ~= "table" then return nil end
        local count = 0
        for _, item in ipairs(items) do
            if item.Name == unitName then count = count + 1 end
        end
        return count
    end

    local function FindRollTarget(targetRank)
        local keepRank = math.max(1, targetRank - 1)
        local base = GetPlayerBase()
        local station = base and base:FindFirstChild("RollStation")
        if not station then return nil end
        for _, model in ipairs(CollectionService:GetTagged("FloatingRollDisplay")) do
            if model:IsA("Model") and model:IsDescendantOf(station) then
                local name = model:GetAttribute("UnitName")
                local definition = name and UnitDatabase[name]
                local rarity = model:GetAttribute("Rarity") or (definition and definition.Rarity)
                local rank = RarityRank[rarity]
                local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
                if rank and rank >= keepRank and prompt and prompt.Enabled and definition and type(definition.Price) == "number" then
                    return { Model = model, Prompt = prompt, Name = name, Rarity = rarity, Price = definition.Price }
                end
            end
        end
    end

    local function FinishRollTarget(returnToFarm)
        local target = pendingRollTarget
        pendingRollTarget = nil
        if returnToFarm and target and target.ReturnCharacter == LocalPlayer.Character then
            local root = target.ReturnCharacter:FindFirstChild("HumanoidRootPart")
            if root and target.ReturnCFrame then root.CFrame = target.ReturnCFrame end
        end
        farmPausedForUnit = false
    end

    local function ProcessRollTarget(targetRank)
        if not (smartTeamEnabled or autoRollBuiltIn) then
            if pendingRollTarget then FinishRollTarget(true) end
            return
        end
        local target = pendingRollTarget
        if not target then
            target = FindRollTarget(targetRank)
            if not target then return end
            pendingRollTarget = target
            if AutoRollStopEvent then AutoRollStopEvent:FireServer() end
            rollRunning = false
        end
        if target.Baseline then
            local count = CountOwnedUnits(target.Name)
            if count and count > target.Baseline then
                TargetTierDisplay:SetValue("Purchased: " .. target.Name)
                FinishRollTarget(true)
                return
            end
        end
        if not target.Model.Parent or not target.Prompt.Parent then
            if target.LastAttempt and os.clock() - target.LastAttempt < 5 then
                TargetTierDisplay:SetValue("Checking purchase: " .. target.Name)
                return
            end
            TargetTierDisplay:SetValue("Purchase not confirmed: " .. target.Name)
            FinishRollTarget(true)
            return
        end
        local money = GetPlayerMoney()
        if money < target.Price then
            TargetTierDisplay:SetValue(string.format("Waiting for money: %s (%d / %d)", target.Name, money, target.Price))
            farmPausedForUnit = false
            return
        end
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local promptPart = target.Prompt:FindFirstAncestorWhichIsA("BasePart")
        local ownedCount = CountOwnedUnits(target.Name)
        if not root or not promptPart or ownedCount == nil or type(fireproximityprompt) ~= "function" then
            TargetTierDisplay:SetValue("Waiting for character, inventory or prompt support")
            farmPausedForUnit = false
            return
        end
        farmPausedForUnit = true
        if not target.ReturnCFrame then
            target.ReturnCharacter = character
            target.ReturnCFrame = root.CFrame
        end
        if character ~= target.ReturnCharacter then
            target.ReturnCharacter = character
            target.ReturnCFrame = root.CFrame
        end
        root.CFrame = promptPart.CFrame * CFrame.new(0, 0, 3)
        target.Baseline = target.Baseline or ownedCount
        local now = os.clock()
        target.ApproachTime = target.ApproachTime or now
        if now - target.ApproachTime < 0.5 then return end
        if not target.LastAttempt or now - target.LastAttempt >= 2 then
            target.LastAttempt = now
            local ok, err = pcall(fireproximityprompt, target.Prompt)
            if not ok then warn("[Zero X] Unit collect: " .. tostring(err)) end
        end
        TargetTierDisplay:SetValue("Collecting: " .. target.Name .. " (" .. target.Rarity .. ")")
    end

