    --------------------------------------------------------------------------
    -- Team Developer & Roll Execution Loop
    --------------------------------------------------------------------------
    task.spawn(function()
        local lastFuseCheck = 0
        local lastSlotCheck = 0
        local lastSellCheck = 0
        local lastEquipCheck = 0

        while not MacUI.Unloaded do
            local now = os.clock()
            local team = EvaluateTeam()
            local currentTargetRank = 4 -- Default to Epic+

            if team then
                if targetRarityMode == "Smart Adaptive (Auto Next Tier)" then
                    -- If team has reached Epic/Legendary, advance Target to Mythic while keeping Legendary for fusion
                    currentTargetRank = math.max(6, math.min(9, team.MaxRank + 1))
                elseif targetRarityMode == "Uncommon+" then
                    currentTargetRank = 2
                elseif targetRarityMode == "Rare+" then
                    currentTargetRank = 3
                elseif targetRarityMode == "Epic+" then
                    currentTargetRank = 4
                elseif targetRarityMode == "Legendary+" then
                    currentTargetRank = 5
                elseif targetRarityMode == "Mythic+" then
                    currentTargetRank = 6
                elseif targetRarityMode == "Secret+" then
                    currentTargetRank = 7
                elseif targetRarityMode == "Cosmic+" then
                    currentTargetRank = 8
                end

                globalCurrentTargetRank = currentTargetRank
                local targetName = RankNames[currentTargetRank] or "Mythic"
                local fusionName = RankNames[math.max(1, currentTargetRank - 1)] or "Common"
                TargetTierDisplay:SetValue(string.format("Target: %s+ | Fuse: %s+ (Lowest: %s)", targetName, fusionName, team.MinRarity))
                TeamStatsDisplay:SetValue(string.format("DPS: %d | Units: %d", math.floor(team.TotalDPS), team.Count))
                if smartTeamEnabled or autoRollBuiltIn then SyncFilters(currentTargetRank) end
            end

            ProcessRollTarget(currentTargetRank)
            if (smartTeamEnabled or autoRollBuiltIn) and not pendingRollTarget then updateRollSession() end

            -- Auto Equip Best Units
            if not pendingRollTarget and (smartTeamEnabled or autoEquipBest) and EquipBestRequestFunction and (now - lastEquipCheck >= 3) then
                lastEquipCheck = now
                pcall(function() EquipBestRequestFunction:InvokeServer() end)
            end

            -- Auto Upgrade Placement Slots (checks Money first)
            if (smartTeamEnabled and autoUpgradeSlots) and UpgradeRequestEvent and (now - lastSlotCheck >= 4) then
                lastSlotCheck = now
                local slotLv = LocalPlayer:GetAttribute("PlacementSlotLv") or 0
                local cfg = UpgradeConfig["PlacementSlotLv"]
                local maxLv = cfg and (cfg.MaxLevel or cfg.MaxLv or 10) or 10
                if slotLv < maxLv then
                    local nextCost = cfg and cfg.Prices and cfg.Prices[slotLv + 1]
                    if nextCost and GetPlayerMoney() >= nextCost then
                        pcall(function()
                            UpgradeRequestEvent:FireServer("PlacementSlotLv")
                        end)
                    end
                end
            end

            -- Auto Fuse Duplicate Units (Smart Selective Fusion)
            -- Condition 1: Index each unit by unique UnitId to prevent double-counting.
            -- Condition 2: Fusing into a placed unit requires >= 1 spare unequipped copy in bag.
            -- Condition 3: Fusing inventory units requires >= 2 unequipped copies in bag.
            -- Condition 4: Base target must have Stars < 5.
            -- Condition 5: Both base and sacrifice copies must share the exact same Name and Mutation.
            if not pendingRollTarget and autoFuse and FuseRequestFunction and UnitInventory and (now - lastFuseCheck >= 4) then
                lastFuseCheck = now

                -- 1. Index all currently placed unit models on base by their unique UnitId
                local placedModelByUid = {}
                local base = GetPlayerBase()
                if base and base:FindFirstChild("PlacementSlots") then
                    for _, slot in ipairs(base.PlacementSlots:GetChildren()) do
                        local m = slot:FindFirstChildWhichIsA("Model")
                        local uid = m and m:GetAttribute("UnitId")
                        if uid then
                            placedModelByUid[uid] = m
                        end
                    end
                end

                -- 2. Group all distinct units owned by player (UnitInventory.getTools() contains all owned units)
                local tools = UnitInventory.getTools()
                local groups = {}
                local seenUids = {}

                for _, t in ipairs(tools) do
                    local uid = t:GetAttribute("UnitId")
                    if uid and not seenUids[uid] then
                        seenUids[uid] = true

                        local uName = t.Name
                        local mut = t:GetAttribute("Mutation") or "None"
                        local stars = t:GetAttribute("Stars") or 0
                        local key = uName .. "|" .. tostring(mut)

                        if not groups[key] then
                            groups[key] = {
                                Name = uName,
                                Mutation = mut,
                                Placed = {},
                                Unequipped = {},
                                Total = 0,
                            }
                        end

                        groups[key].Total = groups[key].Total + 1

                        local isPlaced = (placedModelByUid[uid] ~= nil)
                        local placedModel = placedModelByUid[uid]

                        local entry = {
                            UnitId = uid,
                            Tool = t,
                            Stars = stars,
                            IsPlaced = isPlaced,
                            Model = placedModel,
                            -- If placed on base, pass the placed Model (as FusionUIController does), else the unique UnitId
                            Arg = placedModel or uid,
                        }

                        if isPlaced then
                            table.insert(groups[key].Placed, entry)
                        else
                            table.insert(groups[key].Unequipped, entry)
                        end
                    end
                end

                -- 3. Execute Fuse ONLY when true duplicates exist AND sacrifice material is available in bag
                for _, g in pairs(groups) do
                    -- Never attempt fuse if total copies < 2 or if there are 0 unequipped copies in bag to sacrifice
                    if g.Total >= 2 and #g.Unequipped >= 1 then
                        local target = nil

                        -- Option A: If a placed copy on the base has Stars < 5, prioritize fusing into it!
                        -- Because #g.Unequipped >= 1, we have spare bag copies to sacrifice into this placed defender.
                        for _, p in ipairs(g.Placed) do
                            if p.Stars < 5 then
                                if not target or p.Stars > target.Stars then
                                    target = p
                                end
                            end
                        end

                        -- Option B: If no placed copy needs stars, fuse inventory units.
                        -- Requires at least 2 unequipped copies (1 base + at least 1 sacrifice).
                        if not target and #g.Unequipped >= 2 then
                            for _, inv in ipairs(g.Unequipped) do
                                if inv.Stars < 5 then
                                    if not target or inv.Stars > target.Stars then
                                        target = inv
                                    end
                                end
                            end
                        end

                        if target and target.Arg then
                            local ok, fused = pcall(function()
                                return FuseRequestFunction:InvokeServer(target.Arg, 1, false, "Max")
                            end)
                            if ok and fused then
                                -- Pause briefly to allow inventory synchronization before next fusion
                                break
                            end
                        end
                    end
                end
            end

            -- Auto Sell Units Below Keep Tier (keeps inventory clean)
            -- Progressively sells units strictly below keepRank (e.g. Target Mythic (6) -> keepRank Legendary (5) -> sells Epic & below)
            if not pendingRollTarget and autoSellJunk and SellUnitsRequestFunction and UnitInventory and (now - lastSellCheck >= 3) then
                lastSellCheck = now

                -- Gather placed unit IDs so we never sell any unit actively placed on the base
                local placedUnitIds = {}
                local base = GetPlayerBase()
                if base and base:FindFirstChild("PlacementSlots") then
                    for _, slot in ipairs(base.PlacementSlots:GetChildren()) do
                        local m = slot:FindFirstChildWhichIsA("Model")
                        local uid = m and m:GetAttribute("UnitId")
                        if uid then placedUnitIds[uid] = true end
                    end
                end

                local curRankTarget = currentTargetRank or globalCurrentTargetRank or 6
                -- Keep target tier AND fusion tier (keepRank = curRankTarget - 1)
                -- Sell units strictly below keepRank
                local keepRank = math.max(1, curRankTarget - 1)

                local tools = UnitInventory.getTools()
                local toSell = {}
                for _, t in ipairs(tools) do
                    local uid = t:GetAttribute("UnitId") or UnitInventory.remoteArg(t)
                    if uid and not placedUnitIds[uid] then
                        if t:GetAttribute("Locked") ~= true and t:GetAttribute("Favorite") ~= true then
                            local uData = UnitDatabase[t.Name]
                            local rarity = (uData and uData.Rarity) or t:GetAttribute("Rarity") or "Common"
                            local rank = RarityRank[rarity] or 1
                            if rank < keepRank then
                                table.insert(toSell, uid)
                                if #toSell >= 20 then break end
                            end
                        end
                    end
                end
                if #toSell > 0 then
                    pcall(function()
                        SellUnitsRequestFunction:InvokeServer(toSell)
                    end)
                end
            end

            task.wait(rollDelay)
        end
    end)
end

