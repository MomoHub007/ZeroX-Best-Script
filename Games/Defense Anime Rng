        return conn
    end

    local function Patch(bag, object, property, value)
        if not object then return end
        local ok, current = pcall(function() return object[property] end)
        if not ok then return end
        local properties = bag[object]
        local record = properties and properties[property]
        if current == value then
            if record then record.Applied = value end
            return
        end
        local written = pcall(function() object[property] = value end)
        if not written then return end
        if not properties then
            properties = {}
            bag[object] = properties
        end
        if not record then
            record = { Original = current }
            properties[property] = record
        end
        record.Applied = value
    end

    local function Restore(bag)
        for object, properties in pairs(bag) do
            for property, record in pairs(properties) do
                pcall(function()
                    if object[property] == record.Applied then
                        object[property] = record.Original
                    end
                end)
            end
            bag[object] = nil
        end
    end

    local function GetCharacter()
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = humanoid and humanoid.RootPart
        return character, humanoid, root
    end

    local function StopFlight()
        if not flight then return end
        local old = flight
        flight = nil
        pcall(function()
            old.Velocity:Destroy()
            old.Orientation:Destroy()
            old.Attachment:Destroy()
            if old.Humanoid.AutoRotate == false then
                old.Humanoid.AutoRotate = old.AutoRotate
            end
        end)
    end

    local function StartFlight(humanoid, root)
        StopFlight()
        local attachment = Instance.new("Attachment")
        attachment.Name = "ZeroXFlightAttachment"
        attachment.Parent = root

        local velocity = Instance.new("LinearVelocity")
        velocity.Name = "ZeroXFlightVelocity"
        velocity.Attachment0 = attachment
        velocity.RelativeTo = Enum.ActuatorRelativeTo.World
        velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        velocity.ForceLimitsEnabled = false
        velocity.VectorVelocity = Vector3.zero
        velocity.Parent = root

        local orientation = Instance.new("AlignOrientation")
        orientation.Name = "ZeroXFlightOrientation"
        orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        orientation.Attachment0 = attachment
        orientation.MaxTorque = math.huge
        orientation.Responsiveness = 20
        orientation.CFrame = root.CFrame.Rotation
        orientation.Parent = root

        flight = {
            Root = root,
            Humanoid = humanoid,
            AutoRotate = humanoid.AutoRotate,
            Attachment = attachment,
            Velocity = velocity,
            Orientation = orientation,
        }
        humanoid.AutoRotate = false
    end

    local function FreezeTrack(track)
        if not alive or not state.DisableAnimations then return end
        pcall(function()
            if animationSaved[track] == nil then animationSaved[track] = track.Speed end
            track:AdjustSpeed(0)
        end)
    end

    local function ClearAnimations()
        if animationConnection then
            animationConnection:Disconnect()
            animationConnection = nil
        end
        watchedAnimator = nil
        for track, speed in pairs(animationSaved) do
            pcall(function()
                if track.IsPlaying and track.Speed == 0 then
                    track:AdjustSpeed(speed)
                end
            end)
            animationSaved[track] = nil
        end
    end

    local function UpdateAnimator(humanoid)
        local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
        if animator == watchedAnimator then return end
        ClearAnimations()
        watchedAnimator = animator
        if animator then
            animationConnection = animator.AnimationPlayed:Connect(FreezeTrack)
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                FreezeTrack(track)
            end
        end
    end

    local function UpdateMotion()
        local needed = state.WalkSpeed or state.Noclip or state.Fly or state.DisableAnimations
        if not state.WalkSpeed then Restore(speedSaved) end
        if not state.Noclip then Restore(collisionSaved) end
        if not state.Fly then StopFlight() end
        if not state.DisableAnimations then ClearAnimations() end

        if not needed then
            if motionConnection then
                motionConnection:Disconnect()
                motionConnection = nil
            end
            return
        end

        if motionConnection then return end

        motionConnection = RunService.PreSimulation:Connect(function()
            if not alive then return end
            local character, humanoid, root = GetCharacter()
            if state.DisableAnimations then UpdateAnimator(humanoid) end
            if not humanoid or humanoid.Health <= 0 then
                StopFlight()
                return
            end
            if state.WalkSpeed then
                Patch(speedSaved, humanoid, "WalkSpeed", state.Speed)
            end
            if state.Noclip and character then
                for _, object in ipairs(character:GetDescendants()) do
                    if object:IsA("BasePart") then
                        Patch(collisionSaved, object, "CanCollide", false)
                    end
                end
            end
            if not state.Fly then return end
            if not root or not root.Parent or root.Anchored then
                StopFlight()
                return
            end
            if not flight or flight.Root ~= root or not flight.Velocity.Parent or not flight.Orientation.Parent then
                StartFlight(humanoid, root)
            end

            local camera = workspace.CurrentCamera
            local direction = Vector3.zero
            if camera and not UserInputService:GetFocusedTextBox() then
                local cf = camera.CFrame
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction = direction + cf.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction = direction - cf.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction = direction + cf.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction = direction - cf.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction = direction + Vector3.yAxis end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then direction = direction - Vector3.yAxis end
                flight.Orientation.CFrame = cf.Rotation
            end
            if direction.Magnitude > 1 then direction = direction.Unit end
            flight.Velocity.VectorVelocity = direction * state.FlySpeed
        end)
    end

    Connect(LocalPlayer.CharacterRemoving, function()
        StopFlight()
        ClearAnimations()
        Restore(speedSaved)
        Restore(collisionSaved)
    end)

    Connect(UserInputService.JumpRequest, function()
        if not alive or not state.InfiniteJump or state.Fly or UserInputService:GetFocusedTextBox() then return end
        local _, humanoid = GetCharacter()
        if humanoid and humanoid.Health > 0 then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)

    Connect(PromptService.PromptShown, function(prompt)
        if alive and state.InstantPrompt then Patch(promptSaved, prompt, "HoldDuration", 0) end
    end)

    local function ApplyPrompts()
        if not state.InstantPrompt then
            Restore(promptSaved)
            return
        end
        for _, object in ipairs(workspace:GetDescendants()) do
            if object:IsA("ProximityPrompt") then
                Patch(promptSaved, object, "HoldDuration", 0)
            end
        end
    end

    local function ApplyPerformanceObject(object)
        if not (state.FPSBoost or state.UltraFPSBoost) then return end
        if object:IsA("BasePart") then
            Patch(performanceSaved, object, "CastShadow", false)
            if state.UltraFPSBoost then
                Patch(performanceSaved, object, "Material", Enum.Material.SmoothPlastic)
                Patch(performanceSaved, object, "Reflectance", 0)
                if object:IsA("MeshPart") then
                    Patch(performanceSaved, object, "TextureID", "")
                end
            end
        elseif object:IsA("Light") or object:IsA("PostEffect") then
            Patch(performanceSaved, object, "Enabled", false)
        elseif state.UltraFPSBoost then
            if object:IsA("Decal") or object:IsA("Texture") then
                Patch(performanceSaved, object, "Transparency", 1)
            elseif object:IsA("SpecialMesh") then
                Patch(performanceSaved, object, "TextureId", "")
            end
        end
    end

    local function ApplyPerformance()
        performanceVersion = performanceVersion + 1
        local version = performanceVersion
        Restore(performanceSaved)
        if not (state.FPSBoost or state.UltraFPSBoost) then return end
        Patch(performanceSaved, Lighting, "GlobalShadows", false)
        task.spawn(function()
            for _, parent in ipairs({ workspace, Lighting }) do
                for index, object in ipairs(parent:GetDescendants()) do
                    if not alive or version ~= performanceVersion then return end
                    ApplyPerformanceObject(object)
                    if index % 300 == 0 then task.wait() end
                end
            end
        end)
    end

    Connect(workspace.DescendantAdded, function(object)
        if not alive then return end
        ApplyPerformanceObject(object)
        if state.InstantPrompt and object:IsA("ProximityPrompt") then
            Patch(promptSaved, object, "HoldDuration", 0)
        end
    end)

    --------------------------------------------------------------------------
    -- Player UI Controls
    --------------------------------------------------------------------------
    local Movement = Tabs.Player:AddSection({ Title = "Movement", Icon = "move" })
    local Performance = Tabs.Player:AddSection({ Title = "Performance", Icon = "monitor" })
    local FlySection = Tabs.Player:AddSection({ Title = "Fly", Icon = "send" })
    local Session = Tabs.Player:AddSection({ Title = "Session", Icon = "refresh-cw" })

    local function AddStateToggle(section, index, title, key, changed)
        local descriptions = { WalkSpeed = "ระบบปรับความเร็วเดินตามค่าที่เลือก", InfiniteJump = "ระบบกระโดดได้ต่อเนื่องกลางอากาศ", Noclip = "ระบบเดินทะลุสิ่งกีดขวาง", InstantPrompt = "ระบบกดจุดโต้ตอบโดยไม่ต้องรอเวลากดค้าง", FPSBoost = "ระบบลดเอฟเฟกต์เพื่อช่วยเพิ่ม FPS", UltraFPSBoost = "ระบบลดรายละเอียดเพิ่มเติมเพื่อเพิ่ม FPS", DisableAnimations = "ระบบปิดแอนิเมชันของตัวละคร", Fly = "ระบบบินด้วยปุ่มควบคุมการเคลื่อนที่" }
        return section:AddToggle(index, {
            Title = title,
            Description = descriptions[key],
            Default = false,
            Callback = function(value)
                if not alive then return end
                state[key] = value
                if changed then changed() end
            end,
        })
    end

    AddStateToggle(Movement, "ZeroXWalkSpeed", "WalkSpeed", "WalkSpeed", UpdateMotion)
    Movement:AddSlider("ZeroXSpeed", {
        Title = "Speed", Description = "ปรับความเร็วเดินที่ใช้เมื่อเปิด WalkSpeed",
        Min = 0,
        Max = 200,
        Default = 32,
        Increment = 1,
        Callback = function(value) state.Speed = value end,
    })
    AddStateToggle(Movement, "ZeroXInfiniteJump", "Infinite Jump", "InfiniteJump")
    AddStateToggle(Movement, "ZeroXNoclip", "Noclip", "Noclip", UpdateMotion)
    AddStateToggle(Movement, "ZeroXInstantPrompt", "Instant ProximityPrompt", "InstantPrompt", ApplyPrompts)

    Performance:AddToggle("ZeroXDisable3D", {
        Title = "Disable 3D Rendering", Description = "ปิดภาพสามมิติเพื่อลดภาระเครื่อง",
        Default = false,
        Callback = function(value)
            if not alive then return end
            pcall(function() RunService:Set3dRenderingEnabled(not value) end)
        end,
    })
    AddStateToggle(Performance, "ZeroXFPSBoost", "FPS Boost", "FPSBoost", ApplyPerformance)
    AddStateToggle(Performance, "ZeroXUltraFPSBoost", "Ultra FPS Boost", "UltraFPSBoost", ApplyPerformance)
    AddStateToggle(Performance, "ZeroXDisableAnimations", "Disable Player Animations", "DisableAnimations", UpdateMotion)

    AddStateToggle(FlySection, "ZeroXFly", "Fly", "Fly", UpdateMotion)
    FlySection:AddSlider("ZeroXFlySpeed", {
        Title = "Fly Speed", Description = "ปรับความเร็วในการบิน",
        Min = 1,
        Max = 200,
        Default = 60,
        Increment = 1,
        Callback = function(value) state.FlySpeed = value end,
    })

    Session:AddToggle("ZeroXReconnect", {
        Title = "Auto Reconnect on Kick", Description = "ระบบเข้าเกมใหม่เมื่อถูกตัดการเชื่อมต่อ",
        Default = false,
        Callback = function(value)
            state.Reconnect = value
        end,
    })

    Session:AddToggle("ZeroXHideOnStart", {
        Title = "Hide UI On Start",
        Description = "ซ่อนหน้าต่างเมื่อรันครั้งต่อไปและเปิด Autoload",
        Default = false,
    })

    MacUI:OnUnload(function()
        alive = false
        performanceVersion = performanceVersion + 1
        if motionConnection then
            motionConnection:Disconnect()
            motionConnection = nil
        end
        for _, conn in ipairs(connections) do
            conn:Disconnect()
        end
        table.clear(connections)
        StopFlight()
        ClearAnimations()
        Restore(speedSaved)
        Restore(collisionSaved)
        Restore(promptSaved)
        Restore(performanceSaved)
    end)
end

--------------------------------------------------------------------------------
-- ZERO X: Local Overhead Name
--------------------------------------------------------------------------------
do
    local TARGET_NAME = "ZERO X SCRIPTHUB"
    local alive = true
    local character
    local playerConnections = {}
    local characterConnections = {}
    local labels = {}

    local function DisconnectAll(list)
        for _, c in ipairs(list) do c:Disconnect() end
        table.clear(list)
    end

    local function EscapeRichText(value)
        return (value:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
    end

    local function NameTexts()
        local tag = LocalPlayer:GetAttribute("GuildTag")
        if type(tag) ~= "string" or tag == "" then
            return TARGET_NAME, EscapeRichText(TARGET_NAME)
        end
        local color = LocalPlayer:GetAttribute("GuildColor")
        local hex = typeof(color) == "Color3" and color:ToHex() or "8D89ED"
        return "[" .. tag .. "] " .. TARGET_NAME,
            '<font color="#' .. hex .. '">[' .. EscapeRichText(tag) .. ']</font> ' .. EscapeRichText(TARGET_NAME)
    end

    local function ReleaseLabel(label, record)
        record.Connection:Disconnect()
        pcall(function()
            if label.Text == record.Expected then label.Text = record.Original end
        end)
        labels[label] = nil
    end

    local function Refresh()
        local overhead = character and character:FindFirstChild("OverHead")
        if overhead and not overhead:IsA("BillboardGui") then overhead = nil end
        local main = overhead and overhead:FindFirstChild("Main")
        local display = main and main:FindFirstChild("DisplayName")
        local shadow = display and display:FindFirstChild("TxtShadow")
        local front = shadow and shadow:FindFirstChild("Txt")
        local plainText, richText = NameTexts()
        local wanted = {}

        if shadow and shadow:IsA("TextLabel") then wanted[shadow] = plainText end
        if front and front:IsA("TextLabel") then wanted[front] = front.RichText and richText or plainText end

        for label, record in pairs(labels) do
            if wanted[label] == nil then ReleaseLabel(label, record) end
        end

        for label, text in pairs(wanted) do
            local record = labels[label]
            if not record then
                record = { Original = label.Text }
                labels[label] = record
                record.Connection = label:GetPropertyChangedSignal("Text"):Connect(function()
                    if not alive or labels[label] ~= record then return end
                    if label.Text ~= record.Expected then
                        record.Original = label.Text
                        Refresh()
                    end
                end)
            end
            record.Expected = text
            if label.Text ~= text then label.Text = text end
        end
    end

    local function BindCharacter(nextCharacter)
        DisconnectAll(characterConnections)
        character = nextCharacter
        if character then
            table.insert(characterConnections, character.DescendantAdded:Connect(Refresh))
            table.insert(characterConnections, character.DescendantRemoving:Connect(Refresh))
        end
        Refresh()
    end

    table.insert(playerConnections, LocalPlayer.CharacterAdded:Connect(BindCharacter))
    table.insert(playerConnections, LocalPlayer.CharacterRemoving:Connect(function(oldChar)
        if character == oldChar then BindCharacter(nil) end
    end))

    MacUI:OnUnload(function()
        alive = false
        DisconnectAll(playerConnections)
        DisconnectAll(characterConnections)
        for label, record in pairs(labels) do ReleaseLabel(label, record) end
    end)

    BindCharacter(LocalPlayer.Character)
end

