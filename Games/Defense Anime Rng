    DropsSection:AddToggle("ZeroXCollectDrops", {
        Title = "Instant Auto Collect Cash & XP",
        Description = "ระบบเก็บเงินและ EXP ที่ศัตรูดรอปให้โดยอัตโนมัติ",
        Default = true,
        Callback = function(val)
            FarmConfig.CollectDrops = val
        end,
    })

    --------------------------------------------------------------------------
    -- Drops Magnet Execution
    --------------------------------------------------------------------------
    local function CollectDrop(drop)
        if not FarmConfig.CollectDrops or not drop or not drop:IsA("BasePart") then return end
        local name = drop.Name
        if name == "CashThing" or name == "XpThing" then
            local owner = drop:GetAttribute("OwnerUserId")
            if owner == LocalPlayer.UserId or owner == nil then
                if name == "CashThing" and CollectCashEvent then
                    pcall(function() CollectCashEvent:FireServer(drop) end)
                elseif name == "XpThing" and CollectXpEvent then
                    pcall(function() CollectXpEvent:FireServer(drop) end)
                end
            end
        end
    end

    workspace.DescendantAdded:Connect(CollectDrop)

    -- Sweep loop for drops already in workspace
    task.spawn(function()
        while not MacUI.Unloaded do
            if FarmConfig.CollectDrops then
                for _, child in ipairs(workspace:GetChildren()) do
                    if child.Name == "CashThing" or child.Name == "XpThing" then
                        CollectDrop(child)
                    end
                end
            end
            task.wait(1)
        end
    end)

    --------------------------------------------------------------------------
    -- Weapon Auto-Purchaser & Equipper
    --------------------------------------------------------------------------
    local sortedWeapons = {}
    for name, data in pairs(WeaponsDatabase) do
        if not data.Unobtainable and data.Price and data.Price > 0 and data.Damage then
            table.insert(sortedWeapons, {
                Name = name,
                Price = data.Price,
                Damage = data.Damage
            })
        end
    end
    table.sort(sortedWeapons, function(a, b) return a.Damage < b.Damage end)

    local purchasedDamage = 0
    local pendingEquipWeapon = nil

    local function BuyBestWeapon()
        if FarmConfig.AutoBuyBestWeapon and BuyWeaponRequestFunction then
            local currentWeaponName = LocalPlayer:GetAttribute("EquippedWeapon") or ""
            local currentDmg = math.max(purchasedDamage, (WeaponsDatabase[currentWeaponName] and WeaponsDatabase[currentWeaponName].Damage) or 0)
            local money = GetPlayerMoney()

            for i = #sortedWeapons, 1, -1 do
                local w = sortedWeapons[i]
                if w.Damage > currentDmg and money >= w.Price then
                    local bought = BuyWeaponRequestFunction:InvokeServer(w.Name)
                    if bought then
                        purchasedDamage = w.Damage
                        pendingEquipWeapon = w.Name
                    end
                    break
                end
            end
        end
    end

    local function EquipBestWeapon()
        if not FarmConfig.AutoEquipWeapon then return end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if not hum or hum.Health <= 0 then return end

        if pendingEquipWeapon and EquipWeaponRequestFunction then
            local weaponName = pendingEquipWeapon
            EquipWeaponRequestFunction:InvokeServer(weaponName)
            if pendingEquipWeapon == weaponName then
                pendingEquipWeapon = nil
            end
            if MacUI.Unloaded or not FarmConfig.AutoEquipWeapon then return end
        end

        -- Select the strongest owned weapon, including the one currently held.
        if FarmConfig.AutoEquipWeapon and bp then
            local currentTool = char:FindFirstChildOfClass("Tool")
            local bestTool = nil
            local currentData = currentTool and WeaponsDatabase[currentTool.Name]
            local bestDmg = currentTool and (currentData and currentData.Damage or 10) or -1
            for _, item in ipairs(bp:GetChildren()) do
                if item:IsA("Tool") then
                    local wData = WeaponsDatabase[item.Name]
                    local dmg = wData and wData.Damage or 10
                    if dmg > bestDmg then
                        bestDmg = dmg
                        bestTool = item
                    end
                end
            end
            if bestTool then
                hum:EquipTool(bestTool)
            end
        end
    end

    -- Separate workers keep a yielding purchase request from blocking equipment or combat.
    local function StartWeaponWorker(name, step)
        task.spawn(function()
            while not MacUI.Unloaded do
                local ok, err = pcall(step)
                if not ok then
                    warn("[Zero X] " .. name .. ": " .. tostring(err))
                end
                task.wait(2)
            end
        end)
    end

    StartWeaponWorker("Auto Buy Weapon", BuyBestWeapon)
    StartWeaponWorker("Auto Equip Weapon", EquipBestWeapon)

    --------------------------------------------------------------------------
    -- Smart Target Query
    --------------------------------------------------------------------------
    local function QueryTargets()
        local base = GetPlayerBase()
        if not base then return {} end

        local targets = {}
        local bossHolder = base:FindFirstChild("BossHolder")
        local enemiesHolder = base:FindFirstChild("EnemiesHolder")

        local function CheckTarget(model, isBoss)
            if not model or not model.Parent then return end
            local hum = model:FindFirstChildOfClass("Humanoid")
            local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            if hum and hum.Health > 0 and hrp then
                table.insert(targets, {
                    Model = model,
                    Humanoid = hum,
                    RootPart = hrp,
                    IsBoss = isBoss or model:GetAttribute("IsBoss") == true,
                    Health = hum.Health,
                    MaxHealth = hum.MaxHealth,
                })
            end
        end

        if bossHolder then
            for _, b in ipairs(bossHolder:GetChildren()) do
                CheckTarget(b, true)
            end
        end
        if enemiesHolder then
            for _, e in ipairs(enemiesHolder:GetChildren()) do
                CheckTarget(e, false)
            end
        end

        local char = LocalPlayer.Character
        local playerHrp = char and char:FindFirstChild("HumanoidRootPart")
        local pPos = playerHrp and playerHrp.Position or Vector3.zero

        if FarmConfig.TargetPriority == "Boss First" then
            table.sort(targets, function(a, b)
                if a.IsBoss ~= b.IsBoss then return a.IsBoss end
                return a.Health < b.Health
            end)
        elseif FarmConfig.TargetPriority == "Lowest HP" then
            table.sort(targets, function(a, b) return a.Health < b.Health end)
        elseif FarmConfig.TargetPriority == "Closest" and playerHrp then
            table.sort(targets, function(a, b)
                return (a.RootPart.Position - pPos).Magnitude < (b.RootPart.Position - pPos).Magnitude
            end)
        elseif FarmConfig.TargetPriority == "Normal First" then
            table.sort(targets, function(a, b)
                if a.IsBoss ~= b.IsBoss then return not a.IsBoss end
                return a.Health < b.Health
            end)
        end

        return targets
    end

    --------------------------------------------------------------------------
    -- Farm Loop Controller
    --------------------------------------------------------------------------
    local lastAttackTime = 0

    local function IsTargetInAttackRange(target, playerRoot, isGun)
        if not target.Model.Parent or not target.RootPart.Parent or target.Humanoid.Health <= 0 then return false end
        local offset = target.RootPart.Position - playerRoot.Position
        if isGun then
            return Vector3.new(offset.X, 0, offset.Z).Magnitude <= 50
        end
        if target.Model:GetAttribute("WorldRaidTarget") then
            local localPosition = target.RootPart.CFrame:PointToObjectSpace(playerRoot.Position)
            local halfSize = target.RootPart.Size / 2
            local closest = Vector3.new(
                math.clamp(localPosition.X, -halfSize.X, halfSize.X),
                math.clamp(localPosition.Y, -halfSize.Y, halfSize.Y),
                math.clamp(localPosition.Z, -halfSize.Z, halfSize.Z)
            )
            offset = target.RootPart.CFrame:PointToWorldSpace(closest) - playerRoot.Position
        end
        local range = math.max(1, target.Model:GetScale()) * 10
        return math.abs(offset.X) <= range and math.abs(offset.Y) <= range and math.abs(offset.Z) <= range
    end

    task.spawn(function()
        while not MacUI.Unloaded do
            if not farmPausedForUnit and (FarmConfig.Enabled or FarmConfig.AutoAttack) then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if hrp and hum and hum.Health > 0 then
                    local targets = FarmConfig.Enabled and QueryTargets() or {}
                    local currentTarget = targets[1]

                    if currentTarget and currentTarget.RootPart.Parent then
                        local targetRoot = currentTarget.RootPart
                        if (hrp.Position - targetRoot.Position).Magnitude > 6 then
                            hrp.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
                        end
                    end

                    if PlayerAttackEvent then
                        local tool = char:FindFirstChildOfClass("Tool")
                        local weapon = tool and WeaponsDatabase[tool.Name]
                        local isGun = weapon and weapon.IsGun == true
                        if FarmConfig.Enabled and currentTarget then
                            for _, target in ipairs(targets) do
                                if not FarmConfig.Enabled or farmPausedForUnit or MacUI.Unloaded then break end
                                if IsTargetInAttackRange(target, hrp, isGun) then
                                    local ok, err = pcall(function()
                                        PlayerAttackEvent:FireServer(target.Model)
                                    end)
                                    if not ok then warn("[Zero X] Smart Farm attack: " .. tostring(err)) end
                                end
                            end
                        end
                        if FarmConfig.AutoAttack then
                            local now = os.clock()
                            local swingLv = LocalPlayer:GetAttribute("SwingSpeedLv") or 0
                            local cooldown = 0.25 / (1 + (swingLv * 0.1))

                            if now - lastAttackTime >= cooldown then
                                lastAttackTime = now
                                local ok, err = pcall(function()
                                    if not isGun then
                                        PlayerAttackEvent:FireServer()
                                    end
                                end)
                                if not ok then
                                    warn("[Zero X] Combat: " .. tostring(err))
                                end
                            end
                        end
                    end
                end
            end
            task.wait(0.03)
        end
    end)
end

