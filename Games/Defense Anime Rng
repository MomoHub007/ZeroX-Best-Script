--------------------------------------------------------------------------------
-- Dynamic Base & Game Helpers
--------------------------------------------------------------------------------
local cachedBase = nil
local lastBaseCheck = 0

local function GetPlayerBase()
    local now = os.clock()
    if cachedBase and cachedBase.Parent and (now - lastBaseCheck < 2) then
        return cachedBase
    end
    lastBaseCheck = now

    local bases = workspace:FindFirstChild("Bases")
    if not bases then return nil end

    local uidStr = tostring(LocalPlayer.UserId)
    local nameStr = LocalPlayer.Name

    for _, b in ipairs(bases:GetChildren()) do
        local o = b:FindFirstChild("Owner")
        if o and (o.Value == uidStr or o.Value == nameStr) then
            cachedBase = b
            return b
        end
        local attr = b:GetAttribute("Owner") or b:GetAttribute("OwnerUserId")
        if attr and (tostring(attr) == uidStr or tostring(attr) == nameStr) then
            cachedBase = b
            return b
        end
    end
    return nil
end

local function GetPlayerMoney()
    local attribute = LocalPlayer:GetAttribute("Money")
    if type(attribute) == "number" then return attribute end
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        local money = ls:FindFirstChild("Money") or ls:FindFirstChild("Gold")
        if money and typeof(money.Value) == "number" then
            return money.Value
        end
    end
    return 0
end

local function GetCurrentZoneName()
    local base = GetPlayerBase()
    if base then
        local cz = base:FindFirstChild("CurrentZone")
        if cz and cz:IsA("StringValue") and cz.Value ~= "" then
            return cz.Value
        end
    end
    local attr = LocalPlayer:GetAttribute("CurrentZone")
    if attr and attr ~= "" then return tostring(attr) end
    return "Wisteria"
end

