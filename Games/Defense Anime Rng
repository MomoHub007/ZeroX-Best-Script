-- 4. SMART UNIT ROLL & TEAM PROGRESSION
--------------------------------------------------------------------------------
do
    local RarityRank = {
        ["Common"] = 1,
        ["Uncommon"] = 2,
        ["Rare"] = 3,
        ["Epic"] = 4,
        ["Legendary"] = 5,
        ["Mythic"] = 6,
        ["Secret"] = 7,
        ["Cosmic"] = 8,
        ["Divine"] = 9,
        ["Limited"] = 10,
        ["Exclusive"] = 11,
    }

    local RankNames = {
        [1] = "Common",
        [2] = "Uncommon",
        [3] = "Rare",
        [4] = "Epic",
        [5] = "Legendary",
        [6] = "Mythic",
        [7] = "Secret",
        [8] = "Cosmic",
        [9] = "Divine",
    }

    local globalCurrentTargetRank = 4

    local function EvaluateTeam()
        local base = GetPlayerBase()
        local equipped = {}
        local totalDPS = 0
        local minRank = 99
        local minRarity = "Common"
        local maxRank = 1
        local maxRarity = "Common"

        -- 1. First Priority: Check units actually placed on the player's base placement slots (active defense team)
        if base and base:FindFirstChild("PlacementSlots") then
            for _, slot in ipairs(base.PlacementSlots:GetChildren()) do
                local model = slot:FindFirstChildWhichIsA("Model")
                if model then
                    local unitName = model:GetAttribute("UnitName") or string.gsub(model.Name, "^PlacedUnit_", "")
                    local uData = UnitDatabase[unitName]
                    local rarity = uData and uData.Rarity or model:GetAttribute("Rarity") or "Common"
                    local dps = uData and (uData.DPS or uData.Damage) or 0
                    local rank = RarityRank[rarity] or 1
                    totalDPS = totalDPS + dps

                    if rank < minRank then
                        minRank = rank
                        minRarity = rarity
                    end
                    if rank > maxRank then
                        maxRank = rank
                        maxRarity = rarity
                    end
                    table.insert(equipped, { Name = unitName, Rarity = rarity, DPS = dps, Rank = rank, Placed = true })
                end
            end
        end

        -- 2. Fallback to UnitInventory tools if no units are placed yet
        if #equipped == 0 and UnitInventory and typeof(UnitInventory.getTools) == "function" then
            local tools = UnitInventory.getTools()
            for _, t in ipairs(tools) do
                if t:GetAttribute("Equipped") == true then
                    local uData = UnitDatabase[t.Name]
                    local rarity = uData and uData.Rarity or "Common"
                    local dps = uData and (uData.DPS or uData.Damage) or 0
                    local rank = RarityRank[rarity] or 1
                    totalDPS = totalDPS + dps

                    if rank < minRank then
                        minRank = rank
                        minRarity = rarity
                    end
                    if rank > maxRank then
                        maxRank = rank
                        maxRarity = rarity
                    end
                    table.insert(equipped, { Name = t.Name, Rarity = rarity, DPS = dps, Rank = rank, Placed = false })
                end
            end
        end

        if #equipped == 0 then
            minRank = 1
            minRarity = "Common"
        end

        return {
            Equipped = equipped,
            Count = #equipped,
            TotalDPS = totalDPS,
            MinRank = minRank,
            MinRarity = minRarity,
            MaxRank = maxRank,
            MaxRarity = maxRarity,
        }
    end

