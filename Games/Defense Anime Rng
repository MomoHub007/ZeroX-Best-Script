    local function ChallengeReady(tier)
        local definition = challenges and challenges[tier]
        local now = ServerNow()
        if not definition or not now then return false end
        local completed = LocalPlayer:GetAttribute("Challenge" .. tier .. "CompletedAt") or 0
        if definition.CompletionCooldownSeconds then
            return completed <= 0 or completed + definition.CompletionCooldownSeconds <= now
        end
        local interval, offset = definition.ResetInterval, challenges.EpochOffsetSeconds
        if type(interval) ~= "number" or interval <= 0 or type(offset) ~= "number" then return false end
        return math.floor((completed - offset) / interval) < math.floor((now - offset) / interval)
    end

