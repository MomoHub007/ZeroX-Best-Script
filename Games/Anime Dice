if config["Tower Runs"] ~= config["Tower Runs"] or config["Tower Runs"] < 1 or config["Tower Runs"] > 100 then
    warn("[Anime Dice Config] Tower Runs must be between 1 and 100; using 3")
    config["Tower Runs"] = 3
