local function formatDashboardNumber(value)
    local magnitude = math.abs(value)
    local scales = {
        { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" },
    }
    for _, scale in ipairs(scales) do
        if magnitude >= scale[1] then
            local number = string.format("%.2f", value / scale[1]):gsub("%.?0+$", "")
            return number .. scale[2]
        end
    end
    return string.format("%.0f", value)
end

