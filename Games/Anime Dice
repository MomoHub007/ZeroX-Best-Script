local function updateBestPlotUnit(generation)
    local function active()
        return session.alive and session.autoUnits and session.unitsGeneration == generation
    end
    local services = getServices()
    local config = pcall(function() return loadModule({ "Framework", "Features", "Plot", "PlotConfig" }) end)
        and loadModule({ "Framework", "Features", "Plot", "PlotConfig" }) or nil
    if not config then return end
    local plot = getOwnPlot()
    local comm = services.network.ClientComm.new(services.networkRoot, false, "PlotService")
    local collect, interact = comm:GetSignal("CollectBalance"), comm:GetSignal("InteractSlot")

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local function ready()
        return active() and character == player.Character and humanoid and humanoid.Health > 0
            and plot and plot.Parent ~= nil
    end
    if not ready() then return end

    local held = getHeldUnit()
    if plotUnits.reserved then
        if held == plotUnits.reserved then
            unequipHeldUnit(services)
            return
        end
        plotUnits.reserved = nil
    end
    if held ~= nil then return end

    local inventory, slots, rebirth = data.Inventory(), data.Slots(), data.Rebirth()
    if type(inventory) ~= "table" or type(slots) ~= "table" or type(rebirth) ~= "number" then return end
    local placed = {}
    for _, slot in pairs(slots) do
        if slot.unitId then placed[slot.unitId] = true end
    end

    local targetIndex, oldId, weakestOdds
    for index = 1, config.GetMaxSlots() do
        if rebirth >= config.GetSlotRebirthRequirement(index) then
            local slot = slots[tostring(index)]
            if not slot or not slot.unitId then
                targetIndex, oldId, weakestOdds = index, nil, 0
                break
            end
            local odds = unitOdds(services.registry, inventory[slot.unitId])
            if odds and (not weakestOdds or odds < weakestOdds) then
                targetIndex, oldId, weakestOdds = index, slot.unitId, odds
            end
        end
    end
    if not targetIndex then return end

    local candidateId, bestOdds = nil, weakestOdds
    for id, entry in pairs(inventory) do
        if type(id) == "string" and not placed[id] then
            local odds = unitOdds(services.registry, entry)
            if odds and (odds > bestOdds or odds == bestOdds and candidateId and id < candidateId) then
                candidateId, bestOdds = id, odds
            end
        end
    end
    if not candidateId or not ready() then return end

    local slotState = data.Slots[tostring(targetIndex)]
    local function currentUnit()
        local slot = slotState()
        return slot and slot.unitId
    end
    local function waitFor(predicate)
        local deadline = os.clock() + 5
        while ready() and os.clock() < deadline do
            if predicate() then return true end
            task.wait(0.1)
        end
        return false
    end

    plotUnits.reserved = candidateId
    local slot = slotState()
    local balance = slot and slot.balance
    if currentUnit() ~= oldId then return end
    if oldId and type(balance) == "number" and balance > 0 then
        collect:Fire(targetIndex)
        if not waitFor(function()
            local latest = slotState()
            return latest and latest.unitId == oldId and type(latest.balance) == "number"
                and latest.balance < balance
        end) then error("cash collection unconfirmed") end
    end
    if not ready() or currentUnit() ~= oldId or controller.EquippedUnit() ~= nil then return end
    if controller.Equip(candidateId) ~= true then error("equip rejected") end
    if not waitFor(function() return controller.EquippedUnit() == candidateId end) then
        error("equip unconfirmed")
    end
    if not ready() or currentUnit() ~= oldId or controller.EquippedUnit() ~= candidateId then return end

    interact:Fire(targetIndex)
    if not waitFor(function() return currentUnit() == candidateId end) then
        error("placement unconfirmed")
    end
    plotUnits.reserved = nil
    setStatus("Auto Units: placed " .. inventory[candidateId].name .. " (1 in " .. tostring(bestOdds) .. ")")
    return true
end

local function queueBestPlotUnits()
    if not session.alive or not session.autoUnits then return end
    if plotUnits.busy then
        plotUnits.dirty = true
        return
    end
    if os.clock() < (plotUnits.retryAt or 0) then return end
    plotUnits.busy = true
    plotUnits.dirty = false
    local generation = session.unitsGeneration
    task.defer(function()
        local ok, changed = pcall(updateBestPlotUnit, generation)
        plotUnits.busy = false
        if not ok then
            plotUnits.retryAt = os.clock() + 5
            if session.alive and session.autoUnits and session.unitsGeneration == generation then
                setStatus("Auto Units: " .. tostring(changed))
            end
        elseif changed then
            plotUnits.retryAt = os.clock() + 0.55
        end
        if plotUnits.dirty or changed == true then
            task.delay(math.max(0, (plotUnits.retryAt or 0) - os.clock()), queueBestPlotUnits)
        end
    end)
end

