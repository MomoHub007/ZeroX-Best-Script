local unitLevelPending
local unitLevelServices
local unitLevelPolicy = { maxPaybackSeconds = 28800, maxCashFraction = 0.9 }

local function getUnitLevelServices()
    if unitLevelServices then return unitLevelServices end
    local network = loadModule({ "Packages", "Network" })
    local root = ReplicatedStorage:FindFirstChild("Network")
    if not root then error("Network unavailable") end
    unitLevelServices = {
        config = loadModule({ "Framework", "Features", "Plot", "PlotConfig" }),
        unitUtil = loadModule({ "Framework", "Features", "Inventory", "Kinds", "Unit", "UnitUtil" }),
        registry = loadModule({ "Framework", "Features", "Inventory", "EntryRegistry" }),
        signal = network.ClientComm.new(root, false, "PlotService"):GetSignal("LevelUpSlot"),
    }
    return unitLevelServices
end

local function chooseUnitLevel(services)
    local money, rebirth, slots = data.Money(), data.Rebirth(), data.Slots()
    if type(money) ~= "number" or type(rebirth) ~= "number" or type(slots) ~= "table" then
        return nil
    end
    local best
    for key, slot in pairs(slots) do
        local slotIndex = tonumber(key)
        if slotIndex and slotIndex % 1 == 0 and type(slot) == "table"
            and type(slot.unitId) == "string"
            and rebirth >= services.config.GetSlotRebirthRequirement(slotIndex) then
            local entry = data.Inventory[slot.unitId]()
            if entry and type(entry.attributes) == "table" and type(entry.name) == "string" then
                local config = services.registry.getEntryConfig(entry.name)
                if config and config.kind == "Unit" and type(config.income) == "function" then
                    local attributes = table.clone(entry.attributes)
                    local level = attributes.level or 1
                    if type(level) == "number" and level >= 1 then
                        local price = services.unitUtil.GetLevelPrice(entry.name, attributes)
                        local before = config.income(attributes)
                        attributes.level = level + 1
                        local after = config.income(attributes)
                        if type(price) == "number" and price >= 0 and price <= money * unitLevelPolicy.maxCashFraction
                            and type(before) == "number" and type(after) == "number" and after > before then
                            local payback = price / (after - before)
                            if payback <= unitLevelPolicy.maxPaybackSeconds
                                and (not best or payback < best.payback) then
                                best = { slot = slotIndex, unitId = slot.unitId, level = level, payback = payback }
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function runUnitLevels(generation)
    while session.alive and session.autoUnitLevels and session.unitLevelsGeneration == generation do
        pcall(function()
            if unitLevelPending then
                local slot = data.Slots[tostring(unitLevelPending.slot)]()
                local entry = data.Inventory[unitLevelPending.unitId]()
                if not slot or slot.unitId ~= unitLevelPending.unitId or not entry
                    or (entry.attributes.level or 1) > unitLevelPending.level then
                    unitLevelPending = nil
                else
                    if os.clock() >= unitLevelPending.deadline then
                        setStatus("Unit Upgrade: waiting for level confirmation")
                    end
                    return
                end
            end
            local services = getUnitLevelServices()
            local candidate = chooseUnitLevel(services)
            if candidate and session.alive and session.autoUnitLevels
                and session.unitLevelsGeneration == generation then
                unitLevelPending = { slot = candidate.slot, unitId = candidate.unitId,
                    level = candidate.level, deadline = os.clock() + 10 }
                services.signal:Fire(candidate.slot)
                setStatus("Unit Upgrade: requested slot " .. tostring(candidate.slot))
            end
        end)
        task.wait(1.0)
    end
end

