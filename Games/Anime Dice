local function findPath(root, names)
    local current = root
    for _, name in ipairs(names) do
        current = current:WaitForChild(name, 5)
        if not current then
            return nil
        end
    end
    return current
end

local function loadModule(path)
    local module = findPath(ReplicatedStorage, path)
    if not module or not module:IsA("ModuleScript") then
        error("Module unavailable: " .. table.concat(path, "."))
    end
    return require(module)
end

