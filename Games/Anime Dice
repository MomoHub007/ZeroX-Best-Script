            if okRendering then change(rendering, "QualityLevel", Enum.QualityLevel.Level01) end
            connections[#connections + 1] = workspace.DescendantAdded:Connect(function(object)
                if enabled and generation == currentGeneration then simplify(object) end
            end)
            connections[#connections + 1] = lighting.DescendantAdded:Connect(function(object)
                if enabled and generation == currentGeneration then simplify(object) end
            end)
            task.spawn(function()
                local objects = workspace:GetDescendants()
                for index, object in ipairs(objects) do
                    if not enabled or generation ~= currentGeneration or not session.alive then return end
                    simplify(object)
                    if index % 200 == 0 then task.wait() end
                end
                for _, object in ipairs(lighting:GetDescendants()) do
                    if not enabled or generation ~= currentGeneration or not session.alive then return end
                    simplify(object)
                end
            end)
            setStatus("โหมด Potato เปิดแล้ว • " .. session.potatoStatus)
        else
            for _, connection in ipairs(connections) do connection:Disconnect() end
            table.clear(connections)
            for object, properties in pairs(changed) do
                for property, saved in pairs(properties) do
                    pcall(function()
                        if object[property] == saved.applied then object[property] = saved.before end
                    end)
                end
            end
            table.clear(changed)
            if setCap and previousCap then pcall(setCap, previousCap) end
            session.potatoStatus = previousCap and "คืนค่า FPS เดิมแล้ว" or "ไม่ทราบค่า FPS เดิม"
            previousCap = nil
            setStatus("โหมด Potato ปิดแล้ว • " .. session.potatoStatus)
        end
    end
    potatoButton.Activated:Connect(function() session.setPotato(not enabled) end)
