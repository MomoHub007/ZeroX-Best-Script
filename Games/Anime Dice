                if okFn and fn then
                    collectFn = function(slotIdx) return fn(slotIdx) end
                end
            end
        end
    end

    collectCashServices = {
        config = pcall(function() return loadModule({ "Framework", "Features", "Plot", "PlotConfig" }) end)
            and loadModule({ "Framework", "Features", "Plot", "PlotConfig" }) or nil,
        collectFn = collectFn,
