-- FEATURE 1: AUTO ROLL (Zero-Cooldown Instant Rolling)
--------------------------------------------------------------------------------

local instantRollInFlight = false

local function runAutoRoll(generation)
    local function active()
        return session.alive and session.autoRoll and session.rollGeneration == generation
    end
    local services, buffs, registry, rollDice
    local disableRequested = false
    local retryDelay = 2
    while active() do
        local ok, err = pcall(function()
            if not rollDice then
                services = getServices()
                buffs = loadModule({ "Framework", "Features", "Buffs", "BuffController" })
                registry = services.registry
                rollDice = services.network.ClientComm.new(services.networkRoot, false, "RollService"):GetFunction("RollDice")
            end
            if not active() then return end
            local native = data.AutoRoll()
            if type(native) ~= "boolean" then
                setStatus("Instant Roll: waiting for game data")
                return
            end
            if native then
                if not disableRequested then
                    roll.SetAutoRoll(false)
                    disableRequested = true
                end
                setStatus("Instant Roll: waiting for native roll to stop")
                return
            end
            if instantRollInFlight then
                setStatus("Instant Roll: waiting for previous request")
                return
            end
            local inventory, duration = data.Inventory(), buffs.GetBuff("Roll Duration")
            local storage, rollCount = buffs.GetBuff("Unit Storage"), buffs.GetBuff("Rolls")
            if type(inventory) ~= "table" or type(duration) ~= "number" or duration <= 0
                or type(storage) ~= "number" or type(rollCount) ~= "number" or not registry then
                setStatus("Instant Roll: waiting for roll data")
                return
            end
            local count = 0
            for _, entry in pairs(inventory) do
                if type(entry) == "table" and type(entry.name) == "string" then
                    local config = registry.getEntryConfig(entry.name)
                    if config and config.kind == "Unit" then count += 1 end
                end
            end
            local trade = data.PendingTrade()
            if type(trade) == "table" and not trade.applied and type(trade.reservedUnits) == "number" then
                count += trade.reservedUnits
            end
            if storage + (rollCount - 1) <= count then
                setStatus("Instant Roll: unit inventory full")
                return
            end
