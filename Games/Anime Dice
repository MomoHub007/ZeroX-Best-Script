local function runFusePotions(generation)
    local function active()
        return session.alive and session.autoFusePotions and session.fusePotionsGeneration == generation
    end
    local rejectedName, rejectedAmount
    while active() do
        local ok, err = pcall(function()
            local services = getServices()
            local util = loadModule({ "Framework", "Features", "PotionFusing", "PotionFusingUtil" })
            local zoneCheck = loadModule({ "Framework", "Utils", "ZoneCheck" })
            local inventory = data.Inventory()
            if type(inventory) ~= "table" or type(util.FUSE_COST) ~= "number" or util.FUSE_COST < 1 then
                error("potion inventory unavailable")
            end
            if potionFuseInFlight then return end
            if potionFusePending then
                local entry = inventory[potionFusePending.name]
                if not entry or type(entry.amount) == "number" and entry.amount < potionFusePending.amount then
                    potionFusePending = nil
                else
                    setStatus("Potion Fuse: waiting for inventory confirmation")
                    return
                end
            end
            local candidate
            for key, item in pairs(inventory) do
                if type(key) == "string" and type(item) == "table" and key == item.name
                    and type(item.amount) == "number" and item.amount >= util.FUSE_COST
                    and util.GetNextTier(item.name) and not potionPending[key]
                    and not (rejectedName == key and rejectedAmount == item.amount) then
                    if not candidate or key < candidate.name then
                        candidate = { name = key, amount = item.amount }
                    end
                end
            end
            if not active() then return end
            if not candidate then
                if potionFuseTripCharacter and potionFuseTripCharacter == player.Character then
                    local spawn = getOwnPlotSpawn()
                    if not spawn then
                        setStatus("Potion Fuse: waiting for own plot")
                        return
                    end
                    if not active() then return end
                    potionFuseTripCharacter:PivotTo(spawn)
                    potionFuseTripCharacter = nil
                    setStatus("Potion Fuse: returned to plot")
                elseif potionFuseTripCharacter ~= player.Character then
                    potionFuseTripCharacter = nil
                end
                return
            end
            if not zoneCheck.IsNearZone(player, "PotionFusing") then
                local zones = workspace:FindFirstChild("Zones")
                local zone = zones and zones:FindFirstChild("PotionFusing")
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                if not zone or not zone:IsA("BasePart") or not humanoid or humanoid.Health <= 0
                    or not rootPart or not rootPart:IsA("BasePart") then
                    setStatus("Potion Fuse: waiting for character or zone")
                    return
                end
                if not getOwnPlotSpawn() then
                    setStatus("Potion Fuse: waiting for own plot")
                    return
                end
                if not active() then return end
                potionFuseTripCharacter = character
                character:PivotTo(zone.CFrame * CFrame.new(0, math.min(zone.Size.Y / 2, 4), 0))
                setStatus("Potion Fuse: teleporting to fuser")
                task.wait(1)
                if not active() or character ~= player.Character then return end
                local deadline = os.clock() + 5
                while active() and character == player.Character and os.clock() < deadline
                    and not zoneCheck.IsNearZone(player, "PotionFusing") do
                    task.wait(0.5)
                end
                if not active() or character ~= player.Character then return end
                if not zoneCheck.IsNearZone(player, "PotionFusing") then
                    setStatus("Potion Fuse: teleport not confirmed")
                    return
                end
            end
            if not active() then return end
            if not potionFuseTripCharacter then
                if not getOwnPlotSpawn() then setStatus("Potion Fuse: waiting for own plot") return end
                potionFuseTripCharacter = player.Character
            end
            inventory = data.Inventory()
            local latest = inventory[candidate.name]
            if not latest or type(latest.amount) ~= "number" or latest.amount < util.FUSE_COST
                or potionPending[candidate.name] then return end
            local signal = services.network.ClientComm.new(services.networkRoot, false, "PotionFusingService"):GetFunction("Fuse")
            if not active() then return end
            potionFusePending = { name = candidate.name, amount = latest.amount }
            potionFuseInFlight = true
            local success, accepted, reason = pcall(signal, { [candidate.name] = 1 })
            potionFuseInFlight = false
            if not success or accepted ~= true then
                potionFusePending = nil
                rejectedName, rejectedAmount = candidate.name, latest.amount
                if active() then setStatus("Potion Fuse: " .. tostring(reason or accepted)) end
            elseif active() then
                setStatus("Potion Fuse: accepted, waiting for inventory")
            end
        end)
        if not ok and active() then setStatus("Potion Fuse: " .. tostring(err)) end
        task.wait(ok and 3 or 8)
    end
end

