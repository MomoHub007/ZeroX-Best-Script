--------------------------------------------------------------------------------
-- FEATURE 6: AUTO TOWER & HIDE TOWER (Continuous Adaptive Loop & Fallback)
--------------------------------------------------------------------------------

local towerAdaptive = {
    viable = {},
    failed = {},
    viableOrderIndex = 1,
    probeHigherNext = true,
    batchTarget = nil,
    batchProbe = false,
    batchCompleted = 0,
    nextUnverifiedIndex = 1,
}

local function towerActive(generation)
    return session.alive and session.autoTower and session.towerGeneration == generation
end

local function getHighestViableTowers(services)
    local all = services.towers.GetAll()
    local ordered = {}

    for name, config in pairs(all) do
        if not config.event and type(config.order) == "number"
            and type(config.maxFloors) == "number" and config.maxFloors > 0
            and not config.floorOffset and not config.section then
            table.insert(ordered, {
                name = name,
                order = config.order,
                maxFloors = config.maxFloors,
            })
        end
    end

    table.sort(ordered, function(a, b)
        return a.order < b.order
    end)

    return ordered
end

local function selectAdaptiveTower(ordered)
    local viableList = {}
    for _, t in ipairs(ordered) do
        if towerAdaptive.viable[t.name] == true then
            table.insert(viableList, t)
        end
    end

    if #viableList == 0 then
        for offset = 0, #ordered - 1 do
            local index = (towerAdaptive.nextUnverifiedIndex - 1 + offset) % #ordered + 1
            if not towerAdaptive.failed[ordered[index].name] then
                return ordered[index], false
            end
        end
        return ordered[towerAdaptive.nextUnverifiedIndex], false
    end

    -- Check if we should probe a higher tower
    if towerAdaptive.probeHigherNext then
        local highestViableOrder = viableList[#viableList].order
        local candidate = nil
        for _, t in ipairs(ordered) do
            if t.order > highestViableOrder then
                local lastFail = towerAdaptive.failed[t.name]
                if not lastFail or (os.clock() - lastFail) > 300 then
                    candidate = t
                    break
                end
            end
        end

        towerAdaptive.probeHigherNext = false
        if candidate then
            return candidate, true
        end
    end

    -- Round-robin cycle across all currently viable towers
    if towerAdaptive.viableOrderIndex > #viableList then
        towerAdaptive.viableOrderIndex = 1
    end
    local selected = viableList[towerAdaptive.viableOrderIndex]
    towerAdaptive.viableOrderIndex = (towerAdaptive.viableOrderIndex % #viableList) + 1
    towerAdaptive.probeHigherNext = true

    return selected, false
end

