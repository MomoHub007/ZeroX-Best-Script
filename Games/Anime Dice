local pendingTreeUpgrade

local function runAutoUpgrade(generation)
    local function active()
        return session.alive and session.autoUpgrade and session.upgradeGeneration == generation
    end
    while active() do
        local ok, err = pcall(function()
            local tree = upgradeController and upgradeController.Tree
            local options = tree and tree.options
            if not options or not options.structure or not options.data or not options.config then
                local treeStructure = pcall(function() return loadModule({ "Framework", "Features", "Upgrades", "TreeStructure" }) end)
                    and loadModule({ "Framework", "Features", "Upgrades", "TreeStructure" }) or nil
                local upgradesConfig = pcall(function() return loadModule({ "Framework", "Features", "Upgrades", "Upgrades" }) end)
                    and loadModule({ "Framework", "Features", "Upgrades", "Upgrades" }) or nil
                if treeStructure and upgradesConfig then
                    options = {
                        structure = treeStructure.Main or treeStructure,
                        config = upgradesConfig,
                        data = data.Upgrades and data.Upgrades(),
                        getCurrency = data.Money,
                        buy = function(name)
                            pcall(function()
                                local net = ReplicatedStorage:FindFirstChild("Network")
                                local buyRemote = net and net:FindFirstChild("RE") and net.RE:FindFirstChild("BuyUpgrade")
                                if buyRemote and buyRemote:IsA("RemoteEvent") then
                                    buyRemote:FireServer(name)
                                end
                            end)
                        end
                    }
                end
            end
            if not options or not options.structure or not options.data or not options.config then
                error("upgrade tree unavailable")
            end
            local function isUnlocked(name)
                local val = options.data and options.data[name]
                if type(val) == "function" then
                    local sOk, res = pcall(val)
                    return sOk and res == true
                end
                return val == true
            end
            if pendingTreeUpgrade then
                if isUnlocked(pendingTreeUpgrade.name) then
                    pendingTreeUpgrade = nil
                else
                    if os.clock() >= pendingTreeUpgrade.deadline then
                        setStatus("Upgrade Tree: waiting for confirmation")
                    end
                    return
                end
            end
            local money = options.getCurrency()
            if type(money) ~= "number" then error("money unavailable") end
            local structure = options.structure
            local queue, seen, index, best = { structure.Root }, {}, 1, nil
            while index <= #queue do
                local parent = queue[index]
                index += 1
                if not seen[parent] then
                    seen[parent] = true
                    for _, child in ipairs(structure:GetChildren(parent)) do
                        if isUnlocked(child) then
                            queue[#queue + 1] = child
                        else
                            local node = options.config[child]
                            local price = node and node.price
                            if type(price) == "number" and price >= 0 and price <= money
                                and (not best or price < best.price or price == best.price and child < best.name) then
                                best = { name = child, price = price }
                            end
                        end
                    end
                end
            end
            if best and active() then
                pendingTreeUpgrade = { name = best.name, deadline = os.clock() + 10 }
                options.buy(best.name)
                setStatus("Upgrade Tree: requested " .. best.name)
            end
        end)
        if not ok and active() then setStatus("Upgrade Tree: " .. tostring(err)) end
        task.wait(ok and 2 or 8)
    end
end

