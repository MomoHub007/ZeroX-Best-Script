local function prepareTowerTeam(services, generation)
    if not towerActive(generation) then return false end

    -- Automatically equip best tower team before starting tower
    if (session.autoTowerTeam or config["Auto Equip Best Tower Team"]) and services.equipBestTowerTeam then
        pcall(function()
            services.equipBestTowerTeam()
        end)
        task.wait(0.3)
    end

    local team = data.TowerTeam and data.TowerTeam()
    local teamCount = 0
    if type(team) == "table" then
        for _, uuid in pairs(team) do
            if type(uuid) == "string" and #uuid > 0 then
                teamCount += 1
            end
        end
    end

    if teamCount > 0 then
        return true
    end

    local refs = loadModule({ "Framework", "Features", "Towers", "TowerRefs" })
    local inventory = data.Inventory and data.Inventory()
    if type(inventory) ~= "table" or type(team) ~= "table" then return false end
    if towerTeamPending then
        local found = false
        for _, key in pairs(team) do if key == towerTeamPending then found = true break end end
        if not found then return false end
        towerTeamPending = nil
    end
    local candidates = {}
    for key, entry in pairs(inventory) do
        if type(key) == "string" and type(entry) == "table" and type(entry.name) == "string" then
            local config = services.registry.getEntryConfig(entry.name)
            if config and config.kind == "Unit" and type(config.chance) == "function" then
                local ok, chance = pcall(config.chance, entry.attributes)
                if ok and type(chance) == "number" and chance > 0 then
                    candidates[#candidates + 1] = { key = key, chance = chance }
                end
            end
        end
    end
    table.sort(candidates, function(a, b)
        if a.chance == b.chance then return a.key < b.key end
        return a.chance > b.chance
    end)
    local maxTeam = (refs and refs.MAX_TEAM_SIZE) or 4
    local desired, present = {}, {}
    for i = 1, math.min(#candidates, maxTeam) do desired[candidates[i].key] = true end
    if not next(desired) then return false end
    for _, key in pairs(team) do present[key] = true end
    for _, candidate in ipairs(candidates) do
        if not desired[candidate.key] then break end
        if not present[candidate.key] then
            for i = 1, maxTeam do
                if not team[i] or not desired[team[i]] then
                    if not towerActive(generation) then return false end
                    towerTeamPending = candidate.key
                    services.towersComm:GetSignal("UpdateTowerTeam"):Fire(i, candidate.key)
                    return false
                end
            end
        end
    end
    return true
end

local function runAutoTower(generation)
    while towerActive(generation) do
        local ok, err = pcall(function()
            local services = getServices()
            if not services.towers or not services.towerController then
                task.wait(2.0)
                return
            end

            if not prepareTowerTeam(services, generation) then
                setTowerStatus("Waiting for team")
                task.wait(3)
                return
            end
            if not towerActive(generation) then return end

            local ordered = getHighestViableTowers(services)
            if #ordered == 0 then
                task.wait(3.0)
                return
            end

            local target, isProbe = towerAdaptive.batchTarget, towerAdaptive.batchProbe
            if target then
                local available
                for _, tower in ipairs(ordered) do
                    if tower.name == target.name then available = tower break end
                end
                target = available
            end
            if not target then
                target, isProbe = selectAdaptiveTower(ordered)
                towerAdaptive.batchTarget = target
                towerAdaptive.batchProbe = isProbe
                towerAdaptive.batchCompleted = 0
            end
            setTowerStatus((isProbe and "[Probe]: " or "Starting ") .. target.name)
            setStatus("Auto Tower: Preparing " .. target.name .. "...")

            if towerStartInFlight then task.wait(2) return end
            dismissTowerPopups()
            if not towerActive(generation) then return end
            towerStartInFlight = true
            local sOk, started = pcall(startTowerBattle, services, target.name)
            towerStartInFlight = false
            if not sOk then error(started) end

            if not started or not towerActive(generation) then
                setTowerStatus("start not accepted; waiting")
                task.wait(6)
                return
            end

            -- 3. Monitor battle progression until completion
            local startTime = os.clock()
            local outcome = nil
            local highestFloorSeen = 0
            local sawBattle = false
            local finalEnemyDefeated = false

            while towerActive(generation) do
                task.wait(0.8)
                local elapsed = os.clock() - startTime

                if elapsed > 400 then
                    setTowerStatus("waiting for current run")
                end

                if session.autoHideTower then
                    hideTowerDisplay()
                end

                -- Track active battle state & floors
                pcall(function()
                    local pgui = player:FindFirstChild("PlayerGui")
                    if not pgui then return end

                    local root = pgui:FindFirstChild("Root")
                    local towerGui = root and root:FindFirstChild("Tower")

                    if towerGui then
                        local sVis = towerGui.Screen and towerGui.Screen.Visible
                        local hVis = towerGui.Hidden and towerGui.Hidden.Visible

                        if sVis or hVis then
                            sawBattle = true
                        end

                        local hiddenLabel = towerGui.Hidden and towerGui.Hidden:FindFirstChild("Label")
                        if hiddenLabel and hiddenLabel:IsA("TextLabel") then
                            local fl = tonumber(hiddenLabel.Text:match("Floor%s+(%d+)")) or tonumber(hiddenLabel.Text:match("(%d+)"))
                            if fl then
                                highestFloorSeen = math.max(highestFloorSeen, fl)
                                setTowerStatus(string.format("%s (Floor %d)", target.name, fl))
                            end
                        end

                        local floorLabel = towerGui.Screen and towerGui.Screen:FindFirstChild("Floor")
                        if floorLabel and floorLabel:IsA("TextLabel") then
                            local fl = tonumber(floorLabel.Text:match("Floor%s+(%d+)")) or tonumber(floorLabel.Text:match("(%d+)"))
                            if fl then
                                highestFloorSeen = math.max(highestFloorSeen, fl)
                                setTowerStatus(string.format("%s (Floor %d)", target.name, fl))
                            end
                        end
                        local enemy = towerGui.Screen and towerGui.Screen:FindFirstChild("EnemyCard")
                        local healthBar = enemy and enemy:FindFirstChild("HealthBar")
                        local health = healthBar and healthBar:FindFirstChild("Health")
                        if towerGui.Screen.Visible and highestFloorSeen == target.maxFloors
                            and health and health:IsA("TextLabel") and health.Text == "0" then
                            finalEnemyDefeated = true
                        end
                    end

                    -- Check textual outcome
                    for _, gui in ipairs(pgui:GetChildren()) do
                        if gui:IsA("ScreenGui") and gui.Enabled then
                            local gName = gui.Name:lower()
                            if gName:find("tower") or gName:find("battle") then
                                for _, desc in ipairs(gui:GetDescendants()) do
                                    if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                                        local txt = desc.Text:lower()
                                        if txt:find("defeat") or txt:find("failed") or txt:find("you lose") or txt:find("game over") then
                                            outcome = "DEFEAT"
                                            break
                                        elseif txt:find("victory") or txt:find("cleared") or txt:find("you win") or txt:find("stage clear") or txt:find("rewards") then
                                            outcome = "VICTORY"
                                            break
                                        end
                                    end
                                end
                            end
                        end
                        if outcome then break end
                    end
                end)

                -- Check player humanoid
                local char = player.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then
                    outcome = "DEFEAT"
                end

                if outcome then
                    dismissTowerPopups()
                    break
                end

                -- Detect end of battle (UI closed after seeing battle)
                if elapsed > 10 and sawBattle then
                    local pgui = player:FindFirstChild("PlayerGui")
                    local root = pgui and pgui:FindFirstChild("Root")
                    local towerGui = root and root:FindFirstChild("Tower")
                    local activeNow = towerGui and (towerGui.Screen.Visible or towerGui.Hidden.Visible)
                    if not activeNow then
                        if finalEnemyDefeated then
                            outcome = "VICTORY"
                        elseif highestFloorSeen > 0 and highestFloorSeen < target.maxFloors then
                            outcome = "DEFEAT"
                        else
                            outcome = "UNKNOWN"
                        end
                        dismissTowerPopups()
                        break
                    end
                end
            end

            if not towerActive(generation) then return end

            -- 4. Update adaptive loop based on outcome
            if outcome == "VICTORY" then
                towerAdaptive.viable[target.name] = true
                towerAdaptive.failed[target.name] = nil
                setTowerStatus("Cleared " .. target.name .. "!")
                setStatus("Auto Tower: " .. target.name .. " cleared! Viable in loop.")
            elseif outcome == "DEFEAT" then
                towerAdaptive.viable[target.name] = false
                towerAdaptive.failed[target.name] = os.clock()
                setTowerStatus(target.name .. " failed")
                setStatus("Auto Tower: " .. target.name .. " failed")
            else
                setTowerStatus("outcome unconfirmed")
                while towerActive(generation) do task.wait(3) end
                return
            end

            towerAdaptive.batchCompleted += 1
            setStatus(string.format("Auto Tower: %s %s (%d/%d)", target.name, outcome, towerAdaptive.batchCompleted, config["Tower Runs"]))
            if towerAdaptive.batchCompleted >= config["Tower Runs"] then
                for index, tower in ipairs(ordered) do
                    if tower.name == target.name then
                        towerAdaptive.nextUnverifiedIndex = index % #ordered + 1
                        break
                    end
                end
                if outcome == "DEFEAT" then
                    towerAdaptive.viableOrderIndex = 1
                    towerAdaptive.probeHigherNext = false
                end
                towerAdaptive.batchTarget = nil
                towerAdaptive.batchCompleted = 0
            end

            dismissTowerPopups()

            -- 5. Wait for server debounce (5s) before cycling next tower
            task.wait(5.5)
        end)

        if not ok and towerActive(generation) then
            setTowerStatus(tostring(err))
            task.wait(5.0)
        end
    end

    setTowerStatus("Idle")
end

