--------------------------------------------------------------------------------
-- FEATURE 11: AUTO SELL UNITS BELOW THE PLOT THRESHOLD
--------------------------------------------------------------------------------

local cleanupInFlight = false
local cleanupNextIdleStatus = 0
local cleanupHeartbeat = 0
local cleanupMonitorGeneration = 0

local function setCleanupStatus(message)
    session.cleanupStatus = message
    setStatus("Auto Sell: " .. message)
end

local function runCleanup(generation)
    local function active()
        return session.alive and session.autoCleanup and session.cleanupGeneration == generation
    end
    while active() do
        cleanupHeartbeat = os.clock()
        local ok, err = pcall(function()
            if cleanupInFlight then return end
            local services = getServices()
            local sell = services.network.ClientComm.new(services.networkRoot, false, "SellService"):GetFunction("SellInventory")
            if not active() then return end
            local inventory, slots, team = data.Inventory(), data.Slots(), data.TowerTeam()
            if type(inventory) ~= "table" or type(slots) ~= "table" or type(team) ~= "table" then
                error("inventory, plot or tower team unavailable")
            end

            local protected = {}
            local held = getHeldUnit()
            if held then protected[held] = true end
            if plotUnits.reserved then protected[plotUnits.reserved] = true end
            local lowestPlottedOdds
            for _, slot in pairs(slots) do
                if type(slot) == "table" and slot.unitId then
                    protected[slot.unitId] = true
                    local odds = unitOdds(services.registry, inventory[slot.unitId])
                    if not odds then
                        setCleanupStatus("waiting for plot unit odds")
                        return
                    end
                    lowestPlottedOdds = math.min(lowestPlottedOdds or odds, odds)
                end
            end
            for _, key in pairs(team) do protected[key] = true end
            if not lowestPlottedOdds then
                setCleanupStatus("waiting for units on plot")
                return
            end

            local candidates = {}
            for key, entry in pairs(inventory) do
                if type(key) == "string" and type(entry) == "table" and type(entry.name) == "string"
                    and type(entry.attributes) == "table" then
                    local odds = unitOdds(services.registry, entry)
                    if odds and odds < lowestPlottedOdds and not protected[key]
                        and entry.attributes.locked ~= true then
                        candidates[#candidates + 1] = key
                    end
                end
            end
            if #candidates > 0 then
                if not active() then return end
                cleanupInFlight = true
                local success, money, count = pcall(sell, candidates)
                cleanupInFlight = false
                if not active() then return end
                if success and type(count) == "number" and count > 0 then
                    setCleanupStatus("sold " .. count .. " of " .. #candidates .. " units")
                else
                    setCleanupStatus("sale unconfirmed; retrying")
                end
                return
            end
            if active() and os.clock() >= cleanupNextIdleStatus then
                cleanupNextIdleStatus = os.clock() + 30
                setCleanupStatus("no units below plot threshold")
            end
        end)
        if not ok and active() then setCleanupStatus(tostring(err)) end
        if active() then task.wait(ok and 3 or 8) end
    end
end

local function toggleCleanup(forceState)
    if forceState == nil then session.autoCleanup = not session.autoCleanup else session.autoCleanup = forceState end
    session.cleanupGeneration += 1
    cleanupMonitorGeneration += 1
    updateButton(cleanupButton, "Auto Sell Units Below Plot", session.autoCleanup)
    if session.autoCleanup then
        cleanupHeartbeat = os.clock()
        local monitorGeneration = cleanupMonitorGeneration
        task.spawn(runCleanup, session.cleanupGeneration)
        task.spawn(function()
            while session.alive and session.autoCleanup and cleanupMonitorGeneration == monitorGeneration do
                task.wait(10)
                if not session.alive or not session.autoCleanup or cleanupMonitorGeneration ~= monitorGeneration then return end
                if not cleanupInFlight and os.clock() - cleanupHeartbeat > 45 then
                    session.cleanupGeneration += 1
                    cleanupHeartbeat = os.clock()
                    setCleanupStatus("worker stalled; restarting")
                    task.spawn(runCleanup, session.cleanupGeneration)
                end
            end
        end)
    end
end

