                    if config and config.kind == "Boost" and config.category and type(config.tier) == "number"
                        and config.tier > (highestActive[config.category] or 0) and not potionPending[key] then
                        local old = selected[config.category]
                        if not old or config.tier > old.tier then
                            selected[config.category] = { key = key, tier = config.tier, amount = item.amount }
                        end
                    end
                end
            end
            for _, item in pairs(selected) do
                if not active() then return end
                potionPending[item.key] = { amount = item.amount, deadline = os.clock() + 10 }
                local sent = services.useBoost(item.key, 1)
                if not sent then
                    potionPending[item.key] = nil
                    error("boost signal unavailable")
                end
                setStatus("Auto Potions: use requested")
                break
            end
        end)
        if not ok and active() then setStatus("Auto Potions: " .. tostring(err)) end
        task.wait(ok and 3 or 8)
    end
end

