do
    local lighting = game:GetService("Lighting")
    local changed = setmetatable({}, { __mode = "k" })
    local connections = {}
    local enabled, generation, previousCap = false, 0, nil
    local setCap = type(setfpscap) == "function" and setfpscap or nil
    local getCap = type(getfpscap) == "function" and getfpscap or nil

    local function change(object, property, value)
        local ok, oldValue = pcall(function() return object[property] end)
        if not ok or oldValue == value then return end
        local properties = changed[object]
        if properties and properties[property] then return end
        local applied = pcall(function() object[property] = value end)
        if applied then
            if not properties then properties = {}; changed[object] = properties end
            properties[property] = { before = oldValue, applied = value }
        end
    end

    local function simplify(object)
        if object:IsA("BasePart") then
            change(object, "Material", Enum.Material.Plastic)
            change(object, "Reflectance", 0)
            change(object, "CastShadow", false)
        elseif object:IsA("Decal") or object:IsA("Texture") then
            change(object, "Transparency", 1)
        elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam")
            or object:IsA("Fire") or object:IsA("Smoke") or object:IsA("Sparkles")
            or object:IsA("PostEffect") then
            change(object, "Enabled", false)
        end
    end

    session.setPotato = function(on)
        if on == enabled then return end
        enabled = on
        generation += 1
        local currentGeneration = generation
        potatoButton.Text = on and "POTATO • ON" or "POTATO • OFF"
        potatoButton.BackgroundColor3 = on and Color3.fromRGB(58, 104, 75) or Color3.fromRGB(35, 30, 48)
        if on then
            previousCap = nil
            if getCap then
                local ok, cap = pcall(getCap)
                if ok and type(cap) == "number" then previousCap = cap end
            end
            local targetFps = config["FPS Lock"]
            local capped = false
            if setCap then capped = pcall(setCap, targetFps) end
            if capped and getCap then
                local ok, cap = pcall(getCap)
                if ok then capped = cap == targetFps end
            end
            session.potatoStatus = capped and ("ส่งคำขอจำกัด FPS ที่ " .. targetFps .. " แล้ว") or ("ตั้ง FPS ที่ " .. targetFps .. " ไม่สำเร็จ")
            if setCap then
                task.spawn(function()
                    while enabled and generation == currentGeneration and session.alive do
                        task.wait(getCap and 2 or 5)
                        if not enabled or generation ~= currentGeneration or not session.alive then return end
                        local needsUpdate = true
                        if getCap then
                            local ok, cap = pcall(getCap)
                            needsUpdate = not ok or type(cap) ~= "number" or cap ~= targetFps
                        end
                        if needsUpdate then
                            local applied = pcall(setCap, targetFps)
                            if applied and getCap then
                                local ok, cap = pcall(getCap)
                                applied = ok and cap == targetFps
                            end
                            local newStatus = applied and ("ส่งคำขอจำกัด FPS ที่ " .. targetFps .. " แล้ว") or ("ตั้ง FPS ที่ " .. targetFps .. " ไม่สำเร็จ")
                            if session.potatoStatus ~= newStatus then
                                session.potatoStatus = newStatus
                                setStatus("โหมด Potato • " .. newStatus)
                            end
                        end
                    end
                end)
            end
            change(lighting, "GlobalShadows", false)
