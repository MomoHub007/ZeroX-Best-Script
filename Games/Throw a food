    local function DoFilteredSell(silent)
        if not DataController or not DataController:IsReady() then return 0, 0 end
        local animals = GetDataVal("Animals", {})
        local indexMap = GetDataVal("Index", {})
        local bestIncome = LocalPlayer:GetAttribute("BestIncome") or 0

        local minKeepRarityIdx = 999
        if tfa.SellKeepMinRarity ~= "Sell All" and RarityConfig then
            minKeepRarityIdx = RarityConfig.IndexOf(tfa.SellKeepMinRarity)
        end

        local keepMutMap = tfa.SellKeepMutations or {}
        local weakestPlacedIncome = math.huge
        local placedCount = 0
        local maxSlots = FenceConfig and FenceConfig.SlotsFor(GetDataVal("FenceLevel", 0)) or 10

        for _, entry in pairs(animals) do
            if entry.Placed then
                placedCount = placedCount + 1
                local inc = Mutations and Mutations.IncomeOf(entry, bestIncome) or 0
                if inc < weakestPlacedIncome then
                    weakestPlacedIncome = inc
                end
            end
        end

        local toSell = {}
        local totalNonBoughtBag = 0
        local keptInPassByModel = {}

        for id, entry in pairs(animals) do
            if not entry.Placed and not entry.Bought then
                totalNonBoughtBag = totalNonBoughtBag + 1
                local keep = false

                local eco = AnimalEconomy and AnimalEconomy.Get(entry.ModelName)
                local rarityName = eco and eco.Rarity or "Common"
                local rarityIdx = RarityConfig and RarityConfig.IndexOf(rarityName) or 1
                local inc = Mutations and Mutations.IncomeOf(entry, bestIncome) or 0

                if rarityIdx >= minKeepRarityIdx then
                    keep = true
                elseif entry.Mutation and keepMutMap[entry.Mutation] == true then
                    keep = true
                elseif tfa.SellKeepGiant and (tonumber(entry.Size) or 1) > 1 then
                    keep = true
                elseif tfa.SellKeepNewIndex and indexMap[entry.ModelName] ~= true and not keptInPassByModel[entry.ModelName] then
                    keep = true
                    keptInPassByModel[entry.ModelName] = true
                elseif tfa.SellKeepBetterBest then
                    if inc >= bestIncome and bestIncome > 0 then
                        keep = true
                    elseif placedCount < maxSlots and inc > 0 then
                        keep = true
                    elseif placedCount >= maxSlots and inc > weakestPlacedIncome then
                        keep = true
                    end
                end

                if not keep then
                    table.insert(toSell, id)
                end
            end
        end

        if #toSell == 0 then
            return 0, 0
        end

        if #toSell == totalNonBoughtBag and totalNonBoughtBag > 1 then
            local res = InvokeRemote("Plot_SellAll")
            if res and res.Ok then
                local cnt = tonumber(res.Count) or #toSell
                local money = tonumber(res.Money) or 0
                session.SoldCount = session.SoldCount + cnt
                session.SoldMoney = session.SoldMoney + money
                if not silent then
                    Window:Toast("Auto Sell", {
                        Detail = string.format("Sold %d animal(s) for %s", cnt, FmtMoney(money)),
                        Icon = "dollar-sign",
                        Highlight = true,
                    })
                end
                return cnt, money
            end
        end

        local soldCnt = 0
        local soldMoney = 0
        for _, id in ipairs(toSell) do
            if not alive then break end
            local res = InvokeRemote("Plot_SellAnimal", id)
            if res and res.Ok then
                soldCnt = soldCnt + 1
                soldMoney = soldMoney + (tonumber(res.Money) or 0)
            end
            task.wait(0.05)
        end

        if soldCnt > 0 then
            session.SoldCount = session.SoldCount + soldCnt
            session.SoldMoney = session.SoldMoney + soldMoney
            if not silent then
                Window:Toast("Auto Sell", {
                    Detail = string.format("Sold %d animal(s) for %s", soldCnt, FmtMoney(soldMoney)),
                    Icon = "dollar-sign",
                    Highlight = true,
                })
            end
        end
        return soldCnt, soldMoney
    end

