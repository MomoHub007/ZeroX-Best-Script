        EnsureNotTraining()
        local starter = workspace:FindFirstChild("StarterArea")
        local cross = starter and starter:FindFirstChild("CrossLine")
        if not starter or not cross then return false end
        local pos = Vector3.new(cross.Position.X, starter.Position.Y + starter.Size.Y / 2 + 3, cross.Position.Z - 2.5)
        SafePivot(CFrame.lookAt(pos, pos + Vector3.new(0, 0, -1)))
        local waitStart = os.clock()
        while alive and (tfa.AutoThrow or tfa.HybridFarm) and os.clock() - waitStart < 15 do
            if not (ClientState and ClientState.Busy == "Throw") and os.clock() - waitStart > 0.6 then
                break
            end
            task.wait(0.2)
        end
        task.spawn(RunPostCatchMaintenance)
        return true
    end

    local function DoStartSilentTrain()
        local spot = GetTrainingSpotPos()
        if not spot then return false end
        if GetDataVal("Stand", 0) < 1 then
            if tfa.AutoBuyStand1 then
                DoUpgradeStand(true)
            end
            if GetDataVal("Stand", 0) < 1 then
                return false, "NoStand"
            end
        end

        if LocalPlayer:GetAttribute("Training") == true then
            return true
        end

        -- Stand 4 studs from TrainingSpot: inside server's 5-stud range, outside client's 3.2-stud cutscene trigger
        local targetPos = spot + Vector3.new(4, 3, 0)
        local _, _, hrp = GetCharParts()
        if not hrp then return false end
        if (hrp.Position - targetPos).Magnitude > 2.5 then
            SafePivot(CFrame.lookAt(targetPos, Vector3.new(spot.X, targetPos.Y, spot.Z)))
            task.wait(0.4)
        end
        local res = InvokeRemote("Training_Start")
        if res and res.Ok then
            return true
        end
        if res and res.Reason == "TooFar" then
            SafePivot(CFrame.lookAt(targetPos, Vector3.new(spot.X, targetPos.Y, spot.Z)))
            task.wait(0.45)
            local retry = InvokeRemote("Training_Start")
            return retry and retry.Ok
        end
        return false, res and res.Reason
    end

