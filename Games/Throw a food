    local origSuperBegin
    if SuperThrow then
        origSuperBegin = SuperThrow.Begin
        SuperThrow.Begin = function(params, ...)
            local obj = origSuperBegin(params, ...)
            if alive and tfa.ManualLuckyAutoUse and obj and obj.SavedMode and obj.UseSaved then
                task.defer(function()
                    if alive and not obj.Dead then
                        pcall(obj.UseSaved, obj)
                    end
                end)
            end
            return obj
        end
    end

    local activeRingRush = nil
    local origRRRunAsync, origRRStep
    if RingRushFlight and RingRushCourse then
        origRRRunAsync = RingRushFlight.RunAsync
        RingRushFlight.RunAsync = function(params, ...)
            if type(params) == "table" and params.Begin and params.Begin.Seed and params.Launch then
                activeRingRush = {
                    Course = RingRushCourse.new(params.Begin.Seed, params.Launch),
                    Food = params.Food,
                    Launch = params.Launch,
                    StartTime = os.clock(),
                    NextRing = 1,
                }
            end
            local ok, a, b = pcall(origRRRunAsync, params, ...)
            activeRingRush = nil
            if not ok then error(a) end
            return a, b
        end
    end

    if RingRushSteering then
        origRRStep = RingRushSteering.Step
        RingRushSteering.Step = function(self, frame, scale, ...)
            if alive and tfa.RingRushAutoSteer and activeRingRush and activeRingRush.Course then
                local course = activeRingRush.Course
                local food = activeRingRush.Food
                local elapsed = os.clock() - activeRingRush.StartTime
                local dist = activeRingRush.NextRing > 1 and course:GetRingDistance(activeRingRush.NextRing - 1) or 0
                if food and food.Parent then
                    dist = math.max(0, course.Start.Z - food:GetPivot().Position.Z)
                end
                while dist >= course:GetRingDistance(activeRingRush.NextRing) do
                    activeRingRush.NextRing = activeRingRush.NextRing + 1
                end
                local ring = course:GetRing(activeRingRush.NextRing)
                local target = course:GetRingOffset(ring, elapsed)

                -- Check mobs between current and next ring to dodge cleanly
                local mobs = course:GetMobs(math.max(1, activeRingRush.NextRing - 1))
                for _, mob in ipairs(mobs) do
                    if mob.Distance >= dist - 2 and mob.Distance <= dist + 42 then
                        local mobOff = course:GetMobOffset(mob, elapsed)
                        local delta = target - mobOff
                        if delta.Magnitude < 4.8 then
                            local push = delta.Magnitude > 0.05 and delta.Unit or Vector2.new(1, 0)
                            target = mobOff + push * 5.2
                            local maxOff = RingRushConfig and RingRushConfig.Course.MaxOffset or 26
                            if target.Magnitude > maxOff then
                                target = target.Unit * maxOff
                            end
                        end
                    end
                end

                self.Scheme = "Mouse"
                self.Goal = target
                local dt = (type(frame) == "table" and frame.DeltaTime) or 0.016
                self.SpringX:Step(target.X, 0, dt)
                self.SpringY:Step(target.Y, 0, dt)
                return
            end
            return origRRStep(self, frame, scale, ...)
        end
    end

