    local function DoSilentThrowOnce()
        if not alive then return false end
        if ClientState and ClientState.Busy then
            return false, "ClientBusy"
        end
        local char, hum, hrp = GetCharParts()
        if not char or not hum or not hrp or hum.Health <= 0 then
            return false, "NoCharacter"
        end

        EnsureNotTraining()

        local throwPos = GetStarterThrowPos()
        if not throwPos then
            return false, "NoStarterArea"
        end

        local oldCF = tfa.ReturnAfterThrow and char:GetPivot() or nil
        if (hrp.Position - throwPos).Magnitude > 6 then
            SafePivot(CFrame.lookAt(throwPos, throwPos + Vector3.new(0, 0, -1)))
            task.wait(0.35)
        end

        if tfa.AutoApplyPower then
            ApplyTargetThrowPower(true)
        end
        if tfa.AutoBuyFood or tfa.AutoEquipBestFood then
            DoBuyBestFood(true)
        end

        local startRes = InvokeRemote("Throw_Start")
        if not startRes or not startRes.Ok then
            local reason = startRes and startRes.Reason or "Unknown"
            if reason == "TooFar" then
                SafePivot(CFrame.lookAt(throwPos, throwPos + Vector3.new(0, 0, -1)))
                task.wait(0.45)
            elseif reason == "Training" then
                InvokeRemote("Training_Stop")
                task.wait(0.25)
            elseif reason == "Cooldown" then
                task.wait(0.25)
            else
                task.wait(0.2)
            end
            return false, reason
        end

        if startRes.RingRush then
            -- Active Ring Rush event: farm up to 100 rings safely if RingRushCourse exists
            local rrBegin = InvokeRemote("RingRush_Begin")
            if rrBegin and rrBegin.Ok and RingRushCourse and RingRushConfig and AreaUtil then
                local launch = AreaUtil.GetLaunchPosition()
                local course = RingRushCourse.new(rrBegin.Seed, launch)
                local passes = 0
                local elapsed = 0
                local fromDist = 0
                local fromTime = 0
                local targetRings = 100
                for idx = 1, targetRings do
                    if not alive or not (tfa.AutoThrow or tfa.HybridFarm) then break end
                    local ring = course:GetRing(idx)
                    local spd = RingRushCourse.GetSpeed(passes, 0)
                    local dt = (ring.Distance - fromDist) / spd + 0.03
                    task.wait(dt)
                    elapsed = fromTime + dt
                    local offset = course:GetRingOffset(ring, elapsed)
                    local rep = InvokeRemote("RingRush_Report", idx, true, offset.X, offset.Y, elapsed)
                    passes = passes + 1
                    fromDist = ring.Distance
                    fromTime = elapsed
                    if rep and rep.Ended then break end
                end
                InvokeRemote("RingRush_End")
                InvokeRemote("Throw_Cancel")
                if oldCF then SafePivot(oldCF) end
                return true, "RingRush"
            else
                InvokeRemote("Throw_Cancel")
                if oldCF then SafePivot(oldCF) end
                return false, "RingRush"
            end
        end

        if tfa.AutoUseSuper and (GetDataVal("SuperThrows", 0) > 0) then
            pcall(InvokeRemote, "Throw_UseSuper")
        end

        local ratio = 0.5
        if tfa.PerfectMeter and ThrowMeterMath then
            FireEvent("Throw_MeterStarted")
            local hp = ThrowMeterMath.HalfPeriod()
            task.wait(hp)
            ratio = 1
        else
            FireEvent("Throw_MeterStarted")
            task.wait(0.15)
        end

        local res = InvokeRemote("Throw_Resolve", ratio)
        if not res or not res.Ok then
            InvokeRemote("Throw_Cancel")
            if oldCF then SafePivot(oldCF) end
            return false, res and res.Reason or "ResolveFail"
        end

        local comp = InvokeRemote("Throw_Complete")
        if comp and comp.Ok then
            UpdateSessionCatch(res)
            task.spawn(RunPostCatchMaintenance)
        end

        if oldCF then
            SafePivot(oldCF)
        end
        return true
    end

    local function DoLegitWalkThrowOnce()
        if not alive then return false end
        if ClientState and ClientState.Busy then
            task.wait(0.2)
            return false
        end
        local char, hum, hrp = GetCharParts()
        if not char or not hum or not hrp or hum.Health <= 0 then
