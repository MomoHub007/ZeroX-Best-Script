    local function EnsureNotTraining()
        local isTraining = LocalPlayer:GetAttribute("Training") == true
            or (TrainingController and TrainingController.IsRunning())
        if not isTraining then
            return true
        end
        if TrainingController and TrainingController.IsRunning() then
            pcall(TrainingController.Stop)
