    local function RefreshPlotTable()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return end
        local rows = {}
        for _, p in ipairs(plots:GetChildren()) do
            local uid = p:GetAttribute("OwnerUserId") or 0
            local ownerName = "Empty"
            if uid > 0 then
                local plr = game:GetService("Players"):GetPlayerByUserId(uid)
                ownerName = plr and plr.DisplayName or ("User_" .. tostring(uid))
            end
            local bestInc = 0
            local totalInc = 0
            local bestName = "-"
            local animalsFolder = p:FindFirstChild("Animals")
            if animalsFolder then
                for _, a in ipairs(animalsFolder:GetChildren()) do
                    local inc = tonumber(a:GetAttribute("Income")) or 0
                    totalInc = totalInc + inc
                    if inc >= bestInc and inc > 0 then
                        bestInc = inc
                        local mut = a:GetAttribute("Mutation")
                        local disp = a:GetAttribute("DisplayName") or a.Name
                        bestName = (mut and ("[" .. mut .. "] ") or "") .. disp
                    end
                end
            end
            if uid > 0 or totalInc > 0 then
                table.insert(rows, {
                    p.Name,
                    ownerName,
                    bestName,
                    FmtRate(bestInc),
                    FmtRate(totalInc),
                    PlotPart = p,
                    _sort = totalInc,
                })
            end
        end
        table.sort(rows, function(a, b) return a._sort > b._sort end)
        RestoreCap()
        PlotTable:SetRows(rows)
    end

