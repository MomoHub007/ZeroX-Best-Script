    local espEntries = {} -- [model] = { Billboard, Highlight }

    local function ClearESP()
        for model, entry in pairs(espEntries) do
            if entry.Billboard then entry.Billboard:Destroy() end
            if entry.Highlight then entry.Highlight:Destroy() end
            espEntries[model] = nil
        end
    end

    local function UpdateESP()
        if not tfa.AnimalESP then
            if next(espEntries) ~= nil then
                ClearESP()
            end
            return
        end

        local _, _, hrp = GetCharParts()
        local myPos = hrp and hrp.Position
        local myPlotIdx = LocalPlayer:GetAttribute("PlotIndex")
        local rarityFilter = tfa.ESPRarityFilter or {}
        local seen = {}

        local plots = workspace:FindFirstChild("Plots")
        if plots then
            for _, plot in ipairs(plots:GetChildren()) do
                local isMyPlot = myPlotIdx and tostring(myPlotIdx) == plot.Name
                if not (tfa.ESPExcludeOwnPlot and isMyPlot) then
                    local animalsFolder = plot:FindFirstChild("Animals")
                    if animalsFolder then
                        for _, model in ipairs(animalsFolder:GetChildren()) do
                            if model:IsA("Model") and model.Parent then
                                local rarity = model:GetAttribute("Rarity") or "Common"
                                local mut = model:GetAttribute("Mutation")
                                local inc = tonumber(model:GetAttribute("Income")) or 0
                                local pos = model:GetPivot().Position
                                local dist = myPos and (pos - myPos).Magnitude or 0
                                local passesRarity = (next(rarityFilter) == nil) or (rarityFilter[rarity] == true)
                                local passesMut = (not tfa.ESPOnlyMutated) or (mut ~= nil and mut ~= "")
                                local passesDist = dist <= (tfa.ESPMaxDistance or 600)

                                if passesRarity and passesMut and passesDist then
                                    seen[model] = true
                                    local entry = espEntries[model]
                                    if not entry then
                                        local color = (RarityConfig and RarityConfig.Get(rarity).Color) or Color3.fromRGB(255, 220, 90)
                                        local hl = Instance.new("Highlight")
                                        hl.Name = "ZeroX_HL"
                                        hl.Adornee = model
                                        hl.FillColor = color
                                        hl.OutlineColor = Color3.new(1, 1, 1)
                                        hl.FillTransparency = 0.72
                                        hl.OutlineTransparency = 0.15
                                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                        hl.Parent = espFolder

                                        local bb = Instance.new("BillboardGui")
                                        bb.Name = "ZeroX_BB"
                                        bb.Adornee = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                                        bb.Size = UDim2.fromOffset(180, 44)
                                        bb.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
                                        bb.AlwaysOnTop = true
                                        bb.MaxDistance = tfa.ESPMaxDistance or 600
                                        bb.Parent = espFolder

                                        local lbl = Instance.new("TextLabel")
                                        lbl.Size = UDim2.fromScale(1, 1)
                                        lbl.BackgroundTransparency = 1
                                        lbl.Font = Enum.Font.GothamBold
                                        lbl.TextSize = 13
                                        lbl.TextColor3 = color
                                        lbl.TextStrokeTransparency = 0.25
                                        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
                                        local disp = model:GetAttribute("DisplayName") or model.Name
                                        local mutTag = (mut and mut ~= "") and ("[" .. mut .. "] ") or ""
                                        lbl.Text = string.format("%s%s\n%s | %s", mutTag, disp, rarity, FmtRate(inc))
                                        lbl.Parent = bb

                                        espEntries[model] = { Highlight = hl, Billboard = bb }
                                    else
                                        entry.Billboard.MaxDistance = tfa.ESPMaxDistance or 600
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        for model, entry in pairs(espEntries) do
            if not seen[model] or not model.Parent then
                if entry.Billboard then entry.Billboard:Destroy() end
                if entry.Highlight then entry.Highlight:Destroy() end
                espEntries[model] = nil
            end
        end
    end

