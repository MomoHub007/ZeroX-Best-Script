--------------------------------------------------------------------------------
-- THROW FOOD FOR ANIMALS — PRO FEATURE SUITE
--------------------------------------------------------------------------------
do
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunService = game:GetService("RunService")
    local CollectionService = game:GetService("CollectionService")
    local Lighting = game:GetService("Lighting")
    local VirtualUser = pcall(function() return game:GetService("VirtualUser") end) and game:GetService("VirtualUser") or nil
    local UIS = game:GetService("UserInputService")

    local setIdFn = setthreadidentity or (syn and syn.set_thread_identity) or setidentity
    local getIdFn = getthreadidentity or (syn and syn.get_thread_identity) or getidentity
    local baseIdentity = (type(getIdFn) == "function" and getIdFn()) or 8
    local function RestoreCap()
        if type(setIdFn) == "function" then
            pcall(setIdFn, baseIdentity)
        end
    end

    local origWindowToast = Window.Toast
    Window.Toast = function(self, title, opts)
        RestoreCap()
        return origWindowToast(self, title, opts)
    end

    local function Toast(title, opts)
        return Window:Toast(title, opts)
    end

    local ConfigFolder = ReplicatedStorage:WaitForChild("Config", 15)
    local SharedFolder = ReplicatedStorage:WaitForChild("Shared", 15)
    local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts", 15)
    local ClientFolder = PlayerScripts and PlayerScripts:WaitForChild("Client", 15)
    local ControllersFolder = ClientFolder and ClientFolder:WaitForChild("Controllers", 15)

    local function SafeRequire(inst)
        if not inst then return nil end
        local ok, res = pcall(require, inst)
        RestoreCap()
        return ok and res or nil
    end

    local Remotes = SafeRequire(SharedFolder and SharedFolder:FindFirstChild("Remotes"))
    local NumberFormat = SafeRequire(SharedFolder and SharedFolder:FindFirstChild("NumberFormat"))
    local AreaUtil = SafeRequire(SharedFolder and SharedFolder:FindFirstChild("AreaUtil"))
    local ThrowMeterMath = SafeRequire(SharedFolder and SharedFolder:FindFirstChild("ThrowMeterMath"))
    local LuckOdds = SafeRequire(SharedFolder and SharedFolder:FindFirstChild("LuckOdds"))
    local AdminAbuse = SafeRequire(SharedFolder and SharedFolder:FindFirstChild("AdminAbuse"))
    local Mutations = SafeRequire(SharedFolder and SharedFolder:FindFirstChild("Mutations"))
    local BalanceCurve = SafeRequire(SharedFolder and SharedFolder:FindFirstChild("BalanceCurve"))
    local RingRushCourse = SafeRequire(SharedFolder and SharedFolder:FindFirstChild("RingRushCourse"))

    local GameConfig = SafeRequire(ConfigFolder and ConfigFolder:FindFirstChild("GameConfig"))
    local AreasConfig = SafeRequire(ConfigFolder and ConfigFolder:FindFirstChild("AreasConfig"))
    local FoodsConfig = SafeRequire(ConfigFolder and ConfigFolder:FindFirstChild("FoodsConfig"))
    local StandsConfig = SafeRequire(ConfigFolder and ConfigFolder:FindFirstChild("StandsConfig"))
    local FenceConfig = SafeRequire(ConfigFolder and ConfigFolder:FindFirstChild("FenceConfig"))
    local LevelConfig = SafeRequire(ConfigFolder and ConfigFolder:FindFirstChild("LevelConfig"))
    local RarityConfig = SafeRequire(ConfigFolder and ConfigFolder:FindFirstChild("RarityConfig"))
    local MutationsConfig = SafeRequire(ConfigFolder and ConfigFolder:FindFirstChild("MutationsConfig"))
    local AnimalEconomy = SafeRequire(ConfigFolder and ConfigFolder:FindFirstChild("AnimalEconomy"))
    local AdminAbuseConfig = SafeRequire(ConfigFolder and ConfigFolder:FindFirstChild("AdminAbuseConfig"))
    local RingRushConfig = SafeRequire(ConfigFolder and ConfigFolder:FindFirstChild("RingRushConfig"))
    local AnimalsData = SafeRequire(ReplicatedStorage:FindFirstChild("AnimalsData"))

    local DataController = SafeRequire(ControllersFolder and ControllersFolder:FindFirstChild("DataController"))
    local ClientState = SafeRequire(ControllersFolder and ControllersFolder:FindFirstChild("ClientState"))
    local ThrowMeter = SafeRequire(ControllersFolder and ControllersFolder:FindFirstChild("ThrowMeter"))
    local SuperThrow = SafeRequire(ControllersFolder and ControllersFolder:FindFirstChild("SuperThrow"))
    local RevealSequence = SafeRequire(ControllersFolder and ControllersFolder:FindFirstChild("RevealSequence"))
    local TrainingController = SafeRequire(ControllersFolder and ControllersFolder:FindFirstChild("TrainingController"))
    local Movement = SafeRequire(ControllersFolder and ControllersFolder:FindFirstChild("Movement"))
    local ScreenFX = SafeRequire(ControllersFolder and ControllersFolder:FindFirstChild("ScreenFX"))
    local CameraRig = SafeRequire(ControllersFolder and ControllersFolder:FindFirstChild("CameraRig"))
    local HUDController = SafeRequire(ControllersFolder and ControllersFolder:FindFirstChild("HUDController"))
    local RingRushFolder = ControllersFolder and ControllersFolder:FindFirstChild("RingRush")
    local RingRushFlight = SafeRequire(RingRushFolder and RingRushFolder:FindFirstChild("RingRushFlight"))
    local RingRushSteering = SafeRequire(RingRushFolder and RingRushFolder:FindFirstChild("RingRushSteering"))

    local AnimalNames = {}
    local TotalAnimalCount = 0
    if type(AnimalsData) == "table" then
        for _, list in pairs(AnimalsData) do
            if type(list) == "table" then
                for _, entry in ipairs(list) do
                    if entry.ModelName then
                        if not AnimalNames[entry.ModelName] then
                            TotalAnimalCount = TotalAnimalCount + 1
                        end
                        AnimalNames[entry.ModelName] = entry.Name or entry.ModelName
                    end
                end
            end
        end
    end

    local function FmtMoney(n)
        if NumberFormat and NumberFormat.Money then
            return NumberFormat.Money(tonumber(n) or 0)
        end
        return "$" .. tostring(math.floor(tonumber(n) or 0))
    end

    local function FmtRate(n)
        if NumberFormat and NumberFormat.PerSecond then
            return NumberFormat.PerSecond(tonumber(n) or 0)
        end
        return "$" .. tostring(math.floor(tonumber(n) or 0)) .. "/s"
    end

    local function FmtNum(n)
        if NumberFormat and NumberFormat.Abbreviate then
            return NumberFormat.Abbreviate(tonumber(n) or 0)
        end
        return tostring(n or 0)
    end

    local function GetDataReady()
        if not DataController then return false end
        if not DataController:IsReady() then
            pcall(function() DataController:WaitForReady() end)
        end
        return DataController:IsReady()
    end

    local function GetDataVal(key, default)
        if not DataController or not DataController:IsReady() then
            return default
        end
        local v = DataController:Get(key)
        RestoreCap()
        if v == nil then return default end
        return v
    end

    local function GetCharParts()
        local char = LocalPlayer.Character
        if not char then return nil, nil, nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart") or (hum and hum.RootPart)
        return char, hum, hrp
    end

    local function SafePivot(cf)
        local char, hum, hrp = GetCharParts()
        if not char or not hrp or not hum or hum.Health <= 0 then
            return false
        end
        if hrp.Anchored then
            hrp.Anchored = false
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        char:PivotTo(cf)
        return true
    end

    local function GetMyPlotPart()
        local plotIdx = LocalPlayer:GetAttribute("PlotIndex")
        local plots = workspace:FindFirstChild("Plots")
        if plotIdx and plots then
            return plots:FindFirstChild(tostring(plotIdx))
        end
        return nil
    end

    local function GetTrainingSpotPos()
        local plot = GetMyPlotPart()
        if not plot or not GameConfig then return nil end
        return plot.Position + GameConfig.Plot.TrainingSpotOffset
    end

    local function GetStarterThrowPos()
        local starter = workspace:FindFirstChild("StarterArea")
        if not starter then return nil end
        local cross = starter:FindFirstChild("CrossLine")
        local y = starter.Position.Y + starter.Size.Y / 2 + 3
        if cross then
            return Vector3.new(cross.Position.X, y, cross.Position.Z + 1.5), cross.Position
        end
        return Vector3.new(starter.Position.X, y, starter.Position.Z + starter.Size.Z / 2 + 1.5), nil
    end

    local function InvokeRemote(name, ...)
