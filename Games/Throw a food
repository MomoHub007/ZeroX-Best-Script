    local function ApplyTargetThrowPower(silent)
        if not LevelConfig or not AreaUtil then return false end
        local lvl = GetDataVal("Level", 1)
        local maxP = LevelConfig.ThrowPowerForLevel(lvl)
        local minP = math.min(LevelConfig.MinThrowPower, maxP)
        local targetVal = 0

        if tfa.TargetArea ~= "Max Power (Auto)" then
            local areaIdx = areaIndexByLabel[tfa.TargetArea]
            if areaIdx then
                local dist = AreaUtil.TargetDistanceForArea(areaIdx)
                if tfa.AccountPerfectBonus and GameConfig then
                    dist = dist - (GameConfig.Throw.MeterBonusStuds or 20)
                end
                local clamped = math.clamp(math.floor(dist + 0.5), minP, maxP)
                targetVal = (clamped >= maxP) and 0 or clamped
            end
        end

        local currentSet = GetDataVal("ThrowPower", 0)
        if currentSet == targetVal then
            return true
        end

        local res = InvokeRemote("Player_SetThrowPower", targetVal)
        if not silent then
            if res and res.Ok then
                Window:Toast("Power Targeter", {
                    Detail = targetVal == 0 and ("Set to MAX (" .. tostring(maxP) .. ")") or ("Set throw power to " .. tostring(targetVal)),
                    Icon = "check-circle",
                    Highlight = true,
                })
            else
                Window:Toast("Power Targeter", {
                    Detail = "Failed: " .. tostring(res and res.Reason or "Error"),
                })
            end
        end
        return res and res.Ok
    end

    local function DoBuyBestFood(silent)
        if not FoodsConfig or not DataController or not DataController:IsReady() then return false end
        local money = GetDataVal("Money", 0)
        local owned = GetDataVal("OwnedFoods", {})
        local equipped = GetDataVal("EquippedFood", 1)
        local boughtAny = false

        if tfa.AutoBuyFood then
            for i = #FoodsConfig.List, 1, -1 do
                local food = FoodsConfig.Get(i)
                if food then
                    local isOwned = owned[tostring(i)] == true or owned[i] == true
                    if isOwned then
                        break
                    end
                    local price = BalanceCurve and BalanceCurve.GetItemPrice(LocalPlayer, food) or food.Price
                    RestoreCap()
                    if money >= price then
                        local res = InvokeRemote("Shop_Buy", i)
                        if res and res.Ok then
                            boughtAny = true
                            if not silent then
                                Window:Toast("Food Shop", {
                                    Detail = "Bought " .. tostring(food.Name),
                                    Icon = "shopping-bag",
                                    Highlight = true,
                                })
                            end
                            owned = GetDataVal("OwnedFoods", owned)
                            if tfa.AutoEquipBestFood then
                                InvokeRemote("Shop_Equip", i)
                            end
                            break
                        end
                    end
                end
            end
        end

        if tfa.AutoEquipBestFood and not boughtAny then
            owned = GetDataVal("OwnedFoods", {})
            equipped = GetDataVal("EquippedFood", 1)
            for i = #FoodsConfig.List, 1, -1 do
                if owned[tostring(i)] == true or owned[i] == true then
